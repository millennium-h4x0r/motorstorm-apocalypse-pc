--- a/CMakeLists.txt	2026-11-04 10:48:13.036460865 +0100
+++ b/CMakeLists.txt	2026-11-04 10:48:13.037460873 +0100
@@ -351,6 +351,37 @@
     endif()
 endif()
 
+# Movie decoding: cellVdec (MPEG-2, AVC, MPEG-4 Part 2/XviD) and cellAdec
+# (AC3) decode through FFmpeg's libraries when pkg-config finds them, and
+# fall back to black pictures and silence otherwise. Linked dynamically
+# (LGPL). Debian/Ubuntu: libavcodec-dev libavutil-dev libswscale-dev.
+option(PS3RECOMP_FFMPEG "Decode cellVdec/cellAdec streams with FFmpeg if found" ON)
+# A cross build (MinGW) must not pick up the build host's .pc files: only
+# look when the toolchain points pkg-config at its own sysroot.
+if(PS3RECOMP_FFMPEG AND CMAKE_CROSSCOMPILING AND NOT DEFINED ENV{PKG_CONFIG_LIBDIR})
+    message(STATUS "  Movies:       cross build without PKG_CONFIG_LIBDIR; FFmpeg not used")
+    set(PS3RECOMP_FFMPEG OFF)
+endif()
+if(PS3RECOMP_FFMPEG)
+    find_package(PkgConfig QUIET)
+    if(PkgConfig_FOUND)
+        # GLOBAL: the runtime is a static library linked from the port's own
+        # directory, which has to see the imported target too.
+        pkg_check_modules(PS3RECOMP_AV QUIET IMPORTED_TARGET GLOBAL
+            libavcodec libavutil libswscale)
+    endif()
+    if(PS3RECOMP_AV_FOUND)
+        set_source_files_properties(
+            "${CMAKE_CURRENT_SOURCE_DIR}/libs/codec/cellVdec.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/libs/codec/cellAdec.c"
+            PROPERTIES COMPILE_DEFINITIONS PS3RECOMP_HAVE_FFMPEG=1)
+        target_link_libraries(ps3recomp_runtime PRIVATE PkgConfig::PS3RECOMP_AV)
+        message(STATUS "  Movies:       FFmpeg (libavcodec ${PS3RECOMP_AV_libavcodec_VERSION})")
+    else()
+        message(STATUS "  Movies:       FFmpeg not found; cellVdec/cellAdec give black pictures and silence")
+    endif()
+endif()
+
