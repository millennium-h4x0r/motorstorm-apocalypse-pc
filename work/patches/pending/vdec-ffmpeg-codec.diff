+        for (u32 x = 0; x < w * 2; x += 2) { row[x] = 0x80; row[x + 1] = 0x10; }
+        for (u32 y = 0; y < h; y++) vm_memcpy_to(dst + y * w * 2, row, w * 2);
+        break;
+    default:                                           /* YUV420 planar */
+        vm_memset(dst, 0x10, (size_t)w * h);
+        vm_memset(dst + w * h, 0x80, (size_t)(w / 2) * (h / 2) * 2);
+        break;
+    }
