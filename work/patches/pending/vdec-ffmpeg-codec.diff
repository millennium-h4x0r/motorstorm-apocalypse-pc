+static void vdec_store_black(u32 dst, u32 type, u8 alpha, u32 w, u32 h)
+{
+    u8 row[4096 * 4];
+    if (w > 4096) w = 4096;
+    switch (type) {
+    case 0: case 1:                                    /* ARGB32 / RGBA32 */
+        memset(row, 0, w * 4);
+        for (u32 x = 0; x < w; x++) row[x * 4 + (type == 0 ? 0 : 3)] = alpha;
