+#define ADEC_AC3_MAXCH      6u
+#define ADEC_AC3_PCM_MAX    (ADEC_AC3_SAMPLES * ADEC_AC3_MAXCH * 4u)
+#define ADEC_AC3_PCM_EA(h)  (VM_HLE_INJECT_BASE + 0x60000u + (u32)(h) * 0x10000u)
