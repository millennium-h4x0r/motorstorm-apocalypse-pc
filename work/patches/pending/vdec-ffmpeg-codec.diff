 /* ---------------------------------------------------------------------------
+ * AC3
+ * -----------------------------------------------------------------------*/
+/* CellAdecParamAc3 (guest): +0 u8 wordSize, +1 u8 outputMode, +2 u8 outLfeOn,
+ * +4 f32 drcCutScaleFactor, +8 f32 drcBoostScaleFactor, +0xC u8
+ * compressionMode, +0xD u8 numberOfChannels, +0xE stereoMode, +0xF
+ * dualmonoMode, +0x10 karaokeCapableMode, +0x14 f32 pcmScaleFactor,
+ * +0x18..+0x2C s32 channelPointer0..5.
+ *
+ * MotorStorm Apocalypse (fn 0x9EE6D0) passes wordSize FLOAT, outputMode 2_0
+ * with no LFE and channelPointers {0,2,1,3,4,5} for a stereo stream, or 3_2
+ * + LFE with {0,1,2,3,4,5} for 5.1; pcmScaleFactor 1.0. It sizes each frame
+ * by the PcmItem's size (1536 * channels * 4) and copies it with GetPcm. */
+static void adec_ac3_params(AdecSlot* a, u32 param)
+{
+    static const u8 mode_ch[8] = { 2, 1, 2, 3, 3, 4, 4, 5 };
+    a->wordSize = 1;
+    a->outCh = 2;
+    a->scale = 1.0f;
+    static const u8 stereo_map[ADEC_AC3_MAXCH] = { 0, 2, 1, 3, 4, 5 };
+    memcpy(a->chmap, stereo_map, sizeof stereo_map);
+    if (!param) return;
+    a->wordSize = vm_read8(param + 0) ? 1 : 0;
+    const u8 mode = vm_read8(param + 1);
+    a->outCh = (u8)(mode_ch[mode & 7] + (vm_read8(param + 2) ? 1 : 0));
+    if (a->outCh > ADEC_AC3_MAXCH) a->outCh = ADEC_AC3_MAXCH;
+    const float sc = vm_read_f32(param + 0x14);
+    a->scale = (sc > 0.0f && sc < 16.0f) ? sc : 1.0f;
+    for (u32 i = 0; i < ADEC_AC3_MAXCH; i++) {
+        const s32 cp = (s32)vm_read32(param + 0x18 + i * 4);
+        if (cp >= 0 && cp < (s32)ADEC_AC3_MAXCH) a->chmap[i] = (u8)cp;
+    }
+}
+
+static void adec_q_reset(AdecSlot* a)
+{
+    adec_lock();
+    a->qHead = a->qCount = 0;
+    adec_unlock();
+}
+
+/* Room for one more frame? Caller holds the lock. */
+static AdecFrame* adec_q_tail(AdecSlot* a)
+{
+    if (a->qCount >= ADEC_PCMQ) return NULL;
+    AdecFrame* f = &a->q[(a->qHead + a->qCount) % ADEC_PCMQ];
+    if (!f->pcm) f->pcm = (u8*)malloc(ADEC_AC3_PCM_MAX);
+    return f->pcm ? f : NULL;
+}
+
+#ifdef PS3RECOMP_HAVE_FFMPEG
+static inline void adec_put_sample(u8* p, u8 word, float s)
+{
+    if (word) {                                  /* big-endian float */
+        u32 b; memcpy(&b, &s, 4);
+        p[0] = (u8)(b >> 24); p[1] = (u8)(b >> 16); p[2] = (u8)(b >> 8); p[3] = (u8)b;
+    } else {                                     /* big-endian s16 */
+        float c = s * 32768.0f;
+        c = c > 32767.0f ? 32767.0f : c < -32768.0f ? -32768.0f : c;
+        const s16 v = (s16)c;
+        p[0] = (u8)((u16)v >> 8); p[1] = (u8)v;
+    }
+}
+
+static void adec_av_close(AdecSlot* a)
+{
+    av_frame_free(&a->frm);
+    av_packet_free(&a->pkt);
+    avcodec_free_context(&a->av);
+}
+
+/* (Re)open the AC3 decoder for the StartSeq parameters. A stereo or mono
+ * request has libavcodec's AC3 decoder downmix (its "downmix" option). */
+static void adec_av_open(AdecSlot* a)
+{
+    adec_av_close(a);
+    const AVCodec* codec = avcodec_find_decoder(AV_CODEC_ID_AC3);
+    if (!codec) { printf("[cellAdec] libavcodec has no AC3 decoder; silence\n"); return; }
+    a->av = avcodec_alloc_context3(codec);
+    if (!a->av) return;
+    AVDictionary* opts = NULL;
+    if (a->outCh <= 2) av_dict_set(&opts, "downmix", a->outCh == 1 ? "mono" : "stereo", 0);
+    if (avcodec_open2(a->av, codec, &opts) < 0) {
+        avcodec_free_context(&a->av);
+        av_dict_free(&opts);
+        return;
+    }
+    av_dict_free(&opts);
+    a->pkt = av_packet_alloc();
+    a->frm = av_frame_alloc();
+}
+
+/* Index in the decoded frame of AC3 input channel k (L C R l r LFE), or -1. */
+static int adec_src_index(const AVFrame* f, int k)
+{
+    static const enum AVChannel want[6][3] = {
+        { AV_CHAN_FRONT_LEFT,  AV_CHAN_FRONT_CENTER, AV_CHAN_NONE },
+        { AV_CHAN_FRONT_CENTER, AV_CHAN_NONE, AV_CHAN_NONE },
+        { AV_CHAN_FRONT_RIGHT, AV_CHAN_FRONT_CENTER, AV_CHAN_NONE },
+        { AV_CHAN_SIDE_LEFT,  AV_CHAN_BACK_LEFT,  AV_CHAN_BACK_CENTER },
+        { AV_CHAN_SIDE_RIGHT, AV_CHAN_BACK_RIGHT, AV_CHAN_BACK_CENTER },
+        { AV_CHAN_LOW_FREQUENCY, AV_CHAN_NONE, AV_CHAN_NONE },
+    };
+    for (int i = 0; i < 3 && want[k][i] != AV_CHAN_NONE; i++) {
+        const int idx = av_channel_layout_index_from_channel(&f->ch_layout, want[k][i]);
+        if (idx >= 0) return idx;
+    }
+    return -1;
+}
+
+/* One decoded AVFrame -> guest-format PCM in `out`. */
+static void adec_convert(const AdecSlot* a, const AVFrame* f, AdecFrame* out)
+{
+    const u32 n  = (u32)f->nb_samples > ADEC_AC3_SAMPLES * 2u ? ADEC_AC3_SAMPLES * 2u : (u32)f->nb_samples;
+    const u32 bw = a->wordSize ? 4u : 2u;
+    int src[ADEC_AC3_MAXCH];
+    for (u32 c = 0; c < a->outCh; c++) src[c] = adec_src_index(f, a->chmap[c]);
+    const int nch = f->ch_layout.nb_channels;
+    u32 o = 0;
+    for (u32 i = 0; i < n && o + a->outCh * bw <= ADEC_AC3_PCM_MAX; i++) {
+        for (u32 c = 0; c < a->outCh; c++, o += bw) {
+            float s = 0.0f;
+            if (src[c] >= 0) {
+                switch (f->format) {
+                case AV_SAMPLE_FMT_FLTP: s = ((const float*)f->extended_data[src[c]])[i]; break;
+                case AV_SAMPLE_FMT_FLT:  s = ((const float*)f->extended_data[0])[i * nch + src[c]]; break;
+                case AV_SAMPLE_FMT_S16P: s = ((const s16*)f->extended_data[src[c]])[i] / 32768.0f; break;
+                case AV_SAMPLE_FMT_S16:  s = ((const s16*)f->extended_data[0])[i * nch + src[c]] / 32768.0f; break;
+                default: break;
+                }
+            }
+            adec_put_sample(out->pcm + o, a->wordSize, s * a->scale);
+        }
+    }
+    out->size = o;
+}
+#endif
+
+/* An AC3 AU: decode it into the frame queue. Returns the number of frames
+ * queued (at least one: an AU that decodes to nothing becomes a frame of
+ * silence, so a title pacing on PCMOUT stays in step), or -1 if the queue
+ * is full. */
+static int adec_ac3_decode(AdecSlot* a, u32 au_ea)
+{
+    const u32 start = vm_read32(au_ea + 0x00), size = vm_read32(au_ea + 0x04);
+    adec_lock();
+    const int full = a->qCount >= ADEC_PCMQ;
+    adec_unlock();
+    if (full) return -1;
+
+    AdecFrame meta = {
+        .auStart = start, .auSize = size,
+        .ptsHi = vm_read32(au_ea + 0x08), .ptsLo = vm_read32(au_ea + 0x0C),
+        .udHi = vm_read32(au_ea + 0x10),  .udLo = vm_read32(au_ea + 0x14),
+    };
+    int queued = 0;
+#ifdef PS3RECOMP_HAVE_FFMPEG
+    if (a->av && start && size) {
+        const u32 need = size + AV_INPUT_BUFFER_PADDING_SIZE;
+        if (need > a->aubufCap) {
+            free(a->aubuf);
+            a->aubuf = (u8*)malloc(need);
+            a->aubufCap = a->aubuf ? need : 0;
+        }
+        if (a->aubuf) {
+            vm_memcpy_from(a->aubuf, start, size);
+            memset(a->aubuf + size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+            a->pkt->data = a->aubuf;
+            a->pkt->size = (int)size;
+            /* An AU with several AC3 frames gives several frames here. */
+            if (avcodec_send_packet(a->av, a->pkt) == 0) {
+                while (avcodec_receive_frame(a->av, a->frm) == 0) {
+                    adec_lock();
+                    AdecFrame* f = adec_q_tail(a);
+                    adec_unlock();
+                    if (f) {
+                        u8* pcm = f->pcm;
+                        *f = meta; f->pcm = pcm;
+                        adec_convert(a, a->frm, f);
+                        adec_lock(); a->qCount++; adec_unlock();
+                        queued++;
+                    }
+                    av_frame_unref(a->frm);
+                }
+            }
+        }
+    }
+#endif
+    if (!queued) {
+        adec_lock();
+        AdecFrame* f = adec_q_tail(a);
+        adec_unlock();
+        if (f) {
+            u8* pcm = f->pcm;
+            *f = meta; f->pcm = pcm;
+            f->size = ADEC_AC3_SAMPLES * a->outCh * (a->wordSize ? 4u : 2u);
+            memset(f->pcm, 0, f->size);          /* 0.0f and 0 are both zero bytes */
+            adec_lock(); a->qCount++; adec_unlock();
+            queued = 1;
+        }
+    }
+    return queued;
+}
+
+/* CellAdecBsiAc3 (guest): +0x14 pcmSize, +0x21 validity, +0x22 channelValue,
+ * +0x23 fsIndex (0 48 kHz), +0x24 outputQuantization, +0x25 outputChannel,
+ * +0x32 acmod, +0x33 lfeOn. Only these are filled. */
+static void adec_ac3_write_item(CellAdecHandle handle, const AdecSlot* a, const AdecFrame* f)
+{
+    const u32 it = a->itemEa, pcm = ADEC_AC3_PCM_EA(handle), bsi = ADEC_BSI_EA(handle);
+    vm_memcpy_to(pcm, f->pcm, f->size);
+    for (u32 o = 0; o < ADEC_BSI_BYTES; o += 4) vm_write32(bsi + o, 0);
+    vm_write32(bsi + 0x14, f->size);
+    vm_write8 (bsi + 0x21, 1);
+    vm_write8 (bsi + 0x22, a->outCh);
+    vm_write8 (bsi + 0x24, a->wordSize);
+    vm_write8 (bsi + 0x25, a->outCh);
+    vm_write8 (bsi + 0x32, a->outCh >= 5 ? 7 : a->outCh == 1 ? 1 : 2);
+    vm_write8 (bsi + 0x33, a->outCh == 6);   /* 3/2 + LFE */
+    vm_write32(it + PCMITEM_PCM_HANDLE, (u32)handle);
+    vm_write32(it + PCMITEM_STATUS,     0);
+    vm_write32(it + PCMITEM_START_ADDR, pcm);
+    vm_write32(it + PCMITEM_SIZE,       f->size);
+    vm_write32(it + PCMITEM_BSI_INFO,   bsi);
+    vm_write32(it + PCMITEM_AU_START,   f->auStart);
+    vm_write32(it + PCMITEM_AU_SIZE,    f->auSize);
+    vm_write32(it + PCMITEM_AU_PTS_HI,  f->ptsHi);
+    vm_write32(it + PCMITEM_AU_PTS_LO,  f->ptsLo);
+    vm_write32(it + PCMITEM_AU_USERDATA,     f->udHi);
+    vm_write32(it + PCMITEM_AU_USERDATA + 4, f->udLo);
+}
