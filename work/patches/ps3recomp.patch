+/*
+ * ps3recomp - the draw engine's backend calls, recorded on a thread of their own
+ *
+ * PS3RECOMP_BE_THREAD=1. The engine decides what each draw needs on the RSX
+ * thread as before; the calls it makes into the backend go into a queue that
+ * a second thread drains into the real backend. In inFAMOUS 2's heavy views
+ * (~9,000 draws a frame) the backend and its driver were a third of the RSX
+ * thread, which was the frame's limit.
+ *
+ * Every call keeps its place in the stream, so the backend sees exactly the
+ * sequence it saw before, on one thread at a time:
+ *
+ * - Calls that return nothing (binds, state, draws, clears, uploads,
+ *   releases, the present) are copied into the queue -- whatever they borrow
+ *   from the engine with them -- and return at once.
+ * - Calls that return something either answer from what the producer already
+ *   knows, or wait for the queue to empty and call the backend directly:
+ *   - surface_view: a view is the same object for the same (surface, remap,
+ *     format) until one of them is released, so the first answer is kept.
+ *   - The snapshots: a backend that refills one texture per target
+ *     (stable_snapshots) returns the same handle each time, so after the
+ *     first one the refill is queued and the known handle returned. The
+ *     worker checks the handle it gets; a different one is reported and
+ *     the caches are dropped.
+ *   - geo_put, for a backend that allows it from any thread
+ *     (geo_put_any_thread), is called directly.
+ *   - Everything else (creates, readbacks, the native passes, submit_and_wait)
+ *     waits for the worker.
+ * - A call from a thread other than the engine's goes straight to the
+ *   backend under the lock the worker holds while it works.
+ * - A deferred readback's completion, which the backend delivers from the
+ *   worker, is copied and handed to the engine on its own thread at its next
+ *   call: the engine's callback touches the engine's state.
+ *
+ * Linux only; elsewhere, and with the variable unset, the engine talks to
+ * the backend itself.
+ */
+#include "rsx_be_thread.h"
+#include "rsx_hitch.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if defined(__linux__)
+#include <linux/futex.h>
+#include <pthread.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+#if defined(__x86_64__) || defined(__i386__)
+#include <immintrin.h>
+#define BQ_PAUSE() _mm_pause()
+#else
+#define BQ_PAUSE() ((void)0)
+#endif
+
+#define BQ_CAP        (128u << 20)            /* the queue, bytes */
+#define BQ_MAX_INLINE (BQ_CAP / 8u)           /* a larger payload goes direct */
+#define BQ_HDR        16u
+#define BQ_PULL_SEGS  64u                     /* segments of a queued pulled draw */
+
+enum {
+    OP_WRAP = 1,
+    OP_BIND_TARGETS, OP_BIND_PIPELINE, OP_VSC, OP_VSC_RANGE, OP_VSC_DELTA, OP_PSC,
+    OP_TEX, OP_VTEX, OP_VIEWPORT, OP_SCISSOR, OP_STENCIL_REF, OP_DEPTH_BIAS,
+    OP_DEPTH_BOUNDS, OP_ZPASS_COUNT, OP_ZPASS_CLEAR, OP_ZPASS_REPORT,
+    OP_DRAW, OP_DRAW_GEO, OP_CLEAR_COLOR, OP_CLEAR_DS, OP_PRESENT,
+    OP_TEX_UPLOAD, OP_TEX_RELEASE, OP_COLOR_RELEASE, OP_DEPTH_RELEASE,
+    OP_PIPE_RELEASE, OP_GEO_DROP, OP_SNAP_COLOR, OP_SNAP_DEPTH, OP_SNAP_RGBA8, OP_SNAP_RECT,
+    OP_DRAW_PULLED, OP_NATIVE_LATCH, OP_TEX_CREATE, OP_TEX_INIT,
+    OP_NATIVE_LIGHTING, OP_NATIVE_SSAO, OP_SURFACE_BLIT, OP_CLEAR_COLOR_RECT, OP_CLEAR_DS_RECT,
+};
+
+typedef struct { u32 op, size, pad[2]; } bq_hdr;
+
+/* A (surface, remap, format) -> view, and (target[, w, h]) -> snapshot. */
+#define BQ_VC_SLOTS 4096u
+typedef struct { u32 surface, remap, fmt, view; } bq_view;
+typedef struct { u32 kind, target, w, h, snap; } bq_snap;
+
+static struct {
+    const rsx_draw_backend* be;     /* the real one */
+    rsx_draw_backend api;           /* the one the engine calls */
+    int on;                         /* the worker runs */
+    u8* buf;
+    /* The cursors live on three cache lines: the producer's own, the one it
+     * publishes on, and the worker's. Sharing one, every reserve (a dozen a
+     * draw) took the line from the worker spinning on `pub`, and every
+     * consume took it back: bq_reserve and bq_publish were 8% of the RSX
+     * thread. */
+    _Alignas(64) u64 w;             /* producer: written, not yet published */
+    u64 w_pub;                      /* producer: what it last published */
+    u64 rfree_seen;                 /* producer: Q.rfree as last read */
+    _Alignas(64) u64 pub;           /* published (worker reads) */
+    u32 wseq;                       /* futex word: bumped on publish */
+    u32 worker_sleeps;
+    _Alignas(64) u64 r;             /* executed (worker writes) */
+    u64 rfree;                      /* reusable: r, held back while the backend
+                                     * still points into a record (OP_VSC_RANGE) */
+    u32 rseq;                       /* futex word: bumped on consume */
+    u32 producer_sleeps;
+    _Alignas(64) int stop;
+    pthread_t th;
+    pthread_mutex_t lock;           /* the backend, while someone runs it */
+    pthread_t producer;
+    int have_producer;
+    bq_view views[BQ_VC_SLOTS];
+    bq_snap snaps[BQ_VC_SLOTS];
+    u32 snap_bad;                   /* worker: a queued snapshot came back different */
+    pthread_mutex_t done_lock;      /* deferred readback completions for the engine */
+    struct bq_done* done_head;
+    u32 n_done;
+    u64 n_sync, n_async;            /* PS3RECOMP_BE_THREAD_STATS */
+    u64 presents_sent;              /* producer: OP_PRESENT queued */
+    int latch_failed;               /* worker: a queued native_latch failed */
+    int lt_failed;                  /* worker: a queued native_lighting failed or moved its images */
+    u32 lt_out[2], lt_w, lt_h;      /* producer: the last direct native_lighting's images and size */
+    int ao_failed;                  /* worker: a queued native_ssao failed or moved its images */
+    u32 ao_out[3], ao_in[2];        /* producer: the last direct native_ssao's images and inputs */
+    int blit_failed;                /* worker: a queued surface_blit failed */
+    u64 presents_done;              /* worker: OP_PRESENT executed */
+    u32 seen_gen;                   /* the backend's free_gen when the caches were last right */
+    u64 n_forget_all, n_forget_some;  /* bq_gen_check: caches dropped whole / by handle */
+} Q;
+/* bind_vs_constants_delta's copy of the 512 VS constant rows, the worker's (OP_VSC_DELTA). */
+static u8 s_vsc_mirror[512][16] __attribute__((aligned(16)));
+
+/* What the backend's state setters were last given, as the queue will leave
+ * them once it has run. They only store their arguments (the draw reads
+ * them), so a call with the same arguments as the last one changes nothing
+ * and is not queued: most draws repeat the targets, the pipeline, the
+ * textures, the fragment constants and the fixed state of the one before.
+ * Producer-only. Forgotten on every direct call (whatever it did, it ran
+ * the backend), on a pipeline release (the backend unbinds a released
+ * pipeline) and at init and shutdown. PS3RECOMP_BQ_ELIDE=0 queues them all. */
+#define BQ_PSC_MEMO 4096u
+static struct {
+    int on;                          /* -1 unknown, 0 off, 1 on */
+    u32 have;                        /* BQ_S_* known */
+    u32 nrt, depth, rt[RSX_BE_MAX_COLOR_TARGETS];
+    u32 pipeline;
+    u32 tex_mask, tex_samp, tex[RSX_BE_MAX_TEXTURES];
+    rsx_be_sampler_desc samp[RSX_BE_MAX_TEXTURES];
+    u32 vtex_mask, vtex_samp, vtex[RSX_BE_MAX_VERTEX_TEXTURES];
+    rsx_be_sampler_desc vsamp[RSX_BE_MAX_VERTEX_TEXTURES];
+    u32 vp[4], sc[4], stencil, bias[2], bounds[2];
+    int zpass;
+    u32 psc_bytes;
+    u8 psc[BQ_PSC_MEMO];
+} S = { .on = -1 };
+enum { BQ_S_TARGETS = 1, BQ_S_PIPE = 2, BQ_S_TEX = 4, BQ_S_VTEX = 8, BQ_S_VP = 16, BQ_S_SC = 32,
+       BQ_S_STENCIL = 64, BQ_S_BIAS = 128, BQ_S_BOUNDS = 256, BQ_S_ZPASS = 512, BQ_S_PSC = 1024 };
+static void bq_s_forget(void) { S.have = 0; }
+static int bq_s_on(void)
+{
+    if (S.on < 0) { const char* e = getenv("PS3RECOMP_BQ_ELIDE"); S.on = !e ? 1 : e[0] == '2' ? 2 : e[0] != '0'; }
+    return S.on;
+}
+/* A repeat: dropped, or with PS3RECOMP_BQ_ELIDE=2 queued anyway and marked,
+ * for the worker to check that it changed nothing (state_digest). */
+#define BQ_OP_SAME 0x80000000u
+static u32 s_mark_next;
+static int bq_elide(void)
+{
+    if (S.on != 2) return 1;
+    s_mark_next = BQ_OP_SAME;
+    return 0;
+}
+
+static void bq_run_done(void);
+
+static long bq_futex(u32* addr, int op, u32 val)
+{
+    return syscall(SYS_futex, addr, op, val, NULL, NULL, 0);
+}
+
+/* ---- the worker ----------------------------------------------------------- */
+
+static const u8* bq_at(u64 pos) { return Q.buf + (size_t)(pos % BQ_CAP); }
+
+static void bq_exec_op(const bq_hdr* h, u32 op);
+/* PS3RECOMP_BQ_OPPROF=1: the worker's time by record type, per presented
+ * frame, every 5 s -- what the recording thread spends its frame on. */
+static const char* const s_op_names[] = { "?", "wrap", "bind_targets", "bind_pipeline", "vsc", "vsc_range",
+    "vsc_delta", "psc", "tex", "vtex", "viewport", "scissor", "stencil_ref", "depth_bias", "depth_bounds",
+    "zpass_count", "zpass_clear", "zpass_report", "draw", "draw_geo", "clear_color", "clear_ds", "present",
+    "tex_upload", "tex_release", "color_release", "depth_release", "pipe_release", "geo_drop", "snap_color",
+    "snap_depth", "snap_rgba8", "snap_rect", "draw_pulled", "native_latch", "tex_create", "tex_init",
+    "native_lighting", "native_ssao", "surface_blit", "clear_color_rect", "clear_ds_rect" };
+static void bq_opprof(u32 op, u64 ns)
+{
+    static int on = -1; static u64 tot[64], cnt[64], frames, t0, idle0;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_BQ_OPPROF"); on = e && e[0] == '1'; }
+    if (!on) return;
+    op &= 63u; tot[op] += ns; cnt[op]++;
+    if (op == OP_PRESENT) frames++;
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    const u64 now = (u64)ts.tv_sec * 1000000000ull + (u64)ts.tv_nsec;
+    if (!t0) t0 = now;
+    if (now - t0 < 5000000000ull || !frames) return;
+    u64 all = 0; for (int k = 0; k < 64; k++) all += tot[k];
+    char line[1600]; int o = snprintf(line, sizeof line, "[bq-prof] %.2f ms/frame busy of %.2f:",
+        all / 1e6 / frames, (now - t0) / 1e6 / frames);
+    for (int pass = 0; pass < 12; pass++) {           /* the 12 biggest */
+        int best = -1;
+        for (int k = 0; k < 64; k++) if (cnt[k] && (best < 0 || tot[k] > tot[best])) best = k;
+        if (best < 0) break;
+        o += snprintf(line + o, sizeof line - (size_t)o, " %s %.2f ms/%.0f (%.0f ns)",
+                      best < (int)(sizeof s_op_names / sizeof s_op_names[0]) ? s_op_names[best] : "op",
+                      tot[best] / 1e6 / frames, (double)cnt[best] / frames, (double)tot[best] / cnt[best]);
+        cnt[best] = 0;
+    }
+    fprintf(stderr, "%s\n", line);
+    memset(tot, 0, sizeof tot); memset(cnt, 0, sizeof cnt); frames = 0; t0 = now; (void)idle0;
+}
+static void bq_exec(const bq_hdr* h)
+{
+    { static int on = -1; if (on < 0) { const char* e = getenv("PS3RECOMP_BQ_OPPROF"); on = e && e[0] == '1'; }
+      if (on) {
+          struct timespec a, b; clock_gettime(CLOCK_MONOTONIC, &a);
+          if (!(h->op & BQ_OP_SAME)) bq_exec_op(h, h->op); else bq_exec_op(h, h->op & ~BQ_OP_SAME);
+          clock_gettime(CLOCK_MONOTONIC, &b);
+          bq_opprof(h->op & ~BQ_OP_SAME, (u64)(b.tv_sec - a.tv_sec) * 1000000000ull + (u64)(b.tv_nsec - a.tv_nsec));
+          return;
+      } }
+    if (!(h->op & BQ_OP_SAME)) { bq_exec_op(h, h->op); return; }
+    const unsigned long long d0 = Q.be->state_digest ? Q.be->state_digest(Q.be->user) : 0;
+    bq_exec_op(h, h->op & ~BQ_OP_SAME);
+    const unsigned long long d1 = Q.be->state_digest ? Q.be->state_digest(Q.be->user) : 0;
+    static u64 n, bad;
+    n++;
+    if (d0 != d1 && bad++ < 16)
+        fprintf(stderr, "[be-thread] ELIDE CHECK: record %u changed the backend state (%llu of %llu)\n",
+                h->op & ~BQ_OP_SAME, (unsigned long long)bad, (unsigned long long)n);
+    if (!(n & ((1u << 20) - 1u)))
+        fprintf(stderr, "[be-thread] elide check: %llu repeats, %llu changed the state\n",
+                (unsigned long long)n, (unsigned long long)bad);
+}
+
+static void bq_exec_op(const bq_hdr* h, u32 op)
+{
+    const rsx_draw_backend* be = Q.be;
+    void* u = be->user;
+    const u8* p = (const u8*)h + BQ_HDR;
+    switch (op) {
+    case OP_BIND_TARGETS: {
+        const u32* a = (const u32*)p;            /* count, depth, surfaces[] */
+        be->bind_targets(u, a + 2, a[0], a[1]);
+        break; }
+    case OP_BIND_PIPELINE: be->bind_pipeline(u, *(const u32*)p); break;
+    case OP_VSC: be->bind_vs_constants(u, p + 16, *(const u32*)p); break;
+    case OP_VSC_RANGE: {
+        const u32* a = (const u32*)p;            /* first, count, tail_bytes, total */
+        const u8* rows = p + 16;
+        const u8* tail = rows + (size_t)a[1] * 16u;
+        /* The backend reads rows [first, first + count) of the block it is
+         * handed: point it that many rows before the copy. */
+        be->bind_vs_constants_range(u, (const void*)((uintptr_t)rows - (uintptr_t)a[0] * 16u),
+                                    a[0], a[1], tail, a[2], a[3]);
+        break; }
+    case OP_VSC_DELTA: {
+        const u32* a = (const u32*)p;            /* first, count, tail_bytes, total, ndirty */
+        const u32 nd = a[4];
+        const u16* idx = (const u16*)(p + 32);
+        const u8* rows = p + 32 + (((size_t)nd * 2u + 15u) & ~(size_t)15u);
+        for (u32 k = 0; k < nd; k++) memcpy(s_vsc_mirror[idx[k]], rows + (size_t)k * 16u, 16);
+        be->bind_vs_constants_range(u, s_vsc_mirror, a[0], a[1], rows + (size_t)nd * 16u, a[2], a[3]);
+        break; }
+    case OP_PSC: be->bind_ps_constants(u, p + 16, *(const u32*)p); break;
+    case OP_TEX: case OP_VTEX: {
+        const u32* a = (const u32*)p;            /* mask, has_samplers, n */
+        const u32 n = a[2];
+        const u32* tex = a + 4;
+        const rsx_be_sampler_desc* s = a[1] ? (const rsx_be_sampler_desc*)(p + 16 + (size_t)n * 4u) : NULL;
+        if (op == OP_TEX) be->bind_textures(u, tex, s, a[0]);
+        else                 be->bind_vertex_textures(u, tex, s, a[0]);
+        break; }
+    case OP_VIEWPORT: { const float* f = (const float*)p; be->set_viewport(u, f[0], f[1], f[2], f[3]); break; }
+    case OP_SCISSOR: { const u32* a = (const u32*)p; be->set_scissor(u, a[0], a[1], a[2], a[3]); break; }
+    case OP_STENCIL_REF: be->set_stencil_ref(u, *(const u32*)p); break;
+    case OP_DEPTH_BIAS: { const float* f = (const float*)p; be->set_depth_bias(u, f[0], f[1]); break; }
+    case OP_DEPTH_BOUNDS: { const float* f = (const float*)p; be->set_depth_bounds(u, f[0], f[1]); break; }
+    case OP_ZPASS_COUNT: be->zpass_count(u, *(const int*)p); break;
+    case OP_ZPASS_CLEAR: be->zpass_clear(u); break;
+    case OP_ZPASS_REPORT: { void* dst; memcpy(&dst, p, sizeof dst); be->zpass_report(u, dst); break; }
+    case OP_DRAW: {
+        const u32* a = (const u32*)p;            /* topology, vertex_count, stride, index_count, has_indices */
+        const u8* v = p + 32;
+        const u8* i = v + (((size_t)a[1] * a[2] + 15u) & ~(size_t)15u);
+        be->draw(u, (rsx_topology)a[0], v, a[1], a[2], a[4] ? (const u32*)i : NULL, a[3]);
+        break; }
+    case OP_DRAW_PULLED: {
+        /* topology, nsegs, index_count, has_indices; nsegs sizes; the
+         * indices; the segments, each at a 16-byte boundary. */
+        const u32* a = (const u32*)p;
+        const u32 ns = a[1];
+        rsx_be_pull_seg segs[BQ_PULL_SEGS];
+        const u8* q = p + ((16u + ns * 4u + 15u) & ~15u);
+        const u32* idx = a[3] ? (const u32*)q : NULL;
+        if (a[3]) q += ((size_t)a[2] * 4u + 15u) & ~(size_t)15u;
+        for (u32 k = 0; k < ns; k++) {
+            segs[k].p = q; segs[k].bytes = a[4 + k];
+            q += ((size_t)a[4 + k] + 15u) & ~(size_t)15u;
+        }
+        be->draw_pulled(u, (rsx_topology)a[0], segs, ns, idx, a[2]);
+        break; }
+    case OP_DRAW_GEO: {
+        const u32* a = (const u32*)p;
+        be->draw_geo(u, (rsx_topology)a[0], a[1], a[2], a[3], a[4]);
+        break; }
+    case OP_CLEAR_COLOR: { const u32* a = (const u32*)p; be->clear_color(u, a[0], (const float*)(p + 16)); break; }
+    case OP_CLEAR_DS: {
+        const u32* a = (const u32*)p; float dv; memcpy(&dv, a + 2, 4);
+        be->clear_depth_stencil(u, a[0], a[1], dv, (u8)a[3]);
+        break; }
+    case OP_PRESENT:
+        be->present(u, *(const u32*)p);
+        __atomic_add_fetch(&Q.presents_done, 1, __ATOMIC_RELEASE);
+        break;
+    case OP_TEX_UPLOAD: {
+        const u32* a = (const u32*)p;            /* tex, face, mip, w, h, row_bytes, rows */
+        be->texture_upload(u, a[0], a[1], a[2], a[3], a[4], p + 32, a[5], a[6]);
+        break; }
+    case OP_TEX_RELEASE:   be->texture_release(u, *(const u32*)p); break;
+    case OP_COLOR_RELEASE: be->color_target_release(u, *(const u32*)p); break;
+    case OP_DEPTH_RELEASE: be->depth_target_release(u, *(const u32*)p); break;
+    case OP_PIPE_RELEASE:  be->pipeline_release(u, *(const u32*)p); break;
+    case OP_GEO_DROP:      be->geo_drop(u, *(const u32*)p); break;
+    case OP_TEX_CREATE: {
+        const u32* a = (const u32*)p;    /* handle, fmt, w, h, mips, faces, remap, rsx_fmt */
+        be->texture_create_at(u, a[0], (rsx_be_format)a[1], a[2], a[3], a[4], a[5], a[6], a[7]);
+        break; }
+    case OP_TEX_INIT: be->texture_init(u, *(const u32*)p); break;
+    case OP_NATIVE_LATCH: {
+        const u32* a = (const u32*)p;
+        if (be->native_latch(u, a[0], a[1])) __atomic_store_n(&Q.latch_failed, 1, __ATOMIC_RELEASE);
+        break; }
+    case OP_NATIVE_LIGHTING: {
+        const u32* a = (const u32*)p;    /* count, the two images expected, words */
+        u32 out[2] = { 0, 0 };
+        if (be->native_lighting(u, a + 3, a[0], out) || out[0] != a[1] || out[1] != a[2])
+            __atomic_store_n(&Q.lt_failed, 1, __ATOMIC_RELEASE);
+        break; }
+    case OP_NATIVE_SSAO: {
+        const u32* a = (const u32*)p;    /* normals, depth, the three images expected, params */
+        u32 out[3] = { 0, 0, 0 };
+        if (be->native_ssao(u, a[0], a[1], (const float*)(a + 5), out) ||
+            out[0] != a[2] || out[1] != a[3] || out[2] != a[4])
+            __atomic_store_n(&Q.ao_failed, 1, __ATOMIC_RELEASE);
+        break; }
+    case OP_CLEAR_COLOR_RECT: {
+        const u32* a = (const u32*)p;    /* surface, x, y, w, h, pad[3], rgba */
+        be->clear_color_rect(u, a[0], a[1], a[2], a[3], a[4], (const float*)(p + 32));
+        break; }
+    case OP_CLEAR_DS_RECT: {
+        const u32* a = (const u32*)p;    /* depth, flags, x, y, w, h, value, stencil */
+        float dv; memcpy(&dv, a + 6, 4);
+        be->clear_depth_stencil_rect(u, a[0], a[1], a[2], a[3], a[4], a[5], dv, (u8)a[7]);
+        break; }
+    case OP_SURFACE_BLIT: {
+        const u32* a = (const u32*)p;    /* src, sx, sy, sw, sh, dst, dx, dy, dw, dh, flags */
+        if (be->surface_blit(u, a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10]))
+            __atomic_store_n(&Q.blit_failed, 1, __ATOMIC_RELEASE);
+        break; }
+    case OP_SNAP_COLOR: case OP_SNAP_DEPTH: case OP_SNAP_RGBA8: case OP_SNAP_RECT: {
+        const u32* a = (const u32*)p;            /* target, w, h, expected */
+        const u32 got = h->op == OP_SNAP_COLOR ? be->color_snapshot(u, a[0])
+                      : h->op == OP_SNAP_DEPTH ? be->depth_snapshot(u, a[0], a[1], a[2])
+                      : h->op == OP_SNAP_RECT ? be->color_snapshot_rect(u, a[0], a[1], a[2])
+                      : be->depth_snapshot_rgba8(u, a[0], a[1], a[2]);
+        if (got != a[3]) {
+            static int n;
+            if (n++ < 8)
+                fprintf(stderr, "[be-thread] snapshot of %u came back as %u, not %u: dropping the caches\n",
+                        a[0], got, a[3]);
+            __atomic_store_n(&Q.snap_bad, 1u, __ATOMIC_RELEASE);
+        }
+        break; }
+    default:
+        fprintf(stderr, "[be-thread] unknown record %u\n", h->op);
+        break;
+    }
+}
+
+/* Worker: executed up to r, reusable up to safe; wake a producer waiting. */
+static void bq_consumed(u64 r, u64 safe)
+{
+    __atomic_store_n(&Q.rfree, safe, __ATOMIC_SEQ_CST);
+    __atomic_store_n(&Q.r, r, __ATOMIC_SEQ_CST);
+    __atomic_add_fetch(&Q.rseq, 1u, __ATOMIC_SEQ_CST);
+    if (__atomic_load_n(&Q.producer_sleeps, __ATOMIC_SEQ_CST))
+        bq_futex(&Q.rseq, FUTEX_WAKE_PRIVATE, 1);
+}
+
+static void* bq_worker(void* arg)
+{
+    (void)arg;
+    rsx_hs_thread("rec");
+    u64 r = Q.r, safe = Q.rfree;
+    int hold = 0;
+    for (;;) {
+        u64 pub = __atomic_load_n(&Q.pub, __ATOMIC_ACQUIRE);
+        if (r == pub) {
+            /* Idle: spin a little (the next draw is usually microseconds
+             * away), then sleep until a publish. */
+            for (int i = 0; i < 4000 && r == pub; i++) {
+                BQ_PAUSE();
+                pub = __atomic_load_n(&Q.pub, __ATOMIC_ACQUIRE);
+            }
+            if (r == pub) {
+                if (__atomic_load_n(&Q.stop, __ATOMIC_ACQUIRE)) break;
+                const u32 seq = __atomic_load_n(&Q.wseq, __ATOMIC_ACQUIRE);
+                __atomic_store_n(&Q.worker_sleeps, 1u, __ATOMIC_SEQ_CST);
+                pub = __atomic_load_n(&Q.pub, __ATOMIC_SEQ_CST);
+                if (r == pub && !__atomic_load_n(&Q.stop, __ATOMIC_ACQUIRE))
+                    bq_futex(&Q.wseq, FUTEX_WAIT_PRIVATE, seq);
+                __atomic_store_n(&Q.worker_sleeps, 0u, __ATOMIC_RELAXED);
+                continue;
+            }
+        }
+        pthread_mutex_lock(&Q.lock);
+        u32 since = 0;
+        while (r != pub) {
+            const bq_hdr* h = (const bq_hdr*)bq_at(r);
+            if (h->op != OP_WRAP) bq_exec(h);
+            r += h->size;
+            /* The backend keeps the VS rows of OP_VSC_RANGE by pointer until
+             * the next draw reads them: their record is not handed back
+             * before that draw has run. */
+            if (h->op == OP_VSC_RANGE) hold = 1;
+            else if (h->op == OP_DRAW || h->op == OP_DRAW_GEO || h->op == OP_DRAW_PULLED) hold = 0;
+            if (!hold) safe = r;
+            /* Hand room back to the producer now and then, not per record. */
+            if ((since += h->size) >= (4u << 20)) {
+                since = 0;
+                bq_consumed(r, safe);
+            }
+        }
+        pthread_mutex_unlock(&Q.lock);
+        bq_consumed(r, safe);
+    }
+    return NULL;
+}
+
+/* ---- the producer --------------------------------------------------------- */
+
+static void bq_publish(void)
+{
+    if (Q.w_pub == Q.w) return;
+    Q.w_pub = Q.w;
+    __atomic_store_n(&Q.pub, Q.w, __ATOMIC_SEQ_CST);
+    if (__atomic_load_n(&Q.worker_sleeps, __ATOMIC_SEQ_CST)) {
+        __atomic_add_fetch(&Q.wseq, 1u, __ATOMIC_SEQ_CST);
+        bq_futex(&Q.wseq, FUTEX_WAKE_PRIVATE, 1);
+    }
+}
+
+/* After a draw: PS3RECOMP_BQ_PUBLISH_BATCH=<n> publishes every n-th draw (or
+ * past 256 KB unpublished) instead of each one. With the worker keeping up
+ * it sleeps between draws, and every publish was a futex wake -- a syscall a
+ * draw, ~1 us of the RSX thread's ~2 us per queued draw. Anything that waits
+ * for the worker publishes first (bq_wait_for), and so does a present. */
+static void bq_publish_draw(void)
+{
+    static int batch = -1; static u32 pending;
+    if (batch < 0) { const char* e = getenv("PS3RECOMP_BQ_PUBLISH_BATCH"); batch = e ? atoi(e) : 0; if (batch < 0) batch = 0; }
+    if (batch > 1 && ++pending < (u32)batch && Q.w - Q.w_pub < (256u << 10)) return;
+    pending = 0;
+    bq_publish();
+}
+
+/* Until the worker's *at (Q.r: executed, Q.rfree: reusable) reaches `upto`. */
+static void bq_wait_for(const u64* at, u64 upto)
+{
+    bq_publish();
+    int spins = 0;
+    while (__atomic_load_n(at, __ATOMIC_ACQUIRE) < upto) {
+        if (spins < 20000) { spins++; BQ_PAUSE(); continue; }
+        const u32 seq = __atomic_load_n(&Q.rseq, __ATOMIC_ACQUIRE);
+        __atomic_store_n(&Q.producer_sleeps, 1u, __ATOMIC_SEQ_CST);
+        if (__atomic_load_n(at, __ATOMIC_SEQ_CST) < upto) {
+            /* Bounded: a missed wake costs a millisecond, not a hang. */
+            struct timespec ts = { 0, 1000000 };
+            syscall(SYS_futex, &Q.rseq, FUTEX_WAIT_PRIVATE, seq, &ts, NULL, 0);
+        }
+        __atomic_store_n(&Q.producer_sleeps, 0u, __ATOMIC_RELAXED);
+    }
+}
+
+/* Until there is room up to `end`: the worker's rfree only grows, so the
+ * last value read is good until the queue looks full by it. */
+static void bq_room(u64 end)
+{
+    if (end - Q.rfree_seen <= BQ_CAP) return;
+    Q.rfree_seen = __atomic_load_n(&Q.rfree, __ATOMIC_ACQUIRE);
+    if (end - Q.rfree_seen <= BQ_CAP) return;
+    const u64 t0 = RSX_HS_T0();
+    bq_wait_for(&Q.rfree, end - BQ_CAP);
+    RSX_HS_END(HS_BQ_ROOM, t0);
+    Q.rfree_seen = __atomic_load_n(&Q.rfree, __ATOMIC_ACQUIRE);
+}
+
+/* Room for `bytes` at the write position, wrapping first if the record would
+ * run past the end. Returns the record. */
+static bq_hdr* bq_reserve(u32 op, u32 payload)
+{
+    const u32 need = (BQ_HDR + payload + 15u) & ~15u;
+    u64 pos = Q.w % BQ_CAP;
+    if (pos + need > BQ_CAP) {
+        const u32 pad = (u32)(BQ_CAP - pos);
+        bq_room(Q.w + pad + need);
+        bq_hdr* wh = (bq_hdr*)(Q.buf + pos);
+        wh->op = OP_WRAP; wh->size = pad;
+        Q.w += pad;
+        pos = 0;
+    } else {
+        bq_room(Q.w + need);
+    }
+    bq_hdr* h = (bq_hdr*)(Q.buf + pos);
+    h->op = op | s_mark_next; h->size = need;
+    s_mark_next = 0;
+    Q.w += need;
+    Q.n_async++;
+    return h;
+}
+#define BQ_P(h) ((u8*)(h) + BQ_HDR)
+
+/* Is this the engine's thread? The first hot call names it. */
+/* Answered from a thread-local mark first: every queued call asks, and
+ * pthread_self plus the compare were 2% of the RSX thread. The mark names
+ * the init it was taken under, so a new init asks again. */
+static __thread u32 tl_mine_init;
+static u32 s_init_seq;                  /* bumped by every init; outlives the memset of Q */
+static int bq_mine(void)
+{
+    if (tl_mine_init == s_init_seq && Q.have_producer) return 1;
+    if (!Q.have_producer) {
+        Q.producer = pthread_self(); Q.have_producer = 1;
+        tl_mine_init = s_init_seq;
+        return 1;
+    }
+    if (pthread_equal(Q.producer, pthread_self())) { tl_mine_init = s_init_seq; return 1; }
+    /* Another thread runs the backend behind the producer's back: from now
+     * on nothing is elided. */
+    __atomic_store_n(&S.on, 0, __ATOMIC_RELAXED);
+    static int n;
+    if (n++ < 4) fprintf(stderr, "[be-thread] a backend call from another thread: run under the lock\n");
+    return 0;
+}
+
+/* A call that needs the backend now: on the engine's thread, after the
+ * queue; on any other, between two batches. Pair with bq_direct_end. */
+/* PS3RECOMP_BQ_STATS=1: every 10 s, which synchronous calls made the engine
+ * thread wait for the worker to drain the queue, how often and how long. A
+ * drain in the middle of a frame stops the two threads overlapping. */
+static void bq_sync_note(const char* who, unsigned long long ns)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("PS3RECOMP_BQ_STATS") ? 1 : 0;
+    if (!on) return;
+    enum { N = 32 };
+    static const char* name[N]; static unsigned long long tot[N], cnt[N], t0;
+    int i = 0;
+    while (i < N && name[i] && name[i] != who) i++;
+    if (i == N) return;
+    name[i] = who; tot[i] += ns; cnt[i]++;
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    const unsigned long long now = (unsigned long long)ts.tv_sec * 1000000000ull + (unsigned long long)ts.tv_nsec;
+    if (!t0) t0 = now;
+    if (now - t0 < 10000000000ull) return;
+    fprintf(stderr, "[bq-sync] last 10 s:");
+    for (int k = 0; k < N && name[k]; k++)
+        if (cnt[k]) fprintf(stderr, " %s %llux %.1f ms;", name[k], cnt[k], tot[k] / 1e6);
+    fprintf(stderr, " caches dropped whole %llu, by handle %llu", (unsigned long long)Q.n_forget_all,
+            (unsigned long long)Q.n_forget_some);
+    Q.n_forget_all = Q.n_forget_some = 0;
+    fputc('\n', stderr);
+    memset(tot, 0, sizeof tot); memset(cnt, 0, sizeof cnt); t0 = now;
+}
+
+static void bq_direct_begin_named(const char* who)
+{
+    if (Q.on && bq_mine()) {
+        bq_s_forget();
+        struct timespec a, b;
+        clock_gettime(CLOCK_MONOTONIC, &a);
+        bq_wait_for(&Q.r, Q.w); Q.n_sync++;
+        clock_gettime(CLOCK_MONOTONIC, &b);
+        const unsigned long long ns = (unsigned long long)(b.tv_sec - a.tv_sec) * 1000000000ull + (unsigned long long)b.tv_nsec - (unsigned long long)a.tv_nsec;
+        bq_sync_note(who, ns);
+        if (rsx_hs_on()) {
+            rsx_hs_add(HS_BQ_SYNC, ns);
+            if (ns > g_rsx_hs.sync_top_ns) { g_rsx_hs.sync_top_ns = ns; g_rsx_hs.sync_top = who; }
+        }
+    }
+    pthread_mutex_lock(&Q.lock);
+}
+#define bq_direct_begin() bq_direct_begin_named(__func__)
+static void bq_gen_check(void);
+static void bq_direct_end(void)
+{
+    /* The caches are the engine thread's; a foreign call leaves them be. */
+    if (!Q.on || (Q.have_producer && pthread_equal(Q.producer, pthread_self()))) bq_gen_check();
+    pthread_mutex_unlock(&Q.lock);
+    if (Q.on && Q.have_producer && pthread_equal(Q.producer, pthread_self())) bq_run_done();
+}
+
+/* Whether a call can be queued: the worker runs and this is the engine. */
+static int bq_async(void) { return Q.on && bq_mine(); }
+
+/* ---- caches --------------------------------------------------------------- */
+
+static u32 bq_hash(u32 a, u32 b, u32 c, u32 d)
+{
+    u32 h = a * 0x9E3779B1u ^ b * 0x85EBCA77u ^ c * 0xC2B2AE3Du ^ d * 0x27D4EB2Fu;
+    h ^= h >> 15;
+    return h & (BQ_VC_SLOTS - 1u);
+}
+
+/* A handle went away: every cached answer naming it with it. */
+static void bq_forget(u32 handle)
+{
+    if (!handle) return;
+    for (u32 i = 0; i < BQ_VC_SLOTS; i++) {
+        bq_view* v = &Q.views[i];
+        if (v->view && (v->surface == handle || v->view == handle)) memset(v, 0, sizeof *v);
+        bq_snap* s = &Q.snaps[i];
+        if (s->snap && (s->target == handle || s->snap == handle)) memset(s, 0, sizeof *s);
+    }
+}
+
+static int bq_u32_cmp(const void* a, const void* b)
+{
+    const u32 x = *(const u32*)a, y = *(const u32*)b;
+    return x < y ? -1 : x > y;
+}
+static int bq_in(const u32* sorted, u32 n, u32 v)
+{
+    u32 lo = 0, hi = n;
+    while (lo < hi) { const u32 mid = (lo + hi) / 2; if (sorted[mid] < v) lo = mid + 1; else hi = mid; }
+    return lo < n && sorted[lo] == v;
+}
+
+/* After a call that ran the backend directly: when it released anything by
+ * itself, no kept answer can be trusted. */
+static void bq_gen_check(void)
+{
+    if (!Q.be->free_gen) return;
+    const u32 g = Q.be->free_gen(Q.be->user);
+    if (g != Q.seen_gen) {
+        /* Only the answers naming a released handle, when the backend can say
+         * which (PS3RECOMP_BQ_FORGET_ALL=1: all of them, as before). */
+        static int all = -1;
+        if (all < 0) { const char* e = getenv("PS3RECOMP_BQ_FORGET_ALL"); all = e && e[0] == '1'; }
+        static u32 fr[1024];
+        const u32 n = (!all && Q.be->freed_since) ? Q.be->freed_since(Q.be->user, Q.seen_gen, fr, 1024u) : 2048u;
+        Q.seen_gen = g;
+        if (n > 1024u) {
+            memset(Q.views, 0, sizeof Q.views);
+            memset(Q.snaps, 0, sizeof Q.snaps);
+            Q.n_forget_all++;
+            return;
+        }
+        if (!n) return;
+        qsort(fr, n, sizeof fr[0], bq_u32_cmp);
+        for (u32 i = 0; i < BQ_VC_SLOTS; i++) {
+            bq_view* v = &Q.views[i];
+            if (v->view && (bq_in(fr, n, v->surface) || bq_in(fr, n, v->view))) memset(v, 0, sizeof *v);
+            bq_snap* sn = &Q.snaps[i];
+            if (sn->snap && (bq_in(fr, n, sn->target) || bq_in(fr, n, sn->snap))) memset(sn, 0, sizeof *sn);
+        }
+        Q.n_forget_some++;
+    }
+}
+
+static void bq_check_snaps(void)
+{
+    if (__atomic_load_n(&Q.snap_bad, __ATOMIC_ACQUIRE)) {
+        __atomic_store_n(&Q.snap_bad, 0u, __ATOMIC_RELAXED);
+        memset(Q.snaps, 0, sizeof Q.snaps);
+        memset(Q.views, 0, sizeof Q.views);
+    }
+}
+
+/* ---- deferred readbacks ---------------------------------------------------- */
+
+typedef struct { void (*done)(void*, const void*, u32); void* cookie; u32 h; } bq_rbctx;
+typedef struct bq_done {
+    struct bq_done* next;
+    void (*done)(void*, const void*, u32);
+    void* cookie;
+    u32 pitch;
+    u8 px[];
+} bq_done;
+
+/* What the backend calls when the copy has landed: the engine's callback now
+ * if this is the engine's thread, else a copy for it to collect. */
+static void bq_rb_tramp(void* cookie, const void* rgba, u32 pitch)
+{
+    bq_rbctx* c = (bq_rbctx*)cookie;
+    if (Q.have_producer && pthread_equal(Q.producer, pthread_self())) {
+        bq_run_done();                           /* the older ones first */
+        c->done(c->cookie, rgba, pitch);
+        free(c);
+        return;
+    }
+    const size_t bytes = (size_t)pitch * c->h;
+    bq_done* d = (bq_done*)malloc(sizeof *d + bytes);
+    if (d) {
+        d->done = c->done; d->cookie = c->cookie; d->pitch = pitch;
+        if (bytes && rgba) memcpy(d->px, rgba, bytes);
+        pthread_mutex_lock(&Q.done_lock);
+        d->next = Q.done_head; Q.done_head = d;
+        __atomic_store_n(&Q.n_done, 1u, __ATOMIC_RELEASE);
+        pthread_mutex_unlock(&Q.done_lock);
+    }
+    free(c);
+}
+
+/* On the engine's thread: run the completions the worker collected, oldest
+ * first. */
+static void bq_run_done(void)
+{
+    if (!__atomic_load_n(&Q.n_done, __ATOMIC_ACQUIRE)) return;
+    pthread_mutex_lock(&Q.done_lock);
+    bq_done* d = Q.done_head;
+    Q.done_head = NULL;
+    __atomic_store_n(&Q.n_done, 0u, __ATOMIC_RELAXED);
+    pthread_mutex_unlock(&Q.done_lock);
+    bq_done* rev = NULL;
+    while (d) { bq_done* n = d->next; d->next = rev; rev = d; d = n; }
+    while (rev) { bq_done* n = rev->next; rev->done(rev->cookie, rev->px, rev->pitch); free(rev); rev = n; }
+}
+
+/* ---- the calls the engine makes -------------------------------------------- */
+
+#define U (Q.be->user)
+
+static int t_init(void* user, u32 w, u32 h)
+{
+    (void)user;
+    const int rc = Q.be->init ? Q.be->init(U, w, h) : 0;
+    if (rc) return rc;
+    Q.buf = (u8*)malloc(BQ_CAP);
+    if (!Q.buf) { fprintf(stderr, "[be-thread] no %u MB queue: the engine records itself\n", BQ_CAP >> 20); return 0; }
+    Q.w = Q.w_pub = Q.rfree_seen = Q.pub = Q.r = Q.rfree = 0;
+    Q.stop = 0; Q.have_producer = 0;
+    if (!++s_init_seq) s_init_seq = 1;
+    bq_s_forget();
+    if (pthread_create(&Q.th, NULL, bq_worker, NULL)) {
+        free(Q.buf); Q.buf = NULL;
+        fprintf(stderr, "[be-thread] no worker thread: the engine records itself\n");
+        return 0;
+    }
+    pthread_setname_np(Q.th, "rsx-record");
+    Q.on = 1;
+    fprintf(stderr, "[be-thread] backend calls recorded on their own thread (%u MB queue)\n", BQ_CAP >> 20);
+    return 0;
+}
+
+static void bq_stop(void)
+{
+    if (!Q.on) return;
+    bq_wait_for(&Q.r, Q.w);
+    __atomic_store_n(&Q.stop, 1, __ATOMIC_SEQ_CST);
+    __atomic_add_fetch(&Q.wseq, 1u, __ATOMIC_SEQ_CST);
+    bq_futex(&Q.wseq, FUTEX_WAKE_PRIVATE, 1);
+    pthread_join(Q.th, NULL);
+    Q.on = 0;
+    free(Q.buf); Q.buf = NULL;
+    if (getenv("PS3RECOMP_BE_THREAD_STATS"))
+        fprintf(stderr, "[be-thread] %llu calls queued, %llu waited for the worker\n",
+                (unsigned long long)Q.n_async, (unsigned long long)Q.n_sync);
+}
+
+static void t_shutdown(void* user)
+{
+    (void)user;
+    bq_stop();
+    bq_run_done();
+    if (Q.be->shutdown) Q.be->shutdown(U);
+    bq_s_forget();
+    memset(Q.views, 0, sizeof Q.views);
+    memset(Q.snaps, 0, sizeof Q.snaps);
+}
+
+static void t_submit_and_wait(void* user, u32 reason)
+{
+    (void)user;
+    bq_direct_begin(); Q.be->submit_and_wait(U, reason); bq_direct_end();
+}
+
+static u32 t_texture_create(void* user, rsx_be_format fmt, u32 w, u32 h, u32 mips, u32 faces,
+                            u32 remap, u32 rsx_fmt)
+{
+    (void)user;
+    /* A handle now, the image built in order on the worker: creating it here
+     * waited for the whole queue, ~900 times in the 10 s a new area streams in. */
+    static int on = -1;
+    /* Off by default: built on the worker mid-batch, the images made the
+     * turning-camera p99 worse (155-178 ms windows against ~21). */
+    if (on < 0) { const char* e = getenv("PS3RECOMP_BQ_TEXASYNC"); on = e && e[0] == '1'; }
+    if (on && bq_async() && Q.be->texture_reserve && Q.be->texture_create_at) {
+        const u32 hd = Q.be->texture_reserve(U, fmt, w, h, mips, faces);
+        if (!hd) return 0;
+        u32* a = (u32*)BQ_P(bq_reserve(OP_TEX_CREATE, 32));
+        a[0] = hd; a[1] = (u32)fmt; a[2] = w; a[3] = h; a[4] = mips; a[5] = faces; a[6] = remap; a[7] = rsx_fmt;
+        return hd;
+    }
+    /* PS3RECOMP_BQ_TEXBUILD=1: the image is built here, beside the worker,
+     * and only its first barrier is queued, so the engine gets the same
+     * answer as from texture_create (a handle, or 0 when the image cannot be
+     * made) without waiting for the queue to empty. Off: in soaks it made
+     * the slow frames worse, not better (desktop and Rog Ally). With no
+     * drain at each new texture the uploads pile up in the queue and the
+     * next call that must wait (native SSAO, every frame) waits for all of
+     * them: the engine waited for the worker up to 5x as long (Rog Ally). */
+    static int build = -1;
+    if (build < 0) { const char* e = getenv("PS3RECOMP_BQ_TEXBUILD"); build = e && e[0] == '1'; }
+    if (build && bq_async() && Q.be->texture_reserve && Q.be->texture_build && Q.be->texture_init) {
+        const u32 hd = Q.be->texture_reserve(U, fmt, w, h, mips, faces);
+        if (!hd) return 0;
+        /* As the direct path does after a create: the handle may be one the
+         * backend freed by itself, which a kept view or snapshot still names. */
+        bq_gen_check();
+        if (Q.be->texture_build(U, hd, fmt, w, h, mips, faces, remap, rsx_fmt)) return 0;
+        *(u32*)BQ_P(bq_reserve(OP_TEX_INIT, 4)) = hd;
+        return hd;
+    }
+    bq_direct_begin();
+    const u32 r = Q.be->texture_create(U, fmt, w, h, mips, faces, remap, rsx_fmt);
+    bq_direct_end();
+    return r;
+}
+
+static void t_texture_upload(void* user, u32 tex, u32 face, u32 mip, u32 w, u32 h,
+                             const void* src, u32 row_bytes, u32 rows)
+{
+    (void)user;
+    const u64 bytes = (u64)row_bytes * rows;
+    if (!bq_async() || bytes > BQ_MAX_INLINE) {
+        bq_direct_begin(); Q.be->texture_upload(U, tex, face, mip, w, h, src, row_bytes, rows); bq_direct_end();
+        return;
+    }
+    bq_hdr* hd = bq_reserve(OP_TEX_UPLOAD, 32u + (u32)bytes);
+    u32* a = (u32*)BQ_P(hd);
+    a[0] = tex; a[1] = face; a[2] = mip; a[3] = w; a[4] = h; a[5] = row_bytes; a[6] = rows;
+    if (bytes) memcpy(BQ_P(hd) + 32, src, (size_t)bytes);
+}
+
+static void bq_release(int op, u32 handle,
+                       void (*fn)(void*, u32))
+{
+    /* A target takes its snapshots and their views with it: drop every kept
+     * answer. A texture takes its views. A pipeline names nothing kept. */
+    if (op == OP_COLOR_RELEASE || op == OP_DEPTH_RELEASE) {
+        memset(Q.views, 0, sizeof Q.views);
+        memset(Q.snaps, 0, sizeof Q.snaps);
+    } else if (op == OP_TEX_RELEASE) {
+        bq_forget(handle);
+    }
+    if (!bq_async()) { bq_direct_begin(); fn(U, handle); bq_direct_end(); return; }
+    *(u32*)BQ_P(bq_reserve((u32)op, 4)) = handle;
+}
+static void t_texture_release(void* user, u32 h) { (void)user; bq_release(OP_TEX_RELEASE, h, Q.be->texture_release); }
+static void t_color_release(void* user, u32 h)   { (void)user; bq_release(OP_COLOR_RELEASE, h, Q.be->color_target_release); }
+static void t_depth_release(void* user, u32 h)   { (void)user; bq_release(OP_DEPTH_RELEASE, h, Q.be->depth_target_release); }
+static void t_pipe_release(void* user, u32 h)    { (void)user; S.have &= ~(u32)BQ_S_PIPE; bq_release(OP_PIPE_RELEASE, h, Q.be->pipeline_release); }
+
+static u32 t_color_create(void* user, rsx_be_format fmt, u32 w, u32 h, const void* seed, u32 seed_row_bytes)
+{
+    (void)user;
+    bq_direct_begin();
+    const u32 r = Q.be->color_target_create(U, fmt, w, h, seed, seed_row_bytes);
+    bq_direct_end();
+    return r;
+}
+
+static u32 t_depth_create(void* user, u32 w, u32 h)
+{
+    (void)user;
+    bq_direct_begin(); const u32 r = Q.be->depth_target_create(U, w, h); bq_direct_end();
+    return r;
+}
+
+static u32 t_surface_view(void* user, u32 surface, u32 remap, u32 fmt)
+{
+    (void)user;
+    bq_check_snaps();
+    bq_view* v = &Q.views[bq_hash(surface, remap, fmt, 1u)];
+    if (v->view && v->surface == surface && v->remap == remap && v->fmt == fmt) return v->view;
+    bq_direct_begin(); const u32 r = Q.be->surface_view(U, surface, remap, fmt); bq_direct_end();
+    if (r) { v->surface = surface; v->remap = remap; v->fmt = fmt; v->view = r; }
+    return r;
+}
+
+/* kind 1 colour, 2 depth, 3 depth as RGBA8, 4 colour rectangle (PS3RECOMP_BQ_SNAP_RECT=1) */
+static u32 bq_snapshot(u32 kind, u32 target, u32 w, u32 h)
+{
+    bq_check_snaps();
+    bq_snap* s = &Q.snaps[bq_hash(target, w, h, kind + 7u)];
+    if (Q.be->stable_snapshots && bq_async() && s->snap && s->kind == kind &&
+        s->target == target && s->w == w && s->h == h) {
+        const u32 op = kind == 1 ? OP_SNAP_COLOR : kind == 2 ? OP_SNAP_DEPTH : kind == 4 ? OP_SNAP_RECT : OP_SNAP_RGBA8;
+        u32* a = (u32*)BQ_P(bq_reserve(op, 16));
+        a[0] = target; a[1] = w; a[2] = h; a[3] = s->snap;
+        return s->snap;
+    }
+    bq_direct_begin();
+    const u32 r = kind == 1 ? Q.be->color_snapshot(U, target)
+                : kind == 2 ? Q.be->depth_snapshot(U, target, w, h)
+                : kind == 4 ? Q.be->color_snapshot_rect(U, target, w, h)
+                : Q.be->depth_snapshot_rgba8(U, target, w, h);
+    bq_direct_end();
+    if (r) { s->kind = kind; s->target = target; s->w = w; s->h = h; s->snap = r; }
+    else memset(s, 0, sizeof *s);
+    return r;
+}
