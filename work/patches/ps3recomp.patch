+    case RSX_BE_FMT_R16G16B16A16F: *fsz = 2; *fn = 4; return 8;
+    case RSX_BE_FMT_R32G32B32A32F: *fsz = 4; *fn = 4; return 16;
+    case RSX_BE_FMT_R32F:          *fsz = 4; *fn = 1; return 4;
+    default:                       *fsz = 0; *fn = 0; return 0;
+    }
