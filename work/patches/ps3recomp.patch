+#define vm_read16_stk_mm(m, a)     PPU_STK_LD(uint16_t, __builtin_bswap16, m, a)
+#define vm_read32_stk_mm(m, a)     PPU_STK_LD(uint32_t, __builtin_bswap32, m, a)
+#define vm_read64_stk_mm(m, a)     PPU_STK_LD(uint64_t, __builtin_bswap64, m, a)
+#define vm_write8_stk_mm(m, a, v)  PPU_STK_ST(uint8_t, PPU_BS8, m, a, v)
+#define vm_write16_stk_mm(m, a, v) PPU_STK_ST(uint16_t, __builtin_bswap16, m, a, v)
+#define vm_write32_stk_mm(m, a, v) PPU_STK_ST(uint32_t, __builtin_bswap32, m, a, v)
+#define vm_write64_stk_mm(m, a, v) PPU_STK_ST(uint64_t, __builtin_bswap64, m, a, v)
