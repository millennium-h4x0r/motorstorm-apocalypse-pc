+/* cellVideoOutGetScreenSize(videoOut, screenSize) -- NID 0xFAA275A4.
+ * Reports the screen diagonal, in inches, from the XMB's 3D display settings;
+ * it exists for stereoscopic titles to size their eye separation. With no 3D
+ * display configured the console has no value to report and the call answers
+ * CELL_VIDEO_OUT_ERROR_VALUE_IS_NOT_SET without writing *screenSize. Argument
+ * checks in RPCS3's order (Modules/cellAvconfExt.cpp, behavioural reference
+ * only): null pointer, then a video out other than PRIMARY.
+ *
+ * MotorStorm Apocalypse (func_005F08EC, right after its cellVideoOutGetState)
+ * pre-fills the out-param with 40.0f, ignores the return code, and turns the
+ * diagonal into a physical screen width in metres for its stereo camera:
+ * width = d * 0.0254 / sqrt(1 + 1/aspect^2), aspect 16:9 when GetState
+ * reports CELL_VIDEO_OUT_ASPECT_16_9. Leaving the value unset therefore keeps
+ * the title's own 40" default (0.885 m wide at 16:9), the same answer a
+ * non-3D 1080p-class TV gives on a console. Nothing here selects the display
+ * mode; that comes from cellVideoOutGetState/GetResolutionAvailability.
+ *
+ * The codes are written out because libs/video/cellVideoOut.h's
+ * CELL_VIDEO_OUT_ERROR_* are based at 0x8002B100, not the firmware's
+ * 0x8002B220. */
+#define AVCONF_VIDEO_OUT_PRIMARY                 0
+#define AVCONF_VIDEO_OUT_ERROR_ILLEGAL_PARAMETER (s32)0x8002B222
+#define AVCONF_VIDEO_OUT_ERROR_UNSUPPORTED_OUT   (s32)0x8002B225
+#define AVCONF_VIDEO_OUT_ERROR_VALUE_IS_NOT_SET  (s32)0x8002B228
+
+s32 cellVideoOutGetScreenSize(u32 videoOut, float* screenSize)
+{
+    printf("[cellAvconfExt] VideoOutGetScreenSize(videoOut=%u) -> not set (no 3D display)\n",
+           videoOut);
+    if (!screenSize)
+        return AVCONF_VIDEO_OUT_ERROR_ILLEGAL_PARAMETER;
+    if (videoOut != AVCONF_VIDEO_OUT_PRIMARY)
+        return AVCONF_VIDEO_OUT_ERROR_UNSUPPORTED_OUT;
+    return AVCONF_VIDEO_OUT_ERROR_VALUE_IS_NOT_SET;
+}
