+    if (tight > row_bytes) return;
+    VkDeviceSize off;
+    u8* st = vk_ring_alloc(&s_sring, (VkDeviceSize)tight * rows, 16u, &off);
+    if (!st) return;
+    for (u32 y = 0; y < rows; y++)
