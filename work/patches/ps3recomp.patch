+static inline int mfc_fast_ok(void)
+{
+    static int s_env = -1;
+    int env = __atomic_load_n(&s_env, __ATOMIC_RELAXED);
+    if (__builtin_expect(env < 0, 0)) { env = mfc_diag_env(); __atomic_store_n(&s_env, env, __ATOMIC_RELAXED); }
+    extern int g_spu_param_dump, g_spu_lbt, g_ps3_tl;
+    extern uint32_t g_barrier_sync_watch;
+    return !env && !g_spu_param_dump && !g_spu_lbt && !g_ps3_tl
+        && !g_barrier_sync_watch;
+}
