diff --git a/libs/input/tests/test_pad_sdl_virtual.c b/libs/input/tests/test_pad_sdl_virtual.c
new file mode 100644
index 00000000..41114561
--- /dev/null
+++ b/libs/input/tests/test_pad_sdl_virtual.c
@@ -0,0 +1,187 @@
+/* cellPad against real SDL game controllers: SDL's virtual joysticks
+ * (SDL_JoystickAttachVirtualEx, SDL >= 2.24), which SDL maps as standard game
+ * controllers. Four pads take ports 0..3 in the order they appear; buttons,
+ * sticks and the analog triggers reach cellPadGetData (a part-pulled R2 is a
+ * part pressure with press mode on); a pad unplugged frees its port and
+ * plugged again returns to it; a fifth pad waits for a free port.
+ *
+ *   clang -std=gnu17 -I include $(sdl2-config --cflags) libs/input/tests/test_pad_sdl_virtual.c \
+ *         $(sdl2-config --libs) -o /tmp/test_pad_sdl_virtual && /tmp/test_pad_sdl_virtual \
+ *         && /tmp/test_pad_sdl_virtual file
+ */
+#include "../cellPad.c"
+#include <assert.h>
+#include <unistd.h>
+#include <sys/mman.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+u32 cellGcm_flip_request_count(void) { return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+unsigned char g_spu_coh_bitmap[1];
+int g_spu_coh_armed;
+void spu_coh_notify_write_from_ppu(uint32_t a) { (void)a; }
+uint64_t spu_lockline_mask_range(uint32_t ea, uint32_t len) { (void)ea; (void)len; return 0; }
+void spu_lockline_lock_mask(uint64_t m) { (void)m; }
+void spu_lockline_unlock_mask(uint64_t m) { (void)m; }
+void spu_coh_ppu_store(uint8_t* host, uint32_t ea, const void* src, uint32_t n) { (void)ea; memcpy(host, src, n); }
+void spu_coh_ppu_wrote(uint32_t ea, uint32_t n) { (void)ea; (void)n; }
+
+#if SDL_VERSION_ATLEAST(2, 24, 0)
+typedef struct { int dev; SDL_Joystick* js; } VPad;
+static VPad vpad_new(void)
+{
+    SDL_VirtualJoystickDesc d;
+    memset(&d, 0, sizeof d);
+    d.version = SDL_VIRTUAL_JOYSTICK_DESC_VERSION;
+    d.type = SDL_JOYSTICK_TYPE_GAMECONTROLLER;
+    d.naxes = SDL_CONTROLLER_AXIS_MAX;
+    d.nbuttons = SDL_CONTROLLER_BUTTON_MAX;
+    d.name = "Virtual Pad";
+    /* a vendor/product of its own: with 0/0 SDL can match the first pad to a
+     * stock mapping ("X360 Controller") whose buttons are not the virtual ones */
+    static Uint16 n;
+    d.vendor_id = 0x1209; d.product_id = (Uint16)(0x7000 + n++);
+    VPad v;
+    v.dev = SDL_JoystickAttachVirtualEx(&d);
+    assert(v.dev >= 0);
+    v.js = SDL_JoystickOpen(v.dev);
+    assert(v.js);
+    /* A virtual trigger axis spans the full -32768..32767 (SDL maps it to the
+     * controller's 0..32767): at rest it is -32768, not the 0 a new axis has. */
+    SDL_JoystickSetVirtualAxis(v.js, SDL_CONTROLLER_AXIS_TRIGGERLEFT, -32768);
+    SDL_JoystickSetVirtualAxis(v.js, SDL_CONTROLLER_AXIS_TRIGGERRIGHT, -32768);
+    SDL_JoystickUpdate();
+    return v;
+}
+static void vpad_free(VPad* v)
+{
+    const SDL_JoystickID id = SDL_JoystickInstanceID(v->js);
+    SDL_JoystickClose(v->js);
+    for (int i = 0; i < SDL_NumJoysticks(); i++)
+        if (SDL_JoystickGetDeviceInstanceID(i) == id) { SDL_JoystickDetachVirtual(i); break; }
+}
+static void set_btn(VPad* v, int b, int on) { SDL_JoystickSetVirtualButton(v->js, b, (Uint8)on); SDL_JoystickUpdate(); }
+static void set_axis(VPad* v, int a, int val) { SDL_JoystickSetVirtualAxis(v->js, a, (Sint16)val); SDL_JoystickUpdate(); }
+
+static void pump(void) { SDL_PumpEvents(); usleep((PAD_POLL_INTERVAL_MS + 2) * 1000); cellPad_poll(); }
+static u32 info_status(u32 port)
+{
+    const uint32_t ea = 0x1000;
+    assert(cellPadGetInfo2((CellPadInfo2*)(uintptr_t)ea) == CELL_OK);
+    const uint8_t* b = vm_base + ea + 12 + port * 4;
+    return (u32)b[0] << 24 | (u32)b[1] << 16 | (u32)b[2] << 8 | b[3];
+}
+/* cellPadGetData reports a port only when it changed (len 0 otherwise), so a
+ * state is read once and its words taken from that one report. */
+static void fetch(u32 port)
+{
+    pump();
+    memset(vm_base + 0x2000, 0, 0x100);
+    assert(cellPadGetData(port, (CellPadData*)(uintptr_t)0x2000) == CELL_OK);
+}
+static unsigned w(int idx) { const uint8_t* b = vm_base + 0x2000 + 4 + idx * 2; return (unsigned)b[0] << 8 | b[1]; }
+static unsigned word(u32 port, int idx) { fetch(port); return w(idx); }
+#define CROSS_BIT 0x40u
+#define R2_BIT    0x02u
+/* `file` mode: PS3_PAD_FILE_0 pins port 0 to a file pad; a real (SDL) pad takes
+ * the next free port, 1, and its buttons never show on port 0 (an unattended
+ * test driving port 0 with a real pad plugged into the host). */
+static int file_mode(void)
+{
+    char path[] = "/tmp/test_pad_sdl_virtual_XXXXXX";
+    const int fd = mkstemp(path); assert(fd >= 0);
+    assert(write(fd, "CROSS\n", 6) == 6); close(fd);
+    setenv("PS3_PAD_FILE_0", path, 1);
+    assert(SDL_Init(SDL_INIT_JOYSTICK | SDL_INIT_GAMECONTROLLER) == 0);
+    VPad real = vpad_new();
+    assert(cellPadInit(7) == CELL_OK);
+    assert(cellPadSetPortSetting(0, CELL_PAD_SETTING_PRESS_ON) == CELL_OK);
+    assert(cellPadSetPortSetting(1, CELL_PAD_SETTING_PRESS_ON) == CELL_OK);
+    assert(word(0, CELL_PAD_BTN_OFFSET_DIGITAL2) & CROSS_BIT);            /* the file's CROSS on port 0 */
+    FILE* f = fopen(path, "w"); assert(f); fclose(f);                      /* file: nothing held */
+    set_btn(&real, SDL_CONTROLLER_BUTTON_B, 1);                            /* real pad: CIRCLE */
+    fetch(0); assert(!(w(CELL_PAD_BTN_OFFSET_DIGITAL2) & 0x20u));           /* not on port 0 */
+    fetch(1); assert(w(CELL_PAD_BTN_OFFSET_DIGITAL2) & 0x20u);              /* on port 1 */
+    set_btn(&real, SDL_CONTROLLER_BUTTON_B, 0);
+    printf("file pad keeps port 0, the real pad goes to port 1: ok\n");
+    cellPadEnd(); SDL_Quit(); unlink(path);
+    return 0;
+}
+int main(int argc, char** argv)
+{
+    vm_base = mmap(NULL, 0x10000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    assert(vm_base != MAP_FAILED);
+    setenv("PAD_NO_KEYBOARD", "1", 1);
+    setvbuf(stdout, NULL, _IONBF, 0);
+    if (argc > 1 && !strcmp(argv[1], "file")) {
+        SDL_SetHint(SDL_HINT_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT, "0x1209/0x7000");
+        return file_mode();
+    }
+    /* only the virtual pads: a controller on the host running the test is left out */
+    SDL_SetHint(SDL_HINT_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT,
+                "0x1209/0x7000,0x1209/0x7001,0x1209/0x7002,0x1209/0x7003,0x1209/0x7004");
+    assert(SDL_Init(SDL_INIT_JOYSTICK | SDL_INIT_GAMECONTROLLER) == 0);
+    VPad p[5];
+    for (int i = 0; i < 4; i++) p[i] = vpad_new();
+    assert(cellPadInit(7) == CELL_OK);
+    for (u32 port = 0; port < 4; port++) {
+        assert(cellPadSetPortSetting(port, CELL_PAD_SETTING_PRESS_ON) == CELL_OK);
+        assert(info_status(port) & CELL_PAD_STATUS_CONNECTED);
+    }
+    /* port order = the order they appeared: press CROSS on pad k only */
+    for (int k = 0; k < 4; k++) {
+        set_btn(&p[k], SDL_CONTROLLER_BUTTON_A, 1);
+        for (u32 port = 0; port < 4; port++) {
+            const unsigned d2 = word(port, CELL_PAD_BTN_OFFSET_DIGITAL2);
+            if ((int)port == k) assert(d2 & CROSS_BIT); else assert(!(d2 & CROSS_BIT));
+        }
+        set_btn(&p[k], SDL_CONTROLLER_BUTTON_A, 0);
+    }
+    printf("4 pads: ports 0-3 in order\n");
+    /* analog trigger as pressure: half-pulled R2 on pad 2 */
+    set_axis(&p[2], SDL_CONTROLLER_AXIS_TRIGGERRIGHT, 0);          /* half */
+    { fetch(2); const unsigned pr = w(CELL_PAD_BTN_OFFSET_PRESS_R2), d2 = w(CELL_PAD_BTN_OFFSET_DIGITAL2);
+      printf("pad 2 R2 half: pressure %u, digital %s\n", pr, d2 & R2_BIT ? "on" : "off");
+      assert(pr >= 120 && pr <= 135 && (d2 & R2_BIT)); }
+    set_axis(&p[2], SDL_CONTROLLER_AXIS_TRIGGERRIGHT, 32767);
+    assert(word(2, CELL_PAD_BTN_OFFSET_PRESS_R2) == 255);
+    set_axis(&p[2], SDL_CONTROLLER_AXIS_TRIGGERRIGHT, -32768);      /* released */
+    fetch(2); assert(w(CELL_PAD_BTN_OFFSET_PRESS_R2) == 0 && !(w(CELL_PAD_BTN_OFFSET_DIGITAL2) & R2_BIT));
+    /* left stick on pad 3 */
+    set_axis(&p[3], SDL_CONTROLLER_AXIS_LEFTX, -32768);
+    assert(word(3, CELL_PAD_BTN_OFFSET_ANALOG_LEFT_X) == 0);
+    set_axis(&p[3], SDL_CONTROLLER_AXIS_LEFTX, 32767);
+    assert(word(3, CELL_PAD_BTN_OFFSET_ANALOG_LEFT_X) == 255);
+    set_axis(&p[3], SDL_CONTROLLER_AXIS_LEFTX, 0);
+    printf("triggers and sticks: ok\n");
+    /* a fifth pad: no free port */
+    p[4] = vpad_new();
+    pump(); pump();
+    /* pad 1 unplugged: port 1 is free; the fifth takes it on the rescan */
+    vpad_free(&p[1]);
+    pump();
+    usleep(1100 * 1000); pump();
+    set_btn(&p[4], SDL_CONTROLLER_BUTTON_A, 1);
+    { const unsigned d2 = word(1, CELL_PAD_BTN_OFFSET_DIGITAL2);
+      printf("unplug pad on port 1: the waiting fifth pad %s port 1\n", d2 & CROSS_BIT ? "took" : "did NOT take");
+      assert(d2 & CROSS_BIT); }
+    set_btn(&p[4], SDL_CONTROLLER_BUTTON_A, 0);
+    /* the others kept their ports */
+    set_btn(&p[3], SDL_CONTROLLER_BUTTON_A, 1);
+    assert(word(3, CELL_PAD_BTN_OFFSET_DIGITAL2) & CROSS_BIT);
+    set_btn(&p[3], SDL_CONTROLLER_BUTTON_A, 0);
+    printf("test_pad_sdl_virtual: ok\n");
+    cellPadEnd();
+    SDL_Quit();
+    return 0;
+}
+#else
+int main(void) { return 0; }
+#endif
