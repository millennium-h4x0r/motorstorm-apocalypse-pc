+
+    for (int i = 0; i < nwake; i++) {
+        const u16 id = wake_ids[i];
+        const uint32_t ts = id == 0xFFFFu ? 0 : lfq_taskset_for(q, id);
+        if (!ts) {
+            static int _n = 0;
+            if (__atomic_load_n(&_n, __ATOMIC_RELAXED) < 8 && __atomic_fetch_add(&_n, 1, __ATOMIC_RELAXED) < 8) fprintf(stderr, "[cellSpurs] LFQueuePush q=0x%08X: cannot wake waiter id 0x%04X\n", q, id);
+            continue;
+        }
+        { static int s_l = -1; if (s_l < 0) s_l = getenv("SPURS_LFQ_LOG") ? 1 : 0;
+          if (s_l) fprintf(stderr, "[lfq-push] q=0x%08X wake id=0x%04X -> taskset 0x%08X task %u\n",
