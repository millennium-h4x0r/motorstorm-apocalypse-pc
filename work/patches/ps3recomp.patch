+        have += n;
+    }
+    pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          0, 0, NULL, 1, &bb, 0, NULL);
+    vk_barrier_image(img, aspect == VK_IMAGE_ASPECT_COLOR_BIT ? VK_IMAGE_ASPECT_COLOR_BIT : s_vk.depth_aspect,
+                     VK_IMAGE_LAYOUT_GENERAL);
+    vk_global_barrier();
+    VkBufferImageCopy region = {
+        .bufferOffset = 0, .bufferRowLength = row / bpp,
+        .imageSubresource = { aspect, 0, 0, 1 },
+        .imageOffset = { (int32_t)x, (int32_t)y, 0 },
+        .imageExtent = { w, h, 1 },
+    };
+    pvkCmdCopyBufferToImage(s_vk.cmd, sb, img, VK_IMAGE_LAYOUT_GENERAL, 1, &region);
+    vk_global_barrier();
+    vk_op_end();
