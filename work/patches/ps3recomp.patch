+#define GEO_PROBE   8u
+#define GEO_MAX_BYTES (384ull << 20)
+typedef struct {
+    u64 key;                     /* 0: empty */
+    u32 last_frame, skip_until, dirty_streak;
+    int probation;               /* seen once, nothing kept yet */
+    u32 n_verts, stride, n_draw, n_source_refs;
+    int indexed;
+    u8* verts;
+    u32* indices;
+    u32 res;                     /* the backend's copy (geo_put), 0 for none */
