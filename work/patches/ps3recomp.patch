+/* [ea, ea + n) inside [0x10000, 0x10000 + span). Below 0x10000 the 32-bit
+ * subtraction wraps past any span. */
+PPU_INL int vm_mm_in(int64_t span, uint32_t ea, uint32_t n)
+{
+    return (int64_t)(uint32_t)(ea - 0x10000u) <= span - (int64_t)n;
+}
+PPU_INL int vm_mm_ok(const ppu_mm* m, uint32_t ea, uint32_t n)
+{
+    return vm_mm_in(m->span, ea, n);
+}
+/* Has an SPU reserved ea's line (before the store: a plain read) */
+PPU_INL int vm_mm_line_reserved(uint32_t ea)
+{
+    const uint32_t line = ea >> 7;
+    return (g_spu_coh_bitmap[line >> 3] >> (line & 7)) & 1u;
+}
+PPU_INL int vm_mm_st_ok(const ppu_mm* m, uint32_t ea, uint32_t n)
+{
+    if (!__builtin_expect(vm_mm_in(m->span, ea, n), 1))
+        return 0;
+    return !__builtin_expect(vm_mm_line_reserved(ea), 0);
