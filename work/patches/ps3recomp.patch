+            fprintf(stderr, "[rsx drawtrace] d%u   vertex %u: %g %g %g %g (stride %u)\n", d, k, v[0], v[1], v[2], v[3], s_dt_stride);
+        }
+        fprintf(stderr, "[rsx drawtrace] d%u   vp rows %u+%u%s\n", d, g.vpc_lo, g.vpc_n, g.vpc_full ? " (full)" : "");
+        for (u32 r = g.vpc_lo; r < g.vpc_lo + g.vpc_n && r < RSX_DSP_NUM_CONSTANTS && r < g.vpc_lo + 40u; r++) {
+            float v[4]; memcpy(v, g.rsx.constants[r], 16);
+            fprintf(stderr, "[rsx drawtrace] d%u   vc%u = %g %g %g %g\n", d, r, v[0], v[1], v[2], v[3]);
+        }
+    }
+    if (n <= 12) {
+        const float* c = (const float*)g.fp_cb;
+        const u32 nc = g.fp_constants ? g.fp_constants->count : 0u;
+        fprintf(stderr, "[rsx drawtrace] d%u   fp constants %u\n", d, nc);
+        for (u32 k = 0; k < (nc > 32u ? nc : 32u) && k < 128u && (k + 1) * 16u <= g.fp_cb_cap; k++)
+            fprintf(stderr, "[rsx drawtrace] d%u   c%u = %g %g %g %g\n", d, k,
+                    c[k * 4], c[k * 4 + 1], c[k * 4 + 2], c[k * 4 + 3]);
+    }
+    /* ,vp: the state lines only, for every draw of the frame, no readbacks
+     * (which take minutes over a whole frame). */
+    if (vp_only) {
+        fprintf(stderr, "[rsx drawtrace] d%u p%u n%u -> 0x%08X %ux%u fmt %d (%u targets)\n", d, pipeline, n,
+                n_targets ? g.surfaces[targets[0]].offset : 0, n_targets ? g.surfaces[targets[0]].w : 0,
+                n_targets ? g.surfaces[targets[0]].h : 0, n_targets ? (int)g.surfaces[targets[0]].fmt : -1, n_targets);
+        return;
+    }
+    /* The zeta as the draw left it: how much is at 0, at 1, in between. */
+    if (s_dt_zslot != ENG_INVALID && s_dt_zslot < g.n_zdepths && g.be->depth_readback) {
+        const eng_zdepth* z = &g.zdepths[s_dt_zslot];
+        const u32 zw = (z->guest_w && z->guest_w < z->w) ? z->guest_w : z->w;
+        const u32 zh = (z->guest_h && z->guest_h < z->h) ? z->guest_h : z->h;
+        float* zf = (z->handle && zw && zh) ? (float*)malloc((size_t)zw * zh * sizeof(float)) : NULL;
+        if (zf && !g.be->depth_readback(g.be->user, z->handle, zw, zh, zf)) {
+            u64 z0 = 0, z1 = 0; double sum = 0;
+            for (u32 k = 0; k < zw * zh; k++) { z0 += zf[k] <= 0.0f; z1 += zf[k] >= 1.0f; sum += zf[k]; }
+            fprintf(stderr, "[rsx drawtrace] d%u   zeta 0x%08X %ux%u: at 0 %llu, at 1 %llu, mean %.4f,"
+                    " mid %.7f, row %u: %.7f %.7f %.7f %.7f\n",
+                    d, z->offset, zw, zh, (unsigned long long)z0, (unsigned long long)z1, sum / (zw * zh),
+                    zf[(zh / 2) * zw + zw / 2], zh * 5 / 8,
+                    zf[(zh * 5 / 8) * zw + zw / 8], zf[(zh * 5 / 8) * zw + zw * 3 / 8],
+                    zf[(zh * 5 / 8) * zw + zw * 5 / 8], zf[(zh * 5 / 8) * zw + zw * 7 / 8]);
+        }
+        free(zf);
+    }
+    for (u32 i = 0; i < n_targets; i++) {
+        const eng_surface* s = &g.surfaces[targets[i]];
+        if (!s->handle || !s->w || !s->h) continue;
+        u8* px = (u8*)malloc((size_t)s->w * s->h * 4);
+        if (!px) return;
+        eng_readback_rgba8(s, s->w, s->h, px);
+        unsigned long long sr = 0, sg = 0, sb = 0, sa = 0, yel = 0;
+        const u32 np = s->w * s->h;
+        for (u32 k = 0; k < np; k++) {
+            const u8* q = px + k * 4;
+            sr += q[0]; sg += q[1]; sb += q[2]; sa += q[3];
+            yel += (q[0] >= 250 && q[1] >= 250 && q[2] <= 5);
+        }
+        const u8* m = px + ((s->h / 2) * s->w + s->w / 2) * 4;
+        fprintf(stderr, "[rsx drawtrace] d%u p%u n%u t%u 0x%08X %ux%u fmt %d mean %.1f %.1f %.1f %.1f yellow %.1f%% mid %u,%u,%u,%u\n",
+                d, pipeline, n, i, s->offset, s->w, s->h, (int)s->fmt,
+                (double)sr / np, (double)sg / np, (double)sb / np, (double)sa / np,
+                100.0 * (double)yel / np, m[0], m[1], m[2], m[3]);
+        if (s->fmt != RSX_BE_FMT_R8G8B8A8)
+            fprintf(stderr, "[rsx drawtrace] d%u   t%u float mean %.4g %.4g %.4g %.4g max %.4g %.4g %.4g %.4g, %llu of %u px <= 1\n",
+                    d, i, s_rb_fmean[0], s_rb_fmean[1], s_rb_fmean[2], s_rb_fmean[3],
+                    s_rb_fmax[0], s_rb_fmax[1], s_rb_fmax[2], s_rb_fmax[3],
+                    (unsigned long long)s_rb_le1, np);
+        /* PS3RECOMP_ENG_DRAWTRACE_PX=<fx>,<fy>: also one pixel at that place
+         * (fractions of the target), marked "changed" when this draw wrote
+         * it -- which draws make what is on screen there. */
+        { static int px_on = -1; static float pfx, pfy;
+          static struct { u32 slot; u32 rgba; } prev[16]; static u32 nprev;
+          if (px_on < 0) { const char* q = getenv("PS3RECOMP_ENG_DRAWTRACE_PX");
+              px_on = q && sscanf(q, "%f,%f", &pfx, &pfy) == 2 && pfx == pfx && pfy == pfy;
+              if (px_on) { pfx = pfx < 0.0f ? 0.0f : pfx > 1.0f ? 1.0f : pfx;
+                           pfy = pfy < 0.0f ? 0.0f : pfy > 1.0f ? 1.0f : pfy; } }
+          if (px_on) {
+              const u32 X = (u32)(pfx * s->w) < s->w ? (u32)(pfx * s->w) : s->w - 1;
+              const u32 Y = (u32)(pfy * s->h) < s->h ? (u32)(pfy * s->h) : s->h - 1;
+              const u8* q = px + ((size_t)Y * s->w + X) * 4;
+              const u32 v = (u32)q[0] | (u32)q[1] << 8 | (u32)q[2] << 16 | (u32)q[3] << 24;
+              u32 k = 0;
+              /* By surface slot: one offset can hold surfaces of several sizes. */
+              while (k < nprev && prev[k].slot != targets[i]) k++;
+              const int changed = k == nprev || prev[k].rgba != v;
+              if (k == nprev && nprev < 16) { prev[nprev].slot = targets[i]; nprev++; }
+              if (k < 16) prev[k].rgba = v;
+              if (changed)
+                  fprintf(stderr, "[rsx drawtrace] d%u p%u t%u 0x%08X px %u,%u = %u,%u,%u,%u changed\n",
+                          d, pipeline, i, s->offset, X, Y, q[0], q[1], q[2], q[3]);
+          } }
+        if (keep) {
+            char path[512];
+            snprintf(path, sizeof path, "%s/d%04u_p%u_t%u_%08X.ppm", dir, d, pipeline, i, s->offset);
+            FILE* f = fopen(path, "wb");
+            if (f) { fprintf(f, "P6\n%u %u\n255\n", s->w, s->h);
+                     for (u32 k = 0; k < np; k++) fwrite(px + k * 4, 1, 3, f);
+                     fclose(f); }
+        }
+        free(px);
+    }
+}
+
+static void sink_draw_arrays(void* user, const rsx_dispatch* r, u32 first, u32 count)
+{
+    (void)user; (void)r;
+    dc.n_packets++;
+    if (dc.n_arr >= ENG_MAX_BATCHES) return;
+    dc.arr[dc.n_arr].first = first;
+    dc.arr[dc.n_arr].count = count;
+    dc.n_arr++;
+}
+
+/* INLINE_ARRAY delivers one finished stream rather than a (first, count)
+ * range; queue it as an ordinary consecutive batch and let the fetch plan
+ * read the vertices out of it (rsx_vertex_fetch_plan_set_inline). */
+static void sink_inline_array(void* user, const rsx_dispatch* r,
+                              const u8* data, u32 bytes)
+{
+    (void)user;
+    const u32 stride = rsx_vertex_inline_layout(r, NULL);
+    if (!stride || bytes < stride) {
+        static int n;
+        if (getenv("PS3RECOMP_ENG_DROPLOG") && __atomic_fetch_add(&n, 1, __ATOMIC_RELAXED) < 6)
+            fprintf(stderr, "[rsx engine] inline array dropped: stride=%u bytes=%u\n", stride, bytes);
+        return;
+    }
+    dc.inl = data;
+    dc.inl_bytes = bytes;
+    dc.n_packets++;
+    if (dc.n_arr >= ENG_MAX_BATCHES) return;
+    dc.arr[dc.n_arr].first = 0;
+    dc.arr[dc.n_arr].count = bytes / stride;
+    dc.n_arr++;
+}
+
+static void eng_constlog_draw(u32 rt, u32 cw, u32 ch, u32 n, int indexed);
+
+static void sink_draw_index(void* user, const rsx_dispatch* r, u32 first, u32 count)
+{
+    (void)user; (void)r;
+    dc.n_packets++;
+    if (dc.n_idx >= ENG_MAX_BATCHES) return;
+    dc.idx[dc.n_idx].first = first;
+    dc.idx[dc.n_idx].count = count;
+    dc.n_idx++;
+}
+
+/* Which texture units this draw binds, and from where: a unit naming a
+ * registered colour surface samples that live target rather than guest
+ * memory (every post-process, shadow and reflection in a PS3 title is a
+ * render-to-texture read back through a texture unit), a unit naming a
+ * tracked zeta in DEPTH24_D8 samples its snapshot, and everything else is a
+ * guest upload (rsx_live_draw.c:5986-6062). */
+/* Texture units the current guest fragment program samples: a unit can stay
+ * enabled with a stale binding (a shadow pass keeps its own map bound), and a
+ * snapshot is only worth taking for one the program reads. */
+static u32 eng_fp_tex_mask(void)
+{
+    const eng_fp_memo* fp = NULL;
+    if (!eng_guest_programs(NULL, &fp)) return 0xFFFFu;
+    return fp->tex_mask;
+}
+
+/* ---- native ambient occlusion ---------------------------------------------
+ * rsx_draw_engine_set_native_ssao: the GPU computes what a title's SPU job
+ * derives from NV3089 copies of its G-buffer, and the texture units that
+ * sample the job's output get the GPU's. */
+static struct {
+    rsx_native_ssao_desc d;
+    u32 out[3];          /* the backend's occlusion, half depth, half occlusion */
+    u32 w, h;            /* of the occlusion texture, at the run of out[]     */
+    u32 runs, run_frame;
+    u32 checked;         /* frame of the last mode-2 comparison               */
+} s_nao;
+/* Mode 1, nonzero while the GPU produces the occlusion: the title's kernels
+ * may skip their work (rsx_draw_engine_native_ssao_live). */
+static volatile int s_nao_live;
+
+/* rsx_draw_engine_set_native_lighting. */
+static struct {
+    rsx_native_lighting_desc d;
+    u32 out[2];          /* the backend's diffuse and specular images         */
+    u32 w, h;            /* of the latched images                            */
+    u32 latch_seq;       /* pairs latched                                    */
+    u32 consistent;      /* the latched images are one frame's pair          */
+    u32 done_latch, done_job;  /* what out[] was computed from               */
+    u32 runs, checked;
+    u32 check_w, check_h, check_pitch;   /* mode 2: compare at the next copy */
+} s_nlt;
+/* Mode 1: the GPU's lighting is what the game samples (set by a successful
+ * substitution, cleared by a failure; s_nlt_sub_latch is the pair it was of),
+ * and the job just started may skip. */
+static volatile int s_nlt_live, s_nlt_skip;
+static volatile u32 s_nlt_sub_latch;
+
+/* A frame's two G-buffer copies, in either order (the game copies the depth
+ * first), until both are in: what each resolved to. */
+static struct {
+    u32 have;            /* bit 0 the normals, bit 1 the depth              */
+    u32 latched;         /* the same, latched for the lighting              */
+    u32 n_slot, n_offset, normals;   /* the normals colour target           */
+    u32 z_slot, depth;               /* the zeta and its RGBA8 snapshot     */
+    u32 w[2], h[2];
+    u32 frame;           /* the pair belongs to this frame                 */
+    /* Per image, the copy's first strip when it was left out of guest
+     * memory: where it went and came from, in which frame, for the strips
+     * that follow. */
+    u32 skip_ea[2], skip_loc[2], skip_src[2], skip_frame[2];
+    u32 good_pairs;      /* pairs in a row both passes handled              */
+} s_gb;
+
+void rsx_draw_engine_set_native_ssao(const rsx_native_ssao_desc* desc)
+{
+    memset(&s_nao, 0, sizeof s_nao);
+    __atomic_store_n(&s_nao_live, 0, __ATOMIC_RELEASE);
+    if (desc) s_nao.d = *desc;
+}
+
+const volatile int* rsx_draw_engine_native_ssao_live(void) { return &s_nao_live; }
+
+static void eng_nao_fail(const char* why)
+{
+    s_gb.good_pairs = 0;
+    static int warned;
+    if (warned < 4) { warned++; fprintf(stderr, "[rsx engine] native SSAO: %s; the SPU job does it\n", why); }
+    memset(s_nao.out, 0, sizeof s_nao.out);
+    __atomic_store_n(&s_nao_live, 0, __ATOMIC_RELEASE);
+}
+
+
+static void eng_nlt_fail(const char* why);
+static void eng_nlt_compare(u32 which, const u8* gp, u32 w, u32 h, u32 pitch);
+static int eng_nlt_last_ok(void);
+
+/* SSAO from the frame's normals target and the RGBA8 snapshot of its zeta. */
+static void eng_nao_run(u32 normals, u32 depth, u32 w, u32 h)
+{
+    if (!vm_base || (ppu_vm_size && (u64)s_nao.d.params_ea + 0x140u > ppu_vm_size)) {
+        eng_nao_fail("no parameter block");
+        return;
+    }
+    float pb[80];
+    const u8* bp = vm_base + s_nao.d.params_ea;
+    for (int i = 0; i < 80; i++) {
+        const u32 v = ((u32)bp[4 * i] << 24) | ((u32)bp[4 * i + 1] << 16) |
+                      ((u32)bp[4 * i + 2] << 8) | bp[4 * i + 3];
+        memcpy(&pb[i], &v, 4);
+    }
+    /* Only the words the passes use need to be numbers. */
+    for (int i = 0; i < 80; i++)
+        if ((i < 66 || i == 68 || i == 74) && !isfinite(pb[i])) { eng_nao_fail("a parameter is not a number"); return; }
+    /* The sample tables are the shader's own constants; a block that holds
+     * other ones is not this job's. */
+    static const float tables[36] = {
+        0.0f, 0.360393f, 0.767721f, 0.0606153f, -0.347511f, -0.37089f,
+        0.381673f, -0.488981f, -0.779765f, -0.339852f, 0.021904f, 0.393308f,
+        0.0f, -0.221962f, -0.0020895f, -0.561965f, 0.688986f, 0.221229f,
+        0.682595f, -0.294946f, 0.0797645f, -0.691509f, 0.448074f, 0.250064f,
+        1.0f, 0.906008f, 0.640781f, 0.824937f, 0.63603f, 0.901942f,
+        0.623209f, 0.820917f, 0.620971f, 0.637428f, 0.893728f, 0.884747f };
+    for (int i = 0; i < 36; i++)
+        if (fabsf(pb[4 + i] - tables[i]) > 1e-6f) { eng_nao_fail("the parameter block's sample tables differ"); return; }
+    const float* m = pb + 40;
+    const double a = pb[0], b = pb[1];
+    if (!(a < 0.0) || !(b > 0.0)) { eng_nao_fail("the depth coefficients are out of range"); return; }
+    /* 1/z = a * d24 / (2^24 - 1) + b = k * (d0 - d24): exact where the two
+     * terms cancel, near the far plane. */
+    const double d0 = b * 16777215.0 / -a;
+    if (!(d0 < 2147483647.0)) { eng_nao_fail("the depth coefficients are out of range"); return; }
+    const s32 d0i = (s32)d0;
+    float d0i_bits;
+    memcpy(&d0i_bits, &d0i, 4);
+    const float k[28] = {
+        m[0], m[4], m[8], 0.0f,  m[1], m[5], m[9], 0.0f,  m[2], m[6], m[10], 0.0f,
+        pb[57], pb[58], pb[59], pb[56],
+        pb[60], pb[61], pb[62], pb[63],
+        pb[64], pb[65], pb[68], pb[74],
+        (float)(-a / 16777215.0), (float)(d0 - d0i), d0i_bits, 0.0f };
+    u32 out[3] = { 0, 0, 0 };
+    if (!g.be->native_ssao || g.be->native_ssao(g.be->user, normals, depth, k, out)) {
+        eng_nao_fail("the backend refused");
+        return;
+    }
+    memcpy(s_nao.out, out, sizeof out);
+    s_nao.w = w; s_nao.h = h;
+    s_nao.run_frame = g.frames;
+    if (!s_nao.runs++)
+        fprintf(stderr, "[rsx engine] native SSAO: first GPU run at %ux%u (mode %u)\n",
+                w, h, s_nao.d.mode);
+}
+
+/* Both passes are what the game samples, the latest lighting job's lights
+ * are ones the passes do, and the GPU's lighting was sampled for the last
+ * pair. */
+static int eng_gb_both_live(void)
+{
+    return s_nao.d.mode == 1 && s_nlt.d.mode == 1 && eng_nlt_last_ok() &&
+           __atomic_load_n(&s_nao_live, __ATOMIC_ACQUIRE) &&
+           __atomic_load_n(&s_nlt_live, __ATOMIC_ACQUIRE) &&
+           s_nlt.latch_seq - s_nlt_sub_latch <= 1u;
+}
+
+/* The guest's copies of the G-buffer have no reader left: both SPU jobs that
+ * read them skip their work -- the occlusion kernels while the GPU's
+ * occlusion is sampled, the lighting job while its lights are ones the passes
+ * do -- and the jobs' own transfers of them move nothing (spu_dma_skip_range).
+ * Only after GOOD_PAIRS frames in a row of that: a frame that falls back to
+ * the SPU after the copies were left out lights whatever those addresses last
+ * held -- an old lit result, not a G-buffer -- so the copies stay on through
+ * any unsteady stretch. PS3RECOMP_NATIVE_GBUFFER_COPY=1 keeps copying. */
+static int eng_gb_copy_unneeded(void)
+{
+    enum { GOOD_PAIRS = 8 };
+    static int keep = -1;
+    if (keep < 0) keep = getenv("PS3RECOMP_NATIVE_GBUFFER_COPY") ? 1 : 0;
+    if (keep || s_gb.good_pairs < GOOD_PAIRS || !eng_gb_both_live()) return 0;
+    static u32 skipped;
+    if (!skipped++)
+        fprintf(stderr, "[rsx engine] G-buffer copies left out of guest memory from here on\n");
+    return 1;
+}
+
+int rsx_draw_engine_copy_note(u32 location, u32 offset, u32 dst_ea)
+{
+    if (!g.ready || s_guest_reader) return 0;
+    /* The game copies each 1280-wide image as strips (1024 + 256): a later
+     * strip starts inside the first row of the copy. It only follows the
+     * decision the copy's first strip gets. */
+    for (u32 i = 0; i < 2; i++) {
+        const u32 ea = s_gb.skip_ea[i];
+        if (ea && s_gb.skip_frame[i] == g.frames && dst_ea > ea && dst_ea - ea < s_gb.w[i] * 4u)
+            return location == s_gb.skip_loc[i] && offset - s_gb.skip_src[i] == dst_ea - ea;
+    }
+    const int ao = s_nao.d.mode && (dst_ea == s_nao.d.normals_ea || dst_ea == s_nao.d.depth_ea);
+    const int lt = s_nlt.d.mode && (dst_ea == s_nlt.d.normals_ea || dst_ea == s_nlt.d.depth_ea);
+    if (!ao && !lt) return 0;
+    const u32 which = (ao ? dst_ea == s_nao.d.depth_ea : dst_ea == s_nlt.d.depth_ea) ? 1u : 0u;
+    /* A copy of an image the pair already has, or one in another frame than
+     * the pair's (the other copy of that frame failed or never came), starts
+     * a new pair: a pair never spans frames. */
+    if ((s_gb.have & (1u << which)) || (s_gb.have && s_gb.frame != g.frames))
+        s_gb.have = s_gb.latched = 0;
+    if (!s_gb.have) {
+        s_gb.frame = g.frames;
+        /* Mode 2: the first copy of a frame comes after the last frame's job
+         * has finished, and before either buffer is overwritten. */
+        if (lt && s_nlt.check_w) {
+            const u32 cw = s_nlt.check_w, ch = s_nlt.check_h, cp = s_nlt.check_pitch;
+            s_nlt.check_w = 0;
+            for (u32 k = 0; k < 2; k++) {
+                const u32 kea = k ? s_nlt.d.depth_ea : s_nlt.d.normals_ea;
+                if (vm_base && s_nlt.out[k] && (u64)kea + (u64)cp * ch <= (1ull << 32))
+                    eng_nlt_compare(k, vm_base + kea, cw, ch, cp);
+            }
+        }
+        /* Latching overwrites the images the last pair was lit from. */
+        if (lt) s_nlt.consistent = 0;
+    }
+    const char* why = NULL;
+    u32 src = 0;
+    if (!which) {
+        /* The normals come from a colour target, the newest at that offset. */
+        u32 best = ENG_INVALID, stamp = 0;
+        for (u32 i = 0; i < g.n_surfaces; i++) {
+            const eng_surface* s = &g.surfaces[i];
+            if (!s->handle || s->location != location || s->offset != offset) continue;
+            if (best == ENG_INVALID || s->stamp > stamp) { best = i; stamp = s->stamp; }
+        }
+        const eng_surface* s = best != ENG_INVALID ? &g.surfaces[best] : NULL;
+        if (s && s->fmt == RSX_BE_FMT_R8G8B8A8 && s->guest_raster != 2u &&
+            (s->guest_fmt == ENG_SURF_A8R8G8B8 || s->guest_fmt == ENG_SURF_X8R8G8B8_Z8R8G8B8 ||
+             s->guest_fmt == ENG_SURF_X8R8G8B8_O8R8G8B8)) {
+            s_gb.n_slot = best; s_gb.n_offset = offset; s_gb.normals = src = s->handle;
+            s_gb.w[0] = s->w; s_gb.h[0] = s->h;
+        } else {
+            why = "the normals copy is not from a linear A8R8G8B8 target";
+        }
+    } else {
+        /* The depth is the zeta itself read as A8R8G8B8: D[23:16] in A,
+         * D[15:8] in R, D[7:0] in G. */
+        u32 best = ENG_INVALID, stamp = 0;
+        for (u32 i = 0; i < g.n_zdepths; i++) {
+            const eng_zdepth* z = &g.zdepths[i];
+            if (!z->handle || z->location != location || z->offset != offset ||
+                z->guest_fmt != ENG_SURF_Z24S8)
+                continue;
+            if (best == ENG_INVALID || z->stamp > stamp) { best = i; stamp = z->stamp; }
+        }
+        if (best == ENG_INVALID) why = "the depth copy is not from a Z24S8 depth buffer";
+        else if (!(src = eng_zdepth_snapshot_rgba8(best, 0, 0, 0))) why = "no snapshot of the depth";
+        else {
+            s_gb.z_slot = best; s_gb.depth = src;
+            eng_zdepth_extent(&g.zdepths[best], &s_gb.w[1], &s_gb.h[1]);
+        }
+    }
+    if (why) {
+        if (ao) eng_nao_fail(why);
+        if (lt) eng_nlt_fail(why);
+        s_gb.have = s_gb.latched = 0;
+        s_gb.skip_ea[which] = 0;
+        return 0;
+    }
+    s_gb.have |= 1u << which;
+    if (lt) {
+        if (g.be->native_latch && !g.be->native_latch(g.be->user, which, src)) s_gb.latched |= 1u << which;
+        else eng_nlt_fail("the backend could not keep a G-buffer image");
+    }
+    const int skip = eng_gb_copy_unneeded();
+    s_gb.skip_ea[which] = skip ? dst_ea : 0u;
+    s_gb.skip_loc[which] = location; s_gb.skip_src[which] = offset;
+    s_gb.skip_frame[which] = g.frames;
+    if (s_gb.have != 3u) return skip;
+
+    /* Both are in. The one copied first has to be the same image still. */
+    s_gb.have = 0;
+    const eng_surface* n = s_gb.n_slot < g.n_surfaces ? &g.surfaces[s_gb.n_slot] : NULL;
+    const eng_zdepth* z = s_gb.z_slot < g.n_zdepths ? &g.zdepths[s_gb.z_slot] : NULL;
+    if (!n || n->handle != s_gb.normals || n->offset != s_gb.n_offset || !z ||
+        z->snapshot_rgba != s_gb.depth)
+        why = "a G-buffer image changed between the two copies";
+    else if (s_gb.w[0] != s_gb.w[1] || s_gb.h[0] != s_gb.h[1])
+        why = "normals and depth differ in size";
+    if (why) {
+        if (ao) eng_nao_fail(why);
+        if (lt) eng_nlt_fail(why);
+        s_gb.latched = 0;
+        s_gb.skip_ea[which] = 0;   /* copied whole, its strips with it */
+        return 0;
+    }
+    if (ao) eng_nao_run(s_gb.normals, s_gb.depth, s_gb.w[0], s_gb.h[0]);
+    s_gb.good_pairs = eng_gb_both_live() ? s_gb.good_pairs + 1u : 0u;
+    if (lt && s_gb.latched == 3u) {
+        s_nlt.w = s_gb.w[0]; s_nlt.h = s_gb.h[0];
+        __atomic_store_n(&s_nlt.latch_seq, s_nlt.latch_seq + 1u, __ATOMIC_RELAXED);
+        s_nlt.consistent = 1;
+    }
+    s_gb.latched = 0;
+    return skip;
+}
+
+/* Mode 2: one GPU output against what the SPU job wrote at `gp`, `pitch`
+ * bytes a row, in 8-bit levels. PS3RECOMP_NATIVE_SSAO_DUMP=<dir> writes both
+ * images as PGM. */
+static void eng_nao_compare(u32 out, const u8* gp, u32 w, u32 h, u32 pitch)
+{
+    if (g.tex_staging_cap < w * h) {
+        u8* n = (u8*)realloc(g.tex_staging, w * h);
+        if (!n) return;
+        g.tex_staging = n; g.tex_staging_cap = w * h;
+    }
+    g.be->readback(g.be->user, s_nao.out[out], 0, 0, w, h, g.tex_staging, w);
+    double sum = 0.0, sum_gpu = 0.0, sum_spu = 0.0;
+    u32 worst = 0, over1 = 0, over8 = 0;
+    for (u32 y = 0; y < h; y++)
+        for (u32 x = 0; x < w; x++) {
+            const u32 a = g.tex_staging[(size_t)y * w + x], b = gp[(size_t)y * pitch + x];
+            const u32 d = a > b ? a - b : b - a;
+            over1 += d > 1u; over8 += d > 8u;
+            if (d > worst) worst = d;
+            sum += d; sum_gpu += a; sum_spu += b;
+        }
+    { static const char* dir = (const char*)-1;
+      if (dir == (const char*)-1) dir = getenv("PS3RECOMP_NATIVE_SSAO_DUMP");
+      for (int k = 0; dir && k < 2; k++) {
+          char path[512];
+          snprintf(path, sizeof path, "%s/%s_o%u_%06u.pgm", dir, k ? "spu" : "gpu", out, g.frames);
+          FILE* f = fopen(path, "wb");
+          if (!f) continue;
+          fprintf(f, "P5\n%u %u\n255\n", w, h);
+          for (u32 y = 0; y < h; y++)
+              fwrite(k ? gp + (size_t)y * pitch : g.tex_staging + (size_t)y * w, 1, w, f);
+          fclose(f);
+      } }
+    const double n = (double)w * h;
+    fprintf(stderr, "[rsx engine] native SSAO check frame %u, %s: mean |d| %.4g, max %u, "
+            "%.2f%% over 1, %.2f%% over 8 (gpu mean %.4g, spu mean %.4g)\n",
+            g.frames, out ? "half size" : "occlusion", sum / n, worst,
+            100.0 * over1 / n, 100.0 * over8 / n, sum_gpu / n, sum_spu / n);
+}
+
+/* Mode 2, once a second, when the occlusion texture is bound: by then the
+ * SPU job has written its output, and its scratch after the half-size depth
+ * holds the half-size occlusion as blurred down. */
+static void eng_nao_check(const rsx_dsp_texture* t)
+{
+    if (s_nao.run_frame != g.frames || !g.be->readback ||
+        (s_nao.checked && g.frames - s_nao.checked < 60u))
+        return;
+    s_nao.checked = g.frames;
+    if (!(t->format & RSX_TEX_FMT_LINEAR)) {
+        static int warned;
+        if (!warned) { warned = 1; fprintf(stderr, "[rsx engine] native SSAO: swizzled texture, no check\n"); }
+        return;
+    }
+    const u32 pitch = t->pitch ? t->pitch : t->width;
+    const u8* gp = eng_guest_ptr(NULL, t->location, t->offset, pitch * (t->height - 1u) + t->width);
+    if (gp) eng_nao_compare(0, gp, t->width, t->height, pitch);
+    const u32 hw = (s_nao.w + 1u) / 2u, hh = (s_nao.h + 1u) / 2u;
+    if (vm_base && (!ppu_vm_size || (u64)s_nao.d.half_depth_ea + (u64)hw * hh * 5u <= ppu_vm_size))
+        eng_nao_compare(2, vm_base + s_nao.d.half_depth_ea + hw * hh * 4u, hw, hh, hw);
+}
+
+/* A texture unit that names the job's occlusion or half-size depth. Once the
+ * kernels skip their work the guest bytes there are stale, so while the GPU's
+ * result stands it is the one to sample, and a unit that cannot take it hands
+ * the work back to the SPU from the next frame. */
+static int eng_nao_bind(const rsx_dsp_texture* t, u32* out)
+{
+    const u32 ea = cellGcmResolveLocated(t->location == RSX_LOCATION_LOCAL, t->offset);
+    const int which = ea == s_nao.d.occlusion_ea ? 0 : ea == s_nao.d.half_depth_ea ? 1 : -1;
+    if (which < 0 || !s_nao.out[which]) return 0;
+    const int live = __atomic_load_n(&s_nao_live, __ATOMIC_ACQUIRE);
+    if (!live && g.frames - s_nao.run_frame > 1u) return 0;
+    const u32 base = t->format & RSX_TEX_FMT_BASE_MASK & ~(u32)RSX_TEX_FMT_UNNORM;
+    const u32 w = which ? (s_nao.w + 1u) / 2u : s_nao.w;
+    const u32 h = which ? (s_nao.h + 1u) / 2u : s_nao.h;
+    const int fits = base == (which ? 0x9Cu : 0x81u) && t->width == w && t->height == h && !t->cubemap;
+    static u8 logged[2];
+    if (!logged[which]) {
+        logged[which] = 1;
+        fprintf(stderr, "[rsx engine] native SSAO: %s texture fmt 0x%02X remap 0x%04X %ux%u "
+                "pitch %u%s\n", which ? "half-depth" : "occlusion", t->format, t->remap & 0xFFFFu,
+                t->width, t->height, t->pitch, fits ? "" : " -- does not fit, guest texture kept");
+    }
+    if (!fits) {
+        if (s_nao.d.mode == 1) eng_nao_fail("an occlusion texture is bound in another format or size");
+        return 0;
+    }
+    if (s_nao.d.mode == 2) { if (!which) eng_nao_check(t); return 0; }
+    const u32 v = g.be->surface_view
+        ? g.be->surface_view(g.be->user, s_nao.out[which], t->remap, t->format) : 0;
+    if (!v) { eng_nao_fail("no view of the occlusion image"); return 0; }
+    __atomic_store_n(&s_nao_live, 1, __ATOMIC_RELEASE);
+    *out = v;
+    return 1;
+}
+
+/* ---- native lighting -------------------------------------------------------
+ * rsx_draw_engine_set_native_lighting: the job's tiled lighting on the GPU,
+ * from the same two G-buffer images as the occlusion, and the two textures
+ * the game samples afterwards replaced by the GPU's. */
+void rsx_draw_engine_set_native_lighting(const rsx_native_lighting_desc* desc)
+{
+    memset(&s_nlt, 0, sizeof s_nlt);
+    s_nlt.done_latch = s_nlt.done_job = ~0u;
+    __atomic_store_n(&s_nlt_live, 0, __ATOMIC_RELEASE);
+    __atomic_store_n(&s_nlt_skip, 0, __ATOMIC_RELEASE);
+    if (desc) s_nlt.d = *desc;
+}
+
+const volatile int* rsx_draw_engine_native_lighting_skip(void) { return &s_nlt_skip; }
+
+static void eng_spin_pause(void)
+{
+#if defined(__x86_64__) || defined(__i386__)
+    __builtin_ia32_pause();
+#endif
+}
+
+/* s_nlt_job's lock: SPU threads at job start, the RSX thread when it lights. */
+static int s_nlt_lock;
+static void eng_nlt_lock(void)
+{
+    while (__atomic_exchange_n(&s_nlt_lock, 1, __ATOMIC_ACQUIRE)) eng_spin_pause();
+}
+static void eng_nlt_unlock(void) { __atomic_store_n(&s_nlt_lock, 0, __ATOMIC_RELEASE); }
+
+/* The SPU does the lighting from the next job on, and out[] is not a result
+ * to hand out any more. */
+static void eng_nlt_fail(const char* why)
+{
+    static int warned;
+    if (warned < 8) { warned++; fprintf(stderr, "[rsx engine] native lighting: %s; the SPU job does it\n", why); }
+    eng_nlt_lock();     /* not between a job start's read of live and its store of skip */
+    __atomic_store_n(&s_nlt_live, 0, __ATOMIC_RELEASE);
+    __atomic_store_n(&s_nlt_skip, 0, __ATOMIC_RELEASE);
+    eng_nlt_unlock();
+    s_nlt.done_latch = s_nlt.done_job = ~0u;
+    s_gb.good_pairs = 0;
+}
+
+static u32 eng_be32(const u8* p) { return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3]; }
+
+/* IEEE half to float; infinities and NaNs come out as NaN. */
+static float eng_half(const u8* p)
+{
+    const u32 v = ((u32)p[0] << 8) | p[1];
+    const u32 e = (v >> 10) & 31u, f = v & 1023u;
+    const float m = e == 31u ? NAN : e ? ldexpf(1.0f + (float)f / 1024.0f, (int)e - 15)
+                                       : ldexpf((float)f, -24);
+    return (v & 0x8000u) ? -m : m;
+}
+
+static u32 eng_f2u(float f) { u32 u; memcpy(&u, &f, 4); return u; }
+
+/* The job's parameters, packed for the passes when it loads them (on its
+ * SPU thread) and taken by the RSX thread when the result is sampled. */
+enum { NLT_MAX_LIGHTS = 256, NLT_HEADER = 32, NLT_LIGHT_WORDS = 16, NLT_RECORD = 48,
+       NLT_WORDS = NLT_HEADER + NLT_LIGHT_WORDS * NLT_MAX_LIGHTS + 16 };
+static struct {
+    u32 seq;             /* changes of the published words                  */
+    int last_ok;         /* the latest job's lights are ones the passes do   */
+    u32 skipped_latch;   /* latch_seq when an instance last skipped its work */
+    u32 count;           /* words published, from the last good pack         */
+    u32 words[NLT_WORDS];
+} s_nlt_job;
+
+/* The latest job's lights are ones the passes do. */
+static int eng_nlt_last_ok(void)
+{
+    eng_nlt_lock();
+    const int ok = s_nlt_job.last_ok;
+    eng_nlt_unlock();
+    return ok;
+}
+
+/* Pack the block and its light table into `words`; the word count, or 0 with
+ * `why` set when the passes cannot do this job. */
+static u32 eng_nlt_pack(const u8* pb, u32* words, const char** why)
+{
+    const u32 count = eng_be32(pb + 0x90), table = eng_be32(pb + 0x94);
+    *why = NULL;
+    if (count > NLT_MAX_LIGHTS) { *why = "more than 256 lights"; return 0; }
+    if (count && (!table || (u64)table + (u64)count * NLT_RECORD > (1ull << 32))) {
+        *why = "no light table"; return 0;
+    }
+    const u32 clip = NLT_HEADER + NLT_LIGHT_WORDS * count;
+    memset(words, 0, NLT_HEADER * 4u);
+    for (u32 i = 0; i < 16; i++) {
+        words[i] = eng_be32(pb + 0x10 + 4u * i);
+        words[clip + i] = eng_be32(pb + 0x50 + 4u * i);
+        float a, b;
+        memcpy(&a, &words[i], 4); memcpy(&b, &words[clip + i], 4);
+        if (!isfinite(a) || !isfinite(b)) { *why = "a matrix entry is not a number"; return 0; }
+    }
+    words[16] = eng_be32(pb + 0x98);
+    { float c; memcpy(&c, &words[16], 4);
+      if (!isfinite(c)) { *why = "the colour scale is not a number"; return 0; } }
+    words[17] = count;
+    words[22] = clip;
+    /* A record: position (floats), colour (halves) at +0x0C, kind at +0x14,
+     * inner and outer radius, cone gain and cosine at +0x20, direction at
+     * +0x28, near distance at +0x2E (halves). */
+    for (u32 l = 0; l < count; l++) {
+        const u8* r = vm_base + table + NLT_RECORD * l;
+        u32* row = words + NLT_HEADER + NLT_LIGHT_WORDS * l;
+        float f[16] = { 0 };
+        for (int c = 0; c < 3; c++) { const u32 v = eng_be32(r + 4 * c); memcpy(&f[c], &v, 4); }
+        for (int c = 0; c < 3; c++) f[4 + c] = eng_half(r + 0x0C + 2 * c);
+        for (int c = 0; c < 4; c++) f[7 + c] = eng_half(r + 0x20 + 2 * c);
+        f[11] = eng_half(r + 0x2E);
+        for (int c = 0; c < 3; c++) f[12 + c] = eng_half(r + 0x28 + 2 * c);
+        const u32 kind = eng_be32(r + 0x14);
+        if (kind != 1u && kind != 2u) { *why = "a light of a kind other than point or spot"; return 0; }
+        for (int c = 0; c < 15; c++)
+            if (c != 3 && !isfinite(f[c])) { *why = "a light value is not a number"; return 0; }
+        if (!(f[8] > f[7])) { *why = "a light's outer radius is not beyond its inner one"; return 0; }
+        for (int c = 0; c < 16; c++) row[c] = eng_f2u(f[c]);
+        row[3] = kind;
+    }
+    return clip + 16u;
+}
+
+void rsx_draw_engine_native_lighting_job(const u8* pb)
+{
+    static u32 words[NLT_WORDS];     /* under the lock */
+    if (!s_nlt.d.mode || !vm_base) return;
+    /* Every SPU running the job loads the block. Pack beside the published
+     * words, publish only a good pack, and only when it differs. */
+    const char* why;
+    eng_nlt_lock();
+    const u32 count = eng_nlt_pack(pb, words, &why);
+    if (count) {
+        if (count != s_nlt_job.count || memcmp(words, s_nlt_job.words, count * 4u)) {
+            memcpy(s_nlt_job.words, words, count * 4u);
+            s_nlt_job.count = count;
+            s_nlt_job.seq++;
+        }
+    }
+    s_nlt_job.last_ok = count != 0;
+    /* Skip while the game sampled the GPU's result for this pair of copies
+     * or the last one: a consumer that stopped sampling gets the SPU's again.
+     * Counted in pairs, one a frame of the game's, not in presents. */
+    const u32 latch = __atomic_load_n(&s_nlt.latch_seq, __ATOMIC_RELAXED);
+    const int skip = count && __atomic_load_n(&s_nlt_live, __ATOMIC_ACQUIRE) &&
+                     latch - __atomic_load_n(&s_nlt_sub_latch, __ATOMIC_RELAXED) <= 1u;
+    if (skip) s_nlt_job.skipped_latch = latch;
+    __atomic_store_n(&s_nlt_skip, skip, __ATOMIC_RELEASE);
+    eng_nlt_unlock();
+    if (why) {
+        static int warned;
+        if (warned < 4) { warned++; fprintf(stderr, "[rsx engine] native lighting: %s; the SPU job does that frame\n", why); }
+    }
+}
+
+/* The lighting of the latched images with the latest good job parameters,
+ * computed again only when either changed. 0 when out[] holds it. Refused
+ * when the latest job runs on the SPU (its lights are not ones the passes
+ * do) unless an instance of it already skipped its tiles. */
+static int eng_nlt_compute(void)
+{
+    static u32 words[NLT_WORDS];
+    if (!s_nlt.consistent || !g.be->native_lighting) return -1;
+    eng_nlt_lock();
+    const u32 seq = s_nlt_job.seq, count = s_nlt_job.count;
+    const int usable = count && (s_nlt_job.last_ok || s_nlt_job.skipped_latch == s_nlt.latch_seq);
+    const int stale = seq != s_nlt.done_job || s_nlt.latch_seq != s_nlt.done_latch;
+    if (usable && stale) memcpy(words, s_nlt_job.words, count * 4u);
+    eng_nlt_unlock();
+    if (!usable) return -1;
+    if (!stale && s_nlt.out[0]) return 0;
+    const u32 w = s_nlt.w, h = s_nlt.h;
+    words[24] = w; words[25] = h;
+    words[26] = eng_f2u(1.0f / (float)w); words[27] = eng_f2u(1.0f / (float)h);
+    /* The job takes pixel x of its 1280x720 grid as x / 1280: an image
+     * pixel's centre goes where that grid has it. */
+    words[28] = eng_f2u(0.5f - 0.5f * (float)w / 1280.0f);
+    words[29] = eng_f2u(0.5f - 0.5f * (float)h / 720.0f);
+    u32 out[2] = { 0, 0 };
+    if (g.be->native_lighting(g.be->user, words, count, out)) {
+        memset(s_nlt.out, 0, sizeof s_nlt.out);
+        eng_nlt_fail("the backend refused");
+        return -1;
+    }
+    memcpy(s_nlt.out, out, sizeof out);
+    s_nlt.done_job = seq; s_nlt.done_latch = s_nlt.latch_seq;
+    if (!s_nlt.runs++)
+        fprintf(stderr, "[rsx engine] native lighting: first GPU run at %ux%u, %u lights (mode %u)\n",
+                w, h, words[17], s_nlt.d.mode);
+    return 0;
+}
+
+/* Mode 2: a GPU image against what the SPU job wrote over the copy at `gp`
+ * (A8R8G8B8, `pitch` bytes a row), per byte. */
+static void eng_nlt_compare(u32 which, const u8* gp, u32 w, u32 h, u32 pitch)
+{
+    const u32 bytes = w * h * 4u;
+    if (g.tex_staging_cap < bytes) {
+        u8* nb = (u8*)realloc(g.tex_staging, bytes);
+        if (!nb) return;
+        g.tex_staging = nb; g.tex_staging_cap = bytes;
+    }
+    g.be->readback(g.be->user, s_nlt.out[which], 0, 0, w, h, g.tex_staging, w * 4u);
+    double sum[4] = { 0 }, mg[4] = { 0 }, ms[4] = { 0 };
+    u32 worst[4] = { 0 }, over1 = 0, over4 = 0;
+    for (u32 y = 0; y < h; y++)
+        for (u32 x = 0; x < w; x++) {
+            const u8* q = g.tex_staging + ((size_t)y * w + x) * 4u;      /* R, G, B, A */
+            const u8* gq = gp + (size_t)y * pitch + (size_t)x * 4u;      /* A, R, G, B */
+            const u8 gpu[4] = { q[3], q[0], q[1], q[2] };
+            u32 px = 0;
+            for (int c = 0; c < 4; c++) {
+                const u32 d = gpu[c] > gq[c] ? gpu[c] - gq[c] : gq[c] - gpu[c];
+                sum[c] += d; mg[c] += gpu[c]; ms[c] += gq[c];
+                if (d > worst[c]) worst[c] = d;
+                if (d > px) px = d;
+            }
+            over1 += px > 1u; over4 += px > 4u;
+        }
+    /* PS3RECOMP_NATIVE_LIGHTING_DUMP=<dir>: both images as PAM (R, G, B, A). */
+    { static const char* dir = (const char*)-1;
+      if (dir == (const char*)-1) dir = getenv("PS3RECOMP_NATIVE_LIGHTING_DUMP");
+      for (int k = 0; dir && k < 2; k++) {
+          char path[512];
+          snprintf(path, sizeof path, "%s/%s_%s_%06u.pam", dir, k ? "spu" : "gpu",
+                   which ? "spec" : "diff", g.frames);
+          FILE* f = fopen(path, "wb");
+          if (!f) continue;
+          fprintf(f, "P7\nWIDTH %u\nHEIGHT %u\nDEPTH 4\nMAXVAL 255\nTUPLTYPE RGB_ALPHA\nENDHDR\n", w, h);
+          for (u32 y = 0; y < h; y++)
+              for (u32 x = 0; x < w; x++) {
+                  const u8* q = k ? gp + (size_t)y * pitch + (size_t)x * 4u
+                                  : g.tex_staging + ((size_t)y * w + x) * 4u;
+                  const u8 px[4] = { k ? q[1] : q[0], k ? q[2] : q[1], k ? q[3] : q[2], k ? q[0] : q[3] };
+                  fwrite(px, 1, 4, f);
+              }
+          fclose(f);
+      } }
+    const double np = (double)w * h;
