+    u8 nfree[VK_MAX_MEMORY_TYPES][VK_POOL_CLASSES];
+    struct { VkDeviceMemory m; u8 type, cls; } map[VK_POOL_MAP];   /* pooled blocks */
+    u64 hits, misses;
