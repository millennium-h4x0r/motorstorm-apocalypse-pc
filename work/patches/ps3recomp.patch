+/* ---------------------------------------------------------------------------
+ * Virtual pads: PS3_PAD_FILE[_<n>] and PS3_PAD_SCRIPT
+ *
+ * For unattended runs (menus, races, 4-player split-screen) with no person and
+ * no real controller: up to four pads driven by files and/or a timeline.
+ *
+ * Port assignment. A port is VIRTUAL when PS3_PAD_FILE_<n> is set for it
+ * (PS3_PAD_FILE is an alias for PS3_PAD_FILE_0) or PS3_PAD_SCRIPT names it.
+ * A virtual port is pinned: it is reported connected (GetInfo, GetInfo2,
+ * PeriphGetInfo) from cellPadInit on, whether or not any host pad exists, and
+ * no real pad ever lands on it. Real pads (SDL/XInput device slots 0, 1, ...)
+ * fill the non-virtual ports in ascending order: slot 0 -> the lowest free
+ * port, slot 1 -> the next, and so on. The mapping is by slot, not by which
+ * slots happen to be plugged in, so unplugging one pad never moves another to
+ * a different port. With no virtual ports this is the old slot n = port n.
+ * Port 0 keeps its old fallback: when it is neither virtual nor fed by a real
+ * pad it is still reported connected (keyboard pad, nothing pressed). Any
+ * other port with neither is disconnected.
+ *
+ * Held-state file (PS3_PAD_FILE_<n>=<path>). Re-read on every host poll
+ * (every PAD_POLL_INTERVAL_MS). Whitespace, ',' or '+' separated tokens:
+ *   NAME        held at full pressure. NAME is UP DOWN LEFT RIGHT CROSS CIRCLE
+ *               SQUARE TRIANGLE L1 R1 L2 R2 L3 R3 START SELECT (any case).
+ *   NAME=v      pressure v (0-255); the digital bit is held iff v > 0. Mainly
+ *               for the analog triggers: R2=200 is partial throttle.
+ *   LX=v LY=v RX=v RY=v   sticks, 0-255, 128 centre (0 = left/up).
+ * Missing or empty file = nothing held. On port 0 the file ADDS to the
+ * keyboard pad (replacing it left a person at the window unable to press
+ * anything while a script drove the pad), and a file stick at exactly 128
+ * leaves the keyboard's alone.
+ *
+ * Timeline (PS3_PAD_SCRIPT=<path>). One event per line, '#' comments:
+ *   t=<sec> port=<n|n,m,..|all> <verb> [args]
+ *   hold    <controls> [<seconds>] [polls=N]   press for <seconds> (default
+ *           0.1) AND at least N delivered packets (default 4), then release
+ *   set     <controls>       persistent until changed or released
+ *   release <names>|all      drop from 'set' state and any active hold;
+ *                            'all' also recentres the sticks
+ *   connect | disconnect     hot-plug the virtual port. A port whose first
+ *                            event is 'connect' starts unplugged.
+ * <controls> are the file tokens above. t is seconds since the FIRST
+ * cellPadGetData call (not process start: boot/ELF-load time varies run to
+ * run, the first pad poll is when the title is alive). Events are latched,
+ * not windowed: each fires on the first host poll at or after its t, so a
+ * title that stops polling on a loading screen still gets the press when it
+ * resumes. A hold counts the packets the title actually received on that
+ * port (GetData returning len > 0), so a slow screen cannot eat it. Events of
+ * one port fire in order; a hold whose controls overlap a hold still in
+ * progress -- or one that ended less than VPAD_GAP_PACKETS packets ago --
+ * waits, so two scripted taps of DOWN never merge into one long press.
+ * Every event fired logs "[pad] t=<now> port=<n> <verb> <args> ..." and
+ * every hold end "[pad] t=<now> port=<n> end hold <args> (<k> packets)".
+ * -----------------------------------------------------------------------*/
+
+#define VPAD_PORTS          PAD_MAX_HOST_PORTS
+#define VPAD_MAX_HOLDS      8
+#define VPAD_GAP_PACKETS    2      /* released packets between overlapping holds */
+#define VPAD_DEF_HOLD_S     0.1
+#define VPAD_DEF_MIN_POLLS  4
+
+typedef struct {
+    u16 btns;          /* digital bits held */
+    s16 press[16];     /* per-bit pressure, -1 = full (255) when held */
+    s16 axis[4];       /* LX LY RX RY; -1 = not driven */
+    u16 named_btns;    /* bits mentioned (held or NAME=0), for set/release */
+    u8  named_axes;
+} VpadCtl;
+
+enum { VEV_HOLD, VEV_SET, VEV_RELEASE, VEV_CONNECT, VEV_DISCONNECT };
+
+typedef struct {
+    double  t;
+    int     port, line, kind, release_all, min_polls;
+    double  dur;
+    VpadCtl ctl;
+    char    text[96];      /* verb + args as written, for the log */
+} VpadEvent;
+
+typedef struct {
+    VpadCtl ctl;
+    double  t_end;
+    int     min_polls, delivered;
+    char    text[96];
+} VpadHold;
+
+typedef struct {
+    int      active;       /* pinned virtual port */
+    int      unplugged;
+    char     file[512];
+    VpadCtl  set;
+    VpadHold hold[VPAD_MAX_HOLDS];
+    int      n_hold;
+    u32      gap_mask;     /* controls of holds that just ended */
+    int      gap_left;
+    int      cursor;       /* next index into s_vev to consider */
+    int      last_file_btns;
+} VpadPort;
+
+static VpadPort   s_vp[VPAD_PORTS];
+static VpadEvent* s_vev;
+static int        s_n_vev;
+static int        s_vpad_loaded;
+static int        s_vpad_t0_set;
+static unsigned long long s_vpad_t0;
+static volatile char s_vpad_lock_flag;
+
+static void vpad_lock(void)
+{ while (__atomic_test_and_set(&s_vpad_lock_flag, __ATOMIC_ACQUIRE)) { } }
+static void vpad_unlock(void)
+{ __atomic_clear(&s_vpad_lock_flag, __ATOMIC_RELEASE); }
+
+static const struct { const char* name; u16 bit; } s_vpad_names[] = {
+    {"SELECT", CELL_PAD_CTRL_SELECT}, {"L3", CELL_PAD_CTRL_L3},
+    {"R3", CELL_PAD_CTRL_R3},         {"START", CELL_PAD_CTRL_START},
+    {"UP", CELL_PAD_CTRL_UP},         {"RIGHT", CELL_PAD_CTRL_RIGHT},
+    {"DOWN", CELL_PAD_CTRL_DOWN},     {"LEFT", CELL_PAD_CTRL_LEFT},
+    {"L2", CELL_PAD_CTRL_L2},         {"R2", CELL_PAD_CTRL_R2},
+    {"L1", CELL_PAD_CTRL_L1},         {"R1", CELL_PAD_CTRL_R1},
+    {"TRIANGLE", CELL_PAD_CTRL_TRIANGLE}, {"CIRCLE", CELL_PAD_CTRL_CIRCLE},
+    {"CROSS", CELL_PAD_CTRL_CROSS},   {"SQUARE", CELL_PAD_CTRL_SQUARE},
+};
+static const char* const s_vpad_axis_names[4] = { "LX", "LY", "RX", "RY" };
+
+static int vpad_ieq(const char* a, const char* b, size_t n)
+{
+    for (size_t i = 0; i < n; i++) {
+        char x = a[i], y = b[i];
+        if (x >= 'a' && x <= 'z') x = (char)(x - 32);
+        if (y >= 'a' && y <= 'z') y = (char)(y - 32);
+        if (x != y) return 0;
+        if (!x) return 1;
+    }
+    return 1;
+}
+
+static void vpad_ctl_clear(VpadCtl* c)
+{
+    memset(c, 0, sizeof *c);
+    for (int i = 0; i < 16; i++) c->press[i] = -1;
+    for (int i = 0; i < 4; i++)  c->axis[i] = -1;
+}
+
+static int vpad_bit_index(u16 bit)
+{ int i = 0; while (i < 16 && !(bit & (1u << i))) i++; return i; }
+
+static int vpad_clamp255(long v) { return v < 0 ? 0 : v > 255 ? 255 : (int)v; }
+
+/* One control token into c. 1 = recognised. */
+static int vpad_parse_control(const char* tok, size_t len, VpadCtl* c)
+{
+    const char* eq = memchr(tok, '=', len);
+    size_t nlen = eq ? (size_t)(eq - tok) : len;
+    long v = -1;
+    if (eq) {
+        char num[16]; size_t vl = len - nlen - 1;
+        if (vl == 0 || vl >= sizeof num) return 0;
+        memcpy(num, eq + 1, vl); num[vl] = 0;
+        char* end; v = strtol(num, &end, 0);
+        if (*end) return 0;
+        v = vpad_clamp255(v);
+    }
+    for (int a = 0; a < 4; a++)
+        if (nlen == 2 && vpad_ieq(tok, s_vpad_axis_names[a], 2)) {
+            if (v < 0) return 0;               /* a bare "LX" means nothing */
+            c->axis[a] = (s16)v; c->named_axes |= (u8)(1u << a);
+            return 1;
+        }
+    for (unsigned i = 0; i < sizeof s_vpad_names / sizeof s_vpad_names[0]; i++) {
+        const char* nm = s_vpad_names[i].name;
+        if (strlen(nm) == nlen && vpad_ieq(tok, nm, nlen)) {
+            u16 bit = s_vpad_names[i].bit; int b = vpad_bit_index(bit);
+            c->named_btns |= bit;
+            if (v < 0)       { c->btns |= bit;  c->press[b] = -1; }
+            else if (v > 0)  { c->btns |= bit;  c->press[b] = (s16)v; }
+            else             { c->btns &= (u16)~bit; c->press[b] = 0; }
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int vpad_is_sep(char ch)
+{ return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n' || ch == ',' || ch == '+'; }
+
+/* Pressure word in the host state for a digital bit (NULL: no pressure). */
+static u8* vpad_press_field(PadHostState* hs, int b)
+{
+    switch (1u << b) {
+    case CELL_PAD_CTRL_UP:       return &hs->press_up;
+    case CELL_PAD_CTRL_DOWN:     return &hs->press_down;
+    case CELL_PAD_CTRL_LEFT:     return &hs->press_left;
+    case CELL_PAD_CTRL_RIGHT:    return &hs->press_right;
+    case CELL_PAD_CTRL_L2:       return &hs->trigger_l2;
+    case CELL_PAD_CTRL_R2:       return &hs->trigger_r2;
+    case CELL_PAD_CTRL_L1:       return &hs->press_l1;
+    case CELL_PAD_CTRL_R1:       return &hs->press_r1;
+    case CELL_PAD_CTRL_TRIANGLE: return &hs->press_triangle;
+    case CELL_PAD_CTRL_CIRCLE:   return &hs->press_circle;
+    case CELL_PAD_CTRL_CROSS:    return &hs->press_cross;
+    case CELL_PAD_CTRL_SQUARE:   return &hs->press_square;
+    default:                     return NULL;
+    }
+}
+
+/* Lay c over hs. skip_centre: a stick value of 128 does not override (the
+ * file on port 0 merges with the keyboard that way). */
+static void vpad_overlay(PadHostState* hs, const VpadCtl* c, int skip_centre)
+{
+    for (int b = 0; b < 16; b++) {
+        if (!(c->btns & (1u << b))) continue;
+        hs->buttons |= (u16)(1u << b);
+        u8* pf = vpad_press_field(hs, b);
+        if (pf) *pf = (u8)(c->press[b] >= 0 ? c->press[b] : 255);
+    }
+    u8* ax[4] = { &hs->analog_lx, &hs->analog_ly, &hs->analog_rx, &hs->analog_ry };
+    for (int a = 0; a < 4; a++)
+        if (c->axis[a] >= 0 && !(skip_centre && c->axis[a] == 128)) *ax[a] = (u8)c->axis[a];
+}
+
+static u32 vpad_ctl_mask(const VpadCtl* c)
+{
+    u32 m = c->btns;
+    for (int a = 0; a < 4; a++) if (c->axis[a] >= 0) m |= 1u << (16 + a);
+    return m;
+}
+
+static void vpad_read_file(int port, VpadCtl* out)
+{
+    vpad_ctl_clear(out);
+    VpadPort* vp = &s_vp[port];
+    if (!vp->file[0]) return;
+    char buf[1024]; size_t n = 0;
+    FILE* f = fopen(vp->file, "r");
+    if (f) { n = fread(buf, 1, sizeof buf - 1, f); fclose(f); }
+    buf[n] = 0;
+    for (size_t i = 0; i < n; ) {
+        while (i < n && vpad_is_sep(buf[i])) i++;
+        size_t s = i;
+        while (i < n && !vpad_is_sep(buf[i])) i++;
+        if (i > s) vpad_parse_control(buf + s, i - s, out);
+    }
+    if ((int)out->btns != vp->last_file_btns) {
+        if (port == 0) printf("[cellPad] file pad: buttons 0x%04X\n", out->btns);
+        else           printf("[cellPad] file pad %d: buttons 0x%04X\n", port, out->btns);
+        fflush(stdout);
+        vp->last_file_btns = out->btns;
+    }
+}
+
+/* --- script loading ---------------------------------------------------- */
+
+static void vpad_script_error(const char* path, int line, const char* msg)
+{
+    printf("[pad] script %s:%d: %s -- line ignored\n", path, line, msg);
+    fflush(stdout);
+}
+
+/* Parse one script line; appends one event per named port. */
+static void vpad_parse_line(const char* path, int lineno, char* s, int* cap)
+{
+    char* hash = strchr(s, '#'); if (hash) *hash = 0;
+    double t = -1; u32 ports = 0; int kind = -1;
+    VpadEvent ev; memset(&ev, 0, sizeof ev);
+    vpad_ctl_clear(&ev.ctl);
+    ev.dur = VPAD_DEF_HOLD_S; ev.min_polls = VPAD_DEF_MIN_POLLS; ev.line = lineno;
+    size_t len = strlen(s), i = 0;
+    int any = 0;
+    while (i < len) {
+        while (i < len && (s[i] == ' ' || s[i] == '\t' || s[i] == '\r' || s[i] == '\n')) i++;
+        size_t b = i;
+        while (i < len && !(s[i] == ' ' || s[i] == '\t' || s[i] == '\r' || s[i] == '\n')) i++;
+        if (i == b) break;
+        any = 1;
+        char tok[96]; size_t tl = i - b < sizeof tok - 1 ? i - b : sizeof tok - 1;
+        memcpy(tok, s + b, tl); tok[tl] = 0;
+        if (kind < 0 && !strncmp(tok, "t=", 2)) {
+            char* e; t = strtod(tok + 2, &e);
+            if (*e || t < 0) { vpad_script_error(path, lineno, "bad t="); return; }
+            continue;
+        }
+        if (kind < 0 && !strncmp(tok, "port=", 5)) {
+            const char* p = tok + 5;
+            if (!strcmp(p, "all")) { ports = (1u << VPAD_PORTS) - 1; continue; }
+            while (*p) {
+                char* e; long n = strtol(p, &e, 10);
+                if (e == p || n < 0 || n >= VPAD_PORTS) {
+                    vpad_script_error(path, lineno, "bad port= (0-3, a list, or all)"); return; }
+                ports |= 1u << n; p = e; if (*p == ',') p++;
+            }
+            continue;
+        }
+        if (kind < 0) {
+            if      (vpad_ieq(tok, "hold", 5) || vpad_ieq(tok, "press", 6)) kind = VEV_HOLD;
+            else if (vpad_ieq(tok, "set", 4))        kind = VEV_SET;
+            else if (vpad_ieq(tok, "release", 8))    kind = VEV_RELEASE;
+            else if (vpad_ieq(tok, "connect", 8))    kind = VEV_CONNECT;
+            else if (vpad_ieq(tok, "disconnect", 11)) kind = VEV_DISCONNECT;
+            else { vpad_script_error(path, lineno, "unknown verb"); return; }
+            snprintf(ev.text, sizeof ev.text, "%s", s + b);
+            /* trim trailing whitespace from the logged text */
+            for (size_t k = strlen(ev.text); k && (ev.text[k-1] == ' ' || ev.text[k-1] == '\t' ||
+                 ev.text[k-1] == '\r' || ev.text[k-1] == '\n'); k--) ev.text[k-1] = 0;
+            continue;
+        }
+        /* arguments */
+        if (kind == VEV_HOLD && ((tok[0] >= '0' && tok[0] <= '9') || tok[0] == '.')) {
+            char* e; ev.dur = strtod(tok, &e);
+            if (*e || ev.dur < 0) { vpad_script_error(path, lineno, "bad hold duration"); return; }
+            continue;
+        }
+        if (kind == VEV_HOLD && !strncmp(tok, "polls=", 6)) {
+            ev.min_polls = atoi(tok + 6); if (ev.min_polls < 1) ev.min_polls = 1;
+            continue;
+        }
+        if (kind == VEV_RELEASE && vpad_ieq(tok, "all", 4)) { ev.release_all = 1; continue; }
+        if (kind == VEV_CONNECT || kind == VEV_DISCONNECT) {
+            vpad_script_error(path, lineno, "connect/disconnect take no arguments"); return; }
+        /* control tokens, '+' joins several: CROSS+START */
+        int ok = 1;
+        for (size_t k = 0; k < tl; ) {
+            size_t st = k; while (k < tl && tok[k] != '+') k++;
+            if (k > st && !vpad_parse_control(tok + st, k - st, &ev.ctl)) ok = 0;
+            if (k < tl) k++;
+        }
+        if (!ok) { vpad_script_error(path, lineno, "unknown control"); return; }
+    }
+    if (!any) return;                                     /* blank / comment */
+    if (t < 0)     { vpad_script_error(path, lineno, "missing t=");   return; }
+    if (kind < 0)  { vpad_script_error(path, lineno, "missing verb"); return; }
+    if (!ports) ports = 1;                                /* default port 0 */
+    if (kind == VEV_HOLD && !ev.ctl.btns && !ev.ctl.named_axes) {
+        vpad_script_error(path, lineno, "hold needs a control"); return; }
+    if ((kind == VEV_SET || kind == VEV_RELEASE) && !ev.release_all &&
+        !ev.ctl.named_btns && !ev.ctl.named_axes) {
+        vpad_script_error(path, lineno, "nothing to set/release"); return; }
+    ev.t = t; ev.kind = kind;
+    for (int p = 0; p < VPAD_PORTS; p++) {
+        if (!(ports & (1u << p))) continue;
+        if (s_n_vev == *cap) {
+            int nc = *cap ? *cap * 2 : 64;
+            VpadEvent* ne = (VpadEvent*)realloc(s_vev, (size_t)nc * sizeof *ne);
+            if (!ne) return;
+            s_vev = ne; *cap = nc;
+        }
+        ev.port = p;
+        s_vev[s_n_vev++] = ev;
+    }
+}
+
+static int vpad_ev_cmp(const void* a, const void* b)
+{
+    const VpadEvent* x = (const VpadEvent*)a; const VpadEvent* y = (const VpadEvent*)b;
+    if (x->t < y->t) return -1;
+    if (x->t > y->t) return 1;
+    if (x->line != y->line) return x->line - y->line;   /* stable: file order */
+    return x->port - y->port;
+}
+
+static void vpad_load_script(const char* path)
+{
+    FILE* f = fopen(path, "r");
+    if (!f) { printf("[pad] PS3_PAD_SCRIPT %s: cannot open -- no script\n", path); fflush(stdout); return; }
+    char line[512]; int lineno = 0, cap = 0;
+    while (fgets(line, sizeof line, f)) vpad_parse_line(path, ++lineno, line, &cap);
+    fclose(f);
+    if (s_n_vev > 1) qsort(s_vev, (size_t)s_n_vev, sizeof *s_vev, vpad_ev_cmp);
+    for (int i = 0; i < s_n_vev; i++) s_vp[s_vev[i].port].active = 1;
+    /* A port whose first event is 'connect' starts unplugged. */
+    for (int p = 0; p < VPAD_PORTS; p++)
+        for (int i = 0; i < s_n_vev; i++)
+            if (s_vev[i].port == p) { if (s_vev[i].kind == VEV_CONNECT) s_vp[p].unplugged = 1; break; }
+    printf("[pad] PS3_PAD_SCRIPT %s: %d event(s)\n", path, s_n_vev); fflush(stdout);
+}
+
+/* Read the environment once per process (cellPadEnd + cellPadInit does not
+ * restart the timeline). */
+static void vpad_load(void)
+{
+    if (s_vpad_loaded) return;
+    s_vpad_loaded = 1;
+    for (int p = 0; p < VPAD_PORTS; p++) {
+        char name[32]; snprintf(name, sizeof name, "PS3_PAD_FILE_%d", p);
+        const char* e = getenv(name);
+        if (!e && p == 0) e = getenv("PS3_PAD_FILE");
+        vpad_ctl_clear(&s_vp[p].set);
+        s_vp[p].last_file_btns = -1;
+        if (e && *e) {
+            snprintf(s_vp[p].file, sizeof s_vp[p].file, "%s", e);
+            s_vp[p].active = 1;
+        }
+    }
+    s_vp[0].last_file_btns = 0;   /* port 0 logs like the old PS3_PAD_FILE: first non-empty */
+    const char* sc = getenv("PS3_PAD_SCRIPT");
+    if (sc && *sc) vpad_load_script(sc);
+    int any = 0;
+    for (int p = 0; p < VPAD_PORTS; p++) any |= s_vp[p].active;
+    if (any) {
+        printf("[pad] virtual ports:");
+        for (int p = 0; p < VPAD_PORTS; p++)
+            if (s_vp[p].active)
+                printf(" %d(%s%s%s)", p, s_vp[p].file[0] ? "file" : "",
+                       s_vp[p].file[0] && sc && *sc ? "+" : "",
+                       sc && *sc ? "script" : "");
+        printf("; real pads fill the other ports in slot order\n");
+        fflush(stdout);
+    }
+}
+
+static double vpad_now_s(void)
+{
+    return s_vpad_t0_set ? (double)(pad_now_ms() - s_vpad_t0) / 1000.0 : -1.0;
+}
+
+static void vpad_end_hold(int port, int k, double now)
+{
+    VpadPort* vp = &s_vp[port];
+    VpadHold* h = &vp->hold[k];
+    printf("[pad] t=%.3f port=%d end %s (%d packets)\n", now, port, h->text, h->delivered);
+    fflush(stdout);
+    vp->gap_mask |= vpad_ctl_mask(&h->ctl);
+    vp->gap_left = VPAD_GAP_PACKETS;
+    vp->hold[k] = vp->hold[--vp->n_hold];
+}
+
+static int vpad_hold_conflicts(int port, const VpadCtl* c)
+{
+    VpadPort* vp = &s_vp[port];
+    u32 busy = vp->gap_left > 0 ? vp->gap_mask : 0;
+    for (int k = 0; k < vp->n_hold; k++) busy |= vpad_ctl_mask(&vp->hold[k].ctl);
+    return (vpad_ctl_mask(c) & busy) != 0 || vp->n_hold == VPAD_MAX_HOLDS;
+}
+
+static void vpad_fire(VpadEvent* e, double now)
+{
+    VpadPort* vp = &s_vp[e->port];
+    const char* extra = "";
+    char buf[48] = "";
+    switch (e->kind) {
+    case VEV_HOLD: {
+        VpadHold* h = &vp->hold[vp->n_hold++];
+        h->ctl = e->ctl; h->t_end = now + e->dur;
+        h->min_polls = e->min_polls; h->delivered = 0;
+        snprintf(h->text, sizeof h->text, "%s", e->text);
+        snprintf(buf, sizeof buf, " [%.3fs, >=%d packets]", e->dur, e->min_polls);
+        extra = buf;
+        break; }
+    case VEV_SET:
+        for (int b = 0; b < 16; b++) {
+            if (!(e->ctl.named_btns & (1u << b))) continue;
+            if (e->ctl.btns & (1u << b)) { vp->set.btns |= (u16)(1u << b); vp->set.press[b] = e->ctl.press[b]; }
+            else                         { vp->set.btns &= (u16)~(1u << b); vp->set.press[b] = -1; }
+        }
+        for (int a = 0; a < 4; a++)
+            if (e->ctl.named_axes & (1u << a)) vp->set.axis[a] = e->ctl.axis[a];
+        break;
+    case VEV_RELEASE:
+        if (e->release_all) {
+            vpad_ctl_clear(&vp->set);
+            while (vp->n_hold) vpad_end_hold(e->port, vp->n_hold - 1, now);
+        } else {
+            u16 m = e->ctl.named_btns;
+            vp->set.btns &= (u16)~m;
+            for (int b = 0; b < 16; b++) if (m & (1u << b)) vp->set.press[b] = -1;
+            for (int a = 0; a < 4; a++) if (e->ctl.named_axes & (1u << a)) vp->set.axis[a] = -1;
+            for (int k = vp->n_hold - 1; k >= 0; k--) {
+                VpadCtl* hc = &vp->hold[k].ctl;
+                hc->btns &= (u16)~m;
+                for (int a = 0; a < 4; a++) if (e->ctl.named_axes & (1u << a)) hc->axis[a] = -1;
+                if (!vpad_ctl_mask(hc)) vpad_end_hold(e->port, k, now);
+            }
+        }
+        break;
+    case VEV_CONNECT:    vp->unplugged = 0; break;
+    case VEV_DISCONNECT: vp->unplugged = 1; break;
+    }
+    if (now - e->t > 0.05) {
+        char late[40]; snprintf(late, sizeof late, " (due t=%.3f)", e->t);
+        printf("[pad] t=%.3f port=%d %s%s%s\n", now, e->port, e->text, extra, late);
+    } else {
+        printf("[pad] t=%.3f port=%d %s%s\n", now, e->port, e->text, extra);
+    }
+    fflush(stdout);
+}
+
+/* Expire holds, fire due events, in that order (an expiring hold opens the
+ * gap a queued overlapping hold waits on). Caller holds the lock. */
+static void vpad_tick(void)
+{
+    double now = vpad_now_s();
+    if (now < 0) return;                            /* timeline not started */
+    for (int p = 0; p < VPAD_PORTS; p++) {
+        VpadPort* vp = &s_vp[p];
+        for (int k = vp->n_hold - 1; k >= 0; k--)
+            if (now >= vp->hold[k].t_end && vp->hold[k].delivered >= vp->hold[k].min_polls)
+                vpad_end_hold(p, k, now);
+        while (vp->cursor < s_n_vev) {
+            VpadEvent* e = &s_vev[vp->cursor];
+            if (e->port != p) { vp->cursor++; continue; }
+            if (now < e->t) break;
+            if (e->kind == VEV_HOLD && vpad_hold_conflicts(p, &e->ctl)) break;   /* keeps order */
+            vpad_fire(e, now);
+            vp->cursor++;
+        }
+    }
+}
+
+/* Called once per packet the title received on a port (len > 0). */
+static void vpad_delivered(u32 port)
+{
+    if (port >= VPAD_PORTS || !s_vp[port].active) return;
+    vpad_lock();
+    VpadPort* vp = &s_vp[port];
+    for (int k = 0; k < vp->n_hold; k++) vp->hold[k].delivered++;
+    if (vp->gap_left > 0 && --vp->gap_left == 0) vp->gap_mask = 0;
+    vpad_unlock();
+}
+
+static int pad_port_connected(u32 i)
+{
+    if (i >= PAD_MAX_HOST_PORTS) return 0;
+    if (s_vp[i].active) return !s_vp[i].unplugged;
+    return s_host_state[i].connected || i == 0;   /* port-0 fallback pad */
+}
