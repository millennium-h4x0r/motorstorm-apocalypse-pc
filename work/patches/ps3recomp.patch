+ * `out` tightly packed (`bpp` bytes a texel: 4 for D32 depth, 1 for stencil).
+ * The copy is to a host buffer and waited on. 0 on success, -1 otherwise. */
+static int vk_eng_aspect_readback(u32 depth, VkImageAspectFlags aspect, u32 bpp,
+                                  u32 w, u32 h, void* out)
+{
+    vk_eng_obj* z = vk_eng_get(depth, VK_ENG_DEPTH);
+    if (!z || !out || !(s_vk.depth_aspect & aspect)) return -1;
+    if (!w || !h || w > z->w || h > z->h) return -1;
+    vk_buffer* stp = vk_readback_stage((VkDeviceSize)w * h * bpp);
+    if (!stp) return -1;
+    vk_buffer st = *stp;
+    int rc = -1;
+    if (!vk_op_begin()) {
+        vk_barrier_image(z->im.img, s_vk.depth_aspect, VK_IMAGE_LAYOUT_GENERAL);
+        VkBufferImageCopy r = { .imageSubresource = { aspect, 0, 0, 1 },
+                                .imageExtent = { w, h, 1 } };
+        pvkCmdCopyImageToBuffer(s_vk.cmd, z->im.img, VK_IMAGE_LAYOUT_GENERAL, st.buf, 1, &r);
+        VkBufferMemoryBarrier bb = {
+            .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
+            .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .buffer = st.buf, .offset = 0, .size = VK_WHOLE_SIZE };
+        pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+                              0, 0, NULL, 1, &bb, 0, NULL);
+        if (!vk_flush()) {
+            vk_invalidate(&st);
+            memcpy(out, st.ptr, (size_t)w * h * bpp);
+            rc = 0;
+        }
+    }
+    return rc;
+}
+
+/* rsx_draw_backend.depth_readback: the depth values themselves, for a CPU-side
+ * copy out of the depth buffer (rsx_draw_engine_writeback). 32-bit float depth
+ * only, like the snapshot below. */
+/* The engine's w x h are guest pixels. A scaled target gives one texel of
+ * each N x N block, its middle one: averaging depth or stencil would invent
+ * values no draw wrote. */
+static int vk_eng_aspect_readback_guest(u32 depth, VkImageAspectFlags aspect, u32 bpp,
+                                        u32 w, u32 h, void* out)
+{
+    vk_eng_obj* z = vk_eng_get(depth, VK_ENG_DEPTH);
+    const u32 sc = (z && z->sc > 1) ? z->sc : 1;
+    if (sc == 1) return vk_eng_aspect_readback(depth, aspect, bpp, w, h, out);
+    static u8* big; static size_t big_cap;
+    const size_t need = (size_t)w * sc * h * sc * bpp;
+    if (big_cap < need) {
+        u8* n = (u8*)realloc(big, need);
+        if (!n) return -1;
+        big = n; big_cap = need;
+    }
+    if (vk_eng_aspect_readback(depth, aspect, bpp, w * sc, h * sc, big)) return -1;
+    const size_t row = (size_t)w * sc * bpp;
+    for (u32 y = 0; y < h; y++) {
+        const u8* sr = big + (size_t)(y * sc + sc / 2u) * row + (size_t)(sc / 2u) * bpp;
+        u8* dr = (u8*)out + (size_t)y * w * bpp;
+        for (u32 x = 0; x < w; x++) memcpy(dr + (size_t)x * bpp, sr + (size_t)x * sc * bpp, bpp);
+    }
+    return 0;
+}
+
+static int vk_eng_depth_readback(void* user, u32 depth, u32 w, u32 h, float* out)
+{
+    VK_CS(CS_DEPTH_READBACK);
+    RSX_HS_SCOPE(HS_READBACK);
+    (void)user;
+    if (!vk_depth_is_f32(s_vk.depth_format)) return -1;
+    return vk_eng_aspect_readback_guest(depth, VK_IMAGE_ASPECT_DEPTH_BIT, 4u, w, h, out);
+}
+
+/* rsx_draw_backend.stencil_readback: the stencil bytes, when the depth format
+ * has a stencil. */
+static int vk_eng_stencil_readback(void* user, u32 depth, u32 w, u32 h, u8* out)
+{
+    VK_CS(CS_STENCIL_READBACK);
+    RSX_HS_SCOPE(HS_READBACK);
+    (void)user;
+    return vk_eng_aspect_readback_guest(depth, VK_IMAGE_ASPECT_STENCIL_BIT, 1u, w, h, out);
+}
+
+static u32 vk_eng_texture_create(void* user, rsx_be_format fmt, u32 w, u32 h,
+                                 u32 mips, u32 faces, u32 remap, u32 rsx_fmt);
+static void vk_eng_texture_upload(void* user, u32 texture, u32 face, u32 mip, u32 w, u32 h,
+                                  const void* src, u32 row_bytes, u32 rows);
+
+/* rsx_draw_backend.color_snapshot: a copy of a colour target as it stands now,
+ * for a draw that samples the target it is drawing into (inFAMOUS 2's fog and
+ * composite passes). Without it such a unit fell back to guest memory, which
+ * the GPU never writes, and the pass read black. One texture per target,
+ * refilled on every request and released with the target. */
+static u32 vk_eng_color_snapshot(void* user, u32 surface)
+{
+    VK_CS(CS_COLOR_SNAPSHOT);
+    RSX_HS_SCOPE(HS_SNAP);
+    vk_eng_obj* c = vk_eng_get(surface, VK_ENG_COLOR);
+    if (!c) return 0;
+    u32 snap = c->snap_rgba;
+    vk_eng_obj* t = vk_eng_get(snap, VK_ENG_TEXTURE);
+    if (!t || t->w != c->w || t->h != c->h || t->fmt != c->fmt) {
+        if (t) vk_eng_release(user, snap);
+        c->snap_rgba = 0;
+        snap = vk_eng_alloc();
+        if (!snap) return 0;
+        t = &s_eobj[snap];
+        if (vk_create_image(&t->im, c->fmt, c->w, c->h,
+                            VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                            VK_IMAGE_ASPECT_COLOR_BIT)) {
+            vk_destroy_image(&t->im); memset(t, 0, sizeof *t); return 0;
+        }
+        t->kind = VK_ENG_TEXTURE; t->fmt = c->fmt; t->bpp = c->bpp; t->w = c->w; t->h = c->h;
+        c->snap_rgba = snap;
+    }
+    if (vk_op_begin()) return 0;
+    vk_barrier_image(c->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    vk_barrier_image(t->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    VkImageCopy r = { .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                      .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                      .extent = { c->w, c->h, 1 } };
+    pvkCmdCopyImage(s_vk.cmd, c->im.img, VK_IMAGE_LAYOUT_GENERAL,
+                    t->im.img, VK_IMAGE_LAYOUT_GENERAL, 1, &r);
+    vk_barrier_image(t->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    return vk_op_end() ? 0 : snap;
+}
+
+/* rsx_draw_backend.color_snapshot_rect: the top-left w x h guest pixels of a
+ * colour target as a texture of their own. The RSX samples a texture by its
+ * own size; a title that renders a 1240x776 frame into a 1280x1080 target
+ * and samples it as a 1240x776 texture reads that rectangle, where binding
+ * the whole target would stretch [0, 1] over all of it. One per target,
+ * refilled on request (the engine asks once per change of the target). */
+static u32 vk_eng_color_snapshot_rect(void* user, u32 surface, u32 w, u32 h)
+{
+    VK_CS(CS_COLOR_SNAPSHOT);
+    RSX_HS_SCOPE(HS_SNAP);
+    vk_eng_obj* c = vk_eng_get(surface, VK_ENG_COLOR);
+    if (!c || !w || !h) return 0;
+    const u32 sc = c->sc > 1 ? c->sc : 1;
+    const u32 iw = w * sc, ih = h * sc;
+    if (iw > c->w || ih > c->h) return 0;
+    /* PS3RECOMP_VK_SNAPCACHE=1: four copies a target, one a size. Split-screen
+     * samples one target at two or four view sizes in turn, and a single copy
+     * was made again at each change of size -- 36 image allocations a frame
+     * at 2 players. */
+    static int multi = -1;
+    if (multi < 0) { const char* e = getenv("PS3RECOMP_VK_SNAPCACHE"); multi = e && e[0] == '1'; }
+    u32* slotp = &c->snap_rect;
+    if (multi) {
+        u32* cand[4] = { &c->snap_rect, &c->snap_rect_x[0], &c->snap_rect_x[1], &c->snap_rect_x[2] };
+        int k = 0;
+        for (; k < 4; k++) {
+            const vk_eng_obj* q = vk_eng_get(*cand[k], VK_ENG_TEXTURE);
+            if (q && q->w == iw && q->h == ih && q->fmt == c->fmt) break;
+        }
+        if (k == 4) {
+            for (k = 0; k < 4 && vk_eng_get(*cand[k], VK_ENG_TEXTURE); k++) ;
+            if (k == 4) { k = c->snap_rect_next; c->snap_rect_next = (u8)((k + 1) & 3); }
+        }
+        slotp = cand[k];
+    }
+    u32 snap = *slotp;
+    vk_eng_obj* t = vk_eng_get(snap, VK_ENG_TEXTURE);
+    if (!t || t->w != iw || t->h != ih || t->fmt != c->fmt) {
+        if (t) vk_eng_release(user, snap);
+        *slotp = 0;
+        snap = vk_eng_alloc();
+        if (!snap) return 0;
+        c = vk_eng_get(surface, VK_ENG_COLOR);   /* (the table does not move; kept for clarity) */
+        t = &s_eobj[snap];
+        if (vk_create_image(&t->im, c->fmt, iw, ih,
+                            VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                            VK_IMAGE_ASPECT_COLOR_BIT)) {
+            vk_destroy_image(&t->im); memset(t, 0, sizeof *t); return 0;
+        }
+        t->kind = VK_ENG_TEXTURE; t->fmt = c->fmt; t->bpp = c->bpp; t->w = iw; t->h = ih;
+        *slotp = snap;
+    }
+    if (vk_op_begin()) return 0;
+    vk_barrier_image(c->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    vk_barrier_image(t->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    VkImageCopy r = { .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                      .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                      .extent = { iw, ih, 1 } };
+    pvkCmdCopyImage(s_vk.cmd, c->im.img, VK_IMAGE_LAYOUT_GENERAL,
+                    t->im.img, VK_IMAGE_LAYOUT_GENERAL, 1, &r);
+    vk_barrier_image(t->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    return vk_op_end() ? 0 : snap;
+}
+
+/* rsx_draw_backend.depth_snapshot_rgba8: a depth target as the RSX returns a
+ * Z24S8 buffer sampled through A8R8G8B8 -- r = D[15:8], g = D[7:0], b = stencil,
+ * a = D[23:16] (RPCS3 decode_depth24 / convert_z24x8_to_rgba8). Titles read
+ * depth that way for their own comparisons and reconstruction (inFAMOUS 2's
+ * lighting, fog and shadow passes).
+ *
+ * Built on the GPU: the depth snapshot (R32F) and a copy of the stencil
+ * aspect (R8_UINT) are drawn through a full-screen pass that packs the bytes.
+ * The CPU version it replaces waited on two readbacks per request -- ~8 ms
+ * each, hundreds of them a frame in a pass that samples the zeta it draws
+ * into. One RGBA8 texture per depth target, refilled on request. */
+static u32 vk_eng_depth_snapshot(void* user, u32 depth, u32 w, u32 h);
+
+static struct {
+    int                   tried, ok;
+    VkDescriptorSetLayout set_layout;
+    VkPipelineLayout      pipe_layout;
+    VkDescriptorPool      pool;
+    u32                   sets;
+    VkRenderPass          rp;
+    VkPipeline            pipe;
+    VkShaderModule        vs, fs;
+    vk_image              zero_stencil;     /* 1x1 R8_UINT for a depth with none */
+} s_zc;
+#define VK_ZC_SETS 256u
+
+static const char kZcVS[] =
+    "struct VSOut { float4 pos : SV_Position; };\n"
+    "VSOut main(uint id : SV_VertexID) {\n"
+    "    VSOut o;\n"
+    "    float2 p = float2((id << 1) & 2, id & 2);\n"
+    "    o.pos = float4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+    "    return o;\n"
+    "}\n";
+static const char kZcFS[] =
+    "Texture2D<float> zt : register(t0);\n"
+    "Texture2D<uint>  st : register(t1);\n"
+    "float4 main(float4 pos : SV_Position) : SV_Target {\n"
+    "    int3 p = int3(int2(pos.xy), 0);\n"
+    "    float sc = saturate(zt.Load(p)) * 16777215.0;\n"
+    "    uint v = min((uint)sc + (frac(sc) >= 0.5 ? 1u : 0u), 16777215u);\n"
+    "    uint sw, sh; st.GetDimensions(sw, sh);\n"
+    "    uint s = st.Load(int3(min(p.xy, int2(sw, sh) - 1), 0)) & 255u;\n"
+    "    return float4((float)((v >> 8) & 255u), (float)(v & 255u), (float)s,\n"
+    "                  (float)((v >> 16) & 255u)) / 255.0;\n"
+    "}\n";
+
+static int vk_zc_init(void)
+{
+    if (s_zc.tried) return s_zc.ok ? 0 : -1;
+    s_zc.tried = 1;
+    if (!rsx_hlsl_to_spirv_available()) return -1;
+    static u32 spv[16384];
+    u32 n = 0;
+    char log[512];
+    VkShaderModuleCreateInfo smi = { .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+    if (rsx_hlsl_to_spirv(kZcVS, RSX_SHADER_STAGE_VERTEX, spv, 16384, &n, log, sizeof log)) {
+        VK_LOG("engine: depth-as-RGBA8 VS: %s\n", log); return -1;
+    }
+    smi.codeSize = n * 4u; smi.pCode = spv;
+    if (pvkCreateShaderModule(s_vk.device, &smi, NULL, &s_zc.vs) != VK_SUCCESS) return -1;
+    if (rsx_hlsl_to_spirv(kZcFS, RSX_SHADER_STAGE_FRAGMENT, spv, 16384, &n, log, sizeof log)) {
+        VK_LOG("engine: depth-as-RGBA8 FS: %s\n", log); return -1;
+    }
+    smi.codeSize = n * 4u; smi.pCode = spv;
+    if (pvkCreateShaderModule(s_vk.device, &smi, NULL, &s_zc.fs) != VK_SUCCESS) return -1;
+
+    VkDescriptorSetLayoutBinding b[2] = {
+        { RSX_SPIRV_TEXTURE_BINDING + 0u, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1, VK_SHADER_STAGE_FRAGMENT_BIT, NULL },
+        { RSX_SPIRV_TEXTURE_BINDING + 1u, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1, VK_SHADER_STAGE_FRAGMENT_BIT, NULL },
+    };
+    VkDescriptorSetLayoutCreateInfo lci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+                                            .bindingCount = 2, .pBindings = b };
+    if (pvkCreateDescriptorSetLayout(s_vk.device, &lci, NULL, &s_zc.set_layout) != VK_SUCCESS) return -1;
+    VkPipelineLayoutCreateInfo plci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+                                        .setLayoutCount = 1, .pSetLayouts = &s_zc.set_layout };
+    if (pvkCreatePipelineLayout(s_vk.device, &plci, NULL, &s_zc.pipe_layout) != VK_SUCCESS) return -1;
+    VkDescriptorPoolSize ps = { VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 2u * VK_ZC_SETS };
+    VkDescriptorPoolCreateInfo pci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+                                       .maxSets = VK_ZC_SETS, .poolSizeCount = 1, .pPoolSizes = &ps };
+    if (pvkCreateDescriptorPool(s_vk.device, &pci, NULL, &s_zc.pool) != VK_SUCCESS ||
+        pvkCreateDescriptorPool(s_vk.device, &pci, NULL, &s_park.zc) != VK_SUCCESS) return -1;
+
+    VkAttachmentDescription att = {
+        .format = VK_FORMAT_R8G8B8A8_UNORM, .samples = VK_SAMPLE_COUNT_1_BIT,
+        .loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE, .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+        .stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE, .stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE,
+        .initialLayout = VK_IMAGE_LAYOUT_GENERAL, .finalLayout = VK_IMAGE_LAYOUT_GENERAL };
+    VkAttachmentReference cref = { 0, VK_IMAGE_LAYOUT_GENERAL };
+    VkSubpassDescription sub = { .pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                 .colorAttachmentCount = 1, .pColorAttachments = &cref };
+    VkRenderPassCreateInfo rci = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO,
+                                   .attachmentCount = 1, .pAttachments = &att,
+                                   .subpassCount = 1, .pSubpasses = &sub };
+    if (pvkCreateRenderPass(s_vk.device, &rci, NULL, &s_zc.rp) != VK_SUCCESS) return -1;
+
+    VkPipelineShaderStageCreateInfo st[2] = {
+        { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_VERTEX_BIT,
+          .module = s_zc.vs, .pName = "main" },
+        { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_FRAGMENT_BIT,
+          .module = s_zc.fs, .pName = "main" },
+    };
+    VkPipelineVertexInputStateCreateInfo vi = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+    VkPipelineInputAssemblyStateCreateInfo ia = { .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+                                                  .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST };
+    VkPipelineViewportStateCreateInfo vps = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+                                              .viewportCount = 1, .scissorCount = 1 };
+    VkPipelineRasterizationStateCreateInfo ras = { .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+                                                   .polygonMode = VK_POLYGON_MODE_FILL, .cullMode = VK_CULL_MODE_NONE,
+                                                   .frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE, .lineWidth = 1.0f };
+    VkPipelineMultisampleStateCreateInfo ms = { .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+                                                .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT };
+    VkPipelineColorBlendAttachmentState cba = { .colorWriteMask = 0xFu };
+    VkPipelineColorBlendStateCreateInfo cb = { .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+                                               .attachmentCount = 1, .pAttachments = &cba };
+    VkDynamicState dyn[2] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+    VkPipelineDynamicStateCreateInfo dy = { .sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO,
+                                            .dynamicStateCount = 2, .pDynamicStates = dyn };
+    VkGraphicsPipelineCreateInfo gci = {
+        .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO, .stageCount = 2, .pStages = st,
+        .pVertexInputState = &vi, .pInputAssemblyState = &ia, .pViewportState = &vps,
+        .pRasterizationState = &ras, .pMultisampleState = &ms, .pColorBlendState = &cb,
+        .pDynamicState = &dy, .layout = s_zc.pipe_layout, .renderPass = s_zc.rp, .subpass = 0 };
+    if (pvkCreateGraphicsPipelines(s_vk.device, s_pcache, 1, &gci, NULL, &s_zc.pipe) != VK_SUCCESS)
+        return -1;
+    if (vk_create_image(&s_zc.zero_stencil, VK_FORMAT_R8_UINT, 1, 1,
+                        VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                        VK_IMAGE_ASPECT_COLOR_BIT)) return -1;
+    if (vk_op_begin()) return -1;
+    vk_barrier_image(s_zc.zero_stencil.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    VkClearColorValue zero = { .uint32 = { 0, 0, 0, 0 } };
+    VkImageSubresourceRange r = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    pvkCmdClearColorImage(s_vk.cmd, s_zc.zero_stencil.img, VK_IMAGE_LAYOUT_GENERAL, &zero, 1, &r);
+    vk_op_end();
+    s_zc.ok = 1;
+    return 0;
+}
+
+static void vk_zc_shutdown(void)
+{
+    if (s_zc.pipe) pvkDestroyPipeline(s_vk.device, s_zc.pipe, NULL);
+    if (s_zc.rp) pvkDestroyRenderPass(s_vk.device, s_zc.rp, NULL);
+    if (s_zc.pool) pvkDestroyDescriptorPool(s_vk.device, s_zc.pool, NULL);
+    if (s_park.zc) pvkDestroyDescriptorPool(s_vk.device, s_park.zc, NULL);
+    s_park.zc = VK_NULL_HANDLE; s_park.zcn = 0;
+    if (s_zc.pipe_layout) pvkDestroyPipelineLayout(s_vk.device, s_zc.pipe_layout, NULL);
+    if (s_zc.set_layout) pvkDestroyDescriptorSetLayout(s_vk.device, s_zc.set_layout, NULL);
+    if (s_zc.vs) pvkDestroyShaderModule(s_vk.device, s_zc.vs, NULL);
+    if (s_zc.fs) pvkDestroyShaderModule(s_vk.device, s_zc.fs, NULL);
+    vk_destroy_image(&s_zc.zero_stencil);
+    memset(&s_zc, 0, sizeof s_zc);
+}
+
+/* The stencil aspect of a depth target as an R8_UINT texture (one per
+ * target, refilled), or 0 when the format has none. */
+static u32 vk_eng_stencil_snapshot(void* user, u32 depth, u32 w, u32 h)
+{
+    vk_eng_obj* z = vk_eng_get(depth, VK_ENG_DEPTH);
+    if (!z || !(s_vk.depth_aspect & VK_IMAGE_ASPECT_STENCIL_BIT)) return 0;
+    u32 snap = z->snap_stencil;
+    vk_eng_obj* t = vk_eng_get(snap, VK_ENG_TEXTURE);
+    if (!t || t->w != w || t->h != h) {
+        if (t) vk_eng_release(user, snap);
+        z = vk_eng_get(depth, VK_ENG_DEPTH);
+        z->snap_stencil = 0;
+        snap = vk_eng_alloc();
+        if (!snap) return 0;
+        t = &s_eobj[snap];
+        if (vk_create_image(&t->im, VK_FORMAT_R8_UINT, w, h,
+                            VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                            VK_IMAGE_ASPECT_COLOR_BIT)) {
+            vk_destroy_image(&t->im); memset(t, 0, sizeof *t); return 0;
+        }
+        t->kind = VK_ENG_TEXTURE; t->fmt = VK_FORMAT_R8_UINT; t->bpp = 1; t->w = w; t->h = h;
+        z = vk_eng_get(depth, VK_ENG_DEPTH);
+        z->snap_stencil = snap;
+        if (vk_op_begin()) return 0;
+        vk_barrier_image(t->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+        vk_op_end();
+    }
+    const VkBuffer stb = vk_dev_scratch((VkDeviceSize)w * h);
+    if (!stb) return 0;
+    z = vk_eng_get(depth, VK_ENG_DEPTH);          /* growing it may have flushed */
+    t = vk_eng_get(snap, VK_ENG_TEXTURE);
+    if (!z || !t) return 0;
+    vk_buffer st = { .buf = stb };
+    int rc = vk_op_begin();
+    if (!rc) {
+        vk_dev_scratch_hazard(s_vk.cmd);
+        vk_barrier_image(z->im.img, s_vk.depth_aspect, VK_IMAGE_LAYOUT_GENERAL);
+        vk_barrier_image(t->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+        VkBufferImageCopy out = { .imageSubresource = { VK_IMAGE_ASPECT_STENCIL_BIT, 0, 0, 1 },
+                                  .imageExtent = { w, h, 1 } };
+        pvkCmdCopyImageToBuffer(s_vk.cmd, z->im.img, VK_IMAGE_LAYOUT_GENERAL, st.buf, 1, &out);
+        VkBufferMemoryBarrier bb = {
+            .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
+            .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .buffer = st.buf, .offset = 0, .size = VK_WHOLE_SIZE };
+        pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                              0, 0, NULL, 1, &bb, 0, NULL);
+        VkBufferImageCopy in = { .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                                 .imageExtent = { w, h, 1 } };
+        pvkCmdCopyBufferToImage(s_vk.cmd, st.buf, t->im.img, VK_IMAGE_LAYOUT_GENERAL, 1, &in);
+        rc = vk_op_end();
+    }
+    return rc ? 0 : snap;
+}
+
+static u32 vk_eng_depth_snapshot_rgba8(void* user, u32 depth, u32 w, u32 h)
+{
+    VK_CS(CS_DEPTH_SNAPSHOT_RGBA8);
+    RSX_HS_SCOPE(HS_SNAP);
+    vk_eng_obj* z = vk_eng_get(depth, VK_ENG_DEPTH);
+    if (!z || !vk_depth_is_f32(s_vk.depth_format) || vk_zc_init()) return 0;
+    if (w > z->w) w = z->w;
+    if (h > z->h) h = z->h;
+    if (!w || !h) return 0;
+
+    /* The output first: creating it may release an older one. */
+    u32 snap = z->snap_rgba;
+    vk_eng_obj* o = vk_eng_get(snap, VK_ENG_TEXTURE);
+    if (!o || o->w != w || o->h != h || !o->fb) {
+        if (o) vk_eng_release(user, snap);
+        z = vk_eng_get(depth, VK_ENG_DEPTH);
+        z->snap_rgba = 0;
+        snap = vk_eng_alloc();
+        if (!snap) return 0;
+        o = &s_eobj[snap];
+        /* TRANSFER_SRC: native_latch copies it. */
+        if (vk_create_image(&o->im, VK_FORMAT_R8G8B8A8_UNORM, w, h,
+                            VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                            VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+                            VK_IMAGE_ASPECT_COLOR_BIT)) {
+            vk_destroy_image(&o->im); memset(o, 0, sizeof *o); return 0;
+        }
+        o->kind = VK_ENG_TEXTURE; o->fmt = VK_FORMAT_R8G8B8A8_UNORM; o->bpp = 4; o->w = w; o->h = h;
+        o->readable = 1;
+        VkFramebufferCreateInfo fci = { .sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO,
+                                        .renderPass = s_zc.rp, .attachmentCount = 1,
+                                        .pAttachments = &o->im.view, .width = w, .height = h, .layers = 1 };
+        if (pvkCreateFramebuffer(s_vk.device, &fci, NULL, &o->fb) != VK_SUCCESS) {
+            vk_destroy_image(&o->im); memset(o, 0, sizeof *o); return 0;
+        }
+        /* Into GENERAL now, or not kept: a later call would find it the
+         * right size and use it in a layout it never got. */
+        if (vk_op_begin()) { vk_eng_release(user, snap); return 0; }
+        vk_barrier_image(o->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+        vk_op_end();
+        z = vk_eng_get(depth, VK_ENG_DEPTH);
+        z->snap_rgba = snap;
+    }
+
+    /* PS3RECOMP_ENG_ZVIEW=1: the conversion reads the depth target's own
+     * depth and stencil aspects (texel loads, so the whole image does), not
+     * copies of them through a buffer: at 4K those were 24 ms of GPU a frame. */
+    vk_eng_obj* zt = NULL; VkImageView sview = VK_NULL_HANDLE;
+    { const u32 dv = vk_eng_depth_view_aspect(depth, VK_IMAGE_ASPECT_DEPTH_BIT);
+      const u32 sv = dv && vk_depth_has_stencil(s_vk.depth_format)
+                   ? vk_eng_depth_view_aspect(depth, VK_IMAGE_ASPECT_STENCIL_BIT) : 0;
+      if (dv) {
+          zt = &s_eobj[dv];
+          sview = sv ? s_eobj[sv].im.view : s_zc.zero_stencil.view;
+          o = &s_eobj[snap]; (void)o;
+      } }
+    if (!zt) {
+        const u32 zs = vk_eng_depth_snapshot(user, depth, w, h);
+        zt = vk_eng_get(zs, VK_ENG_TEXTURE);
+        if (!zt) return 0;
+        const u32 ss = vk_eng_stencil_snapshot(user, depth, w, h);
+        vk_eng_obj* sto = vk_eng_get(ss, VK_ENG_TEXTURE);
+        sview = sto ? sto->im.view : s_zc.zero_stencil.view;
+    }
+
+    if (s_zc.sets >= VK_ZC_SETS) vk_flush();
+    VkDescriptorSet set = VK_NULL_HANDLE;
+    VkDescriptorSetAllocateInfo dai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+                                        .descriptorPool = s_zc.pool, .descriptorSetCount = 1,
+                                        .pSetLayouts = &s_zc.set_layout };
+    if (pvkAllocateDescriptorSets(s_vk.device, &dai, &set) != VK_SUCCESS) return 0;
+    s_zc.sets++;
+    VkDescriptorImageInfo ii[2] = {
+        { VK_NULL_HANDLE, zt->im.view, VK_IMAGE_LAYOUT_GENERAL },
+        { VK_NULL_HANDLE, sview, VK_IMAGE_LAYOUT_GENERAL },
+    };
+    VkWriteDescriptorSet wr[2] = {
+        { .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = set,
+          .dstBinding = RSX_SPIRV_TEXTURE_BINDING + 0u, .descriptorCount = 1,
+          .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, .pImageInfo = &ii[0] },
+        { .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = set,
+          .dstBinding = RSX_SPIRV_TEXTURE_BINDING + 1u, .descriptorCount = 1,
+          .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, .pImageInfo = &ii[1] },
+    };
+    pvkUpdateDescriptorSets(s_vk.device, 2, wr, 0, NULL);
+
+    if (vk_op_begin()) return 0;
+    vk_global_barrier();
+    VkRenderPassBeginInfo rbi = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO,
+                                  .renderPass = s_zc.rp, .framebuffer = o->fb,
+                                  .renderArea = { { 0, 0 }, { w, h } } };
+    pvkCmdBeginRenderPass(s_vk.cmd, &rbi, VK_SUBPASS_CONTENTS_INLINE);
+    pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s_zc.pipe);
+    VkViewport vp = { 0.0f, 0.0f, (float)w, (float)h, 0.0f, 1.0f };
+    VkRect2D sc = { { 0, 0 }, { w, h } };
+    pvkCmdSetViewport(s_vk.cmd, 0, 1, &vp);
+    pvkCmdSetScissor(s_vk.cmd, 0, 1, &sc);
+    pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s_zc.pipe_layout,
+                             0, 1, &set, 0, NULL);
+    pvkCmdDraw(s_vk.cmd, 3, 1, 0, 0);
+    pvkCmdEndRenderPass(s_vk.cmd);
+    return vk_op_end() ? 0 : snap;
+}
+
+/* ---- native ambient occlusion (rsx_draw_backend.native_ssao) -------------
+ * inFAMOUS 2's SSAO job on the GPU, from the two G-buffer images it copies to
+ * main memory: linear depth at half size, 12 occlusion samples a pixel, a
+ * depth-aware 5-tap blur each way, a depth-aware upsample to the 8-bit image
+ * the game samples. The job's parameters of the frame come in as push
+ * constants; its sample tables are fixed (the engine checks them). Distances
+ * the job has in pixels of a 640 wide image scale with the image. Five
+ * fullscreen passes into engine textures, so the engine samples them through
+ * surface_view like any other. */
+#define VK_AO_SETS 64u
+enum { VK_AO_Z, VK_AO_RAW, VK_AO_H, VK_AO_V, VK_AO_FULL, VK_AO_N };
+
+static struct {
+    int                   tried, ok;
+    VkDescriptorSetLayout set_layout;
+    VkPipelineLayout      pipe_layout;
+    VkDescriptorPool      pool;
+    u32                   sets;
+    VkRenderPass          rp_f32, rp_r8;
+    VkShaderModule        vs, fs[VK_AO_N];
+    VkPipeline            pipe[VK_AO_N];
+    u32                   img[VK_AO_N];      /* engine TEXTURE handles */
+    u32                   w, h;              /* of the depth image     */
+} s_ao;
+
+/* rsx_draw_backend.native_ssao's `params`. lin_z: depth packed into A,R,G
+ * of a colour texel as linear depth, 1/z = k * (d0 - d24). The 8-bit stages
+ * store whole levels as level / 255, which UNORM conversion keeps exact (a
+ * half level would be a rounding tie), and read them back rounded. */
+#define VK_AO_COMMON                                                            \
+    "[[vk::push_constant]] cbuffer AoConst {\n"                                 \
+    "    float4 m0, m1, m2;\n"                                                  \
+    "    float4 proj;\n"     /* scale across, down; radius; unoccluded total */ \
+    "    float4 fall;\n"     /* falloff factors; depth clamp near, far       */ \
+    "    float4 post;\n"     /* output scale, bias; blur, upsample weights   */ \
+    "    float4 zlin;\n"     /* k, fraction of d0, d0's integer part (bits)  */ \
+    "};\n"                                                                      \
+    "float lin_z(float4 t) {\n"                                                 \
+    "    int3 b = int3(t.arg * 255.0 + 0.5);\n"                                 \
+    "    int d = (b.x << 16) | (b.y << 8) | b.z;\n"                             \
+    "    return 1.0 / (zlin.x * (float(asint(zlin.z) - d) + zlin.y));\n"       \
+    "}\n"
+
+static const char kAoDownFS[] =
+    VK_AO_COMMON
+    "Texture2D<float4> dt : register(t0);\n"
+    "float4 main(float4 pos : SV_Position) : SV_Target {\n"
+    "    return lin_z(dt.Load(int3(int2(pos.xy) * 2, 0))).xxxx;\n"
+    "}\n";
+
+/* A sample is an offset in the image plane and the height of the sample
+ * sphere there; the sphere keeps its size on screen nearer than the depth
+ * clamp's near end and beyond its far end. */
+static const char kAoOccFS[] =
+    VK_AO_COMMON
+    "Texture2D<float>  zh : register(t0);\n"
+    "Texture2D<float4> nt : register(t1);\n"
+    "static const float SX[12] = { 0.0, 0.360393, 0.767721, 0.0606153, -0.347511, -0.37089,\n"
+    "    0.381673, -0.488981, -0.779765, -0.339852, 0.021904, 0.393308 };\n"
+    "static const float SY[12] = { 0.0, -0.221962, -0.0020895, -0.561965, 0.688986, 0.221229,\n"
+    "    0.682595, -0.294946, 0.0797645, -0.691509, 0.448074, 0.250064 };\n"
+    "static const float SH[12] = { 1.0, 0.906008, 0.640781, 0.824937, 0.63603, 0.901942,\n"
+    "    0.623209, 0.820917, 0.620971, 0.637428, 0.893728, 0.884747 };\n"
+    "float4 main(float4 pos : SV_Position) : SV_Target {\n"
+    "    int2 p = int2(pos.xy);\n"
+    "    uint w, h; zh.GetDimensions(w, h);\n"
+    "    int2 last = int2(w, h) - 1;\n"
+    "    float scale = float(w) / 640.0;\n"
+    "    float z = zh.Load(int3(p, 0));\n"
+    "    float3 n = floor(nt.Load(int3(p * 2, 0)).rgb * 255.0 + 0.5) * (2.007843137 / 256.0) - 1.0;\n"
+    "    float c0 = dot(n, m0.xyz), c1 = dot(n, m1.xyz), c2 = dot(n, m2.xyz);\n"
+    "    float zcl = clamp(z, fall.z, fall.w);\n"
+    "    float s = z / zcl;\n"
+    "    float zref = z + s * c2;\n"
+    "    float total = 0.0;\n"
+    "    [unroll] for (int i = 0; i < 12; ++i) {\n"
+    "        float2 o = float2(proj.x * SX[i] + c0, proj.y * SY[i] + c1) / zcl * scale;\n"
+    "        int2 q = clamp(int2(floor(float2(p) + 0.5 + o)), int2(0, 0), last);\n"
+    "        float hs = SH[i] * proj.z * s;\n"
+    "        float d = 0.5 * (zh.Load(int3(q, 0)) - zref + hs);\n"
+    "        total += clamp(d, 0.0, hs) + hs * saturate(d * fall.x / s + fall.y * s);\n"
+    "    }\n"
+    "    float vis = total / (proj.w * s);\n"
+    "    return (floor(saturate(post.x * vis + post.y) * 255.0) / 255.0).xxxx;\n"
+    "}\n";
+
+/* Binomial weights, cut where the depth differs; taps one pixel apart at 640
+ * wide. AO_DIR is prepended. */
+static const char kAoBlurFS[] =
+    VK_AO_COMMON
+    "Texture2D<float> ao : register(t0);\n"
+    "Texture2D<float> zh : register(t1);\n"
+    "float4 main(float4 pos : SV_Position) : SV_Target {\n"
+    "    const float G[5] = { 1.0, 6.0, 10.0, 6.0, 1.0 };\n"
+    "    int2 p = int2(pos.xy);\n"
+    "    uint w, h; ao.GetDimensions(w, h);\n"
+    "    int2 last = int2(w, h) - 1;\n"
+    "    float scale = float(w) / 640.0;\n"
+    "    float zc = zh.Load(int3(p, 0));\n"
+    "    float num = 0.0, den = 0.0;\n"
+    "    [unroll] for (int t = -2; t <= 2; ++t) {\n"
+    "        int2 q = p + int(round(float(t) * scale)) * AO_DIR;\n"
+    "        if (any(q < 0) || any(q > last)) continue;\n"
+    "        float a = floor(ao.Load(int3(q, 0)) * 255.0 + 0.5);\n"
+    "        float wt = G[t + 2] * saturate(1.0 - post.z * abs(zh.Load(int3(q, 0)) - zc) / zc);\n"
+    "        num += wt * a;\n"
+    "        den += wt;\n"
+    "    }\n"
+    "    return (floor(num / den) / 255.0).xxxx;\n"
+    "}\n";
+
+/* Bilinear weights cut where the depth differs; the nearest texel when no
+ * weight is left. */
+static const char kAoUpFS[] =
+    VK_AO_COMMON
+    "Texture2D<float>  ao : register(t0);\n"
+    "Texture2D<float>  zh : register(t1);\n"
+    "Texture2D<float4> dt : register(t2);\n"
+    "float4 main(float4 pos : SV_Position) : SV_Target {\n"
+    "    int2 p = int2(pos.xy);\n"
+    "    float zf = lin_z(dt.Load(int3(p, 0)));\n"
+    "    uint w, h; ao.GetDimensions(w, h);\n"
+    "    int2 last = int2(w, h) - 1;\n"
+    "    float2 uv = (float2(p) - 0.5) * 0.5;\n"
+    "    int2 b = int2(floor(uv));\n"
+    "    float2 f = uv - float2(b);\n"
+    "    float num = 0.0, den = 0.0, best = 0.0, bestw = -1.0;\n"
+    "    [unroll] for (int i = 0; i < 4; ++i) {\n"
+    "        int2 o = int2(i & 1, i >> 1);\n"
+    "        float wb = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);\n"
+    "        int2 q = clamp(b + o, int2(0, 0), last);\n"
+    "        float a = floor(ao.Load(int3(q, 0)) * 255.0 + 0.5);\n"
+    "        float wt = wb * saturate(1.0 - post.w * abs(zh.Load(int3(q, 0)) - zf) / zf);\n"
+    "        num += wt * a;\n"
+    "        den += wt;\n"
+    "        if (wb > bestw) { bestw = wb; best = a; }\n"
+    "    }\n"
+    "    float v = den > 1e-9 ? num / den : best;\n"
+    "    return (floor(v) / 255.0).xxxx;\n"
+    "}\n";
+
+static int vk_ao_module(const char* what, const char* src, int stage, VkShaderModule* out)
+{
+    static u32 spv[16384];
+    u32 n = 0;
+    char log[512];
+    if (rsx_hlsl_to_spirv(src, stage, spv, 16384, &n, log, sizeof log)) {
+        VK_LOG("engine: native %s shader: %s\n", what, log);
+        return -1;
+    }
+    VkShaderModuleCreateInfo smi = { .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+                                     .codeSize = n * 4u, .pCode = spv };
+    return pvkCreateShaderModule(s_vk.device, &smi, NULL, out) == VK_SUCCESS ? 0 : -1;
+}
+
+static int vk_ao_render_pass(VkFormat fmt, VkRenderPass* out)
+{
+    VkAttachmentDescription att = {
+        .format = fmt, .samples = VK_SAMPLE_COUNT_1_BIT,
+        .loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE, .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+        .stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE, .stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE,
+        .initialLayout = VK_IMAGE_LAYOUT_GENERAL, .finalLayout = VK_IMAGE_LAYOUT_GENERAL };
+    VkAttachmentReference cref = { 0, VK_IMAGE_LAYOUT_GENERAL };
+    VkSubpassDescription sub = { .pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                 .colorAttachmentCount = 1, .pColorAttachments = &cref };
+    VkRenderPassCreateInfo rci = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO,
+                                   .attachmentCount = 1, .pAttachments = &att,
+                                   .subpassCount = 1, .pSubpasses = &sub };
+    return pvkCreateRenderPass(s_vk.device, &rci, NULL, out) == VK_SUCCESS ? 0 : -1;
+}
+
+static int vk_ao_pipeline(VkShaderModule fs, VkRenderPass rp, VkPipeline* out)
+{
+    VkPipelineShaderStageCreateInfo st[2] = {
+        { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_VERTEX_BIT,
+          .module = s_ao.vs, .pName = "main" },
+        { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_FRAGMENT_BIT,
+          .module = fs, .pName = "main" },
+    };
+    VkPipelineVertexInputStateCreateInfo vi = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+    VkPipelineInputAssemblyStateCreateInfo ia = { .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+                                                  .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST };
+    VkPipelineViewportStateCreateInfo vps = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+                                              .viewportCount = 1, .scissorCount = 1 };
+    VkPipelineRasterizationStateCreateInfo ras = { .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+                                                   .polygonMode = VK_POLYGON_MODE_FILL, .cullMode = VK_CULL_MODE_NONE,
+                                                   .frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE, .lineWidth = 1.0f };
+    VkPipelineMultisampleStateCreateInfo ms = { .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+                                                .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT };
+    VkPipelineColorBlendAttachmentState cba = { .colorWriteMask = 0xFu };
+    VkPipelineColorBlendStateCreateInfo cb = { .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+                                               .attachmentCount = 1, .pAttachments = &cba };
+    VkDynamicState dyn[2] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+    VkPipelineDynamicStateCreateInfo dy = { .sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO,
+                                            .dynamicStateCount = 2, .pDynamicStates = dyn };
+    VkGraphicsPipelineCreateInfo gci = {
+        .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO, .stageCount = 2, .pStages = st,
+        .pVertexInputState = &vi, .pInputAssemblyState = &ia, .pViewportState = &vps,
+        .pRasterizationState = &ras, .pMultisampleState = &ms, .pColorBlendState = &cb,
+        .pDynamicState = &dy, .layout = s_ao.pipe_layout, .renderPass = rp, .subpass = 0 };
+    return pvkCreateGraphicsPipelines(s_vk.device, s_pcache, 1, &gci, NULL, out) == VK_SUCCESS ? 0 : -1;
+}
+
+static int vk_ao_init(void)
+{
+    if (s_ao.tried) return s_ao.ok ? 0 : -1;
+    s_ao.tried = 1;
+    if (!rsx_hlsl_to_spirv_available()) return -1;
+    static char blur_h[sizeof kAoBlurFS + 64], blur_v[sizeof kAoBlurFS + 64];
