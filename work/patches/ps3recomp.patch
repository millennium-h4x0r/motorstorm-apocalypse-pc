diff --git a/libs/codec/tests/test_vdec_handles.c b/libs/codec/tests/test_vdec_handles.c
new file mode 100644
index 00000000..ce0d8743
--- /dev/null
+++ b/libs/codec/tests/test_vdec_handles.c
@@ -0,0 +1,160 @@
+/*
+ * ps3recomp -- cellVdec handles, Ex entry points and the picture queue
+ *
+ * MotorStorm Apocalypse plays its intro movies (XviD in AVI) through
+ * cellVdecQueryAttrEx/cellVdecOpenEx and its own statically linked movie
+ * player. Three things kept the first movie from ever advancing:
+ *
+ *   * the Ex entry points were missing, so the title's handle was never set;
+ *   * once they existed, Open handed out handle 0, and the player's DecodeAu
+ *     wrapper (fn 0x9F0990) treats a 0 handle as "no decoder" and returns
+ *     an error without calling cellVdecDecodeAu;
+ *   * one AU decoded before the previous picture was taken overwrote it.
+ *
+ * Checked here (no FFmpeg: the MPEG-4 black-picture queue): Ex works like
+ * the plain forms; handles are never 0 and
+ * round-trip through every call; pictures queue in order, a full queue is
+ * BUSY, an empty one is EMPTY; the callback gets AUDONE then PICOUT with the
+ * handle it was opened with; the error codes are the firmware's.
+ *
+ * Build (from ps3recomp/):
+ *   cc -std=gnu17 -O1 -Iinclude libs/codec/tests/test_vdec_handles.c \
+ *      -lpthread -o /tmp/test_vdec_handles && /tmp/test_vdec_handles
+ */
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <string.h>
+
+uint8_t* vm_base;
+uint32_t ppu_hle_inject_base = 0x00F00000u;
+#include "../cellVdec.c"
+#include "../vdec_ffmpeg.c"
+#include "../ffmpeg_runtime.c"
+
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+unsigned char g_spu_coh_bitmap[1];
+int g_spu_coh_armed;   /* 0: no SPU reservations, so the coherency paths stay cold */
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_coh_notify_write_from_ppu(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+uint64_t spu_lockline_mask_range(uint32_t ea, uint32_t len) { (void)ea; (void)len; return 0; }
+void spu_lockline_lock_mask(uint64_t m) { (void)m; }
+void spu_lockline_unlock_mask(uint64_t m) { (void)m; }
+
+ps3_guest_caller_fn g_ps3_guest_caller;
+
+enum { MEM = 32u << 20, TYPE = 0x1000, ATTR = 0x1100, CB = 0x1200, HOUT = 0x1300,
+       AU = 0x1400, FMT = 0x1500, ITEMP = 0x1600, PIC = 0x100000 };
+
+static u32 msgs[64][3];   /* handle, type, data */
+static unsigned nmsg;
+static void guest_cb(u32 opd, u64 h, u64 type, u64 data, u64 arg,
+                     u64 a, u64 b, u64 c, u64 d)
+{
+    (void)a; (void)b; (void)c; (void)d;
+    assert(opd == 0xC0DE && arg == 0xA5A5);
+    assert(nmsg < 64);
+    msgs[nmsg][0] = (u32)h; msgs[nmsg][1] = (u32)type; msgs[nmsg][2] = (u32)data;
+    nmsg++;
+}
+
+static void au(u32 addr, u64 pts)
+{
+    vm_write32(AU + (u32)offsetof(CellVdecAuInfo, startAddr), addr);
+    vm_write32(AU + (u32)offsetof(CellVdecAuInfo, size), 100);
+    vm_write64(AU + (u32)offsetof(CellVdecAuInfo, pts), pts);
+    vm_write64(AU + (u32)offsetof(CellVdecAuInfo, dts), pts);
+    vm_write64(AU + (u32)offsetof(CellVdecAuInfo, userData), 0);
+}
+
+int main(void)
+{
+    vm_base = calloc(1, MEM);
+    assert(vm_base);
+    g_ps3_guest_caller = guest_cb;
+
+    /* Firmware error codes (RPCS3 cellVdec.h; MotorStorm compares these). */
+    assert(CELL_VDEC_ERROR_BUSY  == 0x80610103u);
+    assert(CELL_VDEC_ERROR_EMPTY == 0x80610104u);
+    assert(CELL_VDEC_ERROR_FATAL == 0x80610180u);
+
+    /* CellVdecTypeEx { codecType = DIVX, profileLevel, codecSpecificInfo }. */
+    vm_write32(TYPE + 0, CELL_VDEC_CODEC_TYPE_DIVX);
+    vm_write32(TYPE + 4, 0);
+    vm_write32(TYPE + 8, 0x2000);
+    assert(cellVdecQueryAttrEx((void*)(uintptr_t)TYPE, (void*)(uintptr_t)ATTR) == CELL_OK);
+    assert(vm_read32(ATTR) != 0 && vm_read8(ATTR + 4) != 0);
+
+    vm_write32(CB + 0, 0xC0DE);
+    vm_write32(CB + 4, 0xA5A5);
+    vm_write32(HOUT, 0xFFFFFFFFu);
+    assert(cellVdecOpenEx((void*)(uintptr_t)TYPE, NULL, (void*)(uintptr_t)CB,
+                          (CellVdecHandle*)(uintptr_t)HOUT) == CELL_OK);
+    const CellVdecHandle h = vm_read32(HOUT);
+    assert(h != 0 && h != 0xFFFFFFFFu);
+    assert(cellVdecStartSeq(0) == (s32)CELL_VDEC_ERROR_ARG);   /* 0 is no handle */
+    assert(cellVdecStartSeq(h) == CELL_OK);
+
+    /* Queue VDEC_BUSY_AT pictures; the next AU is BUSY and fires nothing. */
+    for (u32 i = 0; i < VDEC_BUSY_AT; i++) {
+        au(0x2000 + i, 1000 + i);
+        assert(cellVdecDecodeAu(h, 0, (void*)(uintptr_t)AU) == CELL_OK);
+    }
+    assert(nmsg == 2 * VDEC_BUSY_AT);
+    for (u32 i = 0; i < nmsg; i++) {
+        assert(msgs[i][0] == h);
+        assert(msgs[i][1] == (i & 1 ? CELL_VDEC_MSG_TYPE_PICOUT : CELL_VDEC_MSG_TYPE_AUDONE));
+    }
+    au(0x3000, 5000);
+    assert(cellVdecDecodeAu(h, 0, (void*)(uintptr_t)AU) == (s32)CELL_VDEC_ERROR_BUSY);
+    assert(nmsg == 2 * VDEC_BUSY_AT);
+
+    /* Drain in order: GetPicItem peeks, GetPicture consumes. */
+    vm_write32(FMT + 0, 3);   /* YUV420 planar */
+    vm_write32(FMT + 4, 0);
+    vm_write8 (FMT + 8, 0xFF);
+    for (u32 i = 0; i < VDEC_BUSY_AT; i++) {
+        assert(cellVdecGetPicItem(h, (const CellVdecPicItem**)(uintptr_t)ITEMP) == CELL_OK);
+        const u32 it = vm_read32(ITEMP);
+        assert(vm_read32(it + 0x04) == 0x2000 + i);              /* startAddr */
+        assert(vm_read32(it + 0x14) == 1000 + i);                /* auPts[0].lower */
+        assert(cellVdecGetPicItem(h, (const CellVdecPicItem**)(uintptr_t)ITEMP) == CELL_OK);
+        assert(vm_read32(vm_read32(ITEMP) + 0x04) == 0x2000 + i);   /* not consumed */
+        assert(cellVdecGetPicture(h, (void*)(uintptr_t)FMT, (void*)(uintptr_t)PIC) == CELL_OK);
+    }
+    assert(vm_read8(PIC) == 0x10 && vm_read8(PIC + 1280 * 720) == 0x80);   /* black */
+    assert(cellVdecGetPicture(h, (void*)(uintptr_t)FMT, (void*)(uintptr_t)PIC)
+           == (s32)CELL_VDEC_ERROR_EMPTY);
+    assert(cellVdecGetPicItem(h, (const CellVdecPicItem**)(uintptr_t)ITEMP)
+           == (s32)CELL_VDEC_ERROR_EMPTY);
+
+    /* Room again. */
+    au(0x3000, 5000);
+    assert(cellVdecDecodeAu(h, 0, (void*)(uintptr_t)AU) == CELL_OK);
+
+    nmsg = 0;
+    assert(cellVdecEndSeq(h) == CELL_OK);
+    assert(nmsg == 1 && msgs[0][1] == CELL_VDEC_MSG_TYPE_SEQDONE);
+    assert(cellVdecClose(h) == CELL_OK);
+    assert(cellVdecStartSeq(h) == (s32)CELL_VDEC_ERROR_ARG);
+
+    /* A second decoder gets a different, still non-zero handle. */
+    assert(cellVdecOpenEx((void*)(uintptr_t)TYPE, NULL, (void*)(uintptr_t)CB,
+                          (CellVdecHandle*)(uintptr_t)HOUT) == CELL_OK);
+    const CellVdecHandle h1 = vm_read32(HOUT);
+    assert(cellVdecOpenEx((void*)(uintptr_t)TYPE, NULL, (void*)(uintptr_t)CB,
+                          (CellVdecHandle*)(uintptr_t)HOUT) == CELL_OK);
+    const CellVdecHandle h2 = vm_read32(HOUT);
+    assert(h1 != 0 && h2 != 0 && h1 != h2);
+
+    free(vm_base);
+    puts("test_vdec_handles: ok");
+    return 0;
+}
