+void lv2_spu_load_segments(const lv2_spu_seg* segs, uint32_t nsegs, uint8_t* ls)
+{
+    for (uint32_t i = 0; i < nsegs; i++) {
+        const uint32_t at = segs[i].ls & 0x3FFFF;
+        uint32_t size = segs[i].size;
