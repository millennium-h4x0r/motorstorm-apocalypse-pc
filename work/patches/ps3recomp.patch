+typedef struct ppu_mm { uint8_t* vb; int64_t span; uint32_t poll; } ppu_mm;
+typedef struct ppu_mm_cache { uint8_t* vb; int64_t span; uint32_t poll; int ready; } ppu_mm_cache;
+static ppu_mm_cache ppu_mmc;
+static __attribute__((noinline, cold)) void ppu_mm_fill(void)
+{
+    const uint32_t hi = (ppu_vm_size != 0 && ppu_vm_size < 0xE0000000u) ? ppu_vm_size : 0xE0000000u;
+    const int64_t span = hi > 0x10000u ? (int64_t)(hi - 0x10000u) : 0;
+    ppu_mmc.vb = vm_base;
+    /* One span for loads and stores: the runtime sets the two flags
+     * together, and were they ever to differ, a load going out of line too
+     * would only be slower. */
+    ppu_mmc.span = (vm_inline_ok && vm_inline_st_ok) ? span : 0;
+    ppu_mmc.poll = ppu_hle_inject_base + 0x2008u;   /* the gcm ref-poll word: vm_read32 */
+    __atomic_store_n(&ppu_mmc.ready, 1, __ATOMIC_RELEASE);
