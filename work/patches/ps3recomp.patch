 /*
  * Execute a single DMA transfer between local store and main memory.
  * Returns 0 on success, -1 on error.
  */
+/* SPU_PUT_DUMP=<overlay>,<n>,<dir>: the first n transfers a job running as
+ * that overlay makes, GETs and PUTs in one sequence, each as
+ * <dir>/<k>_<get|put>_<ea>_<lsa>.bin (the bytes after a GET, before a PUT):
+ * what a job reads and what it hands the RSX or the PPU, to decode offline. */
+static inline void spu_dma_dump_note(const spu_context* spu, uint32_t ea, uint32_t lsa, uint32_t size,
+                              int get, const uint8_t* ls_ptr)
+{
+    static int s_ov = -2, s_n; static char s_dir[300]; static int s_k;
+    if (s_ov == -2) { const char* e = getenv("SPU_PUT_DUMP"); s_ov = -1;
+        if (e) { char* c; s_ov = (int)strtol(e, &c, 10);
+                 if (*c == ',') { s_n = (int)strtol(c + 1, &c, 10);
+                                  if (*c == ',') snprintf(s_dir, sizeof s_dir, "%s", c + 1); else s_ov = -1; }
+                 else s_ov = -1; } }
+    if (s_ov < 0 || spu->resident_ovl != s_ov) return;
+    const int k = __atomic_fetch_add(&s_k, 1, __ATOMIC_RELAXED);
+    if (k >= s_n) return;
+    char path[400];
+    /* The context's address names the SPU: several run the same job at once. */
+    snprintf(path, sizeof path, "%s/%05d_c%04X_%s_%08X_%05X.bin", s_dir, k,
+             (unsigned)(((uintptr_t)spu >> 12) & 0xFFFFu), get ? "get" : "put", ea, lsa);
+    FILE* f = fopen(path, "wb"); if (f) { fwrite(ls_ptr, 1, size, f); fclose(f); }
+}
