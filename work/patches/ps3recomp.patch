diff --git a/tools/test_ppu_local_regs.py b/tools/test_ppu_local_regs.py
new file mode 100755
index 00000000..32c6d02d
--- /dev/null
+++ b/tools/test_ppu_local_regs.py
@@ -0,0 +1,350 @@
+#!/usr/bin/env python3
+"""Checks for the PPU lifter's --local-regs pass (localize_ppu_registers).
+
+The pass keeps GPRs, CR, XER, LR and CTR in C locals inside a lifted function
+and syncs them with ctx only around the lines that hand ctx to something else
+(calls, syscalls, HLE, indirect calls) and in front of every exit. A missed
+write-back hands a callee a stale register; a missed reload makes the function
+continue on a value the callee replaced. These tests pin the write-back and
+reload sets on hand-written bodies in the shapes the lifter emits, and build
+and run one body both ways against a mock callee.
+
+Usage:  python3 tools/test_ppu_local_regs.py
+"""
+
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, TOOLS)
+
+from ppu_lifter import LOCAL_REGS_STATS, configure_local_regs, localize_ppu_registers
+
+FAILS = []
+
+
+def check(name, cond, detail=""):
+    print(f"{'ok  ' if cond else 'FAIL'} {name}" + ("" if cond else f": {detail}"))
+    if not cond:
+        FAILS.append(name)
+
+
+def body(*lines):
+    return [ln if ln.endswith(":") and ln.startswith("loc_") else "        " + ln for ln in lines]
+
+
+def line_with(out, needle):
+    return next((i for i, ln in enumerate(out) if needle in ln), None)
+
+
+CALL = "ctx->lr = 0x00010040; func_00020000(ctx); DRAIN_TRAMPOLINE(ctx);"
+
+
+def test_call_sync():
+    out = localize_ppu_registers(body(
+        "ctx->gpr[3] = ctx->gpr[4] + (int64_t)(1);",
+        "ctx->gpr[9] = (int64_t)(int32_t)(5);",
+        CALL,
+        "ctx->gpr[5] = ctx->gpr[3] + ctx->gpr[9];",
+        "return;"))
+    check("declaration first", out[0].strip().startswith("uint64_t _r3 = ctx->gpr[3]"), out[0])
+    k = line_with(out, "func_00020000(ctx)")
+    check("call line kept against ctx", out[k].strip() == CALL, out[k])
+    check("write-back = written registers", out[k - 1].strip() == "ctx->gpr[3] = _r3; ctx->gpr[9] = _r9;", out[k - 1])
+    check("reload = registers live after", out[k + 1].strip() == "_r3 = ctx->gpr[3]; _r9 = ctx->gpr[9];", out[k + 1])
+    r = line_with(out, "return;")
+    check("exit writes back only what is dirty", out[r - 1].strip() == "ctx->gpr[5] = _r5;", out[r - 1])
+    check("pure lines rewritten", "_r5 = _r3 + _r9;" in out[k + 2], out[k + 2])
+
+
+def test_loop_and_cond_exit():
+    out = localize_ppu_registers(body(
+        "loc_00010000:",
+        "ctx->gpr[4] = vm_read8(ctx->gpr[3] + 0x0);",
+        "ctx->gpr[3] = ctx->gpr[3] + (int64_t)(1);",
+        "{ int64_t a = (int32_t)ctx->gpr[4]; int64_t b = (int64_t)0; uint32_t cr_val = "
+        "((a < b) ? 8 : (a > b) ? 4 : 2) | ((ctx->xer >> 31) & 1u); "
+        "ctx->cr = (ctx->cr & ~(0xFu << 28)) | (cr_val << 28); }",
+        "if ((!((ctx->cr >> 29) & 1))) goto loc_00010000;",
+        "if ((--ctx->ctr != 0)) { g_trampoline_fn = (void(*)(void*))func_00030000; return; }",
+        "return;"))
+    text = "\n".join(out)
+    check("no ctx register in the loop", "ctx->gpr[3] +" not in text and "ctx->cr >>" not in text, text)
+    k = line_with(out, "g_trampoline_fn")
+    check("conditional exit writes back r3, r4, cr and the decremented ctr",
+          "ctx->gpr[3] = _r3; ctx->gpr[4] = _r4; ctx->cr = _cr; ctx->ctr = _ctr; g_trampoline_fn" in out[k], out[k])
+    check("ctr decrement on the local", "--_ctr != 0" in out[k], out[k])
+    r = len(out) - 1
+    check("final return writes back ctr too", "ctx->ctr = _ctr;" in out[r - 1], out[r - 1])
+
+
+def test_switch_default():
+    out = localize_ppu_registers(body(
+        "ctx->ctr = ctx->gpr[0];",
+        "switch ((uint32_t)ctx->ctr) { case 0x00010010u: goto loc_00010010;case 0x00010020u: goto loc_00010020;"
+        " default: ps3_indirect_call(ctx); return; } return;",
+        "loc_00010010:",
+        "ctx->gpr[3] = (int64_t)(int32_t)(1);",
+        "return;",
+        "loc_00010020:",
+        "ctx->gpr[3] = (int64_t)(int32_t)(2);",
+        "return;"))
+    k = line_with(out, "switch")
+    check("switch on the local", "switch ((uint32_t)_ctr)" in out[k], out[k])
+    check("default arm writes back first", "default: ctx->ctr = _ctr; ps3_indirect_call(ctx); return;" in out[k], out[k])
+    k2 = line_with(out, "loc_00010010:")
+    check("case target sees ctr dirty", out[k2 + 2].strip() == "ctx->gpr[3] = _r3; ctx->ctr = _ctr;", out[k2 + 2])
+
+
+def test_switch_trampoline_cases():
+    out = localize_ppu_registers(body(
+        "ctx->ctr = ctx->gpr[0];",
+        "switch ((uint32_t)ctx->ctr) { case 0x00010010u: goto loc_00010010;"
+        "case 0x00090000u: { g_trampoline_fn = (void(*)(void*))func_00090000; return; }"
+        " default: ps3_indirect_call(ctx); return; } return;",
+        "loc_00010010:",
+        "return;"))
+    k = line_with(out, "switch")
+    check("trampoline case writes back first",
+          "case 0x00090000u: { ctx->ctr = _ctr; g_trampoline_fn = (void(*)(void*))func_00090000; return; }" in out[k],
+          out[k])
+    check("mixed switch default writes back", "default: ctx->ctr = _ctr; ps3_indirect_call(ctx);" in out[k], out[k])
+
+
+def test_xer_address_and_reads():
+    out = localize_ppu_registers(body(
+        "ctx->gpr[3] = ppc_sraw(&ctx->xer, (int32_t)ctx->gpr[4], 3);",
+        "return;"))
+    check("&ctx->xer becomes &_xer", "ppc_sraw(&_xer, (int32_t)_r4, 3)" in out[1], out[1])
+    check("xer written back after an address-taken use", "ctx->xer = _xer;" in out[2], out[2])
+
+
+def test_unsupported_left_alone():
+    before = LOCAL_REGS_STATS["unsupported"]
+    src = body("ctx->gpr[3] = 1;", "if (ctx->gpr[3])", "    func_00020000(ctx);", "return;")
+    out = localize_ppu_registers(src)
+    check("unknown shape: body unchanged", out == src, out)
+    check("unknown shape: counted", LOCAL_REGS_STATS["unsupported"] == before + 1)
+    src = body("ctx->gpr[3] = 1;", "if (ctx->gpr[3]) { func_00020000(ctx); goto loc_00010000; }", "loc_00010000:", "return;")
+    check("goto out of a sync line: unchanged", localize_ppu_registers(src) == src)
+
+
+def test_no_registers():
+    src = body("vmx_vaddfp(&ctx->vr[0], &ctx->vr[1], &ctx->vr[2], ctx->vscr);", "return;")
+    check("no localizable register: unchanged", localize_ppu_registers(src) == src)
+
+
+# --- build and run one body both ways --------------------------------------
+PRELUDE = r"""
+#include <stdint.h>
+#include <string.h>
+#include <stdio.h>
+typedef struct { uint64_t gpr[32]; uint32_t cr; uint64_t lr, ctr; uint32_t xer; } ppu_context;
+static uint8_t mem[4096];
+static uint8_t vm_read8(uint64_t a) { return mem[a & 4095]; }
+static void vm_write32(uint64_t a, uint32_t v) { memcpy(&mem[a & 4095], &v, 4); }
+static void (*g_trampoline_fn)(void*);
+static uint64_t seen;
+#define DRAIN_TRAMPOLINE(ctx) do { while (g_trampoline_fn) { void(*f)(void*) = g_trampoline_fn; g_trampoline_fn = 0; f(ctx); } } while (0)
+static void func_00020000(ppu_context* c) {
+    for (int i = 0; i < 32; i++) seen = seen * 31 + c->gpr[i];
+    seen = seen * 31 + c->cr + c->xer + c->lr + c->ctr;
+    c->gpr[3] = c->gpr[3] * 3 + 1; c->gpr[4] ^= 0x55; c->gpr[30] += 7; c->cr ^= 0x10000000u; c->ctr = (c->gpr[3] & 1) + 1;
+}
+static void func_00030000(ppu_context* c) { (void)c; }
+"""
+
+BODY = body(
+    "ctx->gpr[30] = ctx->gpr[3] | ctx->gpr[3];",
