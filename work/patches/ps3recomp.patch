+        .bufferOffset = off,
+        .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, mip, 0, 1 },
+        .imageOffset = { 0, 0, (int32_t)z },
+        .imageExtent = { w, h, 1 },
