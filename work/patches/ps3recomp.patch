+/* ---------------------------------------------------------------------------
+ * PS3RECOMP_RSX_SPLIT: the executor (the rsx thread) and the parser thread.
+ * -----------------------------------------------------------------------*/
+
+/* One method record: what the walker's per-word path (or, with no draw engine,
+ * its run path) does with these words, in the same order. */
+static void gcm_split_exec_meth(u32 w, u32 io, const u32* words, u32 n, int legacy_state_live,
+                                int eng, int s1_2d)
+{
+    extern void rsx_raise_user_cmd(u32 arg);
+    const u32 type = w >> 29, method = w & 0x1FFCu, subch = (w >> 13) & 7u;
+    const int to3d = subch == 0 || (subch == 1 && !s1_2d);
+    s_split_exec_io = io;
+    if (!n) return;
+    if (!eng && to3d) {
+        if (type == 0 && rsx_process_vp_run(&s_state, method, (const u8*)words, n)) return;
+        for (u32 i = 0; i < n; i++)
+            gcm_3d_method(&s_state, type == 0 ? method + i * 4 : method, __builtin_bswap32(words[i]),
+                          legacy_state_live);
+        return;
+    }
+    const int vpc_bulk = type == 0 && n >= 3 && (subch == 0 || subch == 1) && method < 0x1F80u &&
+                         method + n * 4u > 0x1F00u && gcm_vpc_bulk_ok(subch);
+    for (u32 i = 0; i < n; i++) {
+        if (vpc_bulk) {
+            const u32 mi = (method + i * 4u) & 0x1FFCu;
+            if (mi >= 0x1F00u && mi < 0x1F80u) {
+                u32 k = (0x1F80u - mi) >> 2;
+                if (k > n - i) k = n - i;
+                if (k >= 2) {
+                    rsx_draw_engine_vp_consts(mi, (const u8*)(words + i), k);
+                    i += k - 1;
+                    continue;
+                }
+            }
+        }
+        const u32 m = (type == 0) ? method + i * 4 : method;
+        const u32 dw = __builtin_bswap32(words[i]);
+        if (subch == 7 && m == 0x0B00u) {
+            rsx_raise_user_cmd(dw);
+            if (s_user_handler_opd) cellGcmQueueUserCommand(dw);
+            continue;
+        }
+        const u32 mfull = (subch << 13) | m;
+        if (eng && (to3d || mfull >= 0xE900u)) rsx_draw_engine_method(mfull, dw);
+        if (mfull == 0xEB00u || mfull == 0xEB04u)      cellGcmQueueUserCommand(dw);
+        else if (mfull == 0xE920u || mfull == 0xE924u) cellGcmSetFlipCommand(dw & 7u);
+        else if (to3d)                                 gcm_3d_method(&s_state, m, dw, legacy_state_live);
+        else                                           gcm_2d_method(subch, m, dw);
+    }
+}
+
+/* PS3RECOMP_RSX_SPLIT_STATS=1: every 5 s, what went through the ring. */
+static u64 s_split_st_recs, s_split_st_words, s_split_st_flips, s_split_st_passes;
+
+/* The executor: replay the ring until it is empty, at a flip (so the present
+ * that follows shows exactly that frame, as when the walker stopped there), or
+ * after about as many words as one walker pass. */
+static void gcm_split_exec_pass(void)
+{
+    static int s1_2d = -1, trace = -1, stats = -1;
+    if (s1_2d < 0) { const char* e = getenv("GCM_SUBCH1_2D"); s1_2d = e ? atoi(e) : 0; }
+    if (trace < 0) trace = getenv("RSX_TRACE") ? 1 : 0;
+    if (stats < 0) stats = getenv("PS3RECOMP_RSX_SPLIT_STATS") ? 1 : 0;
+    const int eng = rsx_draw_engine_enabled();
+    const int legacy_state_live = rsx_get_backend() != NULL || !eng || trace;
+    u64 tail = __atomic_load_n(&s_ring_tail.v, __ATOMIC_ACQUIRE);
+    long budget = 0x100000;
+    int more = 0;
+    s_split_st_passes++;
+    while (s_ring_r != tail) {
+        if (budget <= 0) { more = 1; break; }
+        const u32* r = s_ring + (s_ring_r & s_ring_mask);
+        const u32 type = r[0] >> 24, len = r[0] & 0xFFFFFFu;
+        int flip = 0;
+        switch (type) {
+        case GCM_R_PAD: break;
+        case GCM_R_METH:
+            gcm_split_exec_meth(r[1], r[2], r + 3, len - 3, legacy_state_live, eng, s1_2d);
+            break;
+        case GCM_R_FLIP:
+            gcm_fifo_flip_word(&s_state, r[1]);
+            flip = 1;
+            s_split_st_flips++;
+            break;
+        case GCM_R_REL:
+            atomic_thread_fence(memory_order_release);
+            vm_write32(r[1], r[2]);
+            { static int rn = 0; if (r[3] != 0x400u && PS3_LOG_FIRST(rn, 40))   /* TEMP */
+                fprintf(stderr, "[SEMA-REL] get=0x%08X off=0x%X val=0x%08X\n", r[4], r[3], r[2]); }
+            break;
+        case GCM_R_LABEL:
+            atomic_thread_fence(memory_order_release);
+            vm_write32(r[1], r[2]);
+            break;
+        case GCM_R_REF:      gcm_ref_push_at(r[1], r[2]); break;
+        case GCM_R_RESYNC_M: rsx_process_method(&s_resync_state, r[1], r[2]); break;
+        case GCM_R_FLIP_SKIP:
+            if (s_fifo_flips_reached != s_fifo_flips_queued) s_fifo_flips_reached++;
+            break;
+        case GCM_R_FLIP_ALL: s_fifo_flips_reached = s_fifo_flips_queued; break;
+        default:
+            fprintf(stderr, "[gcm] split ring: bad record 0x%08X at %llu\n", r[0], (unsigned long long)s_ring_r);
+            abort();
+        }
+        s_ring_r += len;
+        budget -= (long)len;
+        s_split_st_recs++; s_split_st_words += len;
+        __atomic_store_n(&s_ring_head.v, s_ring_r, __ATOMIC_RELEASE);
+        if (s_ring_r == tail) tail = __atomic_load_n(&s_ring_tail.v, __ATOMIC_ACQUIRE);
+        /* Stop at the flip, unless more than half the ring is waiting: then the
+         * intermediate presents are frames too far behind to show (the walker's
+         * GCM_FIFO_CATCHUP_BYTES rule). */
+        if (flip && tail - s_ring_r < s_ring_cap / 2) { more = s_ring_r != tail; break; }
+    }
+
+    AcquireSRWLockExclusive(&s_ref_pub_lock);
+    gcm_ref_publish_one();
+    /* As at the end of a walker pass: drained to `put` with no fence left to
+     * publish, ref shows the newest one. */
+    if (!more && s_ring_r == __atomic_load_n(&s_ring_tail.v, __ATOMIC_ACQUIRE) &&
+        __atomic_load_n(&s_split_parser_at_put, __ATOMIC_ACQUIRE) &&
+        s_ref_any && s_ref_qhead == __atomic_load_n(&s_ref_qtail, __ATOMIC_ACQUIRE)) {
+        const u32 want = __atomic_load_n(&s_ref_last, __ATOMIC_ACQUIRE);
+        if (vm_read32(GCM_CONTROL_GUEST_ADDR + 8) != want) {
+            static int n;
+            if (n++ < 8) fprintf(stderr, "[cellGcmSys] ref 0x%08X behind the last fence drained 0x%08X -- published\n",
+                                 vm_read32(GCM_CONTROL_GUEST_ADDR + 8), want);
+            vm_write32(GCM_CONTROL_GUEST_ADDR + 8, want);
+        }
+    }
     ReleaseSRWLockExclusive(&s_ref_pub_lock);
+
+    if (stats) {
+        static unsigned long long t0;
+        const unsigned long long now = ps3_ms_now();
+        if (!t0) t0 = now;
+        if (now - t0 >= 5000u) {
+            const u64 used = __atomic_load_n(&s_ring_tail.v, __ATOMIC_ACQUIRE) - s_ring_r;
+            fprintf(stderr, "[rsx-split] %llu records, %.1f MB, %llu flips, %llu executor passes in %.1f s; "
+                    "%llu parser stalls on a full ring; %.1f MB queued now\n",
+                    (unsigned long long)s_split_st_recs, s_split_st_words * 4.0 / 1048576.0,
+                    (unsigned long long)s_split_st_flips, (unsigned long long)s_split_st_passes,
+                    (now - t0) / 1000.0, (unsigned long long)s_split_stalls, used * 4.0 / 1048576.0);
+            s_split_st_recs = s_split_st_words = s_split_st_flips = s_split_st_passes = 0;
+            s_split_stalls = 0;
+            t0 = now;
+        }
+    }
+
+    /* More to do: no idle wait before the next pass. Empty: ask the parser to
+     * kick when it writes, and look once more (it may have written already). */
+    if (more) { gcm_split_kick(); return; }
+    __atomic_store_n(&s_split_exec_waiting, 1, __ATOMIC_SEQ_CST);
+    if (__atomic_load_n(&s_ring_tail.v, __ATOMIC_SEQ_CST) != s_ring_r) {
+        __atomic_store_n(&s_split_exec_waiting, 0, __ATOMIC_RELAXED);
+        gcm_split_kick();
+    }
+}
