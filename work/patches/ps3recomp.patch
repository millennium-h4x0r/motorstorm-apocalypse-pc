+def localize_ppu_registers(lines: list[str]) -> list[str]:
+    """--local-regs pass over one function body (the lines between the opening
+    and the closing brace, labels unindented). See the comment block above."""
+    try:
+        return _localize_ppu_registers(lines)
+    except _LocalRegsUnsupported as e:
+        LOCAL_REGS_STATS["unsupported"] += 1
+        LOCAL_REGS_STATS["why: " + str(e).split(":")[0]] += 1
+        return lines
+
+
+def _localize_ppu_registers(lines: list[str]) -> list[str]:
+    n = len(lines)
+    kinds = [_lr_classify_cached(line) for line in lines]
+    labels = {k[1]: i for i, k in enumerate(kinds) if k[0] == "label"}
+    for k in kinds:
+        tg = k[1] if k[0] == "pure" else k[2] if k[0] == "switch" else ()
+        if any(x not in labels for x in tg):
+            raise _LocalRegsUnsupported("goto to a missing label: " + str(tg)[:120])
+    END = n
+    succ: list[list[int]] = []
+    use = [0] * n       # registers the line's rewritten part may read
+    maydef = [0] * n
+    mustdef = [0] * n
+    used_all = 0
+    for i, k in enumerate(kinds):
+        kind = k[0]
+        if kind == "label" or kind == "sync":
+            succ.append([i + 1])
+            continue
+        if kind == "exit":
+            succ.append([])
+            continue
+        use[i], maydef[i], mustdef[i], mention = _lr_info(lines[i] if kind == "pure" else k[1], kind == "pure")
+        used_all |= mention
+        if kind == "pure":
+            s = [labels[x] for x in k[1]] if len(k) > 1 else []
+            if len(k) < 3 or k[2]:
+                s.append(i + 1)
+            succ.append(s)
+        elif kind == "cond_exit":
+            succ.append([i + 1])
+        else:  # switch
+            succ.append([labels[x] for x in k[2]])
+    if not used_all:
+        LOCAL_REGS_STATS["no registers"] += 1
+        return lines
+    preds: list[list[int]] = [[] for _ in range(n + 1)]
+    for i, s in enumerate(succ):
+        for j in s:
+            preds[j].append(i)
+
+    # Forward: registers that may be dirty on entry to each line.
+    din = [0] * (n + 1)
+    dout = [0] * n
+    seen = [False] * (n + 1)
+    work = [0]
+    seen[0] = True
+    while work:
+        i = work.pop()
+        if i == END:
+            continue
+        kind = kinds[i][0]
+        out = 0 if kind == "sync" else din[i] | maydef[i]
+        dout[i] = out
+        for j in succ[i]:
+            nv = din[j] | out
+            if nv != din[j] or not seen[j]:
+                din[j] = nv
+                seen[j] = True
+                work.append(j)
+    wb = [0] * (n + 1)
+    for i, k in enumerate(kinds):
+        if not seen[i]:
+            continue
+        if k[0] == "sync" or k[0] == "exit":
+            wb[i] = din[i]
+        elif k[0] in ("cond_exit", "switch"):
+            wb[i] = din[i] | maydef[i]
+    wb[END] = din[END] if seen[END] else 0
+
+    # Backward: registers live on entry to each line.
+    lin = [0] * (n + 1)
+    lin[END] = wb[END]
+    lout = [0] * n
+    work = list(range(n + 1))
+    inq = [True] * (n + 1)
+    while work:
+        i = work.pop()
+        inq[i] = False
+        if i == END:
+            new = wb[END]
+        else:
+            out = 0
+            for j in succ[i]:
+                out |= lin[j]
+            lout[i] = out
+            kind = kinds[i][0]
+            if kind == "sync" or kind == "exit":
+                new = wb[i]
+            elif kind in ("cond_exit", "switch"):
+                new = use[i] | wb[i] | out
+            else:
+                new = use[i] | (out & ~mustdef[i])
+        if new != lin[i]:
+            lin[i] = new
+            for p in preds[i]:
+                if not inq[p]:
+                    inq[p] = True
+                    work.append(p)
+
+    allregs = used_all
+    for i in range(n + 1):
+        allregs |= wb[i]
+    decl = []
+    for ty in ("uint64_t", "uint32_t", "double", "ppu_vr"):
+        parts = [f"{_LR_NAMES[r]} = {_LR_CTX[r]}" for r in range(_LR_NREG)
+                 if allregs >> r & 1 and _LR_TYPES[r] == ty]
+        if parts:
+            decl.append(f"{ty} " + ", ".join(parts) + ";")
+    out_lines = ["    " + " ".join(decl)]
+    LOCAL_REGS_STATS["localized"] += 1
+    for i, line in enumerate(lines):
+        kind = kinds[i][0]
+        ind = line[:len(line) - len(line.lstrip())]
+        if kind == "label":
+            out_lines.append(line)
+        elif kind == "pure":
+            out_lines.append(_lr_rewrite_cached(line))
+        elif kind == "sync":
+            if wb[i]:
+                out_lines.append(ind + _lr_wb(wb[i]))
+            out_lines.append(line)
+            if lout[i]:
+                out_lines.append(ind + _lr_reload(lout[i]))
+        elif kind == "exit":
+            if wb[i]:
+                out_lines.append(ind + _lr_wb(wb[i]))
+            out_lines.append(line)
+        elif kind == "cond_exit":
+            t, comment = _lr_strip_comments(line)
+            cond, rest = _lr_split_if(t)
+            inner = rest[1:-1].strip() if rest.startswith("{") else rest
+            w = _lr_wb(wb[i])
+            out_lines.append(f"{ind}if ({_lr_rewrite(cond)}) {{ {w + ' ' if w else ''}{inner} }}{comment}")
+        else:  # switch
+            t, comment = _lr_strip_comments(line)
+            m = _LR_SWITCH_RE.fullmatch(t)
+            w = _lr_wb(wb[i])
+            cases = m.group("cases")
+            if w:
+                cases = cases.replace("{ g_trampoline_fn = ", "{ " + w + " g_trampoline_fn = ")
+            new = (t[:m.start("expr")] + _lr_rewrite(m.group("expr")) + t[m.end("expr"):m.start("cases")]
+                   + cases + t[m.end("cases"):m.start("dflt")] + (w + " " if w else "") + t[m.start("dflt"):])
+            out_lines.append(ind + new + comment)
+    if seen[END] and wb[END]:
+        out_lines.append("    " + _lr_wb(wb[END]))
+    for on, bit, sr in ((_LR_SPLIT_CR, 32, _SPLIT_CR), (_LR_SPLIT_XER, 33, _SPLIT_XER)):
+        if on and allregs >> bit & 1:
+            try:
+                out_lines = _lr_split(sr, out_lines)
+                LOCAL_REGS_STATS[f"split {sr.name[1:]}"] += 1
+            except _LocalRegsUnsupported as e:
+                LOCAL_REGS_STATS[f"split {sr.name[1:]} refused: " + str(e).split(":")[0]] += 1
+    return out_lines
+
