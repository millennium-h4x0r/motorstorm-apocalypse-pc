+      if ((++tot & 255) == 0) { LARGE_INTEGER t; QueryPerformanceCounter(&t);
+          fprintf(stderr, "[cellSpurs] LFQueuePush total=%lu after %.1fs\n", tot,
+                  (double)(t.QuadPart - t0.QuadPart) / (double)fq.QuadPart); } }
