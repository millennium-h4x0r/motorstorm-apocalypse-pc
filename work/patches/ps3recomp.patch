+/* IEEE half from float, round to nearest even (clear values). */
+static u16 vk_f2h(float f)
+{
+    u32 x; memcpy(&x, &f, 4);
+    const u32 sign = (x >> 16) & 0x8000u;
+    const int e = (int)((x >> 23) & 0xFF) - 127 + 15;
+    u32 m = x & 0x7FFFFFu;
+    if (((x >> 23) & 0xFF) == 0xFF) return (u16)(sign | 0x7C00u | (m ? 0x200u : 0u));
+    if (e >= 31) return (u16)(sign | 0x7C00u);
+    if (e <= 0) {
+        if (e < -10) return (u16)sign;
+        m |= 0x800000u;
+        const u32 sh = (u32)(14 - e), r = m >> sh, rem = m & ((1u << sh) - 1u), half = 1u << (sh - 1);
+        return (u16)(sign | (r + (rem > half || (rem == half && (r & 1u)))));
+    }
+    u32 r = ((u32)e << 10) | (m >> 13);
+    const u32 rem = m & 0x1FFFu;
+    r += rem > 0x1000u || (rem == 0x1000u && (r & 1u));
+    return (u16)(sign | r);
