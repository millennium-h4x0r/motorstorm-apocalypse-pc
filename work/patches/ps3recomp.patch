+/* PS3_CAUSAL_MAIN_US / PS3_CAUSAL_RSX_US (experiments, causal profiling):
+ * spin that many microseconds once a frame on the thread that requests the
+ * flip / presents it. If the frame time grows by the same amount, that
+ * thread is on the frame's critical path. */
+void ps3_causal_spin(const char* var, int* cache)
+{
+    if (*cache < 0) { const char* e = getenv(var); *cache = e ? atoi(e) : 0; }
+    if (*cache <= 0) return;
+    struct timespec t0, t; clock_gettime(CLOCK_MONOTONIC, &t0);
+    do { clock_gettime(CLOCK_MONOTONIC, &t); }
+    while ((t.tv_sec - t0.tv_sec) * 1000000000LL + (t.tv_nsec - t0.tv_nsec) < (long long)*cache * 1000LL);
+}
