+        for (int i = 0; i < done && pop_waiting > 0 && pop_busy + pop_woken <= 15; i++) {
+            const u16 head = (u16)((pw >> 10) & 31);
+            wake_ids[nwake++] = ef_r16(lfq_id_addr(q + LFQ_POP_W, head));
+            pw = lfq_wake_next(pw);
