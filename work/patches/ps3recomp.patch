+    "static const uint MASK_WORDS = 8, TILE_WORDS = 16, TILE_ANY = 8, TILE_LIT = 9;\n"
+    "static const uint SKY = 0xFFFFFF;\n"
+    "\n"
+    "float P(uint i) { return asfloat(words[i]); }\n"
+    "float4 P4(uint i) { return float4(P(i), P(i + 1), P(i + 2), P(i + 3)); }\n"
+    "int img_w() { return int(words[24]); }\n"
+    "int img_h() { return int(words[25]); }\n"
+    "uint light_count() { return min(words[17], MASK_WORDS * 32); }\n"
+    "\n"
+    "float3 view_position(int2 px, uint d24)\n"
+    "{\n"
+    "    float x = (float(px.x) + P(28)) * P(26), y = (float(px.y) + P(29)) * P(27);\n"
+    "    float4 p = P4(0) * x + P4(4) * y + P4(8) * (float(d24) * exp2(-24.0)) + P4(12);\n"
+    "    return p.xyz / p.w;\n"
