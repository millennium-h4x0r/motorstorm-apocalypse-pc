+        b[4 + i] = (VkDescriptorSetLayoutBinding){ 6u + i, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1,
+                                                   VK_SHADER_STAGE_COMPUTE_BIT, NULL };
