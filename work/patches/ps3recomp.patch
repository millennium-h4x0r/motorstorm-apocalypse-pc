+    u32 cls = 0;
+    while (cls < VK_POOL_CLASSES - 1u && ((VkDeviceSize)256u << 10 << cls) < mai->allocationSize) cls++;
+    const VkDeviceSize size = (VkDeviceSize)256u << 10 << cls;
