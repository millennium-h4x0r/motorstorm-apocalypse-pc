+static void bq_textures(u32 op, u32 n, const u32* textures, const rsx_be_sampler_desc* samplers, u32 mask)
+{
+    u8* p = BQ_P(bq_reserve(op, 16u + n * 4u + (samplers ? n * (u32)sizeof *samplers : 0u)));
+    u32* a = (u32*)p;
+    a[0] = mask; a[1] = samplers != NULL; a[2] = n;
+    u32* t = a + 4;
+    /* Only the units the mask names are read; the rest are left as they are. */
+    for (u32 u = 0; u < n; u++) t[u] = ((mask >> u) & 1u) ? textures[u] : 0;
+    if (samplers) memcpy(p + 16 + (size_t)n * 4u, samplers, (size_t)n * sizeof *samplers);
+}
+/* The same binding as the last one: the backend reads only the units in the
+ * mask, their textures and (when given) their samplers. */
+static int bq_tex_same(u32 n, u32* have_mask, u32* have_samp, u32* tex, rsx_be_sampler_desc* samp,
+                       const u32* textures, const rsx_be_sampler_desc* samplers, u32 mask, u32 bit)
+{
+    if (!bq_s_on()) return 0;
+    int same = (S.have & bit) && *have_mask == mask && *have_samp == (samplers != NULL);
+    for (u32 u = 0; u < n && same; u++)
+        if ((mask >> u) & 1u)
+            same = tex[u] == textures[u] && (!samplers || !memcmp(&samp[u], &samplers[u], sizeof *samplers));
+    if (same) return bq_elide();
+    *have_mask = mask; *have_samp = samplers != NULL;
+    for (u32 u = 0; u < n; u++) {
+        tex[u] = ((mask >> u) & 1u) ? textures[u] : 0;
+        if (samplers) samp[u] = samplers[u];
+    }
+    S.have |= bit;
+    return 0;
+}
+static void t_bind_textures(void* user, const u32* textures, const rsx_be_sampler_desc* samplers, u32 mask)
+{
+    (void)user;
+    if (!bq_async()) { bq_direct_begin(); Q.be->bind_textures(U, textures, samplers, mask); bq_direct_end(); return; }
+    if (bq_tex_same(RSX_BE_MAX_TEXTURES, &S.tex_mask, &S.tex_samp, S.tex, S.samp,
+                    textures, samplers, mask, BQ_S_TEX)) return;
+    bq_textures(OP_TEX, RSX_BE_MAX_TEXTURES, textures, samplers, mask);
+}
+static void t_bind_vtextures(void* user, const u32* textures, const rsx_be_sampler_desc* samplers, u32 mask)
+{
+    (void)user;
+    if (!bq_async()) { bq_direct_begin(); Q.be->bind_vertex_textures(U, textures, samplers, mask); bq_direct_end(); return; }
+    if (bq_tex_same(RSX_BE_MAX_VERTEX_TEXTURES, &S.vtex_mask, &S.vtex_samp, S.vtex, S.vsamp,
+                    textures, samplers, mask, BQ_S_VTEX)) return;
+    bq_textures(OP_VTEX, RSX_BE_MAX_VERTEX_TEXTURES, textures, samplers, mask);
+}
+
+/* A setter's arguments as bits (floats compare as stored, -0 and NaN too):
+ * 1 when they are what the backend already holds. */
+static int bq_s_same(u32 bit, u32* have, const u32* now, u32 n)
+{
+    if (!bq_s_on()) return 0;
+    if ((S.have & bit) && !memcmp(have, now, n * 4u)) return bq_elide();
+    memcpy(have, now, n * 4u);
+    S.have |= bit;
+    return 0;
+}
