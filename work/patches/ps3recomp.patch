+/* The firmware's CA certificates live in /dev_flash/data/cert/CA01.cer ..
+ * CA58.cer; flag bit n selects CA(n+1). With `required` the call reports the
+ * total size of the selected files, with `buffer` it returns them
+ * concatenated. A title asks for the size first and treats 0 as fatal
+ * (MotorStorm Apocalypse: "CellHttpClient.cpp (128) : (FATAL ERROR): Could
+ * not fetch proper cert size", then exits). Files come from the dev_flash
+ * tree the cellFs layer serves (PS3_DEV_FLASH, else RPCS3's). Behaviour as
+ * RPCS3's cellSslCertificateLoader (cellSsl.cpp, GPL; reference only). */
+extern void ppu_fs_host_path(const char* guest, char* out, size_t cap);
+
+static u32 ssl_cert_read(int index, u32 dst, u32 room)
+{
+    char guest[64], host[1024];
+    snprintf(guest, sizeof guest, "/dev_flash/data/cert/CA%02d.cer", index);
+    ppu_fs_host_path(guest, host, sizeof host);
+    FILE* f = fopen(host, "rb");
+    if (!f) return 0;
+    u32 n = 0;
+    unsigned char chunk[4096];
+    size_t got;
+    while ((got = fread(chunk, 1, sizeof chunk, f)) > 0) {
+        if (dst && room > n) {
+            const u32 take = (u32)got < room - n ? (u32)got : room - n;
+            vm_memcpy_to(dst + n, chunk, take);
+        }
+        n += (u32)got;
+    }
+    fclose(f);
+    return n;
+}
