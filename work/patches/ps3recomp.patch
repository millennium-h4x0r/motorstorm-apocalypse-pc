+/* ---- WWS job replay (SPU_DIFF on a job module image) --------------------
+ * A lift made with SPU_LIFT_COUNT=1 (spu_lifter.py --entry-count-at) calls
+ * spu_job_entry_note at its module's entry; with SPU_JOB_COUNT=1 and
+ * SPU_DIFF=<job module image>[,...] (SPU_DIFF_EVERY=<n>: every n-th run), that
+ * run is recorded (spu_diff_begin: registers, local store, every GET/PUT/atomic
+ * /channel value) and then, from the same start state:
+ *   - replayed SPU_JOB_REPLAY=<k> times (default 20) through the LIFTED entry,
+ *     every input served from the record and every PUT compared: rdtsc cycles
+ *     per run, noise-free (no other SPU, no DMA wait), for codegen A/B and for
+ *     checking a native kernel against the lift;
+ *   - replayed once on the interpreter up to the job's return (lifted ==
+ *     interpreter on that input).
+ * Nothing replayed reaches guest memory: PUTs and atomics only compare. */
+static SPU_THREAD_LOCAL int t_job_cap;
+static SPU_THREAD_LOCAL void (*t_job_self)(spu_context*);
+static SPU_THREAD_LOCAL uint32_t t_job_ret;
+/* A replay runs under its own halt boundary: a mismatch stops the replayed
+ * context (stop_request), and its spu_halt must not unwind into the SPURS
+ * kernel's frame. */
+static void spu_job_replay_body(spu_context* r)
+{
+    r->host_depth++; t_job_self(r); spu_drain_call(r, t_job_ret); r->host_depth--;
+}
+extern int spu_run_with_halt(void (*)(spu_context*), spu_context*);
+static spu_context* spu_job_ctx_from(const spu_context* s)
+{
+    spu_context* r = (spu_context*)malloc(sizeof(spu_context));
+    if (!r) return NULL;
+    spu_context_init(r, s->spu_id);
+    memcpy(r->gpr, s->gpr, sizeof r->gpr);
+    memcpy(r->ls, s->ls, SPU_LS_SIZE);
+    r->image_id = s->image_id; r->event_mask = s->event_mask;
+    r->resident_ovl = s->resident_ovl; r->policy_mode = s->policy_mode;
+    memcpy(r->resident_code, s->resident_code, sizeof r->resident_code);
+    r->host_depth = s->host_depth;
+    return r;
+}
+static void spu_job_ctx_free(spu_context* r) { spu_mfc_release(r); spu_coh_unregister(r); free(r); }
+static int spu_job_capture(spu_context* ctx, void (*self)(spu_context*))
+{
+    if (t_job_cap) return 0;
+    if (g_spu_diff_on < 0) spu_diff_init();
+    if (!g_spu_diff_on || g_spu_diff) return 0;
+    spu_diff_t* d = (spu_diff_t*)spu_diff_begin(ctx, self, ctx->resident_ovl);
+    if (!d) return 0;
+    const uint32_t ret = ctx->gpr[0]._u32[0] & SPU_LS_MASK;
+    d->no_ch = 1;
+    t_job_cap = 1;
+    static int s_dbg = -1; if (s_dbg < 0) s_dbg = getenv("SPU_JOB_REPLAY_DBG") ? 1 : 0;
+    if (s_dbg) fprintf(stderr, "[spu-job-replay] capture img=%d entry 0x%05X ret 0x%05X pc 0x%05X host_depth %d policy %d\n",
+                       d->img, d->entry, ret, (unsigned)(ctx->pc & SPU_LS_MASK), ctx->host_depth, ctx->policy_mode);
+    /* SPU_JOB_REPLAY_NATIVE=1: record with the native stand-ins off, then time
+     * the replays both ways and compare the stand-ins' PUTs with the record. */
+    static int s_nat = -1; if (s_nat < 0) s_nat = getenv("SPU_JOB_REPLAY_NATIVE") ? 1 : 0;
+    const int nat_was = g_spu_native_on;
+    if (s_nat) g_spu_native_on = 0;
+    ctx->host_depth++; self(ctx); spu_drain_call(ctx, ret); ctx->host_depth--;   /* the real run, recorded */
+    g_spu_diff = NULL;
+    if (s_dbg) {
+        char b[1024]; int p = snprintf(b, sizeof b, "[spu-job-replay] real run done: %u records, pc 0x%05X:", d->n, (unsigned)(ctx->pc & SPU_LS_MASK));
+        for (unsigned i = 0; i < d->n && i < 24 && p < (int)sizeof b - 48; i++)
+            p += snprintf(b + p, sizeof b - (size_t)p, " %s(ls %05X ea %08X n %u)", diff_tn(d->r[i].type), d->r[i].a, d->r[i].b, d->r[i].n);
+        fprintf(stderr, "%s\n", b);
+    }
+    /* lifted replays, timed */
+    static int s_k = -1; if (s_k < 0) { const char* e = getenv("SPU_JOB_REPLAY"); s_k = e ? atoi(e) : 20; if (s_k < 1) s_k = 1; if (s_k > 1000) s_k = 1000; }
+    unsigned long long cyc[1000]; int bad = 0, short_ = 0;
+    for (int i = 0; i < s_k; i++) {
+        spu_context* r = spu_job_ctx_from(d->snap);
+        if (!r) break;
+        d->replay = 1; d->pos = 0; d->bad = 0; d->quiet = i > 0;
+        g_spu_diff = d;
+        t_job_self = self; t_job_ret = ret;
+        const unsigned long long t0 = __rdtsc();
+        spu_run_with_halt(spu_job_replay_body, r);
+        cyc[i] = __rdtsc() - t0;
+        g_spu_diff = NULL;
+        bad += d->bad; short_ += d->pos < d->n;
+        if (s_dbg && i < 2) fprintf(stderr, "[spu-job-replay] replay %d: %llu cycles, %u/%u records, bad %d, end pc 0x%05X status 0x%X img %d ovl %d\n",
+                                    i, cyc[i], d->pos, d->n, d->bad, (unsigned)(r->pc & SPU_LS_MASK), (unsigned)r->status, r->image_id, r->resident_ovl);
+        spu_job_ctx_free(r);
+    }
+    for (int i = 1; i < s_k; i++) for (int j = i; j > 0 && cyc[j - 1] > cyc[j]; j--) { unsigned long long t = cyc[j]; cyc[j] = cyc[j - 1]; cyc[j - 1] = t; }
+    if (s_nat) {   /* the same replays with the stand-ins on */
+        unsigned long long nc[1000]; int nbad = 0, nshort = 0;
+        g_spu_native_on = 1;
+        for (int i = 0; i < s_k; i++) {
+            spu_context* r = spu_job_ctx_from(d->snap);
+            if (!r) break;
+            d->replay = 1; d->pos = 0; d->bad = 0; d->quiet = i > 0;
+            g_spu_diff = d; t_job_self = self; t_job_ret = ret;
+            const unsigned long long t0 = __rdtsc();
+            spu_run_with_halt(spu_job_replay_body, r);
+            nc[i] = __rdtsc() - t0;
+            g_spu_diff = NULL;
+            nbad += d->bad; nshort += d->pos < d->n;
+            spu_job_ctx_free(r);
+        }
+        g_spu_native_on = 0;
+        for (int i = 1; i < s_k; i++) for (int j = i; j > 0 && nc[j - 1] > nc[j]; j--) { unsigned long long t = nc[j]; nc[j] = nc[j - 1]; nc[j - 1] = t; }
+        fprintf(stderr, "[spu-job-replay] img=%d run %lu native: x%d min %llu median %llu cycles (lifted min %llu median %llu), "
+                "%d mismatched, %d stopped early\n", d->img, d->run, s_k, nc[0], nc[s_k / 2], cyc[0], cyc[s_k / 2], nbad, nshort);
+    }
+    d->quiet = 0;
+    /* the interpreter, to the job's return */
+    spu_context* r = spu_job_ctx_from(d->snap);
+    int interp_ok = -1;
+    if (r) {
+        d->replay = 1; d->pos = 0; d->bad = 0; d->cut = 0;
+        g_spu_diff = d;
+        spu_interp_run_until(r, d->entry, ret);
+        g_spu_diff = NULL;
+        interp_ok = !d->bad && d->pos >= d->n;
+        spu_job_ctx_free(r);
+    }
+    fprintf(stderr, "[spu-job-replay] img=%d run %lu entry 0x%05X: %u records; lifted x%d: min %llu median %llu cycles, "
+            "%d mismatched, %d stopped early; interpreter %s\n",
+            d->img, d->run, d->entry, d->n, s_k, cyc[0], cyc[s_k / 2], bad, short_,
+            interp_ok < 0 ? "not run" : interp_ok ? "agrees" : "DIFFERS");
+    free(d->snap); free(d->r); free(d->bytes); free(d);
+    g_spu_native_on = nat_was;
+    t_job_cap = 0;
+    return 1;
+}
