+    "            mask[l / 32] |= 1u << (l % 32);\n"
+    "        }\n"
+    "    }\n"
+    "    uint any_light = 0;\n"
+    "    [unroll] for (uint w = 0; w < MASK_WORDS; w++) { tiles[TILE_WORDS * t + w] = mask[w]; any_light |= mask[w]; }\n"
+    "    tiles[TILE_WORDS * t + TILE_ANY] = any_light;\n"
+    "    tiles[TILE_WORDS * t + TILE_LIT] = 0;\n"
+    "}\n",
+    "// per pixel: the diffuse light (square-root encoded RGB with a shared scale in\n"
+    "// A) and the specular intensity, from the lights of its tile\n"
+    "[numthreads(8, 8, 1)]\n"
+    "void main(uint3 id : SV_DispatchThreadID)\n"
+    "{\n"
+    "    int2 px = int2(id.xy);\n"
+    "    if (px.x >= img_w() || px.y >= img_h()) return;\n"
+    "    uint t = uint((px.y * TILES_Y / img_h()) * TILES_X + px.x * TILES_X / img_w());\n"
+    "    if (tiles[TILE_WORDS * t + TILE_ANY] == 0) return;\n"
+    "    const float SCALE = 0.35355338;    // 1 / (2 sqrt 2)\n"
+    "    uint4 tex = uint4(normals_tex.Load(int3(px, 0)).argb * 255.0 + 0.5);\n"
+    "    float3 normal = normalize(float3(tex.yzw) * (2.0 / 255.0) - 1.0);\n"
+    "    float3 pos = view_position(px, depth24(px));\n"
+    "    float3 view = normalize(pos);\n"
+    "    float gloss = exp2(float(tex.x) * (8.0 / 255.0) - 0.88895999);\n"
+    "    float spec_gain = gloss * 0.92592591 + 1.0;\n"
+    "    float3 diffuse = 0.0;\n"
+    "    float specular = 0.0;\n"
+    "    bool lit = false;\n"
+    "    for (uint w = 0; w < MASK_WORDS; w++)\n"
+    "        for (uint bits = tiles[TILE_WORDS * t + w]; bits != 0; bits &= bits - 1) {\n"
+    "            Light l = lights[w * 32 + firstbitlow(bits)];\n"
+    "            float3 to_light = l.pos_radius.xyz - pos;\n"
+    "            float d2 = dot(to_light, to_light), inv_d = rsqrt(d2);\n"
+    "            if (!in_range(l, to_light, d2, inv_d)) continue;\n"
+    "            lit = true;\n"
+    "            float dist = d2 * inv_d;\n"
+    "            float att = saturate((l.pos_radius.w - dist) * l.falloff.x);\n"
+    "            if (l.dir_kind.w == 2.0) {\n"
+    "                float angle = dot(to_light, -l.dir_kind.xyz) * inv_d;\n"
+    "                att = dist > l.falloff.w ? att * saturate(l.falloff.y * (l.falloff.z - angle)) : 0.0;\n"
+    "            }\n"
+    "            float3 dir = to_light * inv_d;\n"
+    "            float intensity = max(dot(normal, dir), 0.0) * att * att;\n"
+    "            diffuse += l.colour_mag.xyz * intensity;\n"
+    "            float n_dot_h = max(dot(normal, normalize(dir - view)), 0.0);\n"
+    "            float shape = (1.0 - n_dot_h) * gloss + 1.0;\n"
+    "            shape *= shape; shape *= shape; shape *= shape;\n"
+    "            specular += spec_gain * intensity * l.colour_mag.w / shape;\n"
+    "        }\n"
+    "    if (lit && tiles[TILE_WORDS * t + TILE_LIT] == 0) InterlockedOr(tiles[TILE_WORDS * t + TILE_LIT], 1u);\n"
+    "    float3 v = sqrt(diffuse);\n"
+    "    float a = min(floor(max(max(max(v.x, v.y), v.z), 1.0) * (SCALE * 255.0)), 255.0);\n"
+    "    float3 rgb = min(floor(v * (SCALE * 255.0 * 255.0) / a), 255.0);\n"
+    "    store(px, float4(rgb, a) / 255.0, min(floor(sqrt(specular) * (SCALE * 255.0)), 255.0) / 255.0);\n"
+    "}\n",
+    "// per pixel row of a tile: a tile none of whose pixels is in a light's range\n"
+    "// stays empty, even when a light volume reaches it\n"
+    "[numthreads(64, 1, 1)]\n"
+    "void main(uint3 id : SV_DispatchThreadID)\n"
+    "{\n"
+    "    uint i = id.x;\n"
+    "    if (i >= uint(TILES_X * img_h())) return;\n"
+    "    int tx = int(i % uint(TILES_X)), y = int(i / uint(TILES_X));\n"
+    "    uint t = uint((y * TILES_Y / img_h()) * TILES_X + tx);\n"
+    "    if (tiles[TILE_WORDS * t + TILE_LIT] != 0 || tiles[TILE_WORDS * t + TILE_ANY] == 0) return;\n"
+    "    for (int x = tile_left(tx); x < tile_left(tx + 1); x++) store(int2(x, y), 0.0, 0.0);\n"
+    "}\n"
+};
