+/* X16, Y16_X16, Y16_X16_FLOAT, X32_FLOAT and depth present their channels the
+ * way RPCS3's get_component_mapping does. X16 through the crossbar inFAMOUS 2
+ * uses for its lookup (0xAAEE: A<-G, R<-B, G<-G, B<-B) must land on the value
+ * for A and G and on ONE (component 3 of the R16 upload) for R and B. */
+static void test_remap_sixteen_bit_and_float_lanes(void)
+{
+    u8 m[4];
+    /* X16 {R,1,R,1} under RPCS3's decoded_remap: identity is rewritten to
+     * 0x66 (A,G <- the value, R,B <- 1); 0xEE to 0xAA (every output reads
+     * the value); with the override bit set identity becomes 0x56 (A <- the value). */
+    rsx_texture_component_remap(0xAAE4u, 0x94u, m);          /* X16, identity */
+    CHECK_EQ(m[A_], 0); CHECK_EQ(m[R_], RSX_REMAP_ONE); CHECK_EQ(m[G_], 0); CHECK_EQ(m[B_], RSX_REMAP_ONE);
+    rsx_texture_component_remap(0xAAEEu, 0x94u | 0x20u, m);  /* X16 LN, 0xAAEE */
+    CHECK_EQ(m[A_], 0); CHECK_EQ(m[R_], 0); CHECK_EQ(m[G_], 0); CHECK_EQ(m[B_], 0);
+    rsx_texture_component_remap(0x0001AAE4u, 0x94u, m);      /* X16, identity + override: 0x56 */
+    CHECK_EQ(m[A_], 0); CHECK_EQ(m[R_], RSX_REMAP_ONE); CHECK_EQ(m[G_], RSX_REMAP_ONE); CHECK_EQ(m[B_], RSX_REMAP_ONE);
+    /* Depth ignores the crossbar, ops included. */
+    rsx_texture_component_remap(0x00E4u, 0x90u, m);          /* DEPTH24_D8, all forced zero */
+    for (int i = 0; i < 4; i++) CHECK_EQ(m[i], 0);
+    /* Float formats cannot be remapped: the low byte is identity. */
+    rsx_texture_component_remap(0xAA1Bu, 0x9Au, m);          /* W16..X16 FLOAT, reversed asked */
+    CHECK_EQ(m[A_], 3); CHECK_EQ(m[R_], 0); CHECK_EQ(m[G_], 1); CHECK_EQ(m[B_], 2);
+    /* shuffle_mask_bits: a mask on source R (bit 1) reaches every output
+     * reading R -- for B8 {1,R,R,R} under identity that is R, G and B. */
+    CHECK_EQ(rsx_texture_shuffle_mask(0xAAE4u, 0x85u, 0xFu), 0xFu);
+    CHECK_EQ(rsx_texture_shuffle_mask(0xAA1Bu, 0x85u, 0x2u), 0x4u);   /* R read by output G */
+    CHECK_EQ(rsx_texture_shuffle_mask(0x00E4u, 0x85u, 0xFu), 0x0u);   /* all forced zero */
+    rsx_texture_component_remap(0xAAE4u, 0x95u, m);          /* Y16_X16 */
+    CHECK_EQ(m[A_], 1); CHECK_EQ(m[R_], 0); CHECK_EQ(m[G_], 1); CHECK_EQ(m[B_], 0);
+    rsx_texture_component_remap(0xAAE4u, 0x9Fu, m);          /* Y16_X16_FLOAT */
+    CHECK_EQ(m[A_], 0); CHECK_EQ(m[R_], 1); CHECK_EQ(m[G_], 0); CHECK_EQ(m[B_], 1);
+    rsx_texture_component_remap(0xAAE4u, 0x9Cu, m);          /* X32_FLOAT */
+    for (int i = 0; i < 4; i++) CHECK_EQ(m[i], 0);
+    rsx_texture_component_remap(0xAAE4u, 0x90u, m);          /* DEPTH24_D8 */
+    for (int i = 0; i < 4; i++) CHECK_EQ(m[i], 0);
+}
