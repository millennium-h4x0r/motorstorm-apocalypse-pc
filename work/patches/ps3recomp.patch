+/*
+ * ps3recomp - link stubs for the libs/spurs host tests
+ *
+ * libps3recomp_runtime.a leaves the PPU side (runtime/ppu: loader, HLE table,
+ * reservation and write-watch hooks, VFS root) to the title's executable. A
+ * test that links the library without a title supplies these instead. None of
+ * them is reached by the paths the spurs tests exercise; they only satisfy the
+ * linker for objects pulled in alongside cellSpurs.o. Deliberately does NOT
+ * include ppu_memory.h: the extern vm_* below are the out-of-line copies some
+ * C++ objects expect, while the C sources use the header's static inlines.
+ */
+#include <stdint.h>
+#include <string.h>
+
+extern uint8_t* vm_base;
+
+int         g_resv_store_active;
+uint32_t    g_ww_lo, g_ww_hi;
+uint32_t    ppu_vm_size = 0x10000000u;
+int         g_barrier_sync_watch;
+const char* ppu_vfs_root = ".";
+uint32_t    g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
+__thread void* g_active_ctx;
+
+void ps3_ww_report_inline(void) {}
+void ppu_resv_break_store(void) {}
+void ppu_resv_register(void) {}
+void ppu_register_function(void) {}
+void ppu_dump_guest_stack(void) {}
+void ppu_dump_bctrl_ring(void) {}
+void ppu_log_host_chain(void) {}
+void ppu_guest_callstack(void) {}
+void ppu_guest_caller(void) {}
+void ppu_guard_page(uint32_t a) { (void)a; }
+void lbp_breadcrumb_dump(void) {}
+const char* ppu_prof_resolve_host(void) { return "?"; }
+void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(void*))
+{ (void)nid; (void)name; (void)fn; }
+
+static uint32_t bswap32(uint32_t v) { return __builtin_bswap32(v); }
+uint8_t  vm_read8(uint32_t a)  { return vm_base[a]; }
+uint32_t vm_read32(uint32_t a) { uint32_t v; memcpy(&v, vm_base + a, 4); return bswap32(v); }
+uint64_t vm_read64(uint32_t a) { return ((uint64_t)vm_read32(a) << 32) | vm_read32(a + 4); }
+void vm_write8(uint32_t a, uint8_t v)   { vm_base[a] = v; }
+void vm_write32(uint32_t a, uint32_t v) { v = bswap32(v); memcpy(vm_base + a, &v, 4); }
diff --git a/libs/spurs/tests/test_spurs_taskset2.c b/libs/spurs/tests/test_spurs_taskset2.c
new file mode 100644
index 00000000..78a4ecde
--- /dev/null
+++ b/libs/spurs/tests/test_spurs_taskset2.c
@@ -0,0 +1,334 @@
+/*
+ * ps3recomp - cellSpurs Taskset2 / Barrier HLE test
+ *
+ * Drives the Taskset2 entry points the way MotorStorm Apocalypse's Havok
+ * (hkSpuUtil) does -- attribute init, CreateTaskset2, CreateTask2 with a NULL
+ * attribute, TryJoinTask2/JoinTask2 reaping, DestroyTaskset2 -- and checks the
+ * big-endian guest layout they leave behind, plus cellSpursBarrierInitialize.
+ *
+ * The task "ELF" is not an ELF, so spu_elf_image_size() returns 0 and nothing
+ * is dispatched: a task exit is simulated the way the runtime's task-exit path
+ * (spu_taskset_task_exited) does it -- slot state 0x12, ready bit cleared,
+ * enabled kept until a join. The slot-state protocol is SPU libspurs' (see
+ * spurs_taskset.h); the last part races simulated SPU-side creates (a
+ * GETLLAR/PUTLLC-style claim of the enabled bitset, then the heqi check on the
+ * slot state) against PPU creates and joins.
+ *
+ * Build (from the ps3recomp root, after building the runtime library into
+ * <build>, e.g. cmake -S . -B <build> -G Ninja && cmake --build <build>
+ * --target ps3recomp_runtime):
+ *
+ *   cc -std=gnu17 -O1 -D_GNU_SOURCE -Iinclude -Ilibs/spurs -Iruntime/spu \
+ *      -Iruntime/ppu -Iruntime/memory -Iruntime/syscalls -Iruntime/platform \
+ *      libs/spurs/tests/test_spurs_taskset2.c libs/spurs/tests/test_spurs_stubs.c \
+ *      <build>/libps3recomp_runtime.a \
+ *      -lpthread -lm -lstdc++ -o /tmp/test_spurs_taskset2 && /tmp/test_spurs_taskset2
+ */
+#include "cellSpurs.h"
+#include "spurs_taskset.h"
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define MEM_SIZE (16u << 20)
+uint8_t* vm_base;
+
+static int g_fail, g_pass;
+#define CHECK(c) do { if (c) g_pass++; else { g_fail++; \
+    fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); } } while (0)
+
+enum {
+    SPURS_EA   = 0x100000,   /* CellSpurs (128-aligned) */
+    TS_EA      = 0x200000,   /* CellSpursTaskset2 (0x2900) */
+    ATTR_EA    = 0x210000,   /* CellSpursTasksetAttribute2 (512) */
+    NAMEBUF_EA = 0x211000,   /* CellSpursTaskNameBuffer (128 x 32) */
+    TS_NAME_EA = 0x213000,
+    ELF_EA     = 0x220000,   /* not an SPU ELF -> never dispatched */
+    ARG_EA     = 0x230000,   /* CellSpursTaskArgument (16) */
+    ID_EA      = 0x230100,   /* CellSpursTaskId out */
+    EXIT_EA    = 0x230200,   /* s32 exit code out */
+    TATTR_EA   = 0x230400,   /* CellSpursTaskAttribute2 (256) */
+    TNAME_EA   = 0x230600,
+    BARRIER_EA = 0x240000,
+    FLAG_EA    = 0x250000,   /* CellSpursEventFlag (128) */
+    FLAG2_EA   = 0x250080,
+};
+uint32_t spurs_port_ef(uint32_t port);
+uint32_t spurs_port_queue(uint32_t port);
+
+static void put_str(u32 ea, const char* s) { memcpy(vm_base + ea, s, strlen(s) + 1); }
+
+static void task_exit(u32 id)   /* what spu_taskset_task_exited does */
+{
+    spurs_bitset_clear(TS_EA + CSTS_READY, id);
+    spurs_bitset_clear(TS_EA + CSTS_PENDING_READY, id);
+    spurs_ts2_mark_exited(TS_EA, id, 0);
+}
+static int enabled(u32 id) { return (vm_read8(TS_EA + CSTS_ENABLED + id / 8) >> (7 - id % 8)) & 1; }
+void spu_taskset_line_committed(uint32_t line);
+
+/* SPU libspurs' create (hkp_integrate LS 0x11F28), as far as ids go: claim
+ * the first clear enabled bit with a GETLLAR/PUTLLC-style compare-and-commit
+ * of the header, ++live count, then the slot-state check it halts on. */
+static _Atomic int g_halts, g_spu_dup;
+static int spu_create(void)
+{
+    for (;;) {
+        uint8_t snap[0x80];
+        memcpy(snap, vm_base + TS_EA, sizeof snap);       /* GETLLAR (unlocked) */
+        int id = -1;
+        for (int t = 0; t < 128 && id < 0; t++)
+            if (!(snap[CSTS_ENABLED + t / 8] & (0x80u >> (t % 8)))) id = t;
+        if (id < 0) return -1;                             /* EAGAIN */
+        const uint64_t m = spu_lockline_mask_ea(TS_EA);
+        spu_lockline_lock_mask(m);
+        int ok = !memcmp(snap, vm_base + TS_EA, sizeof snap);   /* PUTLLC */
+        if (ok) {
+            vm_base[TS_EA + CSTS_ENABLED + id / 8] |= (uint8_t)(0x80u >> (id % 8));
+            vm_base[TS_EA + CSTS_LIVE_COUNT]++;
+        }
+        spu_lockline_unlock_mask(m);
+        if (!ok) continue;
+        const u32 r = spurs_ts2_rec(TS_EA, (u32)id);
+        const uint64_t mr = spu_lockline_mask_ea(r);
+        spu_lockline_lock_mask(mr);
+        const uint8_t st = vm_base[r + 15];
+        if (st != 0x01 && st != 0x12) g_halts++;           /* heqi, LS 0x126D8 */
+        vm_base[r + 15] = (uint8_t)(st | 0x10);
+        spu_lockline_unlock_mask(mr);
+        return id;
+    }
+}
+
+typedef struct { int iters, ppu; u32 id_ea; int made; } race_arg;
+static _Atomic int g_join_fail;
+static uint8_t g_owner[128];                               /* 0 free, 1 ppu, 2 spu */
+static void* racer(void* p)
+{
+    race_arg* a = (race_arg*)p;
+    for (int i = 0; i < a->iters; i++) {
+        int id;
+        if (a->ppu) {
+            id = cellSpursCreateTask2(TS_EA, a->id_ea, ELF_EA, ARG_EA, 0) == CELL_OK
+               ? (int)vm_read32(a->id_ea) : -1;
+        } else id = spu_create();
+        if (id < 0) continue;
+        a->made++;
+        if (__atomic_exchange_n(&g_owner[id], (uint8_t)(a->ppu ? 1 : 2), __ATOMIC_SEQ_CST)) g_spu_dup++;
+        __atomic_store_n(&g_owner[id], 0, __ATOMIC_SEQ_CST);
+        task_exit((u32)id);
+        if (cellSpursTryJoinTask2(TS_EA, (u32)id, 0) != CELL_OK) g_join_fail++;
+    }
+    return NULL;
+}
+
+static int create(u32 attr)
+{
+    vm_write32(ID_EA, 0xDEADBEEF);
+    s32 rc = cellSpursCreateTask2(TS_EA, ID_EA, ELF_EA, ARG_EA, attr);
+    return rc == CELL_OK ? (int)vm_read32(ID_EA) : -1;
+}
+
+static void* exit_later(void* p)
+{
+    usleep(30 * 1000);
+    task_exit((u32)(uintptr_t)p);
+    return NULL;
+}
+
+int main(void)
+{
+    vm_base = (uint8_t*)calloc(1, MEM_SIZE);
+    if (!vm_base) return 2;
+
+    CHECK(cellSpursInitialize((CellSpurs*)(uintptr_t)SPURS_EA, 1, 100, 1000, 0) == CELL_OK);
+
+    /* ---- attribute defaults (RPCS3 _cellSpursTasksetAttribute2Initialize) ---- */
+    memset(vm_base + ATTR_EA, 0xCC, 0x200);
+    CHECK(_cellSpursTasksetAttribute2Initialize(ATTR_EA, 0) == CELL_OK);
+    CHECK(vm_read32(ATTR_EA + 0x00) == 0);
+    CHECK(vm_read32(ATTR_EA + 0x04) == 0);
+    CHECK(vm_read64(ATTR_EA + 0x08) == 0);
+    for (int i = 0; i < 8; i++) CHECK(vm_read8(ATTR_EA + 0x10 + i) == 1);
+    CHECK(vm_read32(ATTR_EA + 0x18) == 8);
+    CHECK(vm_read32(ATTR_EA + 0x20) == 0);
+    CHECK(vm_read8(ATTR_EA + 0x1FF) == 0);
+    CHECK(_cellSpursTasksetAttribute2Initialize(0, 0) == (s32)CELL_SPURS_TASK_ERROR_NULL_POINTER);
+
+    /* Havok fills in name, args, priorities and max contention */
+    put_str(TS_NAME_EA, "HavokSpursTaskset");
+    vm_write32(ATTR_EA + 0x04, TS_NAME_EA);
+    vm_write64(ATTR_EA + 0x08, 0x1122334455667788ull);
+    vm_write32(ATTR_EA + 0x18, 5);
+    vm_write32(ATTR_EA + 0x1C, 1);
+    vm_write32(ATTR_EA + 0x20, NAMEBUF_EA);
+
+    /* ---- CreateTaskset2 ---- */
+    CHECK(cellSpursCreateTaskset2(SPURS_EA, TS_EA + 8, ATTR_EA) == (s32)CELL_SPURS_TASK_ERROR_ALIGN);
+    CHECK(cellSpursCreateTaskset2(0, TS_EA, ATTR_EA) == (s32)CELL_SPURS_TASK_ERROR_NULL_POINTER);
+    memset(vm_base + TS_EA, 0xAB, 0x2900);
+    CHECK(cellSpursCreateTaskset2(SPURS_EA, TS_EA, ATTR_EA) == CELL_OK);
+    CHECK(vm_read64(TS_EA + CSTS_SPURS) == SPURS_EA);
+    CHECK(vm_read64(TS_EA + CSTS_ARGS) == 0x1122334455667788ull);
+    CHECK(vm_read8(TS_EA + CSTS_ENABLE_CLEAR_LS) == 1);
+    CHECK(vm_read32(TS_EA + CSTS_SIZE_FIELD) == 0x2900);
+    CHECK(vm_read32(TS_EA + CSTS_ENABLED) == 0);
+    CHECK(vm_read32(TS_EA + 0x1980) == 0);      /* task_exit_code[0] */
+    /* slot state (byte 15): every slot free (1), which SPU libspurs' create
+     * asserts on */
+    CHECK(vm_read8(TS_EA + 0x1980 + 15) == 0x01);
+    CHECK(vm_read8(TS_EA + 0x1980 + 127 * 16 + 15) == 0x01);
+    CHECK(vm_read8(TS_EA + 0x28FF) == 0);       /* whole 0x2900 zeroed */
+    /* SPU-side cellSpursCreateTask refuses (ERROR_PERM) a taskset whose
+     * event-flag ids at +0x1898/+0x189C are both 0: they must be real ids. */
+    CHECK(vm_read32(TS_EA + CSTS_EVENT_FLAG_ID1) != 0);
+    CHECK(vm_read32(TS_EA + CSTS_EVENT_FLAG_ID2) != 0);
+    CHECK(vm_read32(TS_EA + CSTS_EVENT_FLAG_ID1) != vm_read32(TS_EA + CSTS_EVENT_FLAG_ID2));
+
+    /* ---- EventFlagAttachLv2EventQueue: an SPU-to-PPU flag gets a real queue
+     * on a free SPURS port, recorded in the flag (spuPort +0x0C, queue +0x7C)
+     * and routed as the flag's, so an SPU-side Set's event is answered. A
+     * PPU-to-SPU flag is refused. ---- */
+    CHECK(cellSpursEventFlagInitialize((CellSpursTaskset*)(uintptr_t)TS_EA,
+                                       (CellSpursEventFlag*)(uintptr_t)FLAG_EA, 0, 1) == CELL_OK);
+    CHECK(cellSpursEventFlagAttachLv2EventQueue((CellSpursEventFlag*)(uintptr_t)FLAG_EA) == CELL_OK);
+    { const u32 port = vm_read8(FLAG_EA + 0x0C), q = vm_read32(FLAG_EA + 0x7C);
+      CHECK(port >= 16 && port < 64);
+      CHECK(q != 0);
+      CHECK(spurs_port_ef(port) == FLAG_EA);
+      CHECK(spurs_port_queue(port) == q);
+      CHECK(cellSpursEventFlagDetachLv2EventQueue((CellSpursEventFlag*)(uintptr_t)FLAG_EA) == CELL_OK);
+      CHECK(spurs_port_ef(port) == 0); }
+    CHECK(cellSpursEventFlagInitialize((CellSpursTaskset*)(uintptr_t)TS_EA,
+                                       (CellSpursEventFlag*)(uintptr_t)FLAG2_EA, 0, 2) == CELL_OK);
+    CHECK(cellSpursEventFlagAttachLv2EventQueue((CellSpursEventFlag*)(uintptr_t)FLAG2_EA) ==
+          (s32)CELL_SPURS_TASK_ERROR_PERM);
+
+    /* ---- CreateTask2: ids, TaskInfo, names ---- */
+    for (int i = 0; i < 4; i++) vm_write32(ARG_EA + i * 4, 0xA0 + i);
+    CHECK(cellSpursCreateTask2(TS_EA, 0, ELF_EA, ARG_EA, 0) == (s32)CELL_SPURS_TASK_ERROR_NULL_POINTER);
+    CHECK(cellSpursCreateTask2(TS_EA, ID_EA, ELF_EA + 4, ARG_EA, 0) == (s32)CELL_SPURS_TASK_ERROR_ALIGN);
+    CHECK(create(0) == 0);
+    CHECK(vm_read8(TS_EA + 0x1980 + 15) == 0x11);   /* created */
+    CHECK(create(0) == 1);
+    memset(vm_base + TATTR_EA, 0, 256);
+    put_str(TNAME_EA, "hkpIntegrate");
+    vm_write32(TATTR_EA + 0x20, TNAME_EA);
+    vm_write32(TATTR_EA + 0x10, 0x12345678);    /* lsPattern word 0 */
+    CHECK(create(TATTR_EA) == 2);
+    u32 ti2 = spurs_taskset_taskinfo_ea(TS_EA, 2);
+    CHECK(vm_read32(ti2 + TI_ARGS + 0) == 0xA0 && vm_read32(ti2 + TI_ARGS + 12) == 0xA3);
+    CHECK(vm_read64(ti2 + TI_ELF) == ELF_EA);
+    CHECK(vm_read32(ti2 + TI_LS_PATTERN) == 0x12345678);
+    CHECK(strcmp((const char*)vm_base + NAMEBUF_EA + 2 * 32, "hkpIntegrate") == 0);
+    CHECK(vm_read8(NAMEBUF_EA + 0) == 0);       /* no name for task 0 */
+    CHECK(vm_read32(TS_EA + CSTS_ENABLED) == 0xE0000000u);
+    CHECK(vm_read32(TS_EA + CSTS_READY) == 0xE0000000u);
+
+    /* ---- TryJoinTask2: busy while running; id kept until joined ---- */
+    CHECK(vm_read8(TS_EA + CSTS_LIVE_COUNT) == 3);
+    CHECK(cellSpursTryJoinTask2(TS_EA, 0, EXIT_EA) == (s32)CELL_SPURS_TASK_ERROR_BUSY);
+    CHECK(cellSpursTryJoinTask2(TS_EA, 77, EXIT_EA) == (s32)CELL_SPURS_TASK_ERROR_SRCH);
+    CHECK(cellSpursTryJoinTask2(TS_EA, 128, EXIT_EA) == (s32)CELL_SPURS_TASK_ERROR_INVAL);
+    task_exit(0);
+    CHECK(vm_read8(TS_EA + 0x1980 + 15) == 0x12);   /* exited, not joined */
+    CHECK(enabled(0));                              /* the id stays taken */
+    CHECK(create(0) == 3);
+    vm_write32(EXIT_EA, 0xFFFFFFFF);
+    CHECK(cellSpursTryJoinTask2(TS_EA, 0, EXIT_EA) == CELL_OK);
+    CHECK(vm_read8(TS_EA + 0x1980 + 15) == 0x01);   /* joined: free again */
+    CHECK(!enabled(0));
+    CHECK(vm_read8(TS_EA + CSTS_LIVE_COUNT) == 3);  /* 1, 2, 3 */
+    CHECK(vm_read32(EXIT_EA) == 0);
+    CHECK(cellSpursTryJoinTask2(TS_EA, 0, EXIT_EA) == (s32)CELL_SPURS_TASK_ERROR_SRCH);
+    CHECK(create(0) == 0);                      /* reaped id is reused */
+
+    /* ---- JoinTask2 blocks until the task exits ---- */
+    pthread_t th;
+    pthread_create(&th, NULL, exit_later, (void*)(uintptr_t)1);
+    CHECK(cellSpursJoinTask2(TS_EA, 1, EXIT_EA) == CELL_OK);
+    CHECK(!(vm_read8(TS_EA + CSTS_ENABLED) & 0x40));
+    pthread_join(th, NULL);
+    CHECK(cellSpursJoinTask2(TS_EA, 1, 0) == (s32)CELL_SPURS_TASK_ERROR_SRCH);
+
+    /* ---- a task created on an SPU is reaped by the PPU's sweep ---- */
+    { int id = spu_create();
+      CHECK(id == 1);
+      CHECK(vm_read8(spurs_ts2_rec(TS_EA, 1) + 15) == 0x11);
+      CHECK(cellSpursTryJoinTask2(TS_EA, 1, 0) == (s32)CELL_SPURS_TASK_ERROR_BUSY);
+      task_exit(1);
+      CHECK(cellSpursTryJoinTask2(TS_EA, 1, 0) == CELL_OK);
+      CHECK(!enabled(1)); }
+
+    /* ---- an SPU TryJoin leaves 0x04; the commit hook makes it free ---- */
+    CHECK(create(0) == 1);
+    task_exit(1);
+    vm_base[spurs_ts2_rec(TS_EA, 1) + 15] = 0x04;   /* the joiner's PUTLLC */
+    spu_taskset_line_committed(spurs_ts2_rec(TS_EA, 1) & ~127u);
+    CHECK(vm_read8(spurs_ts2_rec(TS_EA, 1) + 15) == 0x01);
+    spurs_taskset_free_id(TS_EA, 1);                /* the joiner's header step */
+    CHECK(spu_create() == 1 && g_halts == 0);
+    task_exit(1);
+    CHECK(cellSpursTryJoinTask2(TS_EA, 1, 0) == CELL_OK);
+
+    /* ---- the SPU creator lets the task start before it marks the record:
+     * a task that exits in between must still leave a state it accepts ---- */
+    { const uint64_t m = spu_lockline_mask_ea(TS_EA);
+      spu_lockline_lock_mask(m);                    /* the creator's header PUTLLC */
+      vm_base[TS_EA + CSTS_ENABLED] |= 0x40; vm_base[TS_EA + CSTS_LIVE_COUNT]++;
+      spu_lockline_unlock_mask(m);
+      task_exit(1);                                 /* started and done already */
+      const uint8_t st = vm_read8(spurs_ts2_rec(TS_EA, 1) + 15);
+      CHECK(st == 0x01 || st == 0x12);              /* the creator's heqi */
+      vm_base[spurs_ts2_rec(TS_EA, 1) + 15] = (uint8_t)(st | 0x10);
+      CHECK(cellSpursTryJoinTask2(TS_EA, 1, 0) == CELL_OK); }
+
+    /* ---- 128-id cap counts unjoined ids ---- */
+    int n = 0;
+    while (create(0) >= 0) n++;
+    CHECK(n == 128 - 3);                        /* 0, 2 and 3 still held */
+    for (u32 i = 0; i < 128; i++) task_exit(i);
+    CHECK(create(0) < 0);                       /* all exited, none joined */
+    for (u32 i = 0; i < 128; i++) cellSpursTryJoinTask2(TS_EA, i, EXIT_EA);
+    CHECK(vm_read8(TS_EA + CSTS_LIVE_COUNT) == 0);
+    CHECK(vm_read32(TS_EA + CSTS_ENABLED) == 0 && vm_read32(TS_EA + CSTS_ENABLED + 12) == 0);
+
+    /* ---- PPU creates/joins racing SPU creates: never one id twice, never
+     * a slot state the SPU create halts on ---- */
+    { race_arg ra[4] = { {20000, 1, ID_EA + 16}, {20000, 0, 0}, {20000, 1, ID_EA + 32}, {20000, 0, 0} };
+      pthread_t rt[4];
+      for (int i = 0; i < 4; i++) pthread_create(&rt[i], NULL, racer, &ra[i]);
+      for (int i = 0; i < 4; i++) pthread_join(rt[i], NULL);
+      CHECK(g_halts == 0);
+      CHECK(g_spu_dup == 0);
+      CHECK(g_join_fail == 0);
+      for (int i = 0; i < 4; i++) CHECK(ra[i].made == ra[i].iters);
+      CHECK(vm_read8(TS_EA + CSTS_LIVE_COUNT) == 0);
+      CHECK(vm_read32(TS_EA + CSTS_ENABLED) == 0); }
+    CHECK(create(0) == 0);
+
+    /* ---- Barrier ---- */
+    memset(vm_base + BARRIER_EA, 0xEE, 128);
+    CHECK(cellSpursBarrierInitialize(TS_EA, BARRIER_EA, 0) == (s32)CELL_SPURS_TASK_ERROR_INVAL);
+    CHECK(cellSpursBarrierInitialize(TS_EA, BARRIER_EA, 129) == (s32)CELL_SPURS_TASK_ERROR_INVAL);
+    CHECK(cellSpursBarrierInitialize(TS_EA, BARRIER_EA + 16, 4) == (s32)CELL_SPURS_TASK_ERROR_ALIGN);
+    CHECK(cellSpursBarrierInitialize(0, BARRIER_EA, 4) == (s32)CELL_SPURS_TASK_ERROR_NULL_POINTER);
+    CHECK(cellSpursBarrierInitialize(TS_EA, BARRIER_EA, 5) == CELL_OK);
+    CHECK(vm_read32(BARRIER_EA + 0x00) == 0);
+    CHECK(vm_read32(BARRIER_EA + 0x04) == 5);
+    CHECK(vm_read32(BARRIER_EA + 0x34) == TS_EA);
+    CHECK(vm_read8(BARRIER_EA + 0x7F) == 0);
+
+    CHECK(cellSpursLFQueueDetachLv2EventQueue(0x250000) == CELL_OK);
+
+    /* ---- DestroyTaskset2 ---- */
+    CHECK(cellSpursDestroyTaskset2(TS_EA + 4) == (s32)CELL_SPURS_TASK_ERROR_ALIGN);
+    CHECK(cellSpursDestroyTaskset2(TS_EA) == CELL_OK);
+    CHECK(vm_read32(TS_EA + CSTS_EVENT_FLAG_ID1) == 0);   /* flags released */
+
+    printf("test_spurs_taskset2: %d passed, %d failed\n", g_pass, g_fail);
+    fflush(stdout);
+    _exit(g_fail ? 1 : 0);   /* skip atexit: the SPURS kernel threads are still up */
+}
diff --git a/libs/spurs/tests/test_spurs_taskset_signal.c b/libs/spurs/tests/test_spurs_taskset_signal.c
new file mode 100644
index 00000000..0cff3726
--- /dev/null
+++ b/libs/spurs/tests/test_spurs_taskset_signal.c
@@ -0,0 +1,178 @@
+/*
+ * ps3recomp - cellSpurs taskset bitset integrity + SPU-side signal wake test
+ *
+ * Two regressions behind MotorStorm Apocalypse's frame-2 hang (EDGE MLAA tasks
+ * parked forever on a CellSpursBarrier):
+ *
+ *  1. cellSpursCreateTask kept a native little-endian `taskCount` in the GUEST
+ *     CellSpursTaskset, at +0x04 -- word 1 of the `running` bitset. After five
+ *     tasks it read back as running = 00000000 05000000 ..., i.e. tasks 37 and
+ *     39 running but not enabled. SPU libspurs' send-signal routine (the one the
+ *     barrier, semaphore and queue release paths use) refuses a taskset whose
+ *     running|ready|pending|signalled|waiting bits are not a subset of
+ *     `enabled`, so the barrier's waiters were never signalled.
+ *  2. That routine signals by setting the task's bit in `signalled` (+0x40)
+ *     with GETLLAR/PUTLLC. A task parked in the HLE WAIT_SIGNAL only noticed on
+ *     its 1 s condvar poll; a committed lock-line write to the taskset now
+ *     wakes it (spu_taskset_line_committed).
+ *  3. A signal sent while a released task's thread had not yet woken up was
+ *     merged into the release and lost: the barrier releases a waiter, the
+ *     PPU's next work kick lands before that waiter's thread runs, and the
+ *     task later sleeps in cellSpursWaitSignal for a kick it already
+ *     consumed. A parked task now consumes its signal when it is delivered,
+ *     and a later one stays latched for the next wait.
+ *
+ * Build like test_spurs_taskset2.c:
+ *
+ *   cc -std=gnu17 -O1 -D_GNU_SOURCE -Iinclude -Ilibs/spurs -Iruntime/spu \
+ *      -Iruntime/ppu -Iruntime/memory -Iruntime/syscalls -Iruntime/platform \
+ *      libs/spurs/tests/test_spurs_taskset_signal.c libs/spurs/tests/test_spurs_stubs.c \
+ *      <build>/libps3recomp_runtime.a \
+ *      -lpthread -lm -lstdc++ -o /tmp/test_spurs_taskset_signal && /tmp/test_spurs_taskset_signal
+ */
+#include "cellSpurs.h"
+#include "spurs_taskset.h"
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#define MEM_SIZE (16u << 20)
+uint8_t* vm_base;
+
+static int g_fail, g_pass;
+#define CHECK(c) do { if (c) g_pass++; else { g_fail++; \
+    fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); } } while (0)
+
+enum {
+    SPURS_EA = 0x100000,
+    TS_EA    = 0x200000,   /* CellSpursTaskset (0x1900) */
+    ELF_EA   = 0x220000,   /* not an SPU ELF -> never dispatched */
+    ARG_EA   = 0x230000,
+    LSP_EA   = 0x230100,
+    ID_EA    = 0x230200,
+};
+
+void spu_taskset_parked_add(uint32_t, uint32_t, uint32_t);
+void spu_taskset_parked_del(uint32_t, uint32_t);
+int  spu_taskset_wait_signal(uint32_t, uint32_t);
+void spu_taskset_line_committed(uint32_t);
+void spu_taskset_signal_task(uint32_t, uint32_t);
+void spu_coh_notify_write(uint32_t);
+
+static unsigned long long now_ms(void)
+{
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
+    return (unsigned long long)t.tv_sec * 1000ull + (unsigned long long)t.tv_nsec / 1000000ull;
+}
+
+static volatile int g_woke, g_woke2;
+static void* waiter2(void* p)
+{
+    (void)p;
+    spu_taskset_wait_signal(TS_EA, 2);
+    g_woke2 = 1;
+    return NULL;
+}
+
+/* Two signals back to back to a parked task: the first resumes it, the
+ * second must survive for its next wait (which then returns at once). */
+static void two_signals(int spu_release)
+{
+    pthread_t th;
+    g_woke2 = 0;
+    pthread_create(&th, NULL, waiter2, NULL);
+    usleep(50 * 1000);
+    CHECK(!g_woke2);
+    if (spu_release) {
+        /* the barrier's release: an SPU PUTLLC setting the bit, then its notify */
+        const uint64_t m = spu_lockline_mask_ea(TS_EA + CSTS_SIGNALLED);
+        spu_lockline_lock_mask(m);
+        vm_base[TS_EA + CSTS_SIGNALLED] |= (uint8_t)(0x80u >> 2);
+        spu_coh_notify_write(TS_EA + CSTS_SIGNALLED);
+        spu_lockline_unlock_mask(m);
+    } else {
+        spu_taskset_signal_task(TS_EA, 2);
+    }
+    spu_taskset_signal_task(TS_EA, 2);          /* the PPU's next kick */
+    pthread_join(th, NULL);
+    CHECK(g_woke2);
+    CHECK(vm_read8(TS_EA + CSTS_SIGNALLED) & (0x80u >> 2));     /* kick latched */
+    unsigned long long t0 = now_ms();
+    spu_taskset_wait_signal(TS_EA, 2);           /* takes the latched kick */
+    CHECK(now_ms() - t0 < 200);
+    CHECK(!(vm_read8(TS_EA + CSTS_SIGNALLED) & (0x80u >> 2)));
+}
+
+static void* waiter(void* p)
+{
+    (void)p;
+    spu_taskset_parked_add(TS_EA, 3, 0);
+    spu_taskset_wait_signal(TS_EA, 3);
+    spu_taskset_parked_del(TS_EA, 3);
+    g_woke = 1;
+    return NULL;
+}
+
+/* The subset check SPU libspurs makes before it signals a task
+ * (EDGE MLAA task, LS 0xABF0). */
+static int bitsets_consistent(void)
+{
+    for (int w = 0; w < 4; w++) {
+        uint32_t run = vm_read32(TS_EA + CSTS_RUNNING + w * 4);
+        uint32_t rdy = vm_read32(TS_EA + CSTS_READY + w * 4);
+        uint32_t pnd = vm_read32(TS_EA + CSTS_PENDING_READY + w * 4);
+        uint32_t ena = vm_read32(TS_EA + CSTS_ENABLED + w * 4);
+        uint32_t sig = vm_read32(TS_EA + CSTS_SIGNALLED + w * 4);
+        uint32_t wai = vm_read32(TS_EA + CSTS_WAITING + w * 4);
+        if ((run | rdy | pnd | sig | wai) & ~ena) return 0;
+        if ((run & wai) | (rdy & pnd)) return 0;
+    }
+    return 1;
+}
+
+int main(void)
+{
+    vm_base = (uint8_t*)calloc(1, MEM_SIZE);
+    if (!vm_base) return 2;
+
+    CHECK(cellSpursInitialize((CellSpurs*)(uintptr_t)SPURS_EA, 1, 100, 1000, 0) == CELL_OK);
+    CHECK(cellSpursCreateTaskset((CellSpurs*)(uintptr_t)SPURS_EA,
+                                 (CellSpursTaskset*)(uintptr_t)TS_EA, 0, NULL, 1) == CELL_OK);
+    for (int i = 0; i < 5; i++) {
+        vm_write32(ID_EA, 0xDEADBEEF);
+        CHECK(cellSpursCreateTask((CellSpursTaskset*)(uintptr_t)TS_EA,
+                                  (CellSpursTaskId*)(uintptr_t)ID_EA,
+                                  (void*)(uintptr_t)ELF_EA, NULL, 0, LSP_EA, ARG_EA) == CELL_OK);
+        CHECK(vm_read32(ID_EA) == (u32)i);
+    }
+    CHECK(vm_read32(TS_EA + CSTS_ENABLED) == 0xF8000000u);
+    for (int w = 0; w < 4; w++) CHECK(vm_read32(TS_EA + CSTS_RUNNING + w * 4) == 0);
+    CHECK(bitsets_consistent());
+    cellSpursShutdownTaskset((CellSpursTaskset*)(uintptr_t)TS_EA);
+    CHECK(bitsets_consistent());
+
+    /* SPU-side signal: bit set by a lock-line write, then the commit hook. */
+    pthread_t th;
+    pthread_create(&th, NULL, waiter, NULL);
+    usleep(50 * 1000);                          /* let it park */
+    CHECK(!g_woke);
+    unsigned long long t0 = now_ms();
+    vm_write8(TS_EA + CSTS_SIGNALLED, (uint8_t)(vm_read8(TS_EA + CSTS_SIGNALLED) | (0x80u >> 3)));
+    spu_taskset_line_committed(TS_EA);
+    while (!g_woke && now_ms() - t0 < 2000) usleep(1000);
+    unsigned long long dt = now_ms() - t0;
+    CHECK(g_woke);
+    CHECK(dt < 500);                            /* not the 1 s poll */
+    pthread_join(th, NULL);
+    CHECK(!(vm_read8(TS_EA + CSTS_SIGNALLED) & (0x80u >> 3)));   /* consumed */
+
+    two_signals(0);
+    two_signals(1);
+
+    printf("test_spurs_taskset_signal: %d passed, %d failed (wake %llums)\n", g_pass, g_fail, dt);
+    fflush(stdout);
+    _exit(g_fail ? 1 : 0);
+}
