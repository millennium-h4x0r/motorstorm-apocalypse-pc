+static int spu_mfc_atomic(spu_context* ctx, uint32_t cmd)
+{
+    if (cmd != MFC_GETLLAR_CMD && cmd != MFC_PUTLLC_CMD &&
+        cmd != MFC_PUTLLUC_CMD && cmd != MFC_PUTQLLUC_CMD)
+        return 0;
+    if (__builtin_expect(g_spu_diff != 0, 0) && spu_diff_atomic(ctx, cmd, 0)) return 1;
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    int r = spu_mfc_atomic_body(ctx, cmd);
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    if (__builtin_expect(g_spu_diff != 0, 0)) spu_diff_atomic(ctx, cmd, 1);
+    /* SPU_ATOMLOG_IMG=<n>: the first 64 distinct (pc, line, cmd) lock-line
+     * commands of image n -- which lines a task's atomics work on. */
