+/* g_trampoline_fn for MinGW-w64 builds, where the lifted PPU code and the
+ * boot scaffold come from different compilers.
+ *
+ * The port compiles the lifted chunks with clang (work/port/tools/ppu_cxx.sh)
+ * and everything else with GCC. On Linux both emit native ELF TLS for
+ * __thread, so ppu_loader.cpp defines the variable and the lifted code reads
+ * it. MinGW GCC emits emulated TLS instead (__emutls_v.g_trampoline_fn, every
+ * access a call to __emutls_get_address) while clang emits native PE TLS
+ * (g_trampoline_fn in .tls), and the two never link against each other.
+ *
+ * So on MinGW the variable is defined here, in a unit the launcher sends to
+ * the same compiler as the lifted code, and the GCC-built scaffold reaches it
+ * through ppu_trampoline_slot() (see ppu_loader.cpp). The hot side, the lifted
+ * code's drain after every call, keeps a plain native TLS access. If the
+ * lifted code is built by GCC instead (PORT_PPU_GCC=1), this unit is too, and
+ * both sides agree on emulated TLS. */
+#if defined(__MINGW32__)
+
+#include "ppu_tls.h"
+
+extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*) = nullptr;
+
+extern "C" void (**ppu_trampoline_slot(void))(void*)
+{
+    return &g_trampoline_fn;
+}
+
+#endif
