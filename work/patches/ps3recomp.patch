+/* ---- Task id ownership and Taskset2 slot states ---------------------------
+ * (The helpers below hold a lock-line stripe, so they touch guest memory with
+ * raw loads/stores: vm_write32 takes the stripe itself and would deadlock.)
+ *
+ *
+ * Read from SPU libspurs as linked into MotorStorm Apocalypse's Havok tasks
+ * (hkp_integrate: cellSpursCreateTask LS 0x11F28, cellSpursTryJoinTask
+ * LS 0x127E8; hkp_collide has the same code at 0x18E78/0x19738):
+ *
+ *  - create: GETLLAR the header line, id = first CLEAR bit of `enabled`
+ *    (+0x30; EAGAIN when none), set it, clear the id's running/ready/pending/
+ *    signalled/waiting bits, ++u8 +0x71 (live-task count), PUTLLC; write
+ *    TaskInfo; set pending_ready; then GETLLAR task_exit_code[id] (Taskset2
+ *    +0x1980 + 16*id) and HALT (heqi, LS 0x126D8) unless byte 15 is 0x01 or
+ *    0x12; byte 15 |= 0x10 (0x01 -> 0x11) and PUTLLC.
+ *  - TryJoin: GETLLAR the record; byte 14 != 0 -> ESRCH; low nibble 2 ->
+ *    exit code = word +8, byte 15 = 0x04, OK; nibble 3 -> byte 15 = 0x04,
+ *    0x80410920; 0x11 -> EAGAIN (still running); else ESRCH. On OK it then
+ *    clears the id's enabled/running/signalled bits and --u8 +0x71.
+ *
+ * So an id belongs to its task from create until JOIN, not until exit:
+ * `enabled` stays set while the task is exited-but-unjoined (state 0x12),
+ * and it is the join that frees the id. (That is why Havok TryJoins all 128
+ * ids when a create fails, and before each batch of PPU creates.) Every
+ * claim/free of an id is one locked read-modify-write of the header line,
+ * like the SPU's GETLLAR/PUTLLC, so a PPU create can never pick the id an
+ * SPU create is claiming. States: 0x01 free, 0x11 created (live), 0x12
+ * exited (unjoined), 0x04 joined by an SPU TryJoin -- which the SPU create
+ * refuses, so the runtime turns a committed 0x04 back into 0x01 at once
+ * (spu_taskset_line_committed), before the joiner frees the enabled bit. */
+enum {
+    CSTS_LIVE_COUNT       = 0x71,   /* u8: tasks created and not yet joined */
+    CSTS2_TASK_EXIT_CODE  = 0x1980, /* v128 task_exit_code[128] (Taskset2) */
+    CSTS2_NAME_BUF        = 0x18A8, /* be u64 CellSpursTaskNameBuffer* (SPU create/TryJoin PUT 32 B at +32*id) */
+    CSTS2_SIZE            = 0x2900,
+    TS2_ST_FREE           = 0x01,
+    TS2_ST_LIVE           = 0x11,
+    TS2_ST_EXITED         = 0x12,
+    TS2_ST_SPU_JOINED     = 0x04,
+};
+static inline int spurs_is_taskset2(uint32_t ts)
+{ return vm_read32(ts + CSTS_SIZE_FIELD) >= (uint32_t)CSTS2_SIZE; }
+static inline uint32_t spurs_ts2_rec(uint32_t ts, uint32_t id)
+{ return ts + CSTS2_TASK_EXIT_CODE + id * 16u; }
+
+/* Claim the first task id whose enabled bit is clear (and not set in
+ * `reserved`, a 128-bit map, may be NULL): set the bit, and for a Taskset2
+ * also count it in +0x71 -- one locked update of the header line, as SPU
+ * libspurs' create does with GETLLAR/PUTLLC. Returns the id, or 128 if none. */
+static inline uint32_t spurs_taskset_claim_id(uint32_t ts, const uint8_t* reserved, int count_live)
+{
+    const uint64_t llm = spu_lockline_mask_ea(ts);
+    uint32_t id = 128;
+    spu_lockline_lock_mask(llm);
+    uint8_t* en = vm_base + ts + CSTS_ENABLED;
+    for (uint32_t t = 0; t < 128; t++) {
+        const uint8_t m = (uint8_t)(0x80u >> (t % 8));
+        if ((__atomic_load_n(&en[t / 8], __ATOMIC_SEQ_CST) | (reserved ? reserved[t / 8] : 0)) & m) continue;
+        __atomic_fetch_or(&en[t / 8], m, __ATOMIC_SEQ_CST);
+        if (count_live) __atomic_fetch_add(vm_base + ts + CSTS_LIVE_COUNT, 1, __ATOMIC_SEQ_CST);
+        id = t;
+        break;
+    }
+    if (id < 128) spu_coh_notify_write(ts);
+    spu_lockline_unlock_mask(llm);
+    return id;
+}
+
+/* Free a joined id: clear its enabled/running/ready/pending/signalled/waiting
+ * bits and --u8 +0x71, in one locked update (SPU TryJoin's header step). */
+static inline void spurs_taskset_free_id(uint32_t ts, uint32_t id)
+{
+    if (id >= 128) return;
+    const uint64_t llm = spu_lockline_mask_ea(ts);
+    const uint8_t m = (uint8_t)~(0x80u >> (id % 8));
+    spu_lockline_lock_mask(llm);
+    for (uint32_t off = CSTS_RUNNING; off <= CSTS_WAITING; off += 0x10)
+        __atomic_fetch_and(vm_base + ts + off + id / 8, m, __ATOMIC_SEQ_CST);
+    __atomic_fetch_sub(vm_base + ts + CSTS_LIVE_COUNT, 1, __ATOMIC_SEQ_CST);
+    spu_coh_notify_write(ts);
+    spu_lockline_unlock_mask(llm);
+}
+
+/* A Taskset2 create (PPU side), after the id is claimed: record zeroed,
+ * state 0x11. Returns the state it found (0x01 or 0x12 are the legal ones). */
+static inline uint8_t spurs_ts2_mark_created(uint32_t ts, uint32_t id)
+{
+    const uint32_t r = spurs_ts2_rec(ts, id);
+    const uint64_t llm = spu_lockline_mask_ea(r);
+    spu_lockline_lock_mask(llm);
+    const uint8_t old = vm_base[r + 15];
+    memset(vm_base + r, 0, 15);
+    __atomic_store_n(vm_base + r + 15, (uint8_t)TS2_ST_LIVE, __ATOMIC_SEQ_CST);
+    spu_coh_notify_write(r);
+    spu_lockline_unlock_mask(llm);
+    return old;
+}
+
+/* The task's exit (what the taskset policy module does): state 0x12, exit
+ * code in word +8. The id stays allocated (enabled stays set) until a join.
+ * Always 0x12, never "old nibble -> 2": an SPU create sets the new task's
+ * pending bit (and so lets it start) BEFORE it marks the record 0x11, and a
+ * short task (hkp_collide runs in ~0.5 ms) can exit in between -- 0x01 -> 0x02
+ * made the creator's check halt (heqi, hkp_integrate LS 0x126D8). 0x12 is
+ * what the creator accepts, and leaves, for exactly this case. Returns the
+ * old state. */
+static inline uint8_t spurs_ts2_mark_exited(uint32_t ts, uint32_t id, uint32_t exit_code)
+{
+    const uint32_t r = spurs_ts2_rec(ts, id);
+    const uint64_t llm = spu_lockline_mask_ea(r);
+    spu_lockline_lock_mask(llm);
+    const uint8_t old = vm_base[r + 15];
+    { const uint32_t be = __builtin_bswap32(exit_code);   /* raw: vm_write32 takes the stripe */
+      memcpy(vm_base + r + 8, &be, 4); }
+    __atomic_store_n(vm_base + r + 15, (uint8_t)TS2_ST_EXITED, __ATOMIC_SEQ_CST);
+    spu_coh_notify_write(r);
+    spu_lockline_unlock_mask(llm);
+    return old;
+}
+
+/* A PPU join step: 0 = joined (state 0x12 -> 0x01, *exit_code = word +8; the
+ * caller then frees the id), 1 = still running (0x11), -1 = no such task. */
+static inline int spurs_ts2_try_reap(uint32_t ts, uint32_t id, uint32_t* exit_code)
+{
+    const uint32_t r = spurs_ts2_rec(ts, id);
+    const uint64_t llm = spu_lockline_mask_ea(r);
+    int rc;
+    spu_lockline_lock_mask(llm);
+    const uint8_t st = vm_base[r + 15];
+    if (vm_base[r + 14]) rc = -1;
+    else if ((st & 0x0F) == 2) {
+        if (exit_code) { uint32_t be; memcpy(&be, vm_base + r + 8, 4); *exit_code = __builtin_bswap32(be); }
+        __atomic_store_n(vm_base + r + 15, (uint8_t)TS2_ST_FREE, __ATOMIC_SEQ_CST);
+        spu_coh_notify_write(r);
+        rc = 0;
+    } else rc = (st == TS2_ST_LIVE) ? 1 : -1;
+    spu_lockline_unlock_mask(llm);
+    return rc;
+}
+
+/* After a committed SPU atomic on a Taskset2 exit-code line: an SPU TryJoin
+ * left state 0x04 (joined), which the SPU create would halt on; make it 0x01
+ * (free). The joiner frees the enabled bit only after this commit returns,
+ * so no create can claim the slot in between. Returns how many it fixed. */
+static inline int spurs_ts2_fix_joined_line(uint32_t line)
+{
+    int n = 0;
+    for (uint32_t o = 15; o < 128; o += 16) n += vm_base[line + o] == TS2_ST_SPU_JOINED;
+    if (!n) return 0;
+    const uint64_t llm = spu_lockline_mask_ea(line);
+    n = 0;
+    spu_lockline_lock_mask(llm);
+    for (uint32_t o = 15; o < 128; o += 16)
+        if (vm_base[line + o] == TS2_ST_SPU_JOINED) {
+            __atomic_store_n(vm_base + line + o, (uint8_t)TS2_ST_FREE, __ATOMIC_SEQ_CST);
+            n++;
+        }
+    if (n) spu_coh_notify_write(line);
+    spu_lockline_unlock_mask(llm);
+    return n;
+}
+
 /* ---- SpursTasksetContext (SPU local store @ 0x2700, size 0x900) ----------
  * Built by the PM in LS before/while running the leaf task. */
 enum {
