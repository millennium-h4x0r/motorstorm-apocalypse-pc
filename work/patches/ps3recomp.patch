+# status reads keep the registers in locals too. The runtime's MFC path
+# (runtime/spu/spu_channels.c spu_mfc_cmd, spu_dma.h) reads no SPU register
+# but in opt-in diagnostics and never leaves the lifted function sideways; the
+# write-back of every written register and the reload of every used one around
+# each `wrch MFC_Cmd` cost the job modules ~240 vector moves per DMA.
+_SAFE_CTX_MFC_RE = re.compile(r"spu_ls_(?:read|write)128\(ctx,|spu_loop_tick\(ctx|spu_job_entry_note\(ctx, \w+\)|"
+                              r"spu_wrch\(ctx, MFC_(?:LSA|EAH|EAL|Size|TagID|Cmd|WrTagMask|WrTagUpdate),|"
+                              r"spu_rdch\(ctx, MFC_(?:RdTagStat|RdAtomicStat)\)|spu_int_set\(ctx,|"
