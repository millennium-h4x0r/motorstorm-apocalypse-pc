@@ -0,0 +1,24 @@
+/*
+ * ps3recomp - link stubs for the libs/input host tests
+ *
+ * cellPad.c is built on its own here (no runtime library), so the symbols its
+ * guest-memory accessors reference (ppu_memory.h's write-watch, reservation
+ * and SPU-coherence hooks) are supplied as inert stand-ins. None of them does
+ * anything: the tests never arm a write watch, a reservation or an SPU.
+ */
+#include <stdint.h>
+
