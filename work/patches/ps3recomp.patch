+    CELL_FONT_O_LIB_VERSION = 0x04,
+    CELL_FONT_O_LIB_MAGIC   = 0x08,   /* SystemClosed[0]: ours */
+    CELL_FONT_O_LIB_SLOT    = 0x0C,   /* SystemClosed[1]: ours */
