+
+def _lr_idx(m) -> int:
+    if m.group(1) is not None:
+        return int(m.group(1))
+    if m.group(2) is not None:
+        return _LR_SPECIAL[m.group(2)]
+    if m.group(3) is not None:
+        return _LR_FPR0 + int(m.group(3))
+    return _LR_VR0 + int(m.group(4))
+
+
+def _lr_mask(s: str) -> int:
+    mask = 0
+    for m in _LR_REG_RE.finditer(s):
+        mask |= 1 << _lr_idx(m)
+    return mask
+
+
+def _lr_reads(s: str) -> int:
+    """Registers s may read: every mention but the target of a plain `=`."""
+    return _lr_mask(_LR_PLAIN_LHS_RE.sub("=", s))
+
+
+def _lr_maydef(s: str) -> int:
+    mask = 0
+    for m in _LR_WRITE_RE.finditer(s):
+        mask |= _lr_mask(m.group(0))
+    return mask
+
+
+def _lr_split_top(s: str, sep: str = ";") -> list[str]:
+    if s.count(sep) <= 1 and "{" not in s:
+        return s.split(sep)
+    out, depth, cur = [], 0, []
+    for ch in s:
+        if ch in "([{":
+            depth += 1
+        elif ch in ")]}":
+            depth -= 1
+        if ch == sep and depth == 0:
+            out.append("".join(cur))
+            cur = []
+        else:
+            cur.append(ch)
+    out.append("".join(cur))
+    return out
+
+
+def _lr_mustdef(t: str) -> int:
+    """Registers a pure line always writes: plain assignments that are
+    top-level statements of the line (or of a plain `{ ... }` block)."""
+    if _LR_KW_RE.match(t):
+        return 0
+    if t.startswith("{") and t.endswith("}"):
+        t = t[1:-1].strip()
+    mask = 0
+    for st in _lr_split_top(t):
+        st = st.strip()
+        if _LR_KW_RE.match(st):
+            continue
+        m = _LR_MUSTDEF_RE.match(st)
+        if m:
+            mask |= _lr_mask(m.group(0))
+    return mask
+
+
+def _lr_rewrite(s: str) -> str:
+    return _LR_REG_RE.sub(lambda m: _LR_NAMES[_lr_idx(m)], s)
+
+
+@functools.lru_cache(maxsize=1 << 18)
+def _lr_rewrite_cached(line: str) -> str:
+    return _lr_rewrite(line)
+
+
+def _lr_touches_ctx(t: str) -> bool:
+    """t hands ctx (or a ctx register it cannot rewrite) to something."""
+    return re.search(r"\bctx\b", _LR_SAFE_CTX_RE.sub("", _LR_REG_RE.sub("", t))) is not None
+
+
+def _lr_balanced(t: str) -> bool:
+    d = {"(": 0, "[": 0, "{": 0}
+    close = {")": "(", "]": "[", "}": "{"}
+    for ch in t:
+        if ch in d:
+            d[ch] += 1
+        elif ch in close:
+            d[close[ch]] -= 1
+            if d[close[ch]] < 0:
+                return False
+    return not any(d.values())
+
+
+def _lr_split_if(t: str):
+    """`if (COND) REST` -> (COND, REST), or None."""
+    if not t.startswith("if ("):
+        return None
+    i, depth = 4, 1
+    while i < len(t) and depth:
+        depth += {"(": 1, ")": -1}.get(t[i], 0)
+        i += 1
+    if depth:
+        return None
+    return t[4:i - 1], t[i:].strip()
+
+
+def _lr_is_exit_body(t: str) -> bool:
+    """t always leaves the function and does not branch inside it."""
+    if t.startswith("{") and t.endswith("}"):
+        t = t[1:-1].strip()
+    if not t.endswith("return;") or len(re.findall(r"\breturn\b", t)) != 1:
+        return False
+    return re.search(r"\b(?:if|else|goto|for|while|do|switch|break|continue)\b", t) is None
+
+
+def _lr_classify(line: str):
+    t = _LR_COMMENT_RE.sub("", line).strip()
+    if _LR_LABEL_RE.fullmatch(t):
+        return ("label", t[:-1])
+    if not t:
+        return ("pure", [])
+    if "/*" in t or "*/" in t or "//" in t or not _lr_balanced(t):
+        raise _LocalRegsUnsupported("comment/unbalanced: " + t[:120])
+    if t.endswith(")") or t.endswith("else") or (not t.endswith(";") and not t.endswith("}")):
+        raise _LocalRegsUnsupported("dangling statement: " + t[:120])
+    exits = re.search(r"\breturn\b|\bg_trampoline_fn\b|longjmp", t) is not None
+    if not exits:
+        if _lr_touches_ctx(t):
+            if re.search(r"\b(?:goto|break|continue)\b", t):
+                raise _LocalRegsUnsupported("control transfer in a sync line: " + t[:120])
+            return ("sync", None)
+        targets = _LR_GOTO_RE.findall(t)
+        if len(re.findall(r"\bgoto\b", t)) != len(targets) or re.search(r"\b(?:break|continue)\b", t):
+            raise _LocalRegsUnsupported("odd goto: " + t[:120])
+        falls = not re.fullmatch(r"goto loc_[0-9A-Fa-f]+;", t)
+        return ("pure", targets, falls)
+    m = _LR_SWITCH_RE.fullmatch(t)
+    if m:
+        if _lr_touches_ctx(m.group("expr")) or not _lr_is_exit_body(m.group("dflt")):
+            raise _LocalRegsUnsupported("switch: " + t[:120])
+        targets = _LR_GOTO_RE.findall(m.group("cases"))
+        if len(re.findall(r"\bgoto\b", t)) != len(targets):
+            raise _LocalRegsUnsupported("switch: " + t[:120])
+        return ("switch", m.group("expr"), targets)
+    sp = _lr_split_if(t)
+    if sp is not None:
+        cond, rest = sp
+        if (_lr_touches_ctx(cond) or re.search(r"\breturn\b|\bg_trampoline_fn\b|\bgoto\b", cond)
+                or not _lr_is_exit_body(rest)):
+            raise _LocalRegsUnsupported("conditional exit: " + t[:120])
+        return ("cond_exit", cond)
+    if _lr_is_exit_body(t):
+        return ("exit", None)
+    raise _LocalRegsUnsupported("unknown exit: " + t[:120])
+
+
+def _lr_strip_comments(line: str) -> tuple[str, str]:
+    """(code without comments, the comments re-joined as a suffix)."""
+    coms = _LR_COMMENT_RE.findall(line)
+    return _LR_COMMENT_RE.sub("", line).strip(), "".join(" " + c for c in coms)
+
+
+@functools.lru_cache(maxsize=1 << 18)
+def _lr_classify_cached(line: str):
+    return _lr_classify(line)
+
+
+@functools.lru_cache(maxsize=1 << 18)
+def _lr_info(s: str, line: bool) -> tuple[int, int, int, int]:
+    """(reads, may-writes, must-writes, mentions) of a pure line or a condition."""
+    t = _LR_COMMENT_RE.sub("", s).strip() if line else s
+    maydef = _lr_maydef(t)
+    return _lr_reads(t), maydef, (_lr_mustdef(t) & maydef) if line else 0, _lr_mask(t)
+
+
+def _lr_wb(mask: int) -> str:
+    return " ".join(f"{_LR_CTX[n]} = {_LR_NAMES[n]};" for n in range(_LR_NREG) if mask >> n & 1)
+
+
+def _lr_reload(mask: int) -> str:
+    return " ".join(f"{_LR_NAMES[n]} = {_LR_CTX[n]};" for n in range(_LR_NREG) if mask >> n & 1)
+
+
+class _SplitReg:
+    """A 32-bit local split into parts that each hold their bits in place
+    (--split-cr: CR's eight fields; --split-xer: XER's CA bit and the rest)."""
+
+    def __init__(self, name: str, ctx: str, parts: list):
+        self.name, self.ctx, self.parts = name, ctx, parts
+        self.tmp = name + "t"
+        self.value = "(" + " | ".join(n for n, _ in parts) + ")"
+        self.write_re = re.compile(rf"(?<![\w.>]){name} = (?!=)")
+        self.read_re = re.compile(rf"(?<![\w.>]){name}\b")
+        self.addr_re = re.compile(rf"&{name}\b")
+
+    def assign(self, src: str) -> str:
+        return " ".join(f"{n} = {src} & 0x{m:08X}u;" for n, m in self.parts)
+
+
+_SPLIT_CR = _SplitReg("_cr", "ctx->cr", [(f"_cr{k}", 0xF0000000 >> (4 * k)) for k in range(8)])
+_SPLIT_XER = _SplitReg("_xer", "ctx->xer", [("_xca", 0x20000000), ("_xrest", 0xDFFFFFFF)])
+
+
+def _lr_split_line(sr: _SplitReg, line: str) -> str:
+    """One line of a localized body with the split register's local turned into
+    its parts: each `R = E;` becomes `{ const uint32_t Rt = E; P0 = Rt & M0;
+    ... }` and every other mention the OR of the parts. Every part is always
+    written: a part the write leaves alone gets back its old value, which the
+    compiler sees through (the masks make the parts disjoint), so an update of
+    one part (a compare's CR field, an addic's CA) no longer keeps the previous
+    update of every other part alive until the next write-back. A line that
+    takes the register's address (srawi's helper) runs on a whole copy inside
+    a block. Raises _LocalRegsUnsupported on a shape it does not know."""
+    if sr.addr_re.search(line):
+        t = line.strip()
+        if re.search(r"\b(?:goto|return|if|else|switch|case|for|while|do)\b|g_trampoline_fn", t) or not t.endswith(";"):
+            raise _LocalRegsUnsupported(f"split: address of {sr.name} in a control line")
+        ind = line[:len(line) - len(line.lstrip())]
+        body = sr.read_re.sub(sr.tmp, t)
+        return f"{ind}{{ uint32_t {sr.tmp} = {sr.value}; {body} {sr.assign(sr.tmp)} }}"
+    out, pos = [], 0
+    for m in sr.write_re.finditer(line):
+        if m.start() < pos:
+            raise _LocalRegsUnsupported("split: nested write")
+        before = line[:m.start()].rstrip()
+        if before and before[-1] not in "{};)":
+            raise _LocalRegsUnsupported("split: write in an expression: " + line[:120])
+        i, depth = m.end(), 0
+        while i < len(line):
+            ch = line[i]
+            if ch in "([{":
+                depth += 1
+            elif ch in ")]}":
+                depth -= 1
+                if depth < 0:
+                    raise _LocalRegsUnsupported("split: unterminated write")
+            elif ch == ";" and depth == 0:
+                break
+            i += 1
+        else:
+            raise _LocalRegsUnsupported("split: unterminated write")
+        rhs = sr.read_re.sub(sr.value, line[m.end():i])
+        out.append(sr.read_re.sub(sr.value, line[pos:m.start()]))
+        out.append(f"{{ const uint32_t {sr.tmp} = {rhs}; {sr.assign(sr.tmp)} }}")
+        pos = i + 1
+    out.append(sr.read_re.sub(sr.value, line[pos:]))
+    return "".join(out)
+
+
+def _lr_split(sr: _SplitReg, out_lines: list[str]) -> list[str]:
+    """--split-cr / --split-xer over a localized body whose first line declares
+    the locals."""
+    decl = out_lines[0]
+    m = re.search(rf"(?<![\w.>]){sr.name} = {re.escape(sr.ctx)}(?=[,;])", decl)
+    if not m:
+        return out_lines
+    fields = ", ".join(f"{n} = {sr.ctx} & 0x{mk:08X}u" for n, mk in sr.parts)
+    res = [decl[:m.start()] + fields + decl[m.end():]]
+    for line in out_lines[1:]:
+        res.append(_lr_split_line(sr, line) if sr.name in line else line)
+    return res
+
+
+def _lr_split_cr(out_lines: list[str]) -> list[str]:
+    return _lr_split(_SPLIT_CR, out_lines)
+
