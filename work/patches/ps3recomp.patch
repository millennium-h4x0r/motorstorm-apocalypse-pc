+/* Watch one more line from now on (a diagnostic hook for the port: a wait
+ * site names the word it waits on at run time), and dump the ring once
+ * after `dump_after` more writes to the watched lines. */
+void spu_lw_add(uint32_t ea, unsigned dump_after)
+{
+    if (s_lw_n < 0) lw_init();
+    const int n = s_lw_n;
+    if (n >= LW_MAX) return;
+    for (int i = 0; i < n; i++) if (s_lw[i] == (ea & ~127u)) return;
+    s_lw[n] = ea & ~127u;
+    coh_mark_line(s_lw[n]);
+    s_lw_dump_at = __atomic_load_n(&s_lw_pos, __ATOMIC_RELAXED) + dump_after;
+    __atomic_store_n(&s_lw_n, n + 1, __ATOMIC_RELEASE);
+    g_spu_lw_on = 1;
+    fprintf(stderr, "[line-watch] watching line 0x%08X (dump after %u writes)\n", s_lw[n], dump_after);
+}
