+static void t_bind_vsc(void* user, const void* data, u32 bytes)
+{
+    (void)user;
+    if (!bq_async() || !data || bytes > BQ_MAX_INLINE) {
+        bq_direct_begin(); Q.be->bind_vs_constants(U, data, bytes); bq_direct_end(); return;
+    }
+    u8* p = BQ_P(bq_reserve(OP_VSC, 16u + bytes));
+    *(u32*)p = bytes;
+    if (bytes && data) memcpy(p + 16, data, bytes);
+}
+
+static void t_bind_vsc_range(void* user, const void* rows, u32 first, u32 count, const void* tail,
+                             u32 tail_bytes, u32 total_bytes)
+{
+    (void)user;
+    if (!bq_async() || !rows) {
+        bq_direct_begin();
+        Q.be->bind_vs_constants_range(U, rows, first, count, tail, tail_bytes, total_bytes);
+        bq_direct_end();
+        return;
+    }
+    u8* p = BQ_P(bq_reserve(OP_VSC_RANGE, 16u + count * 16u + tail_bytes));
+    u32* a = (u32*)p;
+    a[0] = first; a[1] = count; a[2] = tail_bytes; a[3] = total_bytes;
+    if (count) memcpy(p + 16, (const u8*)rows + (size_t)first * 16u, (size_t)count * 16u);
+    if (tail_bytes) memcpy(p + 16 + (size_t)count * 16u, tail, tail_bytes);
+}
+
+/* bind_vs_constants_delta: the rows of [first, first + count) whose dirty
+ * bit is set go into the record (and their bits are cleared); the worker
+ * keeps every row in s_vsc_mirror and hands the backend that. */
+static void t_bind_vsc_delta(void* user, const void* rows, u32 first, u32 count, u64* dirty,
+                             const void* tail, u32 tail_bytes, u32 total_bytes)
+{
+    (void)user;
+    if (!rows || first + count > 512u) {
+        t_bind_vsc_range(user, rows, first, count, tail, tail_bytes, total_bytes);
+        return;
+    }
+    u16 idx[512]; u32 nd = 0;
+    for (u32 r = first; r < first + count; ) {
+        const u64 w = dirty[r >> 6] >> (r & 63u);
+        if (!w) { r = (r | 63u) + 1u; continue; }
+        const u32 z = (u32)__builtin_ctzll(w);
+        r += z;
+        if (r >= first + count) break;
+        idx[nd++] = (u16)r;
+        dirty[r >> 6] &= ~(1ull << (r & 63u));
+        r++;
+    }
+    const u8* src = (const u8*)rows;
+    if (!bq_async()) {
+        bq_direct_begin();
+        for (u32 k = 0; k < nd; k++) memcpy(s_vsc_mirror[idx[k]], src + (size_t)idx[k] * 16u, 16);
+        Q.be->bind_vs_constants_range(U, s_vsc_mirror, first, count, tail, tail_bytes, total_bytes);
+        bq_direct_end();
+        return;
+    }
+    const u32 ib = (nd * 2u + 15u) & ~15u;
+    u8* p = BQ_P(bq_reserve(OP_VSC_DELTA, 32u + ib + nd * 16u + tail_bytes));
+    u32* a = (u32*)p;
+    a[0] = first; a[1] = count; a[2] = tail_bytes; a[3] = total_bytes; a[4] = nd;
+    memcpy(p + 32, idx, (size_t)nd * 2u);
+    u8* q = p + 32 + ib;
+    for (u32 k = 0; k < nd; k++) memcpy(q + (size_t)k * 16u, src + (size_t)idx[k] * 16u, 16);
+    if (tail_bytes) memcpy(q + (size_t)nd * 16u, tail, tail_bytes);
+}
+
+static void t_bind_psc(void* user, const void* data, u32 bytes)
+{
+    (void)user;
+    if (!bq_async() || !data || bytes > BQ_MAX_INLINE) {
+        bq_direct_begin(); Q.be->bind_ps_constants(U, data, bytes); bq_direct_end(); return;
+    }
+    if (bq_s_on()) {
+        if ((S.have & BQ_S_PSC) && S.psc_bytes == bytes && !memcmp(S.psc, data, bytes) && bq_elide()) return;
+        if (bytes <= BQ_PSC_MEMO) { S.psc_bytes = bytes; memcpy(S.psc, data, bytes); S.have |= BQ_S_PSC; }
+        else S.have &= ~(u32)BQ_S_PSC;
+    }
+    u8* p = BQ_P(bq_reserve(OP_PSC, 16u + bytes));
+    *(u32*)p = bytes;
+    if (bytes && data) memcpy(p + 16, data, bytes);
+}
