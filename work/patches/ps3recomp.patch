+#!/usr/bin/env python3
+"""Checks for the PPU lifter's --fast-mm header (apply_fast_mm).
+
+The fast header calls the out-of-line guest accesses through hand-written
+thunks that callers see as clang's preserve_all convention: every register
+but RAX and R11 survives, YMM0-15 whole. clang 18 cannot be trusted to write
+that function itself (it ends an AVX preserve_all function with a vzeroupper,
+which zeroes the upper halves of the YMM registers it has just restored), so
+this builds a caller that keeps integer, double and 256-bit vector values live
+across a cold call into a callee that clobbers every caller-saved register,
+and checks it computes what the same code with an ordinary call computes. It
+also builds the generated header once with GCC (a port's native code includes
+it) and checks the thunks are used under clang.
+
+Usage:  python3 tools/test_ppu_fast_mm.py
+"""
+
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, TOOLS)
+
+from ppu_lifter import HEADER_PREAMBLE, apply_fast_mm
+
+FAILS = []
+
+
+def check(name, cond, detail=""):
+    print(f"{'ok  ' if cond else 'FAIL'} {name}" + ("" if cond else f": {detail}"))
+    if not cond:
+        FAILS.append(name)
+
+
+CALLEE = r"""
+#include <stdint.h>
+/* The out-of-line accessors the thunks call, clobbering every caller-saved
+ * register on the way. */
+#define CLOBBER __asm__ volatile( \
+    "mov $0x1111,%%rcx; mov $0x2222,%%rdx; mov $0x3333,%%rsi; mov $0x4444,%%rdi;" \
+    "mov $0x5555,%%r8; mov $0x6666,%%r9; mov $0x7777,%%r10; mov $0x8888,%%r11;" \
+    "vpcmpeqd %%ymm0,%%ymm0,%%ymm0; vpcmpeqd %%ymm1,%%ymm1,%%ymm1; vpcmpeqd %%ymm2,%%ymm2,%%ymm2;" \
+    "vpcmpeqd %%ymm3,%%ymm3,%%ymm3; vpcmpeqd %%ymm4,%%ymm4,%%ymm4; vpcmpeqd %%ymm5,%%ymm5,%%ymm5;" \
+    "vpcmpeqd %%ymm6,%%ymm6,%%ymm6; vpcmpeqd %%ymm7,%%ymm7,%%ymm7; vpcmpeqd %%ymm8,%%ymm8,%%ymm8;" \
+    "vpcmpeqd %%ymm9,%%ymm9,%%ymm9; vpcmpeqd %%ymm10,%%ymm10,%%ymm10; vpcmpeqd %%ymm11,%%ymm11,%%ymm11;" \
+    "vpcmpeqd %%ymm12,%%ymm12,%%ymm12; vpcmpeqd %%ymm13,%%ymm13,%%ymm13; vpcmpeqd %%ymm14,%%ymm14,%%ymm14;" \
+    "vpcmpeqd %%ymm15,%%ymm15,%%ymm15; vzeroupper" ::: "rcx","rdx","rsi","rdi","r8","r9","r10","r11", \
+    "xmm0","xmm1","xmm2","xmm3","xmm4","xmm5","xmm6","xmm7","xmm8","xmm9","xmm10","xmm11", \
+    "xmm12","xmm13","xmm14","xmm15","memory")
+uint32_t vm_read32(uint64_t a) { CLOBBER; return (uint32_t)(a * 3); }
+volatile uint64_t g_written;
+void vm_write32(uint64_t a, uint32_t v) {
+    CLOBBER; __asm__ volatile("mov $0x9999,%%rax" ::: "rax"); g_written += a ^ v; }
