+void spu_wrch(spu_context* ctx, uint32_t channel, u128 value);
+extern volatile int g_spu_wrch_slow;
+/* SPU_JOB_COUNT=1 with a lift made with SPU_LIFT_COUNT=1 (spu_lifter.py
+ * --entry-count-at): each job module run is counted by its overlay image and
+ * printed every 10 s (spu_channels.c). */
