+static void t_present(void* user, u32 surface)
+{
+    (void)user;
+    bq_run_done();
+    if (!bq_async()) { bq_direct_begin(); Q.be->present(U, surface); bq_direct_end(); return; }
+    /* Two presents queued at most. Nothing else bounds them before the
+     * game's first flip: the boot refreshes the window every 4 ms while the
+     * worker, with VSync, shows one per refresh, so on the start screen the
+     * backlog grew by the second and the first wait after it lasted as long. */
+    if (Q.presents_sent >= 2) {
+        const u64 t0 = RSX_HS_T0();
+        bq_wait_for(&Q.presents_done, Q.presents_sent - 1);
+        RSX_HS_END(HS_BQ_PRESENTQ, t0);
+    }
+    *(u32*)BQ_P(bq_reserve(OP_PRESENT, 4)) = surface;
+    Q.presents_sent++;
+    bq_publish();
+}
+
+int rsx_be_thread_presents_queued(void)
+{
+    if (!Q.on) return 0;
+    return (int)(Q.presents_sent - __atomic_load_n(&Q.presents_done, __ATOMIC_ACQUIRE));
+}
+
+static void t_readback(void* user, u32 surface, u32 x, u32 y, u32 w, u32 h, void* out, u32 pitch)
+{
+    (void)user;
+    bq_direct_begin(); Q.be->readback(U, surface, x, y, w, h, out, pitch); bq_direct_end();
+}
+static u32 t_color_snapshot_rect(void* user, u32 surface, u32 w, u32 h)
+{
+    (void)user;
+    /* PS3RECOMP_BQ_SNAP_RECT=1: like the other snapshots, a repeat of the
+     * same (target, size) is queued and answered from the last handle (the
+     * backend keeps one a size, PS3RECOMP_VK_SNAPCACHE): ~300 a frame at 4P
+     * each waited for the worker to drain (bq_sync ~6 ms a frame). */
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_BQ_SNAP_RECT"); on = e && e[0] == '1'; }
+    if (on) return bq_snapshot(4, surface, w, h);
+    bq_direct_begin(); const u32 r = Q.be->color_snapshot_rect(U, surface, w, h); bq_direct_end();
+    return r;
+}
+static void t_color_upload(void* user, u32 surface, u32 y0, u32 w, u32 rows,
+                           const void* src, u32 row_bytes)
+{
+    (void)user;
+    bq_direct_begin(); Q.be->color_target_upload(U, surface, y0, w, rows, src, row_bytes); bq_direct_end();
+}
+static void t_color_upload_rect(void* user, u32 surface, u32 x0, u32 y0, u32 w, u32 rows,
+                                const void* src, u32 row_bytes)
+{
+    (void)user;
+    bq_direct_begin(); Q.be->color_target_upload_rect(U, surface, x0, y0, w, rows, src, row_bytes); bq_direct_end();
+}
+/* Queued: a GPU copy between two targets the engine keeps alive. Its failures
+ * are structural and repeat, so the answer is the last queued one's: a
+ * failure makes the next call fail (and the engine fall back) one call late. */
+static int t_surface_blit(void* user, u32 src, u32 sx, u32 sy, u32 sw, u32 sh,
+                          u32 dst, u32 dx, u32 dy, u32 dw, u32 dh, u32 flags)
+{
+    (void)user;
+    if (__atomic_exchange_n(&Q.blit_failed, 0, __ATOMIC_ACQ_REL)) return -1;
+    if (!bq_async()) {
+        bq_direct_begin();
+        const int r = Q.be->surface_blit(U, src, sx, sy, sw, sh, dst, dx, dy, dw, dh, flags);
+        bq_direct_end();
+        return r;
+    }
+    u32* a = (u32*)BQ_P(bq_reserve(OP_SURFACE_BLIT, 44));
+    a[0] = src; a[1] = sx; a[2] = sy; a[3] = sw; a[4] = sh;
+    a[5] = dst; a[6] = dx; a[7] = dy; a[8] = dw; a[9] = dh; a[10] = flags;
+    bq_publish();
+    return 0;
+}
+static int t_depth_readback(void* user, u32 depth, u32 w, u32 h, float* out)
+{
+    (void)user;
+    bq_direct_begin(); const int r = Q.be->depth_readback(U, depth, w, h, out); bq_direct_end();
+    return r;
+}
+static int t_stencil_readback(void* user, u32 depth, u32 w, u32 h, u8* out)
+{
+    (void)user;
+    bq_direct_begin(); const int r = Q.be->stencil_readback(U, depth, w, h, out); bq_direct_end();
+    return r;
+}
+static int t_readback_deferred(void* user, u32 surface, u32 w, u32 h,
+                               void (*done)(void*, const void*, u32), void* cookie)
+{
+    (void)user;
+    if (!Q.on) return Q.be->readback_deferred(U, surface, w, h, done, cookie);
+    bq_rbctx* c = (bq_rbctx*)malloc(sizeof *c);
+    if (!c) return -1;
+    c->done = done; c->cookie = cookie; c->h = h;
+    bq_direct_begin(); const int r = Q.be->readback_deferred(U, surface, w, h, bq_rb_tramp, c); bq_direct_end();
+    if (r) free(c);
+    return r;
+}
+/* Queued as native_lighting is, keyed on the two inputs: the same normals
+ * target and depth snapshot are the same size, so the backend refills the
+ * same three images. PS3RECOMP_BQ_LTASYNC=0 turns both off. */
+static int t_native_ssao(void* user, u32 normals, u32 depth, const float params[28], u32 out[3])
+{
+    (void)user;
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_BQ_LTASYNC"); on = !(e && e[0] == '0'); }
+    const int failed = __atomic_exchange_n(&Q.ao_failed, 0, __ATOMIC_ACQ_REL);
+    if (on && bq_async() && !failed && Q.ao_out[0] && normals == Q.ao_in[0] && depth == Q.ao_in[1]) {
+        u32* a = (u32*)BQ_P(bq_reserve(OP_NATIVE_SSAO, 20u + 28u * 4u));
+        a[0] = normals; a[1] = depth;
+        a[2] = Q.ao_out[0]; a[3] = Q.ao_out[1]; a[4] = Q.ao_out[2];
+        memcpy(a + 5, params, 28u * 4u);
+        memcpy(out, Q.ao_out, sizeof Q.ao_out);
+        return 0;
+    }
+    bq_direct_begin(); const int r = Q.be->native_ssao(U, normals, depth, params, out); bq_direct_end();
+    if (r) { memset(Q.ao_out, 0, sizeof Q.ao_out); }
+    else { memcpy(Q.ao_out, out, sizeof Q.ao_out); Q.ao_in[0] = normals; Q.ao_in[1] = depth; }
+    return r;
+}
+/* Queued: it is a GPU copy, and waiting for the worker to drain before it
+ * cost two drains a frame. Its failures are structural (format, size) and
+ * repeat every frame, so the answer given is the previous queued one's: a
+ * failure turns native lighting off one call late. */
+static int t_native_latch(void* user, u32 which, u32 src)
+{
+    (void)user;
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_BQ_LATCHASYNC"); on = !(e && e[0] == '0'); }
+    if (!on || !bq_async()) {
+        bq_direct_begin(); const int r = Q.be->native_latch(U, which, src); bq_direct_end();
+        return r;
+    }
+    if (__atomic_load_n(&Q.latch_failed, __ATOMIC_ACQUIRE)) return -1;
+    u32* a = (u32*)BQ_P(bq_reserve(OP_NATIVE_LATCH, 8));
+    a[0] = which; a[1] = src;
+    return 0;
+}
+/* Queued once a direct call has given the images: the backend refills the
+ * same two every call while the size holds, and the draws that sample them
+ * come after it in the queue. Waiting for the drain instead was the frame's
+ * longest stall (up to 100 ms in the city). A failure, or images that moved,
+ * sends the next call direct again: one call late, as native_latch. */
+static int t_native_lighting(void* user, const u32* words, u32 count, u32 out[2])
+{
+    (void)user;
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_BQ_LTASYNC"); on = !(e && e[0] == '0'); }
+    const u32 w = count > 25u ? words[24] : 0, h = count > 25u ? words[25] : 0;
+    const int failed = __atomic_exchange_n(&Q.lt_failed, 0, __ATOMIC_ACQ_REL);
+    if (on && bq_async() && !failed && Q.lt_out[0] && w == Q.lt_w && h == Q.lt_h &&
+        12u + count * 4u <= BQ_MAX_INLINE) {
+        u32* a = (u32*)BQ_P(bq_reserve(OP_NATIVE_LIGHTING, 12u + count * 4u));
+        a[0] = count; a[1] = Q.lt_out[0]; a[2] = Q.lt_out[1];
+        memcpy(a + 3, words, (size_t)count * 4u);
+        out[0] = Q.lt_out[0]; out[1] = Q.lt_out[1];
+        return 0;
+    }
+    bq_direct_begin(); const int r = Q.be->native_lighting(U, words, count, out); bq_direct_end();
+    if (r) { Q.lt_out[0] = Q.lt_out[1] = 0; }
+    else { Q.lt_out[0] = out[0]; Q.lt_out[1] = out[1]; Q.lt_w = w; Q.lt_h = h; }
+    return r;
+}
+static u32 t_res_scale(void* user) { (void)user; return Q.be->res_scale(U); }
+static u32 t_target_scale(void* user, u32 w, u32 h) { (void)user; return Q.be->target_scale(U, w, h); }
+
+const rsx_draw_backend* rsx_be_thread_wrap(const rsx_draw_backend* be)
+{
+    if (!be) return NULL;
+    { const char* e = getenv("PS3RECOMP_BE_THREAD"); if (!(e && e[0] == '1')) return be; }
+    if (Q.be == be) return &Q.api;
+    if (Q.on) return be;                         /* one wrapped backend at a time */
+    memset(&Q, 0, sizeof Q);
+    pthread_mutex_init(&Q.lock, NULL);
+    pthread_mutex_init(&Q.done_lock, NULL);
+    Q.be = be;
+    rsx_draw_backend* a = &Q.api;
+    *a = *be;                                    /* the flags; every hook is replaced below */
+    a->user = NULL;
+#define W(field, fn) a->field = be->field ? fn : NULL
+    W(init, t_init); W(shutdown, t_shutdown); W(submit_and_wait, t_submit_and_wait);
+    W(texture_create, t_texture_create); W(texture_upload, t_texture_upload);
+    W(texture_release, t_texture_release);
+    W(color_target_create, t_color_create); W(color_target_release, t_color_release);
+    W(color_target_upload, t_color_upload); W(color_snapshot_rect, t_color_snapshot_rect);
+    W(surface_view, t_surface_view);
+    W(depth_target_create, t_depth_create); W(depth_target_release, t_depth_release);
+    W(depth_snapshot, t_depth_snapshot); W(color_snapshot, t_color_snapshot);
+    W(depth_snapshot_rgba8, t_depth_snapshot_rgba8);
+    W(pipeline_create, t_pipeline_create); W(pipeline_release, t_pipe_release);
+    W(bind_targets, t_bind_targets); W(bind_pipeline, t_bind_pipeline);
+    W(bind_vs_constants, t_bind_vsc); W(bind_ps_constants, t_bind_psc);
+    W(bind_textures, t_bind_textures); W(bind_vertex_textures, t_bind_vtextures);
+    W(set_viewport, t_set_viewport); W(set_scissor, t_set_scissor);
+    W(set_stencil_ref, t_set_stencil_ref); W(set_depth_bias, t_set_depth_bias);
+    W(set_depth_bounds, t_set_depth_bounds);
+    W(zpass_count, t_zpass_count); W(zpass_clear, t_zpass_clear); W(zpass_report, t_zpass_report);
+    W(draw, t_draw); W(clear_color, t_clear_color); W(clear_depth_stencil, t_clear_ds);
+    W(present, t_present); W(readback, t_readback);
+    W(bind_vs_constants_range, t_bind_vsc_range);
+    a->bind_vs_constants_delta = be->bind_vs_constants_range ? t_bind_vsc_delta : NULL;
+    W(depth_readback, t_depth_readback); W(stencil_readback, t_stencil_readback);
+    W(native_ssao, t_native_ssao); W(native_latch, t_native_latch);
+    W(native_lighting, t_native_lighting); W(res_scale, t_res_scale); W(target_scale, t_target_scale);
+    W(readback_deferred, t_readback_deferred); W(draw_pulled, t_draw_pulled);
+    W(geo_put, t_geo_put); W(geo_drop, t_geo_drop); W(draw_geo, t_draw_geo);
+    W(color_target_upload_rect, t_color_upload_rect); W(surface_blit, t_surface_blit);
+    W(clear_color_rect, t_clear_color_rect); W(clear_depth_stencil_rect, t_clear_ds_rect);
+    W(texture_create_3d, t_texture_create_3d); W(texture_upload_3d, t_texture_upload_3d);
+    W(depth_view, t_depth_view);
+#undef W
+    a->free_gen = NULL;                          /* the wrapper's own business */
+    a->freed_since = NULL;
+    return a;
+}
+
+#else   /* not Linux: the engine records itself */
+
+const rsx_draw_backend* rsx_be_thread_wrap(const rsx_draw_backend* be) { return be; }
+
+/* Nothing is ever queued: the backend is called directly. */
+int rsx_be_thread_presents_queued(void) { return 0; }
+
+#endif
