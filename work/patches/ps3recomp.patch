diff --git a/libs/input/tests/test_pad_virtual.c b/libs/input/tests/test_pad_virtual.c
new file mode 100644
index 00000000..3ef7f074
--- /dev/null
+++ b/libs/input/tests/test_pad_virtual.c
@@ -0,0 +1,328 @@
+/*
+ * ps3recomp - cellPad virtual-pad test (PS3_PAD_FILE_<n>, PS3_PAD_SCRIPT)
+ *
+ * Drives cellPad the way an unattended MotorStorm Apocalypse run does: four
+ * virtual pads, a timeline script, a held-state file, no real controller. A
+ * simulated clock (pad_test_now_ms) stands in for wall time and each "frame"
+ * polls every port with cellPadGetData, then the big-endian guest packets are
+ * checked per port, along with the connected bits of GetInfo / GetInfo2 /
+ * PeriphGetInfo and the "[pad]" log lines a test harness greps for.
+ *
+ * cellPad.c is compiled into the test with PS3RECOMP_PAD_TEST_HOOKS (no SDL or
+ * XInput backend, test clock, a hook to fake real pads in backend slots).
+ * Build and run (from the ps3recomp root):
+ *
+ *   cc -std=gnu17 -O1 -D_GNU_SOURCE -DPS3RECOMP_PAD_TEST_HOOKS -Iinclude \
+ *      -Ilibs/input -Iruntime/ppu -Iruntime/spu -Iruntime/memory \
+ *      libs/input/cellPad.c libs/input/tests/test_pad_virtual.c \
+ *      libs/input/tests/test_pad_stubs.c -lm -o /tmp/test_pad_virtual \
+ *   && /tmp/test_pad_virtual
+ */
+#include "cellPad.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+uint8_t* vm_base;
+s32 cellPadGetInfo(CellPadInfo2* info);           /* v1; not in cellPad.h */
+void cellPad_test_reload(void);
+void cellPad_test_set_real(int slot, int connected, u16 btns);
+
+static unsigned long long g_now_ms = 100000;
+unsigned long long pad_test_now_ms(void) { return g_now_ms; }
+
+static int g_fail, g_pass;
+#define CHECK(c) do { if (c) g_pass++; else { g_fail++; \
+    fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); } } while (0)
+#define CHECKV(c, fmt, ...) do { if (c) g_pass++; else { g_fail++; \
+    fprintf(stderr, "FAIL %s:%d: %s -- " fmt "\n", __FILE__, __LINE__, #c, __VA_ARGS__); } } while (0)
+
+enum { DATA_EA = 0x1000, INFO_EA = 0x2000, INFO1_EA = 0x3000, PERIPH_EA = 0x4000 };
+
+static u32 rd32(u32 a) { return ((u32)vm_base[a] << 24) | ((u32)vm_base[a+1] << 16) | ((u32)vm_base[a+2] << 8) | vm_base[a+3]; }
+static u16 rd16(u32 a) { return (u16)((vm_base[a] << 8) | vm_base[a+1]); }
+
+typedef struct { s32 len; u16 b[24]; } Pkt;   /* b[] = CellPadData.button[0..23] */
+
+static Pkt get(u32 port)
+{
+    Pkt p; memset(&p, 0, sizeof p);
+    memset(vm_base + DATA_EA, 0xEE, 4 + 2 * CELL_PAD_MAX_CODES);
+    CHECK(cellPadGetData(port, (CellPadData*)(uintptr_t)DATA_EA) == CELL_OK);
+    p.len = (s32)rd32(DATA_EA);
+    for (int i = 0; i < 24; i++) p.b[i] = rd16(DATA_EA + 4 + 2 * i);
+    return p;
+}
+
+/* Packed CELL_PAD_CTRL_* mask of a packet (DIGITAL2 << 8 | DIGITAL1). */
+static u16 btns(const Pkt* p)
+{ return (u16)(((p->b[CELL_PAD_BTN_OFFSET_DIGITAL2] & 0xFF) << 8) | (p->b[CELL_PAD_BTN_OFFSET_DIGITAL1] & 0xFF)); }
+
+static int info2_connected(u32 port, u32* now_connect)
+{
+    CHECK(cellPadGetInfo2((CellPadInfo2*)(uintptr_t)INFO_EA) == CELL_OK);
+    if (now_connect) *now_connect = rd32(INFO_EA + 4);
+    /* CELL_PAD_STATUS_ASSIGN_CHANGES may ride along with a change. */
+    return (rd32(INFO_EA + 12 + 4 * port) & CELL_PAD_STATUS_CONNECTED) != 0;
+}
+static int info1_connected(u32 port)
+{
+    CHECK(cellPadGetInfo((CellPadInfo2*)(uintptr_t)INFO1_EA) == CELL_OK);
+    return (vm_base[INFO1_EA + 0x208 + port] & CELL_PAD_STATUS_CONNECTED) != 0;
+}
+static int periph_connected(u32 port)
+{
+    CHECK(cellPadPeriphGetInfo((CellPadPeriphInfo*)(uintptr_t)PERIPH_EA) == CELL_OK);
+    return (rd32(PERIPH_EA + 12 + 4 * port) & CELL_PAD_STATUS_CONNECTED) != 0;
+}
+
+static void write_file(const char* path, const char* text)
+{
+    FILE* f = fopen(path, "w"); CHECK(f != NULL);
+    if (f) { fputs(text, f); fclose(f); }
+}
+
+static char g_dir[256];
+static void tmp_path(char* out, size_t n, const char* name) { snprintf(out, n, "%s/%s", g_dir, name); }
+
+/* ---------------------------------------------------------------------- */
+/* 1. Four scripted ports + a held-state file on port 0                    */
+/* ---------------------------------------------------------------------- */
+
+#define NFRAMES 200          /* 16 ms frames: t = 0.016 .. 3.2 s */
+
+static void test_script_four_ports(void)
+{
+    char script[300], file0[300], logp[300];
+    tmp_path(script, sizeof script, "race.pad");
+    tmp_path(file0, sizeof file0, "pad0.txt");
+    tmp_path(logp, sizeof logp, "pad.log");
+    write_file(file0, "START RY=10\n");
+    write_file(script,
+        "# split-screen race start\n"
+        "t=0    port=0,1,2 set R2=200       # part throttle\n"
+        "t=0.5  port=1 hold CROSS 0.1\n"
+        "t=0.5  port=1 hold CROSS 0.1       # second tap: must not merge\n"
+        "t=1    port=2 set LX=0 L2\n"
+        "t=1.2  port=2 hold TRIANGLE 0.05 polls=4\n"
+        "t=1.5  port=3 connect\n"
+        "t=1.5  port=3 set r2=255 ly=0\n"
+        "t=2    port=all release all\n"
+        "t=2.5  port=1 release CROSS        # nothing held: harmless\n"
+        "t=3    port=0 bogus CROSS          # bad verb: ignored\n");
+    setenv("PS3_PAD_FILE", file0, 1);
+    setenv("PS3_PAD_SCRIPT", script, 1);
+    unsetenv("PS3_PAD_FILE_0"); unsetenv("PS3_PAD_FILE_1");
+    unsetenv("PS3_PAD_FILE_2"); unsetenv("PS3_PAD_FILE_3");
+
+    /* Capture stdout (the [pad] log) into a file. */
+    fflush(stdout);
+    int saved = dup(1);
+    FILE* lf = freopen(logp, "w", stdout); CHECK(lf != NULL);
+
+    cellPad_test_reload();
+    CHECK(cellPadInit(7) == CELL_OK);
+    for (u32 p = 0; p < 4; p++) cellPadSetPressMode(p, 1);
+
+    /* Before any GetData: 0-2 pinned connected, 3 starts unplugged (its first
+     * event is 'connect'), 4-6 nothing. */
+    u32 nc = 0;
+    CHECK(info2_connected(0, &nc) && info2_connected(1, 0) && info2_connected(2, 0));
+    CHECK(!info2_connected(3, 0) && !info2_connected(4, 0));
+    CHECK(nc == 3);
+    CHECK(info1_connected(0) && info1_connected(2) && !info1_connected(3));
+    CHECK(periph_connected(1) && !periph_connected(3));
+
+    Pkt hist[NFRAMES][4]; memset(hist, 0, sizeof hist);
+    int port3_seen_connected_at = -1;
+    for (int f = 0; f < NFRAMES; f++) {
+        g_now_ms += 16;
+        double t = (f + 1) * 0.016;     /* first GetData (f=0) is t=0 */
+        (void)t;
+        for (u32 p = 0; p < 4; p++) {
+            /* Loading screen: port 2 is not polled from t~1.1 to t~1.6. */
+            if (p == 2 && f >= 69 && f < 100) continue;
+            hist[f][p] = get(p);
+            if (p == 0 && f == 10) {    /* a second read in the same 4 ms: drained */
+                Pkt again = get(0);
+                CHECK(again.len == 0);
+            }
+        }
+        if (port3_seen_connected_at < 0 && info2_connected(3, 0)) port3_seen_connected_at = f;
+    }
+    CHECK(cellPadEnd() == CELL_OK);
+    fflush(stdout);
+    dup2(saved, 1); close(saved);
+    clearerr(stdout);
+
+    /* t~0.1 (frame 6) */
+    for (u32 p = 0; p < 3; p++) {
+        Pkt* k = &hist[6][p];
+        CHECKV(k->len == CELL_PAD_LEN_CHANGE_PRESS_ON, "port %u len %d", p, k->len);
+        CHECKV(btns(k) & CELL_PAD_CTRL_R2, "port %u btns 0x%04X", p, btns(k));
+        CHECKV(k->b[CELL_PAD_BTN_OFFSET_PRESS_R2] == 200, "port %u R2 %u", p, k->b[CELL_PAD_BTN_OFFSET_PRESS_R2]);
+        CHECK(k->b[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_X] == 128);
+    }
+    CHECK(btns(&hist[6][0]) & CELL_PAD_CTRL_START);                 /* file */
+    CHECK(hist[6][0].b[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_Y] == 10);   /* file */
+    CHECK(!(btns(&hist[6][1]) & CELL_PAD_CTRL_START));               /* file is port 0 only */
+    CHECK(hist[6][3].len == 0 && btns(&hist[6][3]) == 0);            /* unplugged */
+
+    /* Port 1: exactly two CROSS presses between t=0.5 and t=1.2, each at least
+     * 4 packets, separated by at least 2 released packets. */
+    int runs = 0, cur = 0, minrun = 1000, gap = 0, mingap = 1000, first = -1;
+    for (int f = 0; f < 75; f++) {
+        int on = (btns(&hist[f][1]) & CELL_PAD_CTRL_CROSS) != 0;
+        if (on && first < 0) first = f;
+        if (on) { if (!cur && runs) { if (gap < mingap) mingap = gap; } cur++; gap = 0; }
+        else    { if (cur) { runs++; if (cur < minrun) minrun = cur; } cur = 0; gap++; }
+        if (on) CHECK(hist[f][1].b[CELL_PAD_BTN_OFFSET_PRESS_CROSS] == 255);
+    }
+    CHECKV(runs == 2, "runs %d", runs);
+    CHECKV(minrun >= 4, "minrun %d", minrun);
+    CHECKV(mingap >= 2, "mingap %d", mingap);
+    CHECKV(first >= 30 && first <= 32, "first CROSS frame %d", first);   /* t=0.5 */
+    CHECK(btns(&hist[1][1]) & CELL_PAD_CTRL_R2);                        /* set kept under hold */
+
+    /* Port 2 after t=1: LX=0, L2 digital + full pressure, R2 still 200. */
+    Pkt* k2 = &hist[66][2];
+    CHECK(k2->b[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_X] == 0);
+    CHECK(btns(k2) & CELL_PAD_CTRL_L2);
+    CHECK(k2->b[CELL_PAD_BTN_OFFSET_PRESS_L2] == 255);
+    CHECK(k2->b[CELL_PAD_BTN_OFFSET_PRESS_R2] == 200);
+
+    /* Port 2 TRIANGLE was due at t=1.2, while the port was not being read; the
+     * hold must survive into >= 4 packets after polling resumes at frame 100. */
+    int tri = 0;
+    for (int f = 100; f < 125; f++) if (btns(&hist[f][2]) & CELL_PAD_CTRL_TRIANGLE) tri++;
+    CHECKV(tri >= 4, "TRIANGLE packets after the loading screen: %d", tri);
+    CHECK(btns(&hist[100][2]) & CELL_PAD_CTRL_TRIANGLE);
+
+    /* Port 3 plugs in at t=1.5 and holds full throttle + stick up. */
+    CHECKV(port3_seen_connected_at >= 92 && port3_seen_connected_at <= 94, "port 3 connected at frame %d", port3_seen_connected_at);
+    Pkt* k3 = &hist[110][3];
+    CHECK(k3->len == CELL_PAD_LEN_CHANGE_PRESS_ON);
+    CHECK((btns(k3) & CELL_PAD_CTRL_R2) && k3->b[CELL_PAD_BTN_OFFSET_PRESS_R2] == 255);
+    CHECK(k3->b[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_Y] == 0);
+
+    /* After t=2 'release all': script state gone on every port; port 0 keeps
+     * its file (START, RY=10). */
+    for (u32 p = 0; p < 4; p++) {
+        Pkt* k = &hist[140][p];
+        u16 want = p == 0 ? CELL_PAD_CTRL_START : 0;
+        CHECKV(btns(k) == want, "port %u btns 0x%04X", p, btns(k));
+        CHECK(k->b[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_X] == 128 && k->b[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_Y] == 128);
+        CHECK(k->b[CELL_PAD_BTN_OFFSET_PRESS_R2] == 0);
+    }
+    CHECK(hist[140][0].b[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_Y] == 10);
+
+    /* The log: one line per event fired, hold ends, the bad line reported. */
+    char logbuf[16384]; size_t n = 0;
+    FILE* r = fopen(logp, "r");
+    if (r) { n = fread(logbuf, 1, sizeof logbuf - 1, r); fclose(r); }
+    logbuf[n] = 0;
+    int cross_fired = 0;
+    for (const char* s = logbuf; (s = strstr(s, "port=1 hold CROSS 0.1")); s++) cross_fired++;
+    CHECKV(cross_fired == 2, "%d", cross_fired);
+    CHECK(strstr(logbuf, "[pad] t=0.000 port=0 set R2=200") || strstr(logbuf, "[pad] t=0.016 port=0 set R2=200"));
+    CHECK(strstr(logbuf, "port=3 connect") != NULL);
+    CHECK(strstr(logbuf, "port=3 set r2=255 ly=0") != NULL);
+    CHECK(strstr(logbuf, "port=2 end hold TRIANGLE") != NULL);
+    CHECK(strstr(logbuf, "port=1 hold CROSS 0.1       # second") == NULL);   /* comments not logged */
+    CHECK(strstr(logbuf, "(due t=0.500)") != NULL);            /* the deferred second tap */
+    CHECK(strstr(logbuf, "port=2 end hold TRIANGLE 0.05 polls=4 (4 packets)") != NULL);
+    CHECK(strstr(logbuf, "port=0 release all") && strstr(logbuf, "port=3 release all"));
+    CHECK(strstr(logbuf, ":11: unknown verb") != NULL);
+    CHECK(strstr(logbuf, "[cellPad] file pad: buttons 0x0008") != NULL);
+    if (g_fail) fprintf(stderr, "---- pad log ----\n%s-----------------\n", logbuf);
+}
+
+/* ---------------------------------------------------------------------- */
+/* 2. Port assignment: virtual port 2 pinned, real pads fill 0, 1, 3        */
+/* ---------------------------------------------------------------------- */
+
+static void test_assignment(void)
+{
+    char file2[300]; tmp_path(file2, sizeof file2, "pad2.txt");
+    write_file(file2, "r2=128, LY=0 bogus\n");
+    unsetenv("PS3_PAD_FILE"); unsetenv("PS3_PAD_SCRIPT");
+    setenv("PS3_PAD_FILE_2", file2, 1);
+
+    cellPad_test_reload();
+    CHECK(cellPadInit(4) == CELL_OK);
+    /* Fake real pads in backend slots 0-2 (seen from the next host poll). */
+    cellPad_test_set_real(0, 1, CELL_PAD_CTRL_CROSS);
+    cellPad_test_set_real(1, 1, CELL_PAD_CTRL_CIRCLE);
+    cellPad_test_set_real(2, 1, CELL_PAD_CTRL_SQUARE);
+    cellPadSetPressMode(2, 1);
+    g_now_ms += 16;
+    Pkt k[4]; for (u32 p = 0; p < 4; p++) k[p] = get(p);
+    CHECK(btns(&k[0]) == CELL_PAD_CTRL_CROSS);
+    CHECK(btns(&k[1]) == CELL_PAD_CTRL_CIRCLE);
+    CHECK(btns(&k[2]) == CELL_PAD_CTRL_R2);
+    CHECK(k[2].b[CELL_PAD_BTN_OFFSET_PRESS_R2] == 128);
+    CHECK(k[2].b[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_Y] == 0);
+    CHECK(btns(&k[3]) == CELL_PAD_CTRL_SQUARE);                 /* slot 2 -> port 3 */
+    u32 nc = 0;
+    CHECK(info2_connected(3, &nc) && nc == 4);
+
+    /* Unplug real slot 1: port 1 disconnects, nothing else moves. */
+    cellPad_test_set_real(1, 0, 0);
+    g_now_ms += 16;
+    for (u32 p = 0; p < 4; p++) k[p] = get(p);
+    CHECK(!info2_connected(1, &nc) && nc == 3);
+    CHECK(k[1].len == 0);
+    CHECK(btns(&k[0]) == CELL_PAD_CTRL_CROSS && btns(&k[3]) == CELL_PAD_CTRL_SQUARE);
+
+    /* A missing file: the port stays connected with nothing held. */
+    unlink(file2);
+    g_now_ms += 16;
+    k[2] = get(2);
+    CHECK(info2_connected(2, 0));
+    CHECK(k[2].len > 0 && btns(&k[2]) == 0 && k[2].b[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_Y] == 128);
+    CHECK(cellPadEnd() == CELL_OK);
+    unsetenv("PS3_PAD_FILE_2");
+}
+
+/* ---------------------------------------------------------------------- */
+/* 3. Nothing configured: the old port-0 fallback, other ports empty         */
+/* ---------------------------------------------------------------------- */
+
+static void test_defaults(void)
+{
+    cellPad_test_reload();
+    CHECK(cellPadInit(7) == CELL_OK);
+    g_now_ms += 16;
+    u32 nc = 0;
+    CHECK(info2_connected(0, &nc) && nc == 1);
+    CHECK(!info2_connected(1, 0) && !info1_connected(1) && info1_connected(0));
+    Pkt k0 = get(0), k1 = get(1);
+    CHECK(k0.len == CELL_PAD_LEN_CHANGE_DEFAULT && btns(&k0) == 0);
+    CHECK(k0.b[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_X] == 128);
+    CHECK(k1.len == 0);
+    /* With a real pad in slot 0 it lands on port 0 as before. */
+    cellPad_test_set_real(0, 1, CELL_PAD_CTRL_START);
+    g_now_ms += 16;
+    k0 = get(0);
+    CHECK(btns(&k0) == CELL_PAD_CTRL_START);
+    CHECK(cellPadEnd() == CELL_OK);
+}
+
+int main(void)
+{
+    vm_base = (uint8_t*)calloc(1, 1u << 20);
+    const char* td = getenv("TMPDIR");
+    snprintf(g_dir, sizeof g_dir, "%s/padtestXXXXXX", td && *td ? td : "/tmp");
+    if (!mkdtemp(g_dir)) { perror("mkdtemp"); return 2; }
+
+    test_script_four_ports();
+    test_assignment();
+    test_defaults();
+
+    char cmd[300]; snprintf(cmd, sizeof cmd, "rm -rf '%s'", g_dir);
+    if (!g_fail) { int rc = system(cmd); (void)rc; }
+    else fprintf(stderr, "(scratch files kept in %s)\n", g_dir);
+    printf("test_pad_virtual: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
