+        const u32 room = buf && size > total ? size - total : 0;
+        const u32 n = ssl_cert_read(bit + 1, room ? buf + total : 0, room);
+        if (!n) missing++;
+        total += n;
+    }
+    printf("[cellSsl] CertificateLoader(flags=0x%llX, buffer=0x%08X, size=%u) -> %u bytes%s\n",
