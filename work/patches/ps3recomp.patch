+/*
+ * mfc_do_transfer without its diagnostics. The full path tests ~30 opt-in
+ * hooks per transfer, and at ~9,000 draws a frame the SPUs make millions of
+ * transfers a second: the tests alone were ~4% of SPURS time. When none of
+ * those variables is set and no host watch is armed, this does what the full
+ * path does for a well-formed transfer and nothing else. Keep the two in step.
+ */
+static inline int mfc_diag_env(void)
+{
+    static const char* const names[] = {
+        "LBP_SKIP_NULL_DMA", "SPU_DMACHK", "SPU_DMA_LAX", "SPU_DMA_RANGE", "SPU_DMA_SKIP_DUMP",
+        "SPU_DMA_STACK_CHECK", "SPU_DMATRACE_ALL", "SPU_DMA_WATCH", "SPU_DSP_IMAGE_EA",
+        "SPU_DUMP_GET", "SPU_GET_EA", "SPU_GET_HAS", "SPU_GETHIST", "SPU_IMG_DMA",
+        "SPU_MFC_TRACE", "SPU_OVL_DIAG", "SPU_OVL_DMA", "SPU_POISON_DMA", "SPU_PUT_EA",
+        "SPU_PUTHIST", "SPU_PUT_RANGE", "SPU_PUT_WATCH", "SPU_SMC_WATCH", "SPU_STACKEA_WATCH", "SPU_PUT_DUMP",
+        "YDKJ_DMA_IMG", "SPU_LS_WATCH", "SPU_DMA_SLOW",
+    };
+    for (unsigned i = 0; i < sizeof names / sizeof names[0]; i++)
+        if (getenv(names[i])) return 1;
+#ifdef SPU_DMA_LOG
+    return 1;
+#else
+    return 0;
+#endif
+}
