+/* The lifted code calls spu_cold_thunk (spu_cold_call): rdi is the argument
+ * block, the stack below the red zone, alignment unknown, and every register
+ * but the flags must come back unchanged. */
+__asm__(
+    ".text\n"
+    ".globl spu_cold_thunk\n"
+    ".type spu_cold_thunk,@function\n"
+    "spu_cold_thunk:\n"
+    "    cmpb $0, g_spu_cold_fast(%rip)\n"
+    "    je   spu_cold_thunk_full\n"
+    "    push %rbp\n"
+    "    mov  %rsp, %rbp\n"
+    "    push %rdi\n"
+    "    and  $-64, %rsp\n"
+    "    call spu_cold_fast\n"
+    "    mov  -8(%rbp), %rdi\n"
+    "    mov  %rbp, %rsp\n"
+    "    pop  %rbp\n"
+    "    cmpl $0, 116(%rdi)\n"
+    "    jne  spu_cold_thunk_full\n"
+    "    ret\n"
+    ".size spu_cold_thunk, .-spu_cold_thunk\n");
+
+/* What the lifted code relies on, checked once on this binary: the fast path
+ * gives spu__av_fm_fix's result and leaves every zmm, k and caller-saved GPR as
+ * it found them. A compiler that puts a vzeroupper before its ret (the port
+ * builds this file with -mllvm -x86-use-vzeroupper=0) or saves less than it
+ * uses fails here, and the full thunk is used throughout. */
+static int spu_cold_fast_selftest(void)
+{
+    spu_cold_args t;
+    memset(&t, 0, sizeof t);
+    t.op = SPU_COLD_FM;
+    const uint32_t a[4] = { 0x7F812345u, 0xFF800001u, 0x3F800000u, 0x7FFFFFFFu };
+    const uint32_t b[4] = { 0x40000000u, 0x7F800000u, 0xBF000000u, 0x00800000u };
+    memcpy(&t.a, a, 16); memcpy(&t.b, b, 16);
+    __m128i va, vb, r0, ok;
+    memcpy(&va, a, 16); memcpy(&vb, b, 16);
+    ok = _mm_setzero_si128(); r0 = _mm_setzero_si128();
+    const __m128i want = spu__av_fm_fix(r0, ok, va, vb);
+    unsigned char same = 0;
+    spu_cold_args* pa = &t;
+    __asm__ volatile(
+        "vpternlogd $0xff, %%zmm0, %%zmm0, %%zmm0\n\t"
+        "vmovdqa64 %%zmm0, %%zmm1\n\t  vmovdqa64 %%zmm0, %%zmm2\n\t  vmovdqa64 %%zmm0, %%zmm3\n\t"
+        "vmovdqa64 %%zmm0, %%zmm4\n\t  vmovdqa64 %%zmm0, %%zmm5\n\t  vmovdqa64 %%zmm0, %%zmm6\n\t"
+        "vmovdqa64 %%zmm0, %%zmm7\n\t  vmovdqa64 %%zmm0, %%zmm8\n\t  vmovdqa64 %%zmm0, %%zmm9\n\t"
+        "vmovdqa64 %%zmm0, %%zmm10\n\t vmovdqa64 %%zmm0, %%zmm11\n\t vmovdqa64 %%zmm0, %%zmm12\n\t"
+        "vmovdqa64 %%zmm0, %%zmm13\n\t vmovdqa64 %%zmm0, %%zmm14\n\t vmovdqa64 %%zmm0, %%zmm15\n\t"
+        "vmovdqa64 %%zmm0, %%zmm16\n\t vmovdqa64 %%zmm0, %%zmm17\n\t vmovdqa64 %%zmm0, %%zmm18\n\t"
+        "vmovdqa64 %%zmm0, %%zmm19\n\t vmovdqa64 %%zmm0, %%zmm20\n\t vmovdqa64 %%zmm0, %%zmm21\n\t"
+        "vmovdqa64 %%zmm0, %%zmm22\n\t vmovdqa64 %%zmm0, %%zmm23\n\t vmovdqa64 %%zmm0, %%zmm24\n\t"
+        "vmovdqa64 %%zmm0, %%zmm25\n\t vmovdqa64 %%zmm0, %%zmm26\n\t vmovdqa64 %%zmm0, %%zmm27\n\t"
+        "vmovdqa64 %%zmm0, %%zmm28\n\t vmovdqa64 %%zmm0, %%zmm29\n\t vmovdqa64 %%zmm0, %%zmm30\n\t"
+        "vmovdqa64 %%zmm0, %%zmm31\n\t"
+        "kxnorq %%k0, %%k0, %%k1\n\t kmovq %%k1, %%k2\n\t kmovq %%k1, %%k3\n\t kmovq %%k1, %%k4\n\t"
+        "kmovq %%k1, %%k5\n\t kmovq %%k1, %%k6\n\t kmovq %%k1, %%k7\n\t"
+        "mov $0x5A5A5A5A5A5A5A5A, %%rax\n\t mov %%rax, %%rcx\n\t mov %%rax, %%rdx\n\t mov %%rax, %%rsi\n\t"
+        "mov %%rax, %%r8\n\t mov %%rax, %%r9\n\t mov %%rax, %%r10\n\t mov %%rax, %%r11\n\t"
+        "mov %%rdi, %%r12\n\t"
+        "lea -128(%%rsp), %%rsp\n\t call spu_cold_thunk\n\t lea 128(%%rsp), %%rsp\n\t"
+        "cmp %%rdi, %%r12\n\t jne 1f\n\t"
+        "cmp %%rax, %%rcx\n\t jne 1f\n\t cmp %%rax, %%rdx\n\t jne 1f\n\t cmp %%rax, %%rsi\n\t jne 1f\n\t"
+        "cmp %%rax, %%r8\n\t jne 1f\n\t cmp %%rax, %%r9\n\t jne 1f\n\t cmp %%rax, %%r10\n\t jne 1f\n\t"
+        "cmp %%rax, %%r11\n\t jne 1f\n\t mov $0x5A5A5A5A5A5A5A5A, %%rcx\n\t cmp %%rax, %%rcx\n\t jne 1f\n\t"
+        "kandq %%k1, %%k2, %%k1\n\t kandq %%k1, %%k3, %%k1\n\t kandq %%k1, %%k4, %%k1\n\t"
+        "kandq %%k1, %%k5, %%k1\n\t kandq %%k1, %%k6, %%k1\n\t kandq %%k1, %%k7, %%k1\n\t"
+        "kortestq %%k1, %%k1\n\t jnc 1f\n\t"
+        "vpandq %%zmm1, %%zmm0, %%zmm0\n\t   vpandq %%zmm2, %%zmm0, %%zmm0\n\t   vpandq %%zmm3, %%zmm0, %%zmm0\n\t"
+        "vpandq %%zmm4, %%zmm0, %%zmm0\n\t   vpandq %%zmm5, %%zmm0, %%zmm0\n\t   vpandq %%zmm6, %%zmm0, %%zmm0\n\t"
+        "vpandq %%zmm7, %%zmm0, %%zmm0\n\t   vpandq %%zmm8, %%zmm0, %%zmm0\n\t   vpandq %%zmm9, %%zmm0, %%zmm0\n\t"
+        "vpandq %%zmm10, %%zmm0, %%zmm0\n\t  vpandq %%zmm11, %%zmm0, %%zmm0\n\t  vpandq %%zmm12, %%zmm0, %%zmm0\n\t"
+        "vpandq %%zmm13, %%zmm0, %%zmm0\n\t  vpandq %%zmm14, %%zmm0, %%zmm0\n\t  vpandq %%zmm15, %%zmm0, %%zmm0\n\t"
+        "vpandq %%zmm16, %%zmm0, %%zmm0\n\t  vpandq %%zmm17, %%zmm0, %%zmm0\n\t  vpandq %%zmm18, %%zmm0, %%zmm0\n\t"
+        "vpandq %%zmm19, %%zmm0, %%zmm0\n\t  vpandq %%zmm20, %%zmm0, %%zmm0\n\t  vpandq %%zmm21, %%zmm0, %%zmm0\n\t"
+        "vpandq %%zmm22, %%zmm0, %%zmm0\n\t  vpandq %%zmm23, %%zmm0, %%zmm0\n\t  vpandq %%zmm24, %%zmm0, %%zmm0\n\t"
+        "vpandq %%zmm25, %%zmm0, %%zmm0\n\t  vpandq %%zmm26, %%zmm0, %%zmm0\n\t  vpandq %%zmm27, %%zmm0, %%zmm0\n\t"
+        "vpandq %%zmm28, %%zmm0, %%zmm0\n\t  vpandq %%zmm29, %%zmm0, %%zmm0\n\t  vpandq %%zmm30, %%zmm0, %%zmm0\n\t"
+        "vpandq %%zmm31, %%zmm0, %%zmm0\n\t"
+        "vpternlogd $0xff, %%zmm1, %%zmm1, %%zmm1\n\t"
+        "vpcmpneqq %%zmm1, %%zmm0, %%k1\n\t"
+        "kortestb %%k1, %%k1\n\t jnz 1f\n\t"
+        "movb $1, %0\n"
+        "1:\n\t"
+        : "+m"(same), "+D"(pa)
+        :
+        : "rax", "rcx", "rdx", "rsi", "r8", "r9", "r10", "r11", "r12", "memory", "cc",
+          "xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7",
+          "xmm8", "xmm9", "xmm10", "xmm11", "xmm12", "xmm13", "xmm14", "xmm15",
+          "xmm16", "xmm17", "xmm18", "xmm19", "xmm20", "xmm21", "xmm22", "xmm23",
+          "xmm24", "xmm25", "xmm26", "xmm27", "xmm28", "xmm29", "xmm30", "xmm31",
+          "k1", "k2", "k3", "k4", "k5", "k6", "k7");
+    __m128i got;
+    memcpy(&got, &t.r, 16);
+    return same && t.op == 0 && _mm_movemask_epi8(_mm_cmpeq_epi8(got, want)) == 0xFFFF;
+}
+__attribute__((constructor)) static void spu_cold_fast_init(void)
+{
+    const char* e = getenv("SPU_COLD_FAST");
+    if ((e && e[0] == '0') || getenv("SPU_FIX_STATS")) return;
+    g_spu_cold_fast = 1;
+    if (!spu_cold_fast_selftest()) {
+        g_spu_cold_fast = 0;
+        fprintf(stderr, "[spu-cold] the fast fix-up path changed registers it must keep: using the full thunk\n");
+    }
+}
+#endif
+
+void spu_cold_dispatch(spu_cold_args* p)
+{
+    spu_context* ctx = (spu_context*)p->ctx;
+    switch (p->op) {
+    case SPU_COLD_LS_READ: {
+        const uint32_t lsa = p->lsa;
+        spu_ls_read_probe(ctx, lsa);
+        spu_ls_watch_hit2(ctx, lsa & (SPU_LS_MASK & ~0xFu), 0, &ctx->ls[lsa & (SPU_LS_MASK & ~0xFu)],
+                          (uint32_t)ctx->pc & SPU_LS_MASK, ctx->gpr[0]._u32[0] & SPU_LS_MASK);
+        return;
+    }
+    case SPU_COLD_LS_WRITE_PRE:
+        spu_ls_write_probe_pre(ctx, p->lsa, p->a);
+        return;
+    case SPU_COLD_LS_WRITE_POST:
+        spu_ls_watch_hit2(ctx, p->lsa, 1, p->p, (uint32_t)ctx->pc & SPU_LS_MASK,
+                          ctx->gpr[0]._u32[0] & SPU_LS_MASK);
+        if (g_spu_smc_watch) spu_ls_write_probe_smc(ctx, p->lsa, p->p);
+        return;
+    default:
+        break;
+    }
+#if defined(__AVX2__) && !defined(SPU_SCALAR_HELPERS) && !defined(__ARM_NEON)
+    __m128i r, ok, a, b, c;
+    memcpy(&r, &p->r, 16); memcpy(&ok, &p->ok, 16);
+    memcpy(&a, &p->a, 16); memcpy(&b, &p->b, 16); memcpy(&c, &p->c, 16);
+    /* SPU_FIX_STATS=1: why float lanes take this path -- an exponent-255
+     * operand, a denormal operand, or neither (the result at or past FLT_MAX,
+     * or a boundary the vector could not settle) -- every 2^20 lanes. */
+    { static int st = -1;
+      if (st < 0) st = getenv("SPU_FIX_STATS") ? 1 : 0;
+      if (st && p->op != SPU_COLD_CXFLT) {
+          static unsigned long long n[3][3];
+          uint32_t m[4], x[4], y[4], z[4];
+          memcpy(m, &ok, 16); memcpy(x, &a, 16); memcpy(y, &b, 16); memcpy(z, &c, 16);
+          const int k = p->op == SPU_COLD_FA ? 0 : p->op == SPU_COLD_FM ? 1 : 2;
+          for (int i = 0; i < 4; i++) {
+              if (m[i]) continue;
+              const uint32_t v[3] = { x[i], y[i], k == 2 ? z[i] : 0 };
+              int e255 = 0, den = 0;
+              for (int j = 0; j < (k == 2 ? 3 : 2); j++) {
+                  const uint32_t e = (v[j] >> 23) & 0xFF;
+                  e255 |= e == 0xFF; den |= e == 0 && (v[j] & 0x7FFFFF);
+              }
+              const unsigned long long t = __atomic_add_fetch(&n[k][e255 ? 0 : den ? 1 : 2], 1, __ATOMIC_RELAXED);
+              (void)t;
+          }
+          static unsigned long long tot;
+          if ((__atomic_add_fetch(&tot, 1, __ATOMIC_RELAXED) & ((1ull << 20) - 1)) == 0)
+              fprintf(stderr, "[spu-fix] fa e255 %llu den %llu other %llu | fm %llu %llu %llu | fma %llu %llu %llu\n",
+                      n[0][0], n[0][1], n[0][2], n[1][0], n[1][1], n[1][2], n[2][0], n[2][1], n[2][2]);
+      } }
+    switch (p->op) {
+    case SPU_COLD_FA:    r = spu__av_fa_fix(r, ok, a, b, p->negp); break;
+    case SPU_COLD_FM:    r = spu__av_fm_fix(r, ok, a, b); break;
+    case SPU_COLD_FMA:   r = spu__av_fma_fix(r, ok, a, b, c, p->negp, p->negc); break;
+    case SPU_COLD_CXFLT: r = spu__av_cxflt_fix(r, ok, a, p->i8, p->flag); break;
+    default: return;
+    }
+    memcpy(&p->r, &r, 16);
+#endif
+}
