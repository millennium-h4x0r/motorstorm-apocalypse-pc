--- /dev/null
+++ b/libs/font/tests/test_cellfont.c
@@ -0,0 +1,265 @@
+/*
+ * ps3recomp - cellFont HLE test: guest struct layouts, allocator callbacks,
+ * the f1/f2 ctx handlers and real glyph rendering.
+ *
+ * Drives the library the way MotorStorm Apocalypse does (fn 0x4FE524 init,
+ * fn 0x500700 glyph cache fill): InitializeWithRevision, the FreeType library
+ * with a MemoryIF whose Malloc/Free are guest OPDs, OpenFontFile on a
+ * /dev_bdvd path, SetScalePixel / GetHorizontalLayout / GetCharGlyphMetrics /
+ * GetKerning, a renderer, a NULL-buffer surface and RenderCharGlyphImage with
+ * the glyph read back through CellFontImageTransInfo. Every result is read
+ * back from guest memory as big-endian at the SDK offset.
+ *
+ * Usage: test_cellfont <font.ttf>   (the TTF stands in for /dev_bdvd/test.ttf)
+ *
+ * Build (from the ps3recomp root), FreeType:
+ *   cc -std=gnu17 -O1 -DPS3RECOMP_HAS_FREETYPE -Iinclude -Ilibs/font \
+ *      $(pkg-config --cflags freetype2) libs/font/tests/test_cellfont.c \
+ *      $(pkg-config --libs freetype2) -lm -o /tmp/test_cellfont
+ * stb_truetype: the same without -DPS3RECOMP_HAS_FREETYPE and pkg-config.
+ */
+#include "../cellFont.c"
+#include <assert.h>
+
+/* ---- runtime stubs ---- */
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+unsigned char g_spu_coh_bitmap[1];
+int g_spu_coh_armed;   /* 0: no SPU reservations, so the coherency paths stay cold */
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_coh_notify_write_from_ppu(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+uint64_t spu_lockline_mask_range(uint32_t ea, uint32_t len) { (void)ea; (void)len; return 0; }
+void spu_lockline_lock_mask(uint64_t m) { (void)m; }
+void spu_lockline_unlock_mask(uint64_t m) { (void)m; }
+
+static const char* g_font_host;
+void ppu_fs_host_path(const char* guest, char* out, size_t cap)
+{
+    snprintf(out, cap, "%s", strcmp(guest, "/dev_bdvd/test.ttf") ? "/nonexistent" : g_font_host);
+}
+
+static struct { uint32_t nid; void (*fn)(ppu_context*); } g_ctx[16];
+static int g_nctx;
+void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(ppu_context*))
+{
+    (void)name; g_ctx[g_nctx].nid = nid; g_ctx[g_nctx].fn = fn; g_nctx++;
+}
+static void (*ctx_fn(const char* name))(ppu_context*)
+{
+    const uint32_t nid = ps3_compute_nid(name);
+    for (int i = 0; i < g_nctx; i++) if (g_ctx[i].nid == nid) return g_ctx[i].fn;
+    return NULL;
+}
+
+/* Guest allocator: a bump heap; Malloc/Free are the OPDs the MemoryIF names,
+ * called with (Object, ...) the way the title's callbacks are. */
+enum { OPD_MALLOC = 0x1000, OPD_FREE = 0x1008, MIF_OBJ = 0xABCD0000u,
+       HEAP = 0x400000, HEAP_END = 0x800000 };
+static uint32_t g_heap = HEAP;
+static int g_mallocs, g_frees;
+uint64_t ppu_guest_call(uint32_t opd, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3,
+                        uint64_t a4, uint64_t a5, uint64_t a6, uint64_t a7)
+{
+    (void)a2; (void)a3; (void)a4; (void)a5; (void)a6; (void)a7;
+    assert(a0 == MIF_OBJ);
+    if (opd == OPD_MALLOC) {
+        g_mallocs++;
+        uint32_t p = (g_heap + 15) & ~15u;
+        g_heap = p + (uint32_t)a1;
+        assert(g_heap < HEAP_END);
+        return p;
+    }
+    if (opd == OPD_FREE) { assert(a1 >= HEAP && a1 < HEAP_END); g_frees++; return 0; }
+    assert(!"unexpected guest call");
+    return 0;
+}
+
+static int g_fail, g_pass;
+#define CHECK(c) do { if (c) g_pass++; else { g_fail++; \
+    fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); } } while (0)
+
+static uint32_t be32(uint32_t ea)   /* raw big-endian read, independent of vm_read32 */
+{
+    const uint8_t* p = vm_base + ea;
+    return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+static float bef(uint32_t ea) { uint32_t u = be32(ea); float f; memcpy(&f, &u, 4); return f; }
+
+enum {
+    CFG = 0x10000, FTCFG = 0x10100, LIBP = 0x10200, PATH = 0x10300, FONT = 0x10400,
+    RCFG = 0x10600, REND = 0x10700, SURF = 0x10900, METR = 0x10A00, TI = 0x10B00,
+    LAYOUT = 0x10C00, KERN = 0x10D00, SURF2 = 0x10E00, BUF2 = 0x20000,
+};
+
+static int32_t call_render(uint32_t font, uint32_t code, uint32_t surf, double x, double y,
+                           uint32_t metrics, uint32_t ti)
+{
+    ppu_context c; memset(&c, 0, sizeof c);
+    c.gpr[3] = font; c.gpr[4] = code; c.gpr[5] = surf;
+    c.fpr[1] = x; c.fpr[2] = y;
+    c.gpr[6] = 0xDEAD0006; c.gpr[7] = 0xDEAD0007;   /* the GPR slots x and y take */
+    c.gpr[8] = metrics; c.gpr[9] = ti;
+    ctx_fn("cellFontRenderCharGlyphImage")(&c);
+    return (int32_t)c.gpr[3];
+}
+
+static int32_t call_scale(const char* name, uint32_t font, double w, double h)
+{
+    ppu_context c; memset(&c, 0, sizeof c);
+    c.gpr[3] = font; c.fpr[1] = w; c.fpr[2] = h;
+    ctx_fn(name)(&c);
+    return (int32_t)c.gpr[3];
+}
+
+int main(int argc, char** argv)
+{
+    if (argc < 2) { fprintf(stderr, "usage: %s <font.ttf>\n", argv[0]); return 2; }
+    g_font_host = argv[1];
+    vm_base = calloc(1, 16u << 20); assert(vm_base);
+    ppu_vm_size = 16u << 20;
+    ps3_font_register_ctx();
+    CHECK(ctx_fn("cellFontSetScalePixel") && ctx_fn("cellFontRenderCharGlyphImage")
+          && ctx_fn("cellFontSetupRenderScalePoint"));
+
+    /* Before init: every call is UNINITIALIZED. */
+    CHECK(cellFontInitLibraryFreeTypeWithRevision(0, FTCFG, LIBP) == (s32)CELL_FONT_ERROR_UNINITIALIZED);
+
+    /* CellFontConfig as fn 0x4FE524 fills it. */
+    vm_write32(CFG + 0x00, 0x30000); vm_write32(CFG + 0x04, 0x40000);
+    vm_write32(CFG + 0x08, 10); vm_write32(CFG + 0x0C, 0x31000); vm_write32(CFG + 0x10, 0);
+    CHECK(cellFontInitializeWithRevision(0x1234, CFG) == CELL_OK);
+    CHECK(cellFontInitializeWithRevision(0x1234, CFG) == (s32)CELL_FONT_ERROR_ALREADY_INITIALIZED);
+
+    /* CellFontLibraryConfigFT: library, MemoryIF {Object, Malloc, Free, Realloc, Calloc}. */
+    vm_write32(FTCFG + 0x00, 0);
+    vm_write32(FTCFG + 0x04, MIF_OBJ);
+    vm_write32(FTCFG + 0x08, OPD_MALLOC);
+    vm_write32(FTCFG + 0x0C, OPD_FREE);
+    vm_write32(FTCFG + 0x10, 0x1010);
+    vm_write32(FTCFG + 0x14, 0x1018);
+    CHECK(cellFontInitLibraryFreeTypeWithRevision(0x1234, FTCFG, LIBP) == CELL_OK);
+    const uint32_t lib = be32(LIBP);
+    CHECK(lib >= HEAP && lib < HEAP_END && g_mallocs == 1);
+    CHECK(be32(lib + 0) == 0 && be32(lib + 4) == 0);   /* libraryType, libraryVersion */
+
+    /* Fonts. */
+    strcpy((char*)vm_base + PATH, "/dev_bdvd/missing.ttf");
+    CHECK(cellFontOpenFontFile(lib, PATH, 0, 1, FONT) == (s32)CELL_FONT_ERROR_FONT_OPEN_FAILED);
+    strcpy((char*)vm_base + PATH, "/dev_bdvd/test.ttf");
+    CHECK(cellFontOpenFontFile(0x12340, PATH, 0, 1, FONT) == (s32)CELL_FONT_ERROR_INVALID_PARAMETER);
+    CHECK(cellFontOpenFontFile(lib, PATH, 0, 1, FONT) == CELL_OK);
+
+    const double S = 24.0;
+    CHECK(call_scale("cellFontSetScalePixel", FONT, S, S) == CELL_OK);
+    CHECK(bef(FONT + CELL_FONT_O_FONT_SCALE_X) == (float)S);
+
+    CHECK(cellFontGetHorizontalLayout(FONT, LAYOUT) == CELL_OK);
+    const float base = bef(LAYOUT + 0), line = bef(LAYOUT + 4);
+    printf("layout @%gpx: baseLineY %.2f lineHeight %.2f effectHeight %.2f\n",
+           S, base, line, bef(LAYOUT + 8));
+    CHECK(base > S * 0.5 && base < S * 1.5);
+    CHECK(line >= base && line < S * 2.5);
+
+    CHECK(cellFontGetCharGlyphMetrics(FONT, 'A', METR) == CELL_OK);
+    const float gw = bef(METR + 0), gh = bef(METR + 4), adv = bef(METR + 16);
+    printf("'A' @%gpx: %.2fx%.2f bearing (%.2f,%.2f) advance %.2f vadvance %.2f\n",
+           S, gw, gh, bef(METR + 8), bef(METR + 12), adv, bef(METR + 28));
+    CHECK(gw > 2 && gw < S && gh > S * 0.4 && gh < S);
+    CHECK(bef(METR + 12) > S * 0.4 && bef(METR + 12) <= gh + 1);   /* bearingY ~ cap height */
+    CHECK(adv > gw * 0.5 && adv < S * 1.5);
+
+    /* Half the scale: metrics scale with it. */
+    CHECK(call_scale("cellFontSetScalePixel", FONT, S / 2, S / 2) == CELL_OK);
+    CHECK(cellFontGetCharGlyphMetrics(FONT, 'A', METR) == CELL_OK);
+    CHECK(fabsf(bef(METR + 16) - adv / 2) < 1.0f);
+    CHECK(call_scale("cellFontSetScalePixel", FONT, S, S) == CELL_OK);
+
+    CHECK(cellFontGetCharGlyphMetrics(FONT, 0x10FFFD, METR) == (s32)CELL_FONT_ERROR_NO_SUPPORT_GLYPH);
+    CHECK(be32(METR + 0) == 0 && be32(METR + 16) == 0);
+
+    vm_write32(KERN, 0xFFFFFFFF); vm_write32(KERN + 4, 0xFFFFFFFF);
+    CHECK(cellFontGetKerning(FONT, 'A', 'V', KERN) == CELL_OK);
+    printf("kerning A,V: %.2f\n", bef(KERN));
+    CHECK(bef(KERN) <= 0.0f && bef(KERN) > -S && be32(KERN + 4) == 0);
+    CHECK(cellFontGetKerning(FONT, 0, 'V', KERN) == CELL_OK && be32(KERN) == 0);
+
+    /* Renderer: config all zero but expandSize, as the title passes it. */
+    vm_write32(RCFG + 0x0C, 1);
