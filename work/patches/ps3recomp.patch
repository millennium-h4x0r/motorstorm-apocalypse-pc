+#if defined(__x86_64__) || defined(__i386__)
+#define VM_MM_ST(T, p, be) __atomic_store_n((volatile T*)(p), (T)(be), __ATOMIC_RELAXED)
+#else
+#define VM_MM_ST(T, p, be) do { uint8_t* _q = (p); T _b = (be);     if (!((uintptr_t)_q & (sizeof(T) - 1))) __atomic_store_n((T*)_q, _b, __ATOMIC_RELAXED);     else memcpy(_q, &_b, sizeof(T)); } while (0)
+#endif
