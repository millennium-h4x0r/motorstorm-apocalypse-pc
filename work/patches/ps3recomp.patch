+/* The task paths fingerprint the whole task ELF (150 KB for a Havok task,
+ * byte by byte) on every start, twice -- ~0.5 ms each on the creator's thread,
+ * a hundred times a second. The ELFs are EBOOT data that never change, so the
+ * last few answers are kept by (pointer, size), with a spot check of the first,
+ * middle and last 64 bytes in case one ever does. */
+static uint64_t spu_task_fingerprint(const uint8_t* image, size_t n)
+{
+    enum { N = 16 };
+    static struct { const uint8_t* p; size_t n; uint64_t spot, fp; } c[N];
+    static int lock, next;
+    if (n < 192) return spu_workload_fingerprint(image, n);
+    const uint64_t spot = spu_workload_fingerprint(image, 64) ^
+                          spu_workload_fingerprint(image + n / 2, 64) * 3 ^
+                          spu_workload_fingerprint(image + n - 64, 64) * 5;
+    while (__atomic_exchange_n(&lock, 1, __ATOMIC_ACQUIRE)) { }
+    for (int i = 0; i < N; i++)
+        if (c[i].p == image && c[i].n == n && c[i].spot == spot) {
+            const uint64_t fp = c[i].fp;
+            __atomic_store_n(&lock, 0, __ATOMIC_RELEASE);
+            return fp;
+        }
+    __atomic_store_n(&lock, 0, __ATOMIC_RELEASE);
+    const uint64_t fp = spu_workload_fingerprint(image, n);
+    while (__atomic_exchange_n(&lock, 1, __ATOMIC_ACQUIRE)) { }
+    c[next].p = image; c[next].n = n; c[next].spot = spot; c[next].fp = fp;
+    next = (next + 1) % N;
+    __atomic_store_n(&lock, 0, __ATOMIC_RELEASE);
+    return fp;
+}
