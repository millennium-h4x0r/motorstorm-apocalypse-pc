+            u8* d = dst + (size_t)y * row;
+            if (as_rgba && argb) { memcpy(d, h, (size_t)s->w * 4u); continue; }
+            /* host R,G,B,A -> guest A,R,G,B (or A,B,G,R): a rotate or a byte
+             * swap of the little-endian word, which the compiler vectorizes */
+            for (u32 x = 0; x < s->w; x++) {
+                u32 v;
+                memcpy(&v, h + (size_t)x * 4u, 4);
+                v = abgr ? __builtin_bswap32(v) : (v << 8) | (v >> 24);
+                memcpy(d + (size_t)x * 4u, &v, 4);
+            }
+        }
+        gwt_host_write_end(wtok);
+        /* One range per target: a disjoint one replaces it rather than
+         * growing a hull over rows that were never written back. */
+        if (s->wb_stamp == s->stamp && y0 <= s->wb_y1 && y1 >= s->wb_y0) {
+            if (y0 < s->wb_y0) s->wb_y0 = y0;
+            if (y1 > s->wb_y1) s->wb_y1 = y1;
+        } else {
+            s->wb_stamp = s->stamp; s->wb_y0 = y0; s->wb_y1 = y1;
+        }
+        /* Its own pixels: the target is still what those bytes hold. */
+        if (s->wt) eng_surface_arm(best);
+        { static int _n = 0; if (_n < 4) { _n++;
+            fprintf(stderr, "[rsx engine] wrote back colour target 0x%08X rows %u..%u (loc %u)\n",
+                    s->offset, y0, y1, location); } }
+        eng_wb_dump("colour", s->offset + y0 * row, dst, (y1 - y0) * row);
+        return;
+    }
+
+    if (bz == ENG_INVALID) return;
+    /* A depth buffer: Z24S8 only, the guest's own w x h at its own pitch --
+     * the attachment is canvas-sized and may be larger than the buffer. */
+    eng_zdepth* z = &g.zdepths[bz];
+    const u32 row = z->guest_pitch;
+    const u32 gw = z->guest_w < z->w ? z->guest_w : z->w;
+    const u32 gh = z->guest_h < z->h ? z->guest_h : z->h;
+    if (z->guest_fmt != ENG_SURF_Z24S8 || !g.be->depth_readback ||
+        (pitch && pitch != row) || row < gw * 4u || !gw)
+        return;
+    u32 y0, y1;
+    if (!eng_wb_rows(z->offset, row, gh, offset, len, &y0, &y1)) return;
+    if (z->wb_seq == z->write_seq && y0 >= z->wb_y0 && y1 <= z->wb_y1) return;
+    u8* dst = (u8*)eng_guest_ptr(NULL, location, z->offset + y0 * row, (y1 - y0) * row);
+    const u32 bytes = gw * y1 * (u32)sizeof(float);
+    if (!dst) return;
+    if (g.tex_staging_cap < bytes) {
+        u8* n = (u8*)realloc(g.tex_staging, bytes);
+        if (!n) return;
+        g.tex_staging = n; g.tex_staging_cap = bytes;
+    }
+    eng_wb_count('z', location, z->offset, gw, y1);
+    if (g.be->submit_and_wait) g.be->submit_and_wait(g.be->user, RSX_BE_FLUSH_GUEST_REFERENCE);
+    float* f = (float*)g.tex_staging;
+    if (g.be->depth_readback(g.be->user, z->handle, gw, y1, f)) return;
+    /* The stencil byte too, where the backend has one; else the guest's
+     * own stays. */
+    static u8* sten; static size_t sten_cap;
+    const size_t sbytes = (size_t)gw * y1;
+    if (g.be->stencil_readback && sten_cap < sbytes) {
+        u8* n = (u8*)realloc(sten, sbytes);
+        if (n) { sten = n; sten_cap = sbytes; }
+    }
+    const int have_s = g.be->stencil_readback && sten_cap >= sbytes &&
+                       !g.be->stencil_readback(g.be->user, z->handle, gw, y1, sten);
+    /* Branch-free so it vectorizes: rsx_depth_to_d24 with the out-of-range
+     * and NaN cases folded into a clamp (1.0 maps exactly to 0xFFFFFF). The
+     * guest word is D23..D16, D15..D8, D7..D0, stencil. */
+    for (u32 y = y0; y < y1; y++) {
+        u8* d = dst + (size_t)(y - y0) * row;
+        const float* fr = f + (size_t)y * gw;
+        const u8* sr = have_s ? sten + (size_t)y * gw : NULL;
+        for (u32 x = 0; x < gw; x++) {
+            float v = fr[x];
+            v = v > 0.0f ? v : 0.0f;
+            v = v < 1.0f ? v : 1.0f;
+            const float sc = v * 16777215.0f;
+            int32_t q = (int32_t)sc;
+            q += (sc - (float)q) >= 0.5f;
+            const u32 z = (u32)q;
+            u32 w = (z >> 16) | (z & 0xFF00u) | ((z & 0xFFu) << 16);
+            if (sr) w |= (u32)sr[x] << 24;
+            else    w |= (u32)d[(size_t)x * 4u + 3u] << 24;
+            memcpy(d + (size_t)x * 4u, &w, 4);
+        }
+    }
+    if (z->wb_seq == z->write_seq && y0 <= z->wb_y1 && y1 >= z->wb_y0) {
+        if (y0 < z->wb_y0) z->wb_y0 = y0;
+        if (y1 > z->wb_y1) z->wb_y1 = y1;
+    } else {
+        z->wb_seq = z->write_seq; z->wb_y0 = y0; z->wb_y1 = y1;
+    }
+    { static int _n = 0; if (_n < 4) { _n++;
+        fprintf(stderr, "[rsx engine] wrote back depth target 0x%08X rows %u..%u (loc %u)\n",
+                z->offset, y0, y1, location); } }
+    eng_wb_dump("depth", z->offset + y0 * row, dst, (y1 - y0) * row);
+}
+
+/* The reverse of the colour write-back above: guest rows something other
+ * than a draw just wrote (an NV3089 copy) go into every linear 32-bit colour
+ * target over them. MotorStorm Apocalypse tonemaps into a local target, copies
+ * it to main memory for the SPU's EDGE MLAA, and copies the result into the
+ * display buffer with NV3089 before drawing its HUD there: without this the
+ * display buffer's target never saw the scene, and the HUD was drawn over
+ * black. Only the newest target at an address takes them, as the write-back
+ * reads the newest; a target with a scale > 1 is repeated by the backend. */
+static void eng_guest_wrote_range(u32 location, u32 offset, u32 pitch, u32 len, u32 rect_w);
+
+/* Upstream's rectangle forms (cellGcmSys' NV3089 path), over the byte range
+ * the rectangle spans. */
+static u32 eng_rect_len(u32 pitch, u32 w, u32 h)
+{
+    if (!w || !h) return 0;
+    const u64 len = (u64)(h - 1u) * pitch + (u64)w * 4u;
+    return len > 0xFFFFFFFFull ? 0xFFFFFFFFu : (u32)len;
+}
+
+void rsx_draw_engine_guest_read(u32 location, u32 offset, u32 pitch, u32 w, u32 h)
+{
+    rsx_draw_engine_writeback(location, offset, pitch, eng_rect_len(pitch, w, h));
+}
+
+void rsx_draw_engine_guest_wrote(u32 location, u32 offset, u32 pitch, u32 w, u32 h)
+{
+    eng_guest_wrote_range(location, offset, pitch, eng_rect_len(pitch, w, h), w);
+}
+
+/* rect_w: the copy wrote only that many pixels of each row, from the column
+ * `offset` starts at (0: whole rows). The other columns keep what the GPU
+ * drew: MotorStorm copies its 1240x680 frame into the middle of a 1280x720
+ * display buffer it has cleared on the GPU, and taking whole rows from guest
+ * memory put stale bands down the left and right edges of the picture. */
+static void eng_guest_wrote_range(u32 location, u32 offset, u32 pitch, u32 len, u32 rect_w)
+{
+    if (!g.ready || s_guest_reader || !len || !g.be->color_target_upload) return;
+    u32 best = ENG_INVALID;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        const eng_surface* s = &g.surfaces[i];
+        if (!s->handle || s->location != location || !s->guest_pitch) continue;
+        if ((u64)offset + len <= s->offset || (u64)offset >= (u64)s->offset + (u64)s->guest_pitch * s->h) continue;
+        if (best == ENG_INVALID || s->stamp > g.surfaces[best].stamp) best = i;
+    }
+    if (best == ENG_INVALID) return;
+    eng_surface* s = &g.surfaces[best];
+    const int abgr = s->guest_fmt == ENG_SURF_A8B8G8R8 ||
+                     s->guest_fmt == ENG_SURF_X8B8G8R8_Z8B8G8R8 ||
+                     s->guest_fmt == ENG_SURF_X8B8G8R8_O8B8G8R8;
+    const int argb = s->guest_fmt == ENG_SURF_A8R8G8B8 ||
+                     s->guest_fmt == ENG_SURF_X8R8G8B8_Z8R8G8B8 ||
+                     s->guest_fmt == ENG_SURF_X8R8G8B8_O8R8G8B8;
+    const u32 row = s->guest_pitch;
+    if ((!argb && !abgr) || s->fmt != RSX_BE_FMT_R8G8B8A8 || s->guest_raster == 2u ||
+        (pitch && pitch != row) || row < s->w * 4u)
+        return;
+    /* Rows the range touches, from its first byte (it may start mid-row). */
+    const u32 rel0 = offset > s->offset ? offset - s->offset : 0u;
+    const u64 end = (u64)offset + len - s->offset;
+    const u32 y0 = rel0 / row;
+    u32 y1 = (u32)((end + row - 1u) / row);
+    if (y1 > s->h) y1 = s->h;
+    if (y1 <= y0) return;
+    /* The columns: the whole row, or the rectangle's when the backend can
+     * take part of one. */
+    u32 x0 = 0, xw = s->w;
+    if (rect_w && g.be->color_target_upload_rect) {
+        const u32 cx = (rel0 % row) / 4u;
+        if (cx < s->w) {
+            x0 = cx;
+            xw = rect_w < s->w - cx ? rect_w : s->w - cx;
+        }
+    }
+    const u8* src = eng_guest_ptr(NULL, location, s->offset + y0 * row, (y1 - y0) * row);
+    if (!src) return;
+    src += (size_t)x0 * 4u;
+    const u32 bytes = xw * 4u * (y1 - y0);
+    if (g.tex_staging_cap < bytes) {
+        u8* n = (u8*)realloc(g.tex_staging, bytes);
+        if (!n) return;
+        g.tex_staging = n; g.tex_staging_cap = bytes;
+    }
+    const int as_rgba = rsx_texture_argb_is_rgba();
+    for (u32 y = 0; y < y1 - y0; y++) {
+        const u8* q = src + (size_t)y * row;
+        u8* h = g.tex_staging + (size_t)y * xw * 4u;
+        if (as_rgba && argb) { memcpy(h, q, (size_t)xw * 4u); continue; }
+        for (u32 x = 0; x < xw; x++) {
+            u32 v;
+            memcpy(&v, q + (size_t)x * 4u, 4);
+            v = abgr ? __builtin_bswap32(v) : (v >> 8) | (v << 24);   /* A,R,G,B -> R,G,B,A */
+            memcpy(h + (size_t)x * 4u, &v, 4);
+        }
+    }
+    if (x0 || xw != s->w)
+        g.be->color_target_upload_rect(g.be->user, s->handle, x0, y0, xw, y1 - y0, g.tex_staging, xw * 4u);
+    else
+        g.be->color_target_upload(g.be->user, s->handle, y0, s->w, y1 - y0, g.tex_staging, s->w * 4u);
+    /* The target is what those bytes hold: no write-back needed for them --
+     * unless only some columns came up, and the rest of those rows differ. */
+    s->stamp = s->cwstamp = ++s_surf_clock;
+    if (x0 || xw != s->w) s->wb_stamp = 0;
+    else { s->wb_stamp = s->stamp; s->wb_y0 = y0; s->wb_y1 = y1; }
+    if (s->wt) eng_surface_arm(best);
+    { static int _n = 0; if (_n < 4) { _n++;
+        fprintf(stderr, "[rsx engine] guest rows %u..%u copied into colour target 0x%08X %ux%u (loc %u)\n",
+                y0, y1, s->offset, s->w, s->h, location); } }
+}
+
+/* ---- NV3089 copies on the GPU, and EDGE MLAA there -------------------------
+ * The 2D engine's copies run on the CPU over guest bytes (cellGcmSys
+ * nv3089_blit). Between two colour targets that costs a GPU-to-guest write-back
+ * with a wait for the GPU, a per-pixel copy and an upload of the result: a
+ * blit in the command buffer does the same. */
+
+/* The ARGB colour target newest at the pixel `offset` (rows `pitch` apart), as
+ * a slot, and that pixel's column and row in it; ENG_INVALID when there is
+ * none, it is not a linear 32-bit ARGB target at that pitch, or a zeta written
+ * since aliases the address (the write-back's rule: the newest writer wins). */
+static u32 eng_blit_target(u32 location, u32 offset, u32 pitch, u32* x, u32* y)
+{
+    u32 best = ENG_INVALID;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        const eng_surface* s = &g.surfaces[i];
+        if (!s->handle || s->location != location || s->guest_pitch != pitch || !pitch) continue;
+        if (offset < s->offset || (u64)offset - s->offset >= (u64)pitch * s->h) continue;
+        if (best == ENG_INVALID || s->stamp > g.surfaces[best].stamp) best = i;
+    }
+    if (best == ENG_INVALID) return ENG_INVALID;
+    const eng_surface* s = &g.surfaces[best];
+    const int argb = s->guest_fmt == ENG_SURF_A8R8G8B8 ||
+                     s->guest_fmt == ENG_SURF_X8R8G8B8_Z8R8G8B8 ||
+                     s->guest_fmt == ENG_SURF_X8R8G8B8_O8R8G8B8;
+    const u32 rel = offset - s->offset;
+    if (!argb || s->fmt != RSX_BE_FMT_R8G8B8A8 || s->guest_raster == 2u || (rel % pitch) % 4u ||
+        (rel % pitch) / 4u >= s->w)
+        return ENG_INVALID;
+    for (u32 i = 0; i < g.n_zdepths; i++) {
+        const eng_zdepth* z = &g.zdepths[i];
+        if (!z->handle || z->location != location || !z->guest_pitch) continue;
+        if (offset < z->offset || (u64)offset - z->offset >= (u64)z->guest_pitch * z->guest_h) continue;
+        if (z->wstamp > s->stamp) return ENG_INVALID;
+    }
+    *x = (rel % pitch) / 4u;
+    *y = rel / pitch;
+    return best;
+}
+
+static int eng_gpu_blit_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_ENG_GPU_BLIT"); on = !(e && e[0] == '0'); }
+    return on;
+}
+
+/* The copy's source rectangle in source pixels: the origin, and the extent
+ * its steps cover, which must come out whole. 0 when it does not. */
+static int eng_nv3089_src_rect(const rsx_nv3089_copy* c, u32* sx, u32* sy, u32* sw, u32* sh)
+{
+    if (!c->ds_dx || !c->dt_dy || !c->out_w || !c->out_h) return 0;
+    *sx = c->in_u >> 4;
+    *sy = c->in_v >> 4;
+    const u64 fw = (u64)c->out_w * c->ds_dx, fh = (u64)c->out_h * c->dt_dy;
+    const u64 w = (fw + (1u << 19)) >> 20, h = (fh + (1u << 19)) >> 20;
+    /* within a 64th of a pixel of whole: a stretch, not a sub-pixel resample */
+    const u64 ew = fw > (w << 20) ? fw - (w << 20) : (w << 20) - fw;
+    const u64 eh = fh > (h << 20) ? fh - (h << 20) : (h << 20) - fh;
+    if (!w || !h || ew > (1u << 14) || eh > (1u << 14) || w > 8192u || h > 8192u) return 0;
+    *sw = (u32)w; *sh = (u32)h;
+    return 1;
+}
+
+/* The native MLAA pass's state (rsx_draw_engine_set_native_mlaa). The copy to
+ * main memory may come in strips (MotorStorm: 1004 + 148 pixels wide); each
+ * maps a source address to a destination one by the same difference.
+ * Split-screen has one buffer copy and one display copy per view, each view at
+ * its own place in the target and the buffer, interleaved (display V1, copy
+ * V1, display V2, copy V2): one state per view (PS3RECOMP_ENG_MLAA_VIEWS=1;
+ * off, one state and the second view's copies made every frame fall back). */
+typedef struct {
+    int pend, used;           /* a buffer copy was left out this frame / a display copy read it */
+    u32 frame;                /* g.frames of the left-out copy */
+    u32 src_slot, src_stamp;  /* the target it came from */
+    u32 dst_loc, delta;       /* buffer offset = target pixel offset + delta */
+    u32 x0, y0, x1, y1, area; /* the strips' bounding box in the target, and their area */
+    u32 sx, sy;               /* where its first strip starts (which view) */
+    u32 cool_until;           /* after a fallback, the guest's path until this frame */
+    /* Seen on the guest's path: a frame whose buffer copy was followed by a
+     * display copy out of the buffer. Only after VERIFY of them in a row is a
+     * buffer copy left out -- a frame that reads the buffer some other way
+     * (a menu) keeps the guest's path. */
+    u32 verified;
+    int obs;                  /* this frame's buffer copy went the guest's way, watched */
+    u32 obs_frame, obs_slot, obs_delta, obs_loc;
+    u32 obs_x0, obs_y0, obs_x1, obs_y1;
+    int obs_seen;             /* ... and a display copy read it */
+    int guest;                /* this buffer copy goes the guest's way */
+    int live;                 /* the slot is in use */
+    int skipped;              /* the SPU MLAA pass of this copy was skipped (mlaa_skip.c) */
+    u32 last_use;             /* g.frames it was last touched */
+} eng_mlaa_view;
+enum { MLAA_VIEWS_MAX = 4 };
+static struct {
+    rsx_native_mlaa_desc d;
+    eng_mlaa_view v[MLAA_VIEWS_MAX];
+    int open, cur;            /* the last copy was a strip of view cur's buffer copy */
+    u32 n_native, n_fallback, n_fills;
+} s_mlaa;
+enum { MLAA_VERIFY = 3 };
+
+static u32 eng_mlaa_nviews(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_ENG_MLAA_VIEWS"); on = e && e[0] == '1'; }
+    return on ? (u32)MLAA_VIEWS_MAX : 1u;
+}
+
+void rsx_draw_engine_set_native_mlaa(const rsx_native_mlaa_desc* desc)
+{
+    memset(&s_mlaa, 0, sizeof s_mlaa);
+    if (desc) s_mlaa.d = *desc;
+}
+
+/* Whether rsx_draw_engine_acquire_skip can answer yes for this label at all:
+ * the split FIFO walker (PS3RECOMP_RSX_SPLIT) then lets the executor catch up
+ * before asking, since the answer depends on the draws before the acquire. */
+int rsx_draw_engine_acquire_skip_armed(u32 label)
+{
+    return s_mlaa.d.mode == 1u && s_mlaa.d.skip_acquire && label == s_mlaa.d.label;
+}
+
+int rsx_draw_engine_acquire_skip(u32 label)
+{
+    /* Only when asked (desc.skip_acquire): the acquire also orders the SPU
+     * tasks' end against the PPU's next kick of them -- the RSX passing it
+     * early lets the game signal tasks still running the last frame, and the
+     * boot hung that way now and then. */
+    if (!(s_mlaa.d.mode == 1u && s_mlaa.d.skip_acquire && label == s_mlaa.d.label)) return 0;
+    for (u32 i = 0; i < eng_mlaa_nviews(); i++)
+        if (s_mlaa.v[i].pend && !s_mlaa.v[i].used) return 1;
+    return 0;
+}
+
+/* For the SPU side (work/port/spu-native/mlaa_skip.c): the buffer copy of the
+ * frame now being anti-aliased was left out of guest memory (native MLAA
+ * armed), so the SPU MLAA tasks would only rework stale bytes that no
+ * display copy reads. Racy by design: a stale 1 costs one frame of the SPU
+ * result while the engine is on its own path anyway; a stale 0 runs the
+ * tasks as before. */
+static u64 s_skchk[4];   /* skipped copies: native, materialized, never shown, read as left */
+int rsx_draw_engine_mlaa_left_out(void)
+{
+    if (s_mlaa.d.mode != 1u) return 0;
+    /* Every view this frame: one whose copy went the guest's way (a second
+     * view without a state, a cool-down) needs the SPU result. */
+    int any = 0;
+    for (u32 i = 0; i < eng_mlaa_nviews(); i++) {
+        const eng_mlaa_view* m = &s_mlaa.v[i];
+        if (__atomic_load_n(&m->guest, __ATOMIC_RELAXED) && m->frame == g.frames) return 0;
+        if (__atomic_load_n(&m->pend, __ATOMIC_RELAXED) && !__atomic_load_n(&m->used, __ATOMIC_RELAXED)) any = 1;
+    }
+    if (any)
+        for (u32 i = 0; i < eng_mlaa_nviews(); i++)
+            if (s_mlaa.v[i].pend && !s_mlaa.v[i].used) __atomic_store_n(&s_mlaa.v[i].skipped, 1, __ATOMIC_RELAXED);
+    return any;
+}
+
+/* What became of the copies whose SPU pass was skipped: shown by the native
+ * pass, shown after eng_mlaa_materialize put the target's own bytes in the
+ * buffer (the SPU pass's result would have been overwritten too), never
+ * shown, or -- the case that must not happen -- read by a guest display copy
+ * as the SPU left it. */
+void rsx_draw_engine_mlaa_check(unsigned long long out[4])
+{
+    for (int i = 0; i < 4; i++) out[i] = s_skchk[i];
+}
+
+static void eng_mlaa_fallback(eng_mlaa_view* m, const char* why)
+{
+    s_mlaa.n_fallback++;
+    m->cool_until = g.frames + 8u;
+    m->verified = 0;
+    /* the first few of each reason, then every 1000th fallback */
+    static const char* seen[8]; static int nseen[8];
+    int k = 0;
+    while (k < 8 && seen[k] && seen[k] != why) k++;
+    if (k < 8 && !seen[k]) seen[k] = why;
+    if ((k < 8 && nseen[k]++ < 3) || s_mlaa.n_fallback % 1000u == 0)
+        fprintf(stderr, "[rsx engine] native MLAA: %s; this frame takes the SPU path (%u native, %u fallbacks)\n",
+                why, s_mlaa.n_native, s_mlaa.n_fallback);
+}
+
+/* A display copy that the native path cannot do: the buffer gets the bytes
+ * the left-out copies would have put there, from the target, so the guest's
+ * copy that follows reads a picture (without the antialiasing). */
+static void eng_mlaa_materialize(eng_mlaa_view* m)
+{
+    if (m->skipped) { s_skchk[1]++; m->skipped = 0; }
+    eng_surface* s = &g.surfaces[m->src_slot];
+    if (!s->handle || !s->guest_pitch) return;
+    const u32 row = s->guest_pitch;
+    rsx_draw_engine_writeback(s->location, s->offset + m->y0 * row, row,
+                              (m->y1 - m->y0) * row);
+    for (u32 y = m->y0; y < m->y1; y++) {
+        const u32 so = s->offset + y * row + m->x0 * 4u, n = (m->x1 - m->x0) * 4u;
+        const u8* sp = eng_guest_ptr(NULL, s->location, so, n);
+        u8* dp = (u8*)eng_guest_ptr(NULL, m->dst_loc, so + m->delta, n);
+        if (sp && dp) memmove(dp, sp, n);
+    }
+}
+
+static int eng_mlaa_any_armed(void)
+{
+    for (u32 i = 0; i < eng_mlaa_nviews(); i++)
+        if (s_mlaa.v[i].pend && !s_mlaa.v[i].used) return 1;
+    return 0;
+}
+
+/* A draw samples the buffer whose copy was left out (a frame that reads it
+ * some other way than the display copy): give it the bytes, now. */
+static void eng_mlaa_tex_guard(u32 location, u32 offset)
+{
+    for (u32 i = 0; i < eng_mlaa_nviews(); i++) {
+        eng_mlaa_view* m = &s_mlaa.v[i];
+        if (!m->pend || m->used) continue;
+        const eng_surface* ts = &g.surfaces[m->src_slot];
+        const u32 lo = ts->offset + m->delta;
+        if (location != m->dst_loc || offset - lo >= ts->guest_pitch * ts->h) continue;
+        eng_mlaa_materialize(m);
+        eng_mlaa_fallback(m, "a draw samples the buffer");
+        m->used = 1;
+    }
+    s_mlaa_armed = eng_mlaa_any_armed();
+}
+
+/* The view state a new buffer copy whose first strip starts at tx,ty goes to:
+ * the one that started there before, else a free one, else the oldest. */
+static eng_mlaa_view* eng_mlaa_view_for(u32 tx, u32 ty)
+{
+    const u32 n = eng_mlaa_nviews();
+    if (n == 1) return &s_mlaa.v[0];
+    for (u32 i = 0; i < n; i++)
+        if (s_mlaa.v[i].live && s_mlaa.v[i].sx == tx && s_mlaa.v[i].sy == ty) return &s_mlaa.v[i];
+    u32 best = 0;
+    for (u32 i = 0; i < n; i++) {
+        if (!s_mlaa.v[i].live) { best = i; break; }
+        if (s_mlaa.v[i].last_use < s_mlaa.v[best].last_use) best = i;
+    }
+    eng_mlaa_view* m = &s_mlaa.v[best];
+    if (m->live && m->pend && !m->used) { eng_mlaa_materialize(m); eng_mlaa_fallback(m, "more views than states"); }
+    memset(m, 0, sizeof *m);
+    m->live = 1; m->sx = tx; m->sy = ty;
+    return m;
+}
+
+static int eng_mlaa_copy(const rsx_nv3089_copy* c, u32 sx, u32 sy, u32 sw, u32 sh)
+{
+    const u32 nv = eng_mlaa_nviews();
+    const int unscaled = c->ds_dx == 0x100000u && c->dt_dy == 0x100000u;
+    const u32 src_px = c->src_offset + sy * c->src_pitch + sx * 4u;
+    const u32 dst_px = c->dst_offset + c->out_y * c->dst_pitch + c->out_x * 4u;
+    /* The display copy of a frame comes at the start of the next one (the
+     * SPUs had the frame between): a left-out copy stays good until the next
+     * buffer copy, for two frames at most. */
+    for (u32 i = 0; i < nv; i++) {
+        eng_mlaa_view* m = &s_mlaa.v[i];
+        if (m->pend && !m->used && g.frames - m->frame > 2u) {
+            eng_mlaa_fallback(m, "a buffer copy that no display copy read");
+            m->pend = 0;
+        }
+    }
+    s_mlaa_armed = eng_mlaa_any_armed();
+    /* 1. The tonemapped image to main memory: left out. It may come in strips,
+     *    one after another; any other copy ends it. */
+    int strip = 0;
+    u32 slot = ENG_INVALID, tx = 0, ty = 0;
+    if (c->src_location == RSX_LOCATION_LOCAL && c->dst_location == RSX_LOCATION_MAIN && unscaled &&
+        c->src_pitch == c->dst_pitch) {
+        slot = eng_blit_target(RSX_LOCATION_LOCAL, src_px, c->src_pitch, &tx, &ty);
+        strip = slot != ENG_INVALID && g.surfaces[slot].offset == s_mlaa.d.src_offset;
+    }
+    if (!strip) s_mlaa.open = 0;
+    if (strip && !s_mlaa.open) {
+        eng_mlaa_view* m = eng_mlaa_view_for(tx, ty);
+        s_mlaa.cur = (int)(m - s_mlaa.v);
+        m->last_use = g.frames;
+        /* a new buffer copy: what came of the last one */
+        if (m->pend && !m->used) {
+            eng_mlaa_fallback(m, "a buffer copy that no display copy read");
+            m->pend = 0;
+        }
+        if (m->obs) {
+            m->verified = m->obs_seen ? m->verified + 1u : 0u;
+            m->obs = 0;
+        }
+        m->pend = 0;
+        s_mlaa.open = 1;
+        /* World frames only (more than PS3RECOMP_ENG_MLAA_MIN_DRAWS guest
+         * draws in the last one, default 50, as PS3RECOMP_ENG_WORLDLOG counts
+         * them): the boot's and the loading screens' frames (0-5 draws) cost
+         * nothing to antialias, and with the SPU tasks running over a stale
+         * near-black buffer there they finish so fast that the boot hung now
+         * and then in the tasks' barrier (the PPU in 0x857EF8 on the
+         * completion word, docs/NOTES.md "EDGE MLAA barrier hang") -- a
+         * timing the race never showed. The bound was 1000: the pre-race
+         * fly-over (86-1100 draws) and light moments of a race then took the
+         * SPU path, ~16 ms of SPU work a frame the GPU thread waited for
+         * (label 0x4B0/0x4C0): 35-47 fps there. (The START RACE stalls once
+         * blamed on 50 were all_tracks' own: it stopped tapping CROSS when a
+         * fly-over passed its HUD test.) */
+        static long min_draws = -1;
+        if (min_draws < 0) { const char* e = getenv("PS3RECOMP_ENG_MLAA_MIN_DRAWS");
+                             min_draws = e && *e ? atol(e) : 50; }
+        m->guest = (s32)(g.frames - m->cool_until) < 0 || m->verified < MLAA_VERIFY ||
+                   g.last_guest_draws <= (u32)min_draws;
+    }
+    if (strip) {
+        eng_mlaa_view* m = &s_mlaa.v[s_mlaa.cur];
+        const eng_surface* s = &g.surfaces[slot];
+        const u32 delta = dst_px - src_px;
+        if (m->guest) {
+            /* The guest's way, watched: does a display copy read it? */
+            if (!m->obs) {
+                m->obs = 1; m->obs_seen = 0; m->obs_frame = g.frames;
+                m->obs_slot = slot; m->obs_delta = delta; m->obs_loc = c->dst_location;
+                m->obs_x0 = tx; m->obs_y0 = ty; m->obs_x1 = tx + c->out_w; m->obs_y1 = ty + c->out_h;
+            } else {
+                if (tx < m->obs_x0) m->obs_x0 = tx;
+                if (ty < m->obs_y0) m->obs_y0 = ty;
+                if (tx + c->out_w > m->obs_x1) m->obs_x1 = tx + c->out_w;
+                if (ty + c->out_h > m->obs_y1) m->obs_y1 = ty + c->out_h;
+            }
+            return 0;
+        }
+        if (tx + c->out_w > s->w || ty + c->out_h > s->h) {
+            if (m->pend) eng_mlaa_materialize(m);
+            eng_mlaa_fallback(m, "a buffer copy past its target");
+            m->pend = 0; m->guest = 1;
+            return 0;
+        }
+        if (m->pend && !m->used && (m->src_slot != slot || m->delta != delta)) {
+            /* another strip, but not of the same copy: undo, guest path */
+            eng_mlaa_materialize(m);
+            eng_mlaa_fallback(m, "buffer copies that do not line up");
+            m->pend = 0; m->guest = 1;
+            return 0;
+        }
+        if (!m->pend || m->used) {
+            if (m->skipped && !m->used) s_skchk[2]++;
+            m->skipped = 0;
+            m->pend = 1; m->used = 0; m->frame = g.frames;
+            m->src_slot = slot; m->src_stamp = s->stamp;
+            m->dst_loc = c->dst_location; m->delta = delta;
+            m->x0 = tx; m->y0 = ty; m->x1 = tx + c->out_w; m->y1 = ty + c->out_h;
+            m->area = 0;
+        } else {
+            if (tx < m->x0) m->x0 = tx;
+            if (ty < m->y0) m->y0 = ty;
+            if (tx + c->out_w > m->x1) m->x1 = tx + c->out_w;
+            if (ty + c->out_h > m->y1) m->y1 = ty + c->out_h;
+        }
+        m->area += c->out_w * c->out_h;
+        s_mlaa_armed = 1;
+        return 1;
+    }
+    /* A copy out of a watched buffer into a colour target: that view's guest
+     * path was read by a display copy. With several views, the one whose
+     * strips the copy's source lies in. */
+    for (u32 i = 0; i < nv; i++) {
+        eng_mlaa_view* m = &s_mlaa.v[i];
+        if (!(m->obs && !m->obs_seen && c->src_location == m->obs_loc &&
+              c->dst_location == RSX_LOCATION_LOCAL))
+            continue;
+        const eng_surface* ts = &g.surfaces[m->obs_slot];
+        const u32 lo = ts->offset + m->obs_delta;
+        u32 dx, dy;
+        if (!ts->handle || src_px - lo >= ts->guest_pitch * ts->h) continue;
+        const u32 rel = src_px - lo, bx = (rel % ts->guest_pitch) / 4u, by = rel / ts->guest_pitch;
+        if (nv > 1 && (bx < m->obs_x0 || by < m->obs_y0 || bx >= m->obs_x1 || by >= m->obs_y1)) continue;
+        if (eng_blit_target(RSX_LOCATION_LOCAL, dst_px, c->dst_pitch, &dx, &dy) != ENG_INVALID) {
+            m->obs_seen = 1;
+            if (m->skipped) { s_skchk[3]++; m->skipped = 0; }   /* the guest's copy reads the buffer */
+            return 0;
+        }
+    }
+    /* The pending view this copy concerns: its buffer (fills) or its strips'
+     * box (the display copy). */
+    eng_mlaa_view* m = NULL;
+    u32 bx = 0, by = 0;
+    int is_fill = 0;
+    for (u32 i = 0; i < nv && !m; i++) {
+        eng_mlaa_view* v = &s_mlaa.v[i];
+        if (!v->pend || v->used) continue;
+        const eng_surface* ts = &g.surfaces[v->src_slot];
+        const u32 tlo = ts->offset + v->delta;           /* the buffer, as the target's extent */
+        const u64 thi = (u64)tlo + (u64)ts->guest_pitch * ts->h;
+        /* 2. Anything else written into the buffer (the border fills): nothing
+         *    reads it now. */
+        if (c->dst_location == v->dst_loc && dst_px >= tlo && dst_px < thi) { m = v; is_fill = 1; break; }
+        if (c->src_location != v->dst_loc || src_px < tlo || src_px >= thi) continue;
+        const u32 rel = src_px - tlo;
+        const u32 x = (rel % ts->guest_pitch) / 4u, y = rel / ts->guest_pitch;
+        if (nv > 1 && (x < v->x0 || y < v->y0 || x >= v->x1 || y >= v->y1)) continue;
+        m = v; bx = x; by = y;
+    }
+    if (!m) return 0;
+    if (is_fill) { s_mlaa.n_fills++; return 1; }
+    /* 3. The buffer, scaled into the display buffer: MLAA and a blit. */
+    const eng_surface* ts = &g.surfaces[m->src_slot];
+    u32 dx, dy;
+    const u32 dslot = c->dst_location == RSX_LOCATION_LOCAL
+                    ? eng_blit_target(RSX_LOCATION_LOCAL, dst_px, c->dst_pitch, &dx, &dy) : ENG_INVALID;
+    const int whole = m->area == (m->x1 - m->x0) * (m->y1 - m->y0);
+    const char* why = NULL;
+    if (c->src_pitch != ts->guest_pitch) why = "a display copy at another pitch";
+    else if (!whole) why = "buffer copies with gaps";
+    else if (bx < m->x0 || by < m->y0 || bx + sw > m->x1 || by + sh > m->y1)
+        why = "a display copy outside the buffer copy";
+    else if (dslot == ENG_INVALID || dslot == m->src_slot) why = "a display copy into no colour target";
+    /* (The target may have been bound again since -- the HUD pass names it
+     * -- but not drawn into before the display copy, which comes first in
+     * the next frame.) */
+    else if (!ts->handle) why = "the image went away after its copy";
+    else if (dx + c->out_w > g.surfaces[dslot].w || dy + c->out_h > g.surfaces[dslot].h)
+        why = "a display copy past its target";
+    else if (g.be->surface_blit(g.be->user, ts->handle, bx, by, sw, sh, g.surfaces[dslot].handle,
+                                dx, dy, c->out_w, c->out_h,
+                                RSX_BE_BLIT_AA | (c->linear ? RSX_BE_BLIT_LINEAR : 0u)))
+        why = "the backend's MLAA pass failed";
+    if (why) {
+        eng_mlaa_materialize(m);
+        eng_mlaa_fallback(m, why);
+        m->used = 1;
+        s_mlaa_armed = eng_mlaa_any_armed();
+        return 0;
+    }
+    g.surfaces[dslot].stamp = g.surfaces[dslot].cwstamp = ++s_surf_clock;
+    if (m->skipped) { s_skchk[0]++; m->skipped = 0; }
+    m->used = 1;
+    s_mlaa_armed = eng_mlaa_any_armed();
+    s_mlaa.n_native++;
+    { static u32 logged;   /* the first native pass of each view slot */
+      const u32 bit = 1u << (u32)(m - s_mlaa.v);
+      if (!(logged & bit)) { logged |= bit;
+          fprintf(stderr, "[rsx engine] native MLAA: view %d target 0x%08X %ux%u at %u,%u -> 0x%08X %ux%u at %u,%u\n",
+                  (int)(m - s_mlaa.v), ts->offset, sw, sh, bx, by, g.surfaces[dslot].offset, c->out_w, c->out_h, dx, dy); } }
+    return 1;
+}
+
+/* A copy out of a colour target into local memory no target covers -- a
+ * texture the game samples later (MotorStorm: its composite, halved, into
+ * 0x02FF0000, and a 256x256 of it into 0x0CE50000) -- gets a colour target
+ * there, which the texture units then bind; the copy is a blit and the source
+ * needs no write-back with its wait for the GPU. Created once at the copy's
+ * pitch, as tall as its rows rounded up, again taller when one needs more.
+ * Only where nothing else is: no colour or depth target overlaps the rows.
+ * PS3RECOMP_ENG_GPU_BLIT=2 keeps such copies on the CPU. */
+static int eng_blit_alias_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_ENG_BLIT_ALIAS"); on = e && e[0] == '1'; }
+    return on;
+}
+static u32 eng_blit_new_target(const rsx_nv3089_copy* c, u32 src_slot, u32* dx, u32* dy)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_ENG_GPU_BLIT"); on = !(e && e[0] == '2'); }
+    if (!on || c->dst_location != RSX_LOCATION_LOCAL || c->dst_pitch % 4u || c->dst_pitch < 64u ||
+        c->dst_pitch > 16384u || (u64)c->out_x + c->out_w > c->dst_pitch / 4u)
+        return ENG_INVALID;
+    const u32 w = c->dst_pitch / 4u;
+    u32 h = (c->out_y + c->out_h + 63u) & ~63u;
+    const u32 lo = c->dst_offset;
+    const u64 hi = (u64)lo + (u64)c->dst_pitch * h;
+    /* the tallest one made here before, if any, sets the floor */
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        const eng_surface* s = &g.surfaces[i];
+        if (!s->handle || s->location != c->dst_location) continue;
+        const u64 shi = (u64)s->offset + (u64)(s->guest_pitch ? s->guest_pitch : s->w * 4u) * s->h;
+        if (s->offset < hi && shi > lo) {
+            if (s->offset == lo && s->w == w && s->guest_pitch == c->dst_pitch) { if (s->h > h) h = s->h; continue; }
+            /* PS3RECOMP_ENG_BLIT_ALIAS=1: a target at another pitch whose
+             * extent merely runs into these rows -- MotorStorm's half-size
+             * composite copy (0x02FF0000, pitch 2560) sits in the last rows
+             * of the 1280x1080 tonemap target (0x02AA0000, pitch 5120), so
+             * the copy went the CPU way with a whole write-back of its
+             * 1280x1080 source each frame (~4 ms and a GPU wait in 1P).
+             * Starting inside it is still refused. */
+            if (eng_blit_alias_on() && s->guest_pitch && s->guest_pitch != c->dst_pitch && s->offset < lo)
+                continue;
+            /* ... or one that only its last rows run into: the same copy's
+             * 540 rows end 7 KB into the 320x270 SSAO target 0x03150000. A
+             * small tail (an eighth of the new target at most) is let alias. */
+            if (eng_blit_alias_on() && s->offset > lo) {
+                const u64 ov = (shi < hi ? shi : hi) - s->offset;
+                if (ov * 8u < hi - lo) continue;
+            }
+            { static int n; const char* e = getenv("PS3RECOMP_ENG_NV3089_WHY");
+              if (e && e[0] == '1' && n++ < 8)
+                  fprintf(stderr, "[rsx engine] nv3089 new target at 0x%08X refused: colour target 0x%08X %ux%u pitch %u overlaps\n",
+                          lo, s->offset, s->w, s->h, s->guest_pitch); }
+            return ENG_INVALID;                  /* someone else's target */
+        }
+    }
+    for (u32 i = 0; i < g.n_zdepths; i++) {
+        const eng_zdepth* z = &g.zdepths[i];
+        if (!z->handle || z->location != c->dst_location || !z->guest_pitch) continue;
+        if (z->offset < hi && (u64)z->offset + (u64)z->guest_pitch * z->guest_h > lo) {
+            { static int n; const char* e = getenv("PS3RECOMP_ENG_NV3089_WHY");
+              if (e && e[0] == '1' && n++ < 8)
+                  fprintf(stderr, "[rsx engine] nv3089 new target at 0x%08X refused: zeta 0x%08X %ux%u pitch %u overlaps\n",
+                          lo, z->offset, z->guest_w, z->guest_h, z->guest_pitch); }
+            return ENG_INVALID;
+        }
+    }
+    const u32 slot = eng_surface_get(c->dst_location, lo, w, h, RSX_BE_FMT_R8G8B8A8);
+    if (slot == ENG_INVALID || slot == src_slot) return ENG_INVALID;
+    eng_surface* s = &g.surfaces[slot];
+    s->guest_fmt = ENG_SURF_A8R8G8B8;
+    s->guest_raster = 1u;
+    s->guest_pitch = c->dst_pitch;
+    { static int n; if (n++ < 8)
+        fprintf(stderr, "[rsx engine] NV3089 copy target made at 0x%08X %ux%u (pitch %u)\n", lo, w, h, c->dst_pitch); }
+    *dx = c->out_x; *dy = c->out_y;
+    return slot;
+}
+
+int rsx_draw_engine_nv3089(const rsx_nv3089_copy* c)
+{
+    /* PS3RECOMP_ENG_NV3089_LOG=<n>: the first n copies this sees, as given. */
+    { static long lg = -2, nl;
+      if (lg == -2) { const char* e = getenv("PS3RECOMP_ENG_NV3089_LOG"); lg = e ? atol(e) : 0; }
+      if (nl < lg) {
+          nl++;
+          u32 tx = 0, ty = 0;
+          const u32 sp = c->src_offset + (c->in_v >> 4) * c->src_pitch + (c->in_u >> 4) * 4u;
+          const u32 ss = g.ready ? eng_blit_target(c->src_location, sp, c->src_pitch, &tx, &ty) : ENG_INVALID;
+          fprintf(stderr, "[rsx engine] nv3089 #%ld f%u src %u:0x%08X p%u in %ux%u uv %u,%u ds 0x%X dt 0x%X fmt %u lin %u"
+                  " -> %u:0x%08X p%u fmt 0x%X out %ux%u at %u,%u clip %u,%u-%u,%u; src target %s (0x%08X %u,%u) mlaa %u/%u/%u\n",
+                  nl, g.frames, c->src_location, c->src_offset, c->src_pitch, c->in_w, c->in_h, c->in_u, c->in_v,
+                  c->ds_dx, c->dt_dy, c->scale_fmt, c->linear, c->dst_location, c->dst_offset, c->dst_pitch,
+                  c->dst_fmt, c->out_w, c->out_h, c->out_x, c->out_y, c->cx0, c->cy0, c->cx1, c->cy1,
+                  ss != ENG_INVALID ? "yes" : "no", ss != ENG_INVALID ? g.surfaces[ss].offset : 0, tx, ty,
+                  s_mlaa.v[0].verified, s_mlaa.v[0].pend, s_mlaa.v[0].obs);
+      } }
+    if (!g.ready || s_guest_reader || !g.be->surface_blit) return 0;
+    /* 32-bit ARGB on both sides, the whole destination inside the clip */
+    if ((c->scale_fmt != 3u && c->scale_fmt != 4u) || c->dst_fmt != 0xAu) return 0;
+    if (c->out_x < c->cx0 || c->out_y < c->cy0 || (u64)c->out_x + c->out_w > c->cx1 ||
+        (u64)c->out_y + c->out_h > c->cy1)
+        return 0;
+    u32 sx, sy, sw, sh;
+    if (!eng_nv3089_src_rect(c, &sx, &sy, &sw, &sh)) return 0;
+    if (s_mlaa.d.mode == 1u && eng_mlaa_copy(c, sx, sy, sw, sh)) return 1;
+    if (!eng_gpu_blit_on() || c->dst_location != RSX_LOCATION_LOCAL) return 0;
+    /* Target to target. */
+    u32 tx, ty, dx, dy;
+    const u32 src_px = c->src_offset + sy * c->src_pitch + sx * 4u;
+    const u32 dst_px = c->dst_offset + c->out_y * c->dst_pitch + c->out_x * 4u;
+    const u32 ss = eng_blit_target(c->src_location, src_px, c->src_pitch, &tx, &ty);
+    if (ss == ENG_INVALID) return 0;
+    u32 ds = eng_blit_target(c->dst_location, dst_px, c->dst_pitch, &dx, &dy);
+    if (ds == ENG_INVALID) ds = eng_blit_new_target(c, ss, &dx, &dy);
+    /* A copy target made for a smaller copy before (620x510 of the halved
+     * composite, then 640x540): made again taller (BLIT_ALIAS's path). */
+    else if (eng_blit_alias_on() && (dx + c->out_w > g.surfaces[ds].w || dy + c->out_h > g.surfaces[ds].h)) {
+        u32 nx, ny; const u32 nd = eng_blit_new_target(c, ss, &nx, &ny);
+        if (nd != ENG_INVALID) { ds = nd; dx = nx; dy = ny; }
+    }
+    /* PS3RECOMP_ENG_NV3089_WHY=1: why a target-to-target copy goes the CPU way (first 16). */
+    static int why_on = -1; static int nwhy;
+    if (why_on < 0) { const char* e = getenv("PS3RECOMP_ENG_NV3089_WHY"); why_on = e && e[0] == '1'; }
+    if (ds == ENG_INVALID || ds == ss) {
+        if (why_on && nwhy++ < 16)
+            fprintf(stderr, "[rsx engine] nv3089 CPU: no destination target at 0x%08X p%u (%ux%u at %u,%u) from 0x%08X\n",
