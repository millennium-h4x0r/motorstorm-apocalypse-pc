+/* The linear A8R8G8B8 / D8R8G8B8 row path against the texel-by-texel
+ * meaning, odd width and padded source rows, both channel orders. */
+static void test_decode_argb_rows(void)
+{
+    const u32 fmts[2] = { FMT_A8R8G8B8, FMT_D8R8G8B8 };
+    for (int fi = 0; fi < 2; fi++)
+      for (int as_rgba = 0; as_rgba < 2; as_rgba++) {
+        rsx_tex_layout L;
+        rsx_texture_layout(fmts[fi] | FMT_LN, 7, 3, &L);
+        L.row_bytes = 7 * 4 + 12;                       /* a pitch with padding */
+        u8 src[3 * 40], out[3 * 7 * 4];
+        for (u32 i = 0; i < sizeof src; i++) src[i] = (u8)(i * 37u + 11u);
+        rsx_texture_decode(out, 7 * 4, src, 7, 3, &L, as_rgba);
+        for (u32 y = 0; y < 3; y++)
+            for (u32 x = 0; x < 7; x++) {
+                const u8* sp = src + y * 40 + x * 4;
+                const u8* dp = out + (y * 7 + x) * 4;
+                const u8 want[4] = { as_rgba ? sp[0] : sp[1], as_rgba ? sp[1] : sp[2],
+                                     as_rgba ? sp[2] : sp[3],
+                                     fmts[fi] == FMT_D8R8G8B8 ? 255 : (as_rgba ? sp[3] : sp[0]) };
+                for (int c = 0; c < 4; c++) CHECK_EQ(dp[c], want[c]);
+            }
+      }
+}
