+static void diff_report(spu_diff_t* d, spu_context* c, const char* what)
+{
+    d->bad = 1;
+    __atomic_store_n(&c->stop_request, 1, __ATOMIC_RELAXED);   /* end the replay here */
+    if (d->quiet) return;
+    if (__atomic_fetch_add(&s_diff_logged, 1, __ATOMIC_RELAXED) >= s_diff_log) return;
+    fprintf(stderr, "[spu-diff] img=%d run %lu entry 0x%05X: step %u/%u at interp pc 0x%05X: %s\n",
+            d->img, d->run, d->entry, d->pos, d->n, c->pc & SPU_LS_MASK, what);
+}
+/* next record in replay, checked against what the interpreter does */
+static spu_diff_rec* diff_next(spu_diff_t* d, spu_context* c, uint8_t type, uint32_t a, uint32_t b)
+{
+    if (d->bad) return NULL;
+    if (d->pos >= d->n) { char w[160]; snprintf(w, sizeof w, "interpreter does %s a=0x%X b=0x%X past the end of the lifted run's record", diff_tn(type), a, b); diff_report(d, c, w); return NULL; }
+    spu_diff_rec* r = &d->r[d->pos];
+    if (r->type != type || r->a != a || r->b != b) {
+        char w[200]; snprintf(w, sizeof w, "lifted did %s a=0x%X b=0x%X, interpreter %s a=0x%X b=0x%X",
+                              diff_tn(r->type), r->a, r->b, diff_tn(type), a, b);
+        diff_report(d, c, w); return NULL;
+    }
+    d->pos++;
+    return r;
+}
+static void diff_cmp_bytes(spu_diff_t* d, spu_context* c, spu_diff_rec* r, const uint8_t* got, const char* what)
+{
+    const uint8_t* want = d->bytes + r->off;
+    for (uint32_t i = 0; i < r->n; i++) if (want[i] != got[i]) {
+        char w[300]; int p = snprintf(w, sizeof w, "%s ea=0x%08X size=%u differs at +0x%X: lifted", what, r->b, r->n, i);
+        const uint32_t s0 = i & ~15u;
+        for (uint32_t k = s0; k < s0 + 16 && k < r->n; k += 4) p += snprintf(w + p, sizeof w - p, " %02X%02X%02X%02X", want[k], want[k+1], want[k+2], want[k+3]);
+        p += snprintf(w + p, sizeof w - p, " | interp");
+        for (uint32_t k = s0; k < s0 + 16 && k < r->n; k += 4) p += snprintf(w + p, sizeof w - p, " %02X%02X%02X%02X", got[k], got[k+1], got[k+2], got[k+3]);
+        d->mis_ls = (r->a + s0) & SPU_LS_MASK;
+        diff_report(d, c, w);
+        return;
+    }
+}
+int spu_diff_dma(spu_context* c, uint32_t lsa, uint32_t ea, uint32_t size, uint32_t cmd)
 {
+    spu_diff_t* d = (spu_diff_t*)g_spu_diff;
+    const int get = mfc_is_get(cmd), put = mfc_is_put(cmd);
+    if (!get && !put) return 0;
+    if (!d->replay) {   /* record: a GET's bytes after the copy -- so note it as it goes */
+        if (put) diff_push(d, 2, lsa, ea, size, &c->ls[lsa], size);
+        else diff_push(d, 1, lsa, ea, size, vm_base + ea, size);   /* the bytes the copy will read */
+        return 0;
+    }
+    spu_diff_rec* r = diff_next(d, c, get ? 1 : 2, lsa, ea);
+    if (!r) return 1;
+    if (get) memcpy(&c->ls[lsa], d->bytes + r->off, r->n < size ? r->n : size);
+    else diff_cmp_bytes(d, c, r, &c->ls[lsa], "PUT");
+    return 1;
+}
+int spu_diff_atomic(spu_context* c, uint32_t cmd, int after)
+{
+    spu_diff_t* d = (spu_diff_t*)g_spu_diff;
+    const uint32_t lsa = c->mfc_lsa & SPU_LS_MASK & ~127u, ea = c->mfc_eal & ~127u;
+    const uint8_t t = cmd == MFC_GETLLAR_CMD ? 3 : cmd == MFC_PUTLLC_CMD ? 4 : 5;
+    if (!d->replay) {
+        if (!after && t != 3) diff_push(d, t, lsa, ea, 0, &c->ls[lsa], 128);
+        else if (after && t == 3) diff_push(d, 3, lsa, ea, c->atomic_stat, &c->ls[lsa], 128);
+        else if (after) d->r[d->n - 1].c = c->atomic_stat;
+        return 0;
+    }
+    if (after) return 0;
+    spu_diff_rec* r = diff_next(d, c, t, lsa, ea);
+    if (r) {
+        if (t == 3) memcpy(&c->ls[lsa], d->bytes + r->off, 128);
+        else diff_cmp_bytes(d, c, r, &c->ls[lsa], t == 4 ? "PUTLLC" : "PUTLLUC");
+        c->atomic_stat = r->c;
+    }
+    return 1;
+}
+int spu_diff_ch(spu_context* c, uint8_t type, uint32_t ch, u128* v)
+{
+    spu_diff_t* d = (spu_diff_t*)g_spu_diff;
+    if (!d->replay || d->no_ch) return 0;
+    spu_diff_rec* r = diff_next(d, c, type, ch, 0);
+    if (r) memcpy(v, d->bytes + r->off, 16);
+    else memset(v, 0, 16);
+    return 1;
+}
+/* SPU_DIFF_CONTROL=1: the recorded (live) run is interpreted as well. Any
+ * difference then is the harness's (an input it does not record), not a
+ * lifter bug: a control for the lifted-vs-interpreted reports. */
+uint32_t spu_diff_live_interp(void* tok)
+{
+    static int s_c = -1; if (s_c < 0) { const char* e = getenv("SPU_DIFF_CONTROL"); s_c = e && e[0] == '1'; }
+    if (!s_c) return 0;
+    ((spu_diff_t*)tok)->live_interp = 1;
+    return ((spu_diff_t*)tok)->entry;
+}
+int spu_diff_replaying(void) { return g_spu_diff && (((spu_diff_t*)g_spu_diff)->replay || ((spu_diff_t*)g_spu_diff)->live_interp); }
+static int spu_diff_recording_replay(void) { return g_spu_diff && ((spu_diff_t*)g_spu_diff)->replay; }
+uint32_t spu_diff_cut(void) { return g_spu_diff ? ((spu_diff_t*)g_spu_diff)->cut : 0; }
+void spu_diff_ch_rec(spu_context* c, uint8_t type, uint32_t ch, u128 v)
+{
+    (void)c;
+    spu_diff_t* d = (spu_diff_t*)g_spu_diff;
+    if (!d->replay && !d->no_ch) diff_push(d, type, ch, 0, 0, &v, 16);
+}
+uint32_t spu_fn_lsa(void (*fn)(spu_context*), int image_id);
+extern void spu_mfc_release(spu_context*);
+extern void spu_coh_unregister(spu_context*);
+void* spu_diff_begin(spu_context* c, void (*entry)(spu_context*), int img)
+{
+    if (g_spu_diff_on < 0) spu_diff_init();
+    if (!g_spu_diff_on || img <= 0 || img >= 512 || !s_diff_img[img] || g_spu_diff) return NULL;
+    const unsigned long run = __atomic_fetch_add(&s_diff_runs[img], 1ul, __ATOMIC_RELAXED);
+    if (run % (unsigned long)s_diff_every) return NULL;
+    const uint32_t lsa = spu_fn_lsa(entry, img);
+    if (!lsa) return NULL;
+    spu_diff_t* d = (spu_diff_t*)calloc(1, sizeof *d);
+    d->snap = (spu_context*)malloc(sizeof(spu_context));
+    if (!d->snap) { free(d); return NULL; }
+    memcpy(d->snap, c, sizeof(spu_context));
+    /* ls is a pointer (to c->ls_store, or guest memory for a raw SPU): the
+     * snapshot must own its copy, or the replay starts from the END state. */
+    d->snap->ls = d->snap->ls_store;
+    if (c->ls != c->ls_store) memcpy(d->snap->ls_store, c->ls, SPU_LS_SIZE);
+    d->img = img; d->entry = lsa; d->run = run;
+    g_spu_diff = d;
+    return d;
+}
+/* One replay of the record from the start state; lifts allowed below `cut`
+ * (0: none). Returns 1 if every compared output agreed. */
+static int spu_diff_replay(spu_diff_t* d, uint32_t cut)
+{
+    spu_context* r = (spu_context*)malloc(sizeof(spu_context));
+    if (!r) return -1;
+    spu_context_init(r, d->snap->spu_id);
+    memcpy(r->gpr, d->snap->gpr, sizeof r->gpr);
+    memcpy(r->ls, d->snap->ls, SPU_LS_SIZE);
+    r->image_id = d->snap->image_id;
+    r->event_mask = d->snap->event_mask;
+    d->replay = 1; d->pos = 0; d->bad = 0; d->cut = cut;
+    g_spu_diff = d;
+    spu_interp_run_until(r, d->entry, 0xA70u);
+    g_spu_diff = NULL;
+    spu_mfc_release(r); spu_coh_unregister(r);
+    free(r);
+    return !d->bad;
+}
+void spu_diff_end(spu_context* c, void* tok)
+{
+    (void)c;
+    spu_diff_t* d = (spu_diff_t*)tok;
+    g_spu_diff = NULL;
+    const int ok = spu_diff_replay(d, 0);
+    /* A PUT that differed: replay again watching the LS qword it came from,
+     * and name the interpreter's last writers of it (the lifted code at those
+     * pcs is where to look). */
+    if (ok == 0 && d->mis_ls && __atomic_load_n(&s_diff_logged, __ATOMIC_RELAXED) <= s_diff_log) {
+        extern SPU_THREAD_LOCAL uint32_t g_spu_lswatch_addr; extern void spu_lswatch_arm(uint32_t);
+        extern SPU_THREAD_LOCAL struct { uint32_t pc; uint8_t b[16]; } g_spu_lswatch_ring[8];
+        extern SPU_THREAD_LOCAL unsigned g_spu_lswatch_n;
+        const uint32_t ls = d->mis_ls;
+        d->quiet = 1; spu_lswatch_arm(ls);
+        spu_diff_replay(d, 0);
+        g_spu_lswatch_addr = 0; d->quiet = 0;
+        const unsigned n = g_spu_lswatch_n, k0 = n > 8 ? n - 8 : 0;
+        for (unsigned k = k0; k < n; k++) {
+            const uint8_t* b = g_spu_lswatch_ring[k & 7u].b;
+            fprintf(stderr, "[spu-diff]   LS 0x%05X written (interp) by pc 0x%05X -> %02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X (write %u of %u)\n",
+                    ls, g_spu_lswatch_ring[k & 7u].pc, b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7],
+                    b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15], k + 1, n);
+        }
+    }
+    if (ok > 0) __atomic_fetch_add(&s_diff_ok, 1, __ATOMIC_RELAXED);
+    const int n = __atomic_add_fetch(&s_diff_checked, 1, __ATOMIC_RELAXED);
+    if (n <= 4 || (n % 50) == 0)
+        fprintf(stderr, "[spu-diff] %d runs checked, %d agreed (img=%d run %lu: %u/%u steps replayed%s)\n",
+                n, __atomic_load_n(&s_diff_ok, __ATOMIC_RELAXED), d->img, d->run, d->pos, d->n,
+                d->pos >= d->n ? "" : ", stopped early");
+    free(d->snap); free(d->r); free(d->bytes); free(d);
+}
