+    "            Light li = lights[l];\n"
+    "            float3 pos = li.pos_radius.xyz;\n"
+    "            float r = li.pos_radius.w;\n"
+    "            float3 near = pos - clamp(pos, lo, hi);\n"
+    "            if (dot(near, near) >= r * r) continue;\n"
+    "            if (any(float4(dot(pl[0], pos), dot(pl[1], pos), dot(pl[2], pos), dot(pl[3], pos)) + r < 0.0)) continue;\n"
