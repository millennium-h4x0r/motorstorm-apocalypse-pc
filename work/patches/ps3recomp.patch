+/* The FIFO parser on its own thread: on by default (2026-11-11: 4P ~32 -> ~37
+ * fps, 1P unchanged; splitscreen, first_race and 39/39 tracks; no freeze in
+ * the Havok hunt's split-on races). PS3RECOMP_RSX_SPLIT=0 keeps one RSX
+ * thread; =2 is lockstep (the parser waits for the executor after every
+ * pass). Read on the rsx thread's first drain. */
+static int gcm_split_on(void)
+{
+    static int on = -1;
+    if (on >= 0) return on;
+    on = 0;
+    const char* e = getenv("PS3RECOMP_RSX_SPLIT");
+    if (e && *e && atoi(e) == 0) return 0;
+    if (!e || !*e) e = "1";
+#ifdef _WIN32
+    fprintf(stderr, "[gcm] PS3RECOMP_RSX_SPLIT: not supported on this host -- one RSX thread\n");
+    return 0;
+#else
+    if (gcm_fifo_dbg() || getenv("GCM_WORD_STATS") || getenv("GCM_METHOD_HIST") || rsx_live_draw_enabled()) {
+        fprintf(stderr, "[gcm] PS3RECOMP_RSX_SPLIT: off -- a per-word FIFO diagnostic or the live "
+                "engine is on, and those run on the single RSX thread only\n");
+        return 0;
+    }
+    long mb = 16;
+    { const char* r = getenv("PS3RECOMP_RSX_SPLIT_RING_MB"); if (r && atol(r) > 0) mb = atol(r); }
+    u64 words = 1;
+    while (words * 4u < (u64)mb << 20) words <<= 1;
+    s_ring = (u32*)malloc(words * 4u);
+    if (!s_ring) { fprintf(stderr, "[gcm] PS3RECOMP_RSX_SPLIT: no memory for the ring\n"); return 0; }
+    s_ring_cap = words; s_ring_mask = words - 1;
+    if (!s_inited) { rsx_state_init(&s_state); s_inited = 1; }
+    s_split_lockstep = atoi(e) == 2;
+    /* The executor's state above is ready before the parser can write. */
+    AcquireSRWLockExclusive(&s_gcm_fifo_lock);
+    s_split_get_pub = s_fifo_getoff;
+    s_split = 1;
+    ReleaseSRWLockExclusive(&s_gcm_fifo_lock);
+    pthread_t t;
+    if (pthread_create(&t, NULL, gcm_split_parser_main, NULL) != 0) {
+        fprintf(stderr, "[gcm] PS3RECOMP_RSX_SPLIT: parser thread not started -- one RSX thread\n");
+        s_split = 0;
+        return 0;
+    }
+    pthread_detach(t);
+    fprintf(stderr, "[gcm] PS3RECOMP_RSX_SPLIT: FIFO parser on its own thread (ring %llu MB%s)\n",
+            (unsigned long long)(words * 4u >> 20), s_split_lockstep ? ", lockstep" : "");
+    on = 1;
+    return 1;
+#endif
