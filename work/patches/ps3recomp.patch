+/* ===========================================================================
+ * PPU stores to marked lines (VM_WRITE_COH, vm_store_coh_notify, ...)
+ *
+ * Every PPU store whose line is marked in the bitmap lands here instead of
+ * open-coding mask, lock, store, notify, unlock. The store still serializes on
+ * the line's stripe; the notify runs only when a claim can be live on the
+ * line (see "Live claims" above).
+ * ===========================================================================*/
+/* Unmarking. A marked line that store after store has no live claim -- the
+ * libgcm command buffer, once some agent reserved a line of it -- goes on
+ * paying the stripe lock on every store, and its lines make every big SPU DMA
+ * PUT over them lock its whole range. After SPU_COH_DEAD_RUN such stores in
+ * a row (per counter; a new claim on the counter starts the run again) the
+ * line is unmarked, so its stores take the plain path again.
+ *
+ * Called with the line's stripe held and fenced. The handshake with a holder
+ * arriving at that moment: every holder raises its claim BEFORE it looks at
+ * the bit (coh_claim_set, then coh_mark_line), and we clear the bit BEFORE we
+ * look at the claims. So either the holder sees the bit clear and marks the
+ * line again with its first-mark barrier, or we see its claim and put the bit
+ * back -- with a barrier of our own, since a PPU store may have seen the bit
+ * clear in between. A holder's snapshot can not be taken in between either:
+ * its seqlock read waits for the stripe we hold.
+ *
+ * SPU_COH_UNMARK=0: lines stay marked (the old behaviour). */
+#define SPU_COH_DEAD_RUN 64
+static int s_coh_unmark_on = -1;
+unsigned long g_spu_coh_unmarks, g_spu_coh_remarks;
+static void coh_line_dead(uint32_t line)
+{
+    if (__builtin_expect(s_lw_n > 0, 0) && lw_is(line)) return;   /* watched lines stay marked */
+    int on = __atomic_load_n(&s_coh_unmark_on, __ATOMIC_RELAXED);
+    if (__builtin_expect(on < 0, 0)) {
+        const char* e = getenv("SPU_COH_UNMARK");
+        on = !(e && e[0] == '0');
+        __atomic_store_n(&s_coh_unmark_on, on, __ATOMIC_RELAXED);
+    }
+    if (!on) return;
+    uint8_t* d = &s_coh_dead[coh_live_ctr(line) - s_coh_live];
+    const unsigned v = __atomic_load_n(d, __ATOMIC_RELAXED) + 1u;
+    if (v < SPU_COH_DEAD_RUN) { __atomic_store_n(d, (uint8_t)v, __ATOMIC_RELAXED); return; }
+    __atomic_store_n(d, 0, __ATOMIC_RELAXED);
+    const uint32_t li = line >> SPU_COH_LINE_SHIFT;
+    const unsigned char bit = (unsigned char)(1u << (li & 7));
+    __atomic_fetch_and(&s_coh_bitmap[li >> 3], (unsigned char)~bit, __ATOMIC_SEQ_CST);
+    __atomic_store_n(&g_spu_coh_lines[li], 0, __ATOMIC_SEQ_CST);
+    if (__atomic_load_n(coh_live_ctr(line), __ATOMIC_SEQ_CST) != 0 ||
+        __atomic_load_n(&s_coh_untracked, __ATOMIC_SEQ_CST)) {
+        __atomic_fetch_or(&s_coh_bitmap[li >> 3], bit, __ATOMIC_SEQ_CST);
+        __atomic_store_n(&g_spu_coh_lines[li], 1, __ATOMIC_SEQ_CST);
+        spu_process_barrier();
+        __atomic_fetch_add(&g_spu_coh_remarks, 1ul, __ATOMIC_RELAXED);
+        return;
+    }
+    /* The byte store above may have landed after a concurrent coh_mark_line
+     * set the bit and its byte (bit op and byte store are two steps): the bit
+     * says which won. Put the byte back, with the barrier the mark's readers
+     * rely on. */
+    if (__atomic_load_n(&s_coh_bitmap[li >> 3], __ATOMIC_SEQ_CST) & bit) {
+        __atomic_store_n(&g_spu_coh_lines[li], 1, __ATOMIC_SEQ_CST);
+        spu_process_barrier();
+        __atomic_fetch_add(&g_spu_coh_remarks, 1ul, __ATOMIC_RELAXED);
+        return;
+    }
+    __atomic_fetch_add(&g_spu_coh_unmarks, 1ul, __ATOMIC_RELAXED);
+}
+
+/* SPU_COH_STATS=1: every 10 s, marked-line PPU stores that notified / found
+ * nothing live, and the lines unmarked / put back meanwhile. */
+static int s_coh_stats = -1;
+static unsigned long s_coh_st_live, s_coh_st_dead;
+static void coh_stats_tick(int live)
+{
+    __atomic_fetch_add(live ? &s_coh_st_live : &s_coh_st_dead, 1ul, __ATOMIC_RELAXED);
+    static unsigned long long last; extern unsigned long long ps3_qpc_us(void);
+    const unsigned long long now = ps3_qpc_us(), l = __atomic_load_n(&last, __ATOMIC_RELAXED);
+    if (now - l < 10000000ull ||
+        !__atomic_compare_exchange_n(&last, (unsigned long long*)&l, now, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED))
+        return;
+    fprintf(stderr, "[coh-stats] marked-line PPU stores: notified %lu, nothing live %lu; unmarked %lu, put back %lu\n",
+            __atomic_exchange_n(&s_coh_st_live, 0ul, __ATOMIC_RELAXED),
+            __atomic_exchange_n(&s_coh_st_dead, 0ul, __ATOMIC_RELAXED),
+            __atomic_exchange_n(&g_spu_coh_unmarks, 0ul, __ATOMIC_RELAXED),
+            __atomic_exchange_n(&g_spu_coh_remarks, 0ul, __ATOMIC_RELAXED));
+}
+
+static inline void coh_ppu_notify_lines(uint32_t ea, uint32_t n)
+{
+    /* Full fence: orders our stripe sequence bump before the counter loads
+     * (the store-buffer half of the handshake with GETLLAR). */
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    const uint32_t first = ea & ~127u, last = (uint32_t)(ea + (n ? n - 1u : 0u)) & ~127u;
+    for (uint32_t line = first; ; line += 128u) {
+        if (spu_coh_is_reserved(line)) {
+            const int live = coh_line_live(line);
+            if (live) spu_coh_notify_write_from_ppu(line);
+            else coh_line_dead(line);
+            if (__builtin_expect(s_coh_stats != 0, 0)) {
+                if (s_coh_stats < 0) s_coh_stats = getenv("SPU_COH_STATS") ? 1 : 0;
+                if (s_coh_stats) coh_stats_tick(live);
+            }
+        }
+        if (line == last) break;
+    }
+}
+
+/* Store n bytes (guest order) at host/ea under the stripe(s), notifying the
+ * lines a reservation may be live on. */
+void spu_coh_ppu_store(uint8_t* host, uint32_t ea, const void* src, uint32_t n)
+{
+    if (__builtin_expect(s_lw_n != 0, 0) && lw_is(ea & ~127u)) {
+        const uint64_t m = spu_lockline_mask_range(ea, n);
+        spu_lockline_lock_mask(m);
+        gm_store_bytes(host, src, n);
+        lw_note(ea, 'S', lw_ppu_who());
+        coh_ppu_notify_lines(ea, n);
+        spu_lockline_unlock_mask(m);
+        return;
+    }
+    if (((ea ^ (uint32_t)(ea + (n ? n - 1u : 0u))) & ~127u) == 0 && !ll_global()
+#ifndef _MSC_VER
+        && s_ll_stats <= 0
+#endif
+        ) {
+        ll_stripe* s = &g_ll[ll_stripe_of(ea)];
+        ll_take(s);
+        gm_store_bytes(host, src, n);
+        coh_ppu_notify_lines(ea, n);
+        ll_drop(s);
+        return;
+    }
+    const uint64_t m = spu_lockline_mask_range(ea, n);
+    spu_lockline_lock_mask(m);
+    gm_store_bytes(host, src, n);
+    coh_ppu_notify_lines(ea, n);
+    spu_lockline_unlock_mask(m);
+}
+
+/* The notify half for a caller that already holds the stripes of
+ * [ea, ea + n) and has stored (vm_memcpy_to / vm_memset). */
+void spu_coh_ppu_notify_locked(uint32_t ea, uint32_t n)
+{
+    coh_ppu_notify_lines(ea, n);
+}
+
+/* The store already landed (its line was unmarked when checked, and is marked
+ * now): the notify half only. */
+void spu_coh_ppu_wrote(uint32_t ea, uint32_t n)
+{
+    const uint64_t m = spu_lockline_mask_range(ea, n);
+    spu_lockline_lock_mask(m);
+    coh_ppu_notify_lines(ea, n);
+    spu_lockline_unlock_mask(m);
+}
+
 #ifdef __cplusplus
 }
 #endif
