+    "[[vk::binding(1)]] RWStructuredBuffer<float4> block_bounds;   // lo, hi per block\n"
+    "[[vk::binding(2)]] RWStructuredBuffer<uint> tiles;            // TILE_WORDS per tile\n"
+    "struct Light { float4 pos_radius; float4 colour_mag; float4 dir_kind; float4 falloff; };\n"
+    "[[vk::binding(3)]] RWStructuredBuffer<Light> lights;\n"
+    "Texture2D<float4> normals_tex : register(t0);   // material in A, normal in RGB\n"
+    "Texture2D<float4> depth_tex : register(t1);     // 24-bit depth in A, R, G\n"
