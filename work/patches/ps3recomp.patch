+/* One side of test_vmx_simd: ppu_vmx.h's float ops compiled for whatever
+ * -march the build passes, behind names with a prefix (PFX), so a baseline
+ * build (the scalar loops) and an x86-64-v3 one (the SSE/AVX forms) can be
+ * linked into one program and compared. */
+#include <stdint.h>
+#include <string.h>
+#include <math.h>
+#include "../ppu_vmx.h"
+#define CAT2(a, b) a##b
+#define CAT(a, b) CAT2(a, b)
+void CAT(PFX, vaddfp)(void* d, const void* a, const void* b, uint32_t v)   { vmx_vaddfp(d, a, b, v); }
+void CAT(PFX, vsubfp)(void* d, const void* a, const void* b, uint32_t v)   { vmx_vsubfp(d, a, b, v); }
+void CAT(PFX, vmaxfp)(void* d, const void* a, const void* b, uint32_t v)   { vmx_vmaxfp(d, a, b, v); }
+void CAT(PFX, vminfp)(void* d, const void* a, const void* b, uint32_t v)   { vmx_vminfp(d, a, b, v); }
+void CAT(PFX, vmaddfp)(void* d, const void* a, const void* b, const void* c, uint32_t v)  { vmx_vmaddfp(d, a, b, c, v); }
+void CAT(PFX, vnmsubfp)(void* d, const void* a, const void* b, const void* c, uint32_t v) { vmx_vnmsubfp(d, a, b, c, v); }
+void CAT(PFX, vrefp)(void* d, const void* b, uint32_t v)     { vmx_vrefp(d, b, v); }
+void CAT(PFX, vrsqrtefp)(void* d, const void* b, uint32_t v) { vmx_vrsqrtefp(d, b, v); }
+void CAT(PFX, vcfsx)(void* d, const void* b, unsigned u)  { vmx_vcfsx(d, b, u); }
+void CAT(PFX, vcfux)(void* d, const void* b, unsigned u)  { vmx_vcfux(d, b, u); }
+void CAT(PFX, vctsxs)(void* d, const void* b, unsigned u, uint32_t* v) { vmx_vctsxs(d, b, u, v); }
+void CAT(PFX, vctuxs)(void* d, const void* b, unsigned u, uint32_t* v) { vmx_vctuxs(d, b, u, v); }
+void CAT(PFX, vperm)(void* d, const void* a, const void* b, const void* c) { vmx_vperm(d, a, b, c); }
+void CAT(PFX, vsldoi)(void* d, const void* a, const void* b, unsigned sh) {
+    switch (sh & 15) {
+#define S(k) case k: VMX_VSLDOI(d, a, b, k); break;
+    S(0) S(1) S(2) S(3) S(4) S(5) S(6) S(7) S(8) S(9) S(10) S(11) S(12) S(13) S(14) S(15)
+#undef S
+    } }
+uint32_t CAT(PFX, vcmpeqfp)(void* d, const void* a, const void* b) { return vmx_vcmpeqfp(d, a, b); }
+uint32_t CAT(PFX, vcmpgefp)(void* d, const void* a, const void* b) { return vmx_vcmpgefp(d, a, b); }
+uint32_t CAT(PFX, vcmpgtfp)(void* d, const void* a, const void* b) { return vmx_vcmpgtfp(d, a, b); }
+void CAT(PFX, vrfin)(void* d, const void* b, uint32_t v) { vmx_vrfin(d, b, v); }
+void CAT(PFX, vrfiz)(void* d, const void* b, uint32_t v) { vmx_vrfiz(d, b, v); }
+void CAT(PFX, vrfip)(void* d, const void* b, uint32_t v) { vmx_vrfip(d, b, v); }
+void CAT(PFX, vrfim)(void* d, const void* b, uint32_t v) { vmx_vrfim(d, b, v); }
+void CAT(PFX, vmhaddshs)(void* d, const void* a, const void* b, const void* c, uint32_t* v) { vmx_vmhaddshs(d, a, b, c, v); }
+void CAT(PFX, vmhraddshs)(void* d, const void* a, const void* b, const void* c, uint32_t* v) { vmx_vmhraddshs(d, a, b, c, v); }
+void CAT(PFX, vmladduhm)(void* d, const void* a, const void* b, const void* c) { vmx_vmladduhm(d, a, b, c); }
+void CAT(PFX, vmsumshm)(void* d, const void* a, const void* b, const void* c) { vmx_vmsumshm(d, a, b, c); }
+void CAT(PFX, vmsumubm)(void* d, const void* a, const void* b, const void* c) { vmx_vmsumubm(d, a, b, c); }
