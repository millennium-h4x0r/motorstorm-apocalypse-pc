diff --git a/runtime/spu/tests/test_spu_float_mx.c b/runtime/spu/tests/test_spu_float_mx.c
new file mode 100644
index 00000000..55ea5d27
--- /dev/null
+++ b/runtime/spu/tests/test_spu_float_mx.c
@@ -0,0 +1,80 @@
+/* SPU_FP_MX (runtime/spu/spu_helpers.h, SPU_FP_MXCSR=1): the fast single-precision forms,
+ * run under MXCSR round toward zero + FTZ + DAZ, against the exact forms under the default
+ * MXCSR, bit for bit.
+ * Random operands mixed with edge values (zeros, SPU zeros with fractions, exponent 255,
+ * near FLT_MAX, near 2^-126, values that cancel). */
+#include "spu_helpers.h"
+#ifndef SPU_FP_MX
+int main(void) { return 0; }   /* the fast forms need x86-64 with AVX2 and FMA, without AVX-512 */
+#else
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+uint8_t* vm_base; uint32_t ppu_vm_size;
+static uint64_t s = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void) { s ^= s << 13; s ^= s >> 7; s ^= s << 17; return (uint32_t)s; }
+static uint32_t pick(void) {
+    static const uint32_t edge[] = { 0, 0x80000000u, 1, 0x807FFFFFu, 0x00400000u, 0x7F800000u, 0xFF800000u, 0x7FFFFFFFu,
+        0xFFFFFFFFu, 0x7FC00000u, 0x7F7FFFFFu, 0xFF7FFFFFu, 0x7F000000u, 0x00800000u, 0x80800000u, 0x00800001u,
+        0x3F800000u, 0xBF800000u, 0x3F800001u, 0x7F7FFFFEu, 0x01000000u, 0x00FFFFFFu };
+    const uint32_t r = rnd();
+    switch (r & 7) {
+    case 0: return edge[(r >> 3) % (sizeof edge / sizeof edge[0])];
+    case 1: return (rnd() & 0x80FFFFFFu) | ((uint32_t)(1 + (r >> 8) % 6) << 23);       /* tiny */
+    case 2: return (rnd() & 0x80FFFFFFu) | ((uint32_t)(250 + (r >> 8) % 6) << 23);     /* huge, exp 250..255 */
+    default: return (rnd() & 0x807FFFFFu) | ((uint32_t)(100 + (r >> 8) % 56) << 23);   /* ordinary */
+    }
+}
+static u128 vec(void) { u128 v; for (int i = 0; i < 4; i++) v._u32[i] = pick(); return v; }
+int main(int argc, char** argv) {
+    const long n = argc > 1 ? atol(argv[1]) : 2000000;
+    long bad[6] = {0}; const char* nm[6] = { "fa", "fs", "fm", "fma", "fms", "fnms" };
+    for (long k = 0; k < n; k++) {
+        u128 a = vec(), b = vec(), c = vec();
+        if ((k & 3) == 0) { for (int i = 0; i < 4; i++) b._u32[i] = a._u32[i] ^ (rnd() & 0x80000003u); } /* near-cancel */
+        if ((k & 7) == 1) { for (int i = 0; i < 4; i++) c._u32[i] = (a._u32[i] ^ 0x80000000u) + (rnd() & 7); }
+        u128 e[6], f[6];
+        spu_fp_fast = 0; _mm_setcsr(0x1F80u);
+        e[0] = spu_fa(a, b); e[1] = spu_fs(a, b); e[2] = spu_fm(a, b);
+        e[3] = spu_fma(a, b, c); e[4] = spu_fms(a, b, c); e[5] = spu_fnms(a, b, c);
+        spu_fp_fast = 1; _mm_setcsr(0xFFC0u);
+        f[0] = spu_fa(a, b); f[1] = spu_fs(a, b); f[2] = spu_fm(a, b);
+        f[3] = spu_fma(a, b, c); f[4] = spu_fms(a, b, c); f[5] = spu_fnms(a, b, c);
+        spu_fp_fast = 0; _mm_setcsr(0x1F80u);
+        for (int o = 0; o < 6; o++) if (memcmp(&e[o], &f[o], 16)) {
+            if (bad[o]++ < 5) {
+                fprintf(stderr, "%s diff:", nm[o]);
+                for (int i = 0; i < 4; i++) if (e[o]._u32[i] != f[o]._u32[i])
+                    fprintf(stderr, " [%d] a=%08X b=%08X c=%08X exact=%08X fast=%08X", i, a._u32[i], b._u32[i], c._u32[i], e[o]._u32[i], f[o]._u32[i]);
+                fprintf(stderr, "\n");
+            }
+        }
+    }
+    /* the conversions: random words (ints and floats alike), every scale 0..255 */
+    long cbad[3] = {0}; const char* cnm[3] = { "cflts", "csflt", "cuflt" };
+    for (long k = 0; k < n; k++) {
+        u128 a = vec();
+        if (k & 1) for (int i = 0; i < 4; i++) a._u32[i] = rnd() >> (rnd() & 31);
+        if ((k & 7) == 2) for (int i = 0; i < 4; i++) a._u32[i] = (uint32_t)-(int32_t)(rnd() >> (rnd() & 31));
+        const int i8 = (int)(rnd() & 0xFF);
+        u128 e[3], f[3];
+        spu_fp_fast = 0; _mm_setcsr(0x1F80u);
+        e[0] = spu_cflts(a, i8); e[1] = spu_csflt(a, i8); e[2] = spu_cuflt(a, i8);
+        spu_fp_fast = 1; _mm_setcsr(0xFFC0u);
+        f[0] = spu_cflts(a, i8); f[1] = spu_csflt(a, i8); f[2] = spu_cuflt(a, i8);
+        spu_fp_fast = 0; _mm_setcsr(0x1F80u);
+        for (int o = 0; o < 3; o++) if (memcmp(&e[o], &f[o], 16)) {
+            if (cbad[o]++ < 5) {
+                fprintf(stderr, "%s diff (i8 %d):", cnm[o], i8);
+                for (int i = 0; i < 4; i++) if (e[o]._u32[i] != f[o]._u32[i])
+                    fprintf(stderr, " [%d] a=%08X exact=%08X fast=%08X", i, a._u32[i], e[o]._u32[i], f[o]._u32[i]);
+                fprintf(stderr, "\n");
+            }
+        }
+    }
+    int fail = 0;
+    for (int o = 0; o < 3; o++) { printf("%s: %ld of %ld vectors differ\n", cnm[o], cbad[o], n); fail |= cbad[o] != 0; }
+    for (int o = 0; o < 6; o++) { printf("%s: %ld of %ld vectors differ\n", nm[o], bad[o], n); fail |= bad[o] != 0; }
+    return fail;
+}
+#endif
