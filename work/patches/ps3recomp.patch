+/* SPU_TS2_DEFER_EXIT=1: a task created on an SPU can run and exit before
+ * its creator has marked its Taskset2 record live: the creator claims the id
+ * and sets its pending bit (we start the task at once, on that commit), and
+ * only then turns the record 0x01 into 0x11. Marked exited (0x12) in that
+ * gap, the record was reaped by a join (0x12 -> 0x01, enabled cleared), and
+ * the creator's late 0x11 left a live record on a free id. The next create
+ * of that id halts (libspurs' heqi, hkp_integrate LS 0x126D8: an SPU Havok
+ * worker dies mid-create), and a PPU create logs "was in state 0x11". On
+ * hardware the policy module runs a new task only after its creator is done.
+ * Here: an exit that finds the record still 0x01 is held, and applied when
+ * the creator's commit makes it 0x11 (spu_taskset_line_committed). */
+#define TS2_DEFER_MAX 64
+static uint32_t s_ts2_defer[TS2_DEFER_MAX];   /* record EA, 0 = empty */
+static _Atomic int s_ts2_defer_n;
+static int ts2_defer_on(void)
+{
+    static int v = -1; if (v < 0) { const char* e = getenv("SPU_TS2_DEFER_EXIT"); v = e && e[0] == '1'; }
+    return v;
+}
+static int ts2_exit_defer(uint32_t ts, uint32_t id)
+{
+    if (!ts2_defer_on()) return 0;
+    extern uint8_t* vm_base;
+    const uint32_t r = spurs_ts2_rec(ts, id);
+    const uint64_t llm = spu_lockline_mask_ea(r);
+    int held = 0;
+    spu_lockline_lock_mask(llm);
+    if (vm_base[r + 15] == TS2_ST_FREE) {
+        for (int i = 0; i < TS2_DEFER_MAX; i++)
+            if (__atomic_load_n(&s_ts2_defer[i], __ATOMIC_RELAXED) == 0) {
+                __atomic_store_n(&s_ts2_defer[i], r, __ATOMIC_SEQ_CST);
+                __atomic_fetch_add(&s_ts2_defer_n, 1, __ATOMIC_SEQ_CST);
+                held = 1;
+                break;
+            }
+    }
+    spu_lockline_unlock_mask(llm);
+    if (held) { static int n; if (__atomic_fetch_add(&n, 1, __ATOMIC_RELAXED) < 16)
+        fprintf(stderr, "[ts2-defer] task %u of taskset 0x%08X exited before its creator marked it live: exit held\n", id, ts); }
+    return held;
+}
+/* A record line was committed: apply the held exits whose records are live now. */
+static void ts2_defer_apply(uint32_t line)
+{
+    if (!__atomic_load_n(&s_ts2_defer_n, __ATOMIC_SEQ_CST)) return;
+    extern uint8_t* vm_base;
+    for (int i = 0; i < TS2_DEFER_MAX; i++) {
+        const uint32_t r = __atomic_load_n(&s_ts2_defer[i], __ATOMIC_SEQ_CST);
+        if (!r || (r & ~127u) != line) continue;
+        const uint64_t llm = spu_lockline_mask_ea(r);
+        spu_lockline_lock_mask(llm);
+        if (__atomic_load_n(&s_ts2_defer[i], __ATOMIC_SEQ_CST) == r && vm_base[r + 15] == TS2_ST_LIVE) {
+            memset(vm_base + r + 8, 0, 4);
+            __atomic_store_n(vm_base + r + 15, (uint8_t)TS2_ST_EXITED, __ATOMIC_SEQ_CST);
+            __atomic_store_n(&s_ts2_defer[i], 0u, __ATOMIC_SEQ_CST);
+            __atomic_fetch_sub(&s_ts2_defer_n, 1, __ATOMIC_SEQ_CST);
+            spu_coh_notify_write(r);
