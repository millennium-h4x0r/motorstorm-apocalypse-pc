+/* texture_build: vk_eng_texture_objects into the reserved handle, from the
+ * engine's thread. The object is written whole and its kind published last:
+ * the recording thread's scans of the table read kinds. */
+static int vk_eng_texture_build(void* user, u32 hd, rsx_be_format fmt, u32 w, u32 h,
+                                u32 mips, u32 faces, u32 remap, u32 rsx_fmt)
+{
+    VK_CS(CS_TEXTURE_CREATE);
+    RSX_HS_SCOPE(HS_TEX_CREATE);
