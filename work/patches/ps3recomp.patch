+/*
+ * ps3recomp - the CellSpurs instance: layout and the SPU-side kernel
+ *
+ * The CellSpurs instance (CELL_SPURS_SIZE = 4096 bytes of game-owned guest
+ * memory, 128-byte aligned) is shared state between three parties: the PPU
+ * library (cellSpurs.c), the SPURS kernel on each SPU (spurs_kernel.c), and
+ * the title itself, whose inlined SDK code stores readyCounts and signal bits
+ * directly. It therefore holds the real big-endian layout firmware libsre
+ * uses; offsets below are the ones libsre reads and writes (cross-checked by
+ * tests/conformance/spurs against libsre run by RPCS3).
+ */
+#ifndef PS3RECOMP_SPURS_INSTANCE_H
+#define PS3RECOMP_SPURS_INSTANCE_H
+
+#include <stdint.h>
+
+enum {
+    /* scheduling line 0 (0x00..0x7F) */
+    SPURS_WKL_READY1     = 0x00,   /* u8/wid: SPUs requested (readyCount) */
+    SPURS_WKL_IDLE2      = 0x10,   /* u8/wid: idle SPUs requested */
+    SPURS_WKL_CURCONT    = 0x20,   /* u8/wid: SPUs running it now */
+    SPURS_WKL_PENDCONT   = 0x30,   /* u8/wid: SPUs about to switch to it */
+    SPURS_WKL_MINCONT    = 0x40,
+    SPURS_WKL_MAXCONT    = 0x50,
+    SPURS_WKL_FLAG       = 0x60,   /* CellSpursWorkloadFlag: be u32 flag at +0x0C */
+    SPURS_WKL_SIGNAL1    = 0x70,   /* be u16: bit 15-wid */
+    SPURS_SYSSRV_MESSAGE = 0x72,   /* u8: bit per SPU, "run the system service" */
+    SPURS_SPU_IDLING     = 0x73,   /* u8: bit per SPU idling in the system service */
+    SPURS_FLAGS1         = 0x74,   /* u8: SF1_* */
+    SPURS_NSPUS          = 0x76,
+    SPURS_WKL_FLAG_RCV   = 0x77,   /* u8: workload owning the flag, 0xFF none */
+    /* state line 1 (0x80..0xFF) */
+    SPURS_WKL_STATE1     = 0x80,   /* u8/wid: WKL_STATE_* */
+    SPURS_WKL_STATUS1    = 0x90,   /* u8/wid: bit per SPU that has taken the workload */
+    SPURS_WKL_EVENT1     = 0xA0,   /* u8/wid: 0x01 shutdown done, 0x02 has hook,
+                                      0x10 a waiter, 0x20 hook called */
+    SPURS_WKL_ENABLED    = 0xB0,   /* be u32: bit 31-wid; 0xFFFF low half on SPURS1 */
+    SPURS_WKL_MSKB       = 0xB4,   /* be u32: wids with a policy module (uniqueId pool) */
+    SPURS_SYSSRV_MSG     = 0xBD,   /* u8: bit per SPU, "re-read the workload table" */
+    SPURS_SYSSRV_TERMINATE = 0xBF, /* u8: bit per SPU, "leave" */
+    SPURS_SYSSRV_ON_SPU  = 0xC8,   /* u8: bit per SPU running the system service */
+    SPURS_SPU_PORT       = 0xC9,   /* u8: the kernel's own SPU event port */
+    SPURS_SYSSRV_TRACE_INIT = 0xCC,/* u8: bit per SPU whose system service set up tracing */
+    /* per-workload blocks */
+    SPURS_WKL_F1         = 0x100,  /* 0x80/wid: +0x28 waiter word, +0x30 hook, +0x38 hook arg */
+    SPURS_WKL_F1_SZ      = 0x80,
+    SPURS_WKL_INFO1      = 0xB00,  /* 0x20/wid: addr u64, arg u64, size u32, uniqueId u8 @0x14,
+                                      priority[8] @0x18 */
+    SPURS_WKL_INFO_SZ    = 0x20,
+    SPURS_WKL_H1         = 0xE00,  /* 0x10/wid: nameClass u64, nameInstance u64 */
+    /* configuration */
+    SPURS_PPU0           = 0xD20,  /* be u64: handler threads */
+    SPURS_PPU1           = 0xD28,
+    SPURS_SPU_TG         = 0xD30,  /* be u32: SPU thread group id */
+    SPURS_SPUS           = 0xD34,  /* be u32[8]: SPU thread ids */
+    SPURS_CFG_FLAGS      = 0xD80,  /* be u32: attribute flags (SAF_*) */
+    SPURS_SPU_PRIO       = 0xD84,
+    SPURS_PPU_PRIO       = 0xD88,
+    SPURS_PREFIX         = 0xD8C,  /* char[15], not NUL-terminated */
+    SPURS_PREFIX_SIZE    = 0xD9B,
+    SPURS_REVISION       = 0xDA0,
+    SPURS_SDK_VERSION    = 0xDA4,
+    SPURS_PORT_BITS      = 0xDA8,  /* be u64: SPU ports the app attached */
+    SPURS_INST_SIZE      = 0x1000,
+};
+
+enum { WKL_STATE_NONE = 0, WKL_STATE_PREPARING = 1, WKL_STATE_RUNNABLE = 2,
+       WKL_STATE_SHUTTING_DOWN = 3, WKL_STATE_REMOVABLE = 4 };
+
+#define SPURS_SF1_EXIT_IF_NO_WORK 0x80u
+#define SPURS_SYS_SERVICE_WID     0x20u      /* the kernel's own system workload */
+#define SPURS_MAX_WKL             16u        /* SPURS1 */
+#define SPURS_POLL_READYCOUNT     1u
+#define SPURS_POLL_SIGNAL         2u
+#define SPURS_POLL_FLAG           4u
+
+/* ---- the SPU side (spurs_kernel.c) ---------------------------------------- */
+
+/* Start the instance's SPU thread group: one kernel per SPU. */
+void spurs_kernel_start(uint32_t spurs_ea, uint32_t nspus);
+/* Terminate it (Finalize) and wait for every SPU to leave. */
+void spurs_kernel_stop(uint32_t spurs_ea);
+/* The PPU library changed the instance: wake idling SPUs now rather than at
+ * their next poll (they also notice changes the title stores itself). */
+void spurs_kernel_notify(uint32_t spurs_ea);
+/* WakeUp: restart a group that exited for lack of work (exitIfNoWork). */
+void spurs_kernel_wakeup(uint32_t spurs_ea);
+/* The PPU side completed a shutdown itself (no SPU had the workload):
+ * deliver it to the handler as the SPU side would. */
+void spurs_kernel_shutdown_completed(uint32_t spurs_ea, uint32_t wid);
+/* WaitForWorkloadShutdown's semaphore: block until the handler posts it. */
+void spurs_kernel_wait_shutdown_sema(uint32_t spurs_ea, uint32_t wid);
+
+/* A PPU-side change to the instance's two control lines (0x00 and 0x80): SPU
+ * code read-modify-writes them whole with GETLLAR/PUTLLC, so the change is made
+ * under the lock-line lock and drops the reservations on the lines it altered.
+ * `snap` is the caller's 0x100-byte scratch. Take nothing else in between, and
+ * call spurs_kernel_notify after the end, not inside. */
+void spurs_ctl_begin(uint32_t spurs_ea, uint8_t* snap);
+void spurs_ctl_end(uint32_t spurs_ea, const uint8_t* snap);
+
+#endif
diff --git a/libs/spurs/spurs_kernel.c b/libs/spurs/spurs_kernel.c
new file mode 100644
index 00000000..32042357
--- /dev/null
+++ b/libs/spurs/spurs_kernel.c
@@ -0,0 +1,1026 @@
+/*
+ * ps3recomp - the SPURS kernel on the SPUs, and libsre's two PPU helpers
+ *
+ * A SPURS instance owns an SPU thread group: every SPU runs the SPURS kernel,
+ * which repeatedly selects a workload from the shared instance and enters its
+ * policy module at LS 0xA00. The kernel's own "system service" workload runs
+ * whenever an SPU has a message for it or nothing else to do: it re-reads the
+ * workload table (wklStatus, runnable mask, per-SPU priorities), completes
+ * shutdowns, and idles the SPU. On the PPU side libsre keeps a handler thread
+ * (starts / restarts the group: exitIfNoWork) and an event helper thread
+ * (shutdown completion: hook, waiter's semaphore).
+ *
+ * This file models those parts as they behave, not just what one title needs:
+ * one host thread per SPU with its own local store (a module image is loaded
+ * only when the SPU switches to a workload at another address, as the kernel
+ * does), the kernel's selection rule and contention bookkeeping, the
+ * system-service handshakes in the instance, and the two PPU helpers. The
+ * behaviour is checked against firmware libsre under RPCS3 by
+ * tests/conformance/spurs (t_workload, t_kernel).
+ *
+ * Instance updates are made with byte/word atomics: the title's inlined SDK
+ * code updates the same words with lwarx/stwcx., which this runtime implements
+ * as compare-and-swap on the reserved value, so either side's change makes the
+ * other's store-conditional retry. The SPUs of one instance serialise their
+ * kernel-side read-modify-writes with a host lock, standing in for the
+ * GETLLAR/PUTLLC loops the real kernel uses on the instance's lines.
+ */
+#if defined(__x86_64__)
+#include <xmmintrin.h>
+#endif
+#ifdef __linux__
+#include <sys/resource.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+#include "rsx_hitch.h"
+#include "spurs_instance.h"
+#include "../../runtime/platform/win32_compat.h"
+#include "../../runtime/ppu/ppu_memory.h"
+#include "spu_workload.h"
+#include "spu_coherency.h"
+#include "ps3emu/guest_call.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include "ps3emu/thread_name.h"
+
+#define KMAX_INST 4
+#define KMAX_SPU  8
+
+typedef struct KInst KInst;
+
+typedef struct {
+    KInst*       in;
+    uint32_t     num;            /* spuNum */
+    spu_context* ctx;            /* this SPU: registers + local store */
+    uint32_t     cur_wid;        /* wklCurrentId (SPURS_SYS_SERVICE_WID: the system service) */
+    uint32_t     cur_uid;        /* wklCurrentUniqueId */
+    uint64_t     cur_addr;       /* wklCurrentAddr: the module image now in LS */
+    uint8_t      loc_cont[SPURS_MAX_WKL], loc_pend[SPURS_MAX_WKL];
+    uint8_t      prio[SPURS_MAX_WKL], uid[SPURS_MAX_WKL];
+    uint16_t     runnable1;
+    uint8_t      idling, sys_init;
+    spu_lifted_entry_fn fn;      /* lifted entry of the loaded image, NULL = interpret */
+    int          image_id;
+} KSpu;
+
+struct KInst {
+    uint32_t           ea;               /* 0 = free slot */
+    uint32_t           nspus;
+    SRWLOCK            lock;             /* kernel-side instance RMWs */
+    CONDITION_VARIABLE idle_cv;          /* idling SPUs */
+    KSpu               spu[KMAX_SPU];
+    HANDLE             spu_th[KMAX_SPU];
+    /* handler thread (group life cycle) */
+    HANDLE             handler_th;
+    SRWLOCK            hlock;
+    CONDITION_VARIABLE hcv;
+    volatile int       exiting;
+    /* event helper thread (shutdown completion) */
+    HANDLE             event_th;
+    volatile uint32_t  notify;           /* wid bits (31-wid) awaiting the helper */
+    uint32_t           sema[SPURS_MAX_WKL];
+    CONDITION_VARIABLE scv;
+    uint8_t            snap[0x100];      /* the control lines as klock found them */
+};
+
+static KInst s_kinst[KMAX_INST];
+static SRWLOCK s_table = SRWLOCK_INIT;
+
+static uint8_t* B(uint32_t ea) { return vm_base + ea; }
+
+/* The instance's two control lines (scheduling 0x00, state 0x80) are also
+ * read-modify-written WHOLE by SPU code with GETLLAR/PUTLLC -- WWS's policy
+ * module updates readyCount that way -- so every kernel-side change to them is
+ * made under the lock-line lock a PUTLLC takes, and drops the SPUs'
+ * reservations on the lines it changed, exactly as a store from another SPU
+ * would. Holding the instance lock alone serialised the kernels with each
+ * other but not with a PUTLLC: a store landing between its compare and its
+ * copy was overwritten with the old byte (inFAMOUS 2 lost a departing SPU's
+ * contention decrement, the PPU saw a phantom SPU in the SpuLight workload and
+ * never signalled it again). Order: instance lock, then lock-line stripes. */
+void spurs_ctl_begin(uint32_t ea, uint8_t* snap)
+{
+    spu_lockline_lock_mask(spu_lockline_mask_range(ea, 0x100));
+    memcpy(snap, B(ea), 0x100);
+}
+/* `self`: the SPU whose kernel made the change. Its own update stands in for
+ * a PUTLLC it issued, which consumes its reservation without raising LR on it. */
+static void ctl_end(uint32_t ea, const uint8_t* snap, const void* self)
+{
+    for (uint32_t o = 0; o < 0x100; o += 0x80)
+        if (memcmp(snap + o, B(ea) + o, 0x80) != 0 && spu_coh_is_reserved(ea + o))
+            spu_coh_notify_write_except(ea + o, self);
+    spu_lockline_unlock_mask(spu_lockline_mask_range(ea, 0x100));
+}
+void spurs_ctl_end(uint32_t ea, const uint8_t* snap) { ctl_end(ea, snap, NULL); }
+static void kline_take(KInst* in) { spurs_ctl_begin(in->ea, in->snap); }
+static void kline_release(KInst* in, const KSpu* v) { ctl_end(in->ea, in->snap, v ? v->ctx : NULL); }
+static void klock(KInst* in) { AcquireSRWLockExclusive(&in->lock); kline_take(in); }
+static void kunlock(KInst* in, const KSpu* v) { kline_release(in, v); ReleaseSRWLockExclusive(&in->lock); }
+static uint32_t be32(const uint8_t* p) { return (uint32_t)p[0] << 24 | p[1] << 16 | p[2] << 8 | p[3]; }
+static uint64_t be64(const uint8_t* p) { return (uint64_t)be32(p) << 32 | be32(p + 4); }
+static void put32(uint8_t* p, uint32_t v) { p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v; }
+static void put64(uint8_t* p, uint64_t v) { put32(p, (uint32_t)(v >> 32)); put32(p + 4, (uint32_t)v); }
+static void bor(uint8_t* p, uint8_t m)  { __atomic_fetch_or(p, m, __ATOMIC_SEQ_CST); }
+static void band(uint8_t* p, uint8_t m) { __atomic_fetch_and(p, m, __ATOMIC_SEQ_CST); }
+
+static KInst* kinst_find(uint32_t ea)
+{
+    for (int i = 0; i < KMAX_INST; i++)
+        if (s_kinst[i].ea == ea) return &s_kinst[i];
+    return NULL;
+}
+
+/* ---- selectWorkload -------------------------------------------------------------- */
+
+/* The kernel's selection (SPURS1). is_poll: called by a running module
+ * (cellSpursModulePollStatus) rather than by the kernel between modules --
+ * then nothing is committed except pending contention for a switch.
+ * Returns {wid << 32 | pollStatus}. */
+static uint64_t kselect(KSpu* v, int is_poll)
+{
+    KInst* in = v->in;
+    uint8_t* S = B(in->ea);
+    const uint8_t bit = (uint8_t)(1u << v->num);
+    uint8_t cont[SPURS_MAX_WKL], pend[SPURS_MAX_WKL];
+    uint32_t sel = SPURS_SYS_SERVICE_WID, status = 0;
+
+    klock(in);
+    for (uint32_t i = 0; i < SPURS_MAX_WKL; i++) {
+        cont[i] = (uint8_t)(S[SPURS_WKL_CURCONT + i] - v->loc_cont[i]);
+        pend[i] = 0;
+        if (is_poll) {
+            pend[i] = (uint8_t)(S[SPURS_WKL_PENDCONT + i] - v->loc_pend[i]);
+            if (i != v->cur_wid) cont[i] = (uint8_t)(cont[i] + pend[i]);
+        }
+    }
+
+    if (__atomic_load_n(S + SPURS_SYSSRV_MESSAGE, __ATOMIC_SEQ_CST) & bit) {
+        /* the system service comes first */
+        v->idling = 0;
+        if (!is_poll || v->cur_wid == SPURS_SYS_SERVICE_WID)
+            band(S + SPURS_SYSSRV_MESSAGE, (uint8_t)~bit);
+    } else {
+        const uint16_t sig = (uint16_t)(S[SPURS_WKL_SIGNAL1] << 8 | S[SPURS_WKL_SIGNAL1 + 1]);
+        const uint32_t flag = be32(S + SPURS_WKL_FLAG + 0x0C);
+        const uint8_t rcv = S[SPURS_WKL_FLAG_RCV];
+        uint32_t max_weight = 0;
+        for (uint32_t i = 0; i < SPURS_MAX_WKL; i++) {
+            const int runnable = (v->runnable1 & (0x8000u >> i)) != 0;
+            const int wsig = (sig & (0x8000u >> i)) != 0;
+            const int wflag = flag == 0 && rcv == i;
+            const uint32_t ready = S[SPURS_WKL_READY1 + i] > 8 ? 8 : S[SPURS_WKL_READY1 + i];
+            const uint32_t idle = S[SPURS_WKL_IDLE2 + i] > 8 ? 8 : S[SPURS_WKL_IDLE2 + i];
+            if (!runnable || !v->prio[i] || S[SPURS_WKL_MAXCONT + i] <= cont[i]) continue;
+            if (!(wflag || wsig || (ready && ready + idle > cont[i]))) continue;
+            /* weight, most significant first: wants an SPU, priority on this
+             * SPU, is the current workload, below its minimum contention,
+             * fewer SPUs already, same module image loaded; ties to the
+             * lowest wid */
+            uint32_t w = (wflag || wsig || ready > cont[i]) ? 0x8000u : 0;
+            w |= (uint32_t)(v->prio[i] & 0x7F) << 8;
+            w |= i == v->cur_wid ? 0x80u : 0;
+            w |= (cont[i] > 0 && S[SPURS_WKL_MINCONT + i] > cont[i]) ? 0x40u : 0;
+            w |= (uint32_t)((8 - cont[i]) & 0x0F) << 2;
+            w |= v->uid[i] == v->cur_uid ? 0x02u : 0;
+            w |= 1;
+            if (w > max_weight) {
+                max_weight = w;
+                sel = i;
+                status = (ready > cont[i] ? SPURS_POLL_READYCOUNT : 0) |
+                         (wsig ? SPURS_POLL_SIGNAL : 0) | (wflag ? SPURS_POLL_FLAG : 0);
+            }
+        }
+        v->idling = sel == SPURS_SYS_SERVICE_WID;
+        if (!is_poll || sel == v->cur_wid) {
+            if (sel < SPURS_MAX_WKL) {
+                /* the signal is taken by this SPU; the flag is re-armed */
+                band(S + SPURS_WKL_SIGNAL1 + (sel >> 3), (uint8_t)~(0x80u >> (sel & 7)));
+                if (sel == rcv)
+                    __atomic_store_n((uint32_t*)(S + SPURS_WKL_FLAG + 0x0C), 0xFFFFFFFFu,
+                                     __ATOMIC_SEQ_CST);
+            }
+        }
+    }
+
+    if (!is_poll) {
+        if (sel < SPURS_MAX_WKL) cont[sel]++;
+        for (uint32_t i = 0; i < SPURS_MAX_WKL; i++) {
+            S[SPURS_WKL_CURCONT + i] = cont[i];
+            S[SPURS_WKL_PENDCONT + i] = (uint8_t)(S[SPURS_WKL_PENDCONT + i] - v->loc_pend[i]);
+            v->loc_cont[i] = 0;
+            v->loc_pend[i] = 0;
+        }
+        if (sel < SPURS_MAX_WKL) v->loc_cont[sel] = 1;
+        v->cur_wid = sel;
+    } else if (sel != v->cur_wid) {
+        if (sel < SPURS_MAX_WKL) pend[sel]++;
+        for (uint32_t i = 0; i < SPURS_MAX_WKL; i++) {
+            S[SPURS_WKL_PENDCONT + i] = pend[i];
+            v->loc_pend[i] = 0;
+        }
+        if (sel < SPURS_MAX_WKL) v->loc_pend[sel] = 1;
+    } else {
+        for (uint32_t i = 0; i < SPURS_MAX_WKL; i++) {
+            S[SPURS_WKL_PENDCONT + i] = (uint8_t)(S[SPURS_WKL_PENDCONT + i] - v->loc_pend[i]);
+            v->loc_pend[i] = 0;
+        }
+    }
+    /* the kernel keeps a copy of the scheduling line at LS 0x100 */
+    memcpy(v->ctx->ls + 0x100, S, 0x80);
+    /* SPURS_KSEL_TRACE=<n>: the first n committing selections (module
+     * boundaries), with the contention they leave behind.
+     * Captured under the locks, printed after them: stderr I/O must not hold
+     * the lock-line stripes every GETLLAR waits on. */
+    static long s_left = -1;     /* __atomic builtins: clang rejects them on _Atomic */
+    if (s_left < 0) { const char* e = getenv("SPURS_KSEL_TRACE"); s_left = e ? atol(e) : 0; }
+    const int trace = !is_poll && s_left > 0 && __atomic_fetch_sub(&s_left, 1, __ATOMIC_RELAXED) > 0;
+    uint8_t tc[3], tr[3];
+    if (trace) { memcpy(tc, S + SPURS_WKL_CURCONT, 3); memcpy(tr, S + SPURS_WKL_READY1, 3); }
+    kunlock(in, v);
+    if (trace)
+        fprintf(stderr, "[ksel] inst 0x%08X spu%u -> wid %u (status 0x%X) cont=%02X%02X%02X ready=%02X%02X%02X pc=0x%05X\n",
+                in->ea, v->num, sel, status, tc[0], tc[1], tc[2], tr[0], tr[1], tr[2],
+                v->ctx->pc & SPU_LS_MASK);
+    return (uint64_t)sel << 32 | status;
+}
+
+/* selectWorkload called by a running module (lifted or interpreted). */
+static uint64_t kselect_from_module(spu_context* ctx, uint32_t is_poll)
+{
+    KSpu* v = (KSpu*)ctx->spurs_vspu;
+    return kselect(v, is_poll != 0);
+}
+
+/* ---- the kernel context in local store ------------------------------------------ */
+
+static void ls_context(KSpu* v)
+{
+    uint8_t* ls = v->ctx->ls;
+    put64(ls + 0x1C0, v->in->ea);                   /* spurs */
+    put32(ls + 0x1C8, v->num);                      /* spuNum */
+    put32(ls + 0x1CC, 31);                          /* dmaTagId */
+    put64(ls + 0x1D0, v->cur_addr);                 /* wklCurrentAddr */
+    put32(ls + 0x1D8, v->cur_uid);                  /* wklCurrentUniqueId */
+    put32(ls + 0x1DC, v->cur_wid);                  /* wklCurrentId */
+    put32(ls + 0x1E0, SPURS_PM_EXIT_TO_KERNEL_LS);  /* exitToKernelAddr */
+    put32(ls + 0x1E4, SPURS_PM_SELECT_WORKLOAD_LS); /* selectWorkloadAddr */
+    ls[0x1E8] = 0; ls[0x1E9] = 0;                   /* moduleId */
+    ls[0x1EA] = v->sys_init;                        /* sysSrvInitialised */
+    ls[0x1EB] = v->idling;                          /* spuIdling */
+    ls[0x1EC] = (uint8_t)(v->runnable1 >> 8);       /* wklRunnable1 */
+    ls[0x1ED] = (uint8_t)v->runnable1;
+    ls[0x1EE] = 0; ls[0x1EF] = 0;                   /* wklRunnable2 */
+    memcpy(ls + 0x220, v->uid, SPURS_MAX_WKL);      /* wklUniqueId[] */
+}
+
+/* ---- shutdown completion: to the event helper ----------------------------------- */
+
+static void kevent_notify(KInst* in, uint32_t bits)
+{
+    AcquireSRWLockExclusive(&in->hlock);
+    in->notify |= bits;
+    WakeAllConditionVariable(&in->scv);
+    ReleaseSRWLockExclusive(&in->hlock);
+}
+
+/* ---- the system service ---------------------------------------------------------- */
+
+/* SPURS_PRIO=<wid>:<prio>,... (prio 1 highest .. 15): replaces the title's
+ * priority of those workloads, on every SPU that has the workload runnable
+ * (a priority of 0, "never on this SPU", is kept). For A/B runs of the
+ * scheduling: the priorities only order the SPUs' choice between ready
+ * workloads, so no result changes, only when jobs run. */
+static int s_prio_n = -1;
+static uint8_t s_prio_wid[SPURS_MAX_WKL], s_prio_val[SPURS_MAX_WKL];
+static void kprio_override(KSpu* v)
+{
+    if (__builtin_expect(s_prio_n < 0, 0)) {
+        int n = 0;
+        const char* e = getenv("SPURS_PRIO");
+        while (e && *e && n < SPURS_MAX_WKL) {
+            char* end; const long w = strtol(e, &end, 0);
+            if (*end != ':') break;
+            const long pr = strtol(end + 1, &end, 0);
+            if (w >= 0 && w < SPURS_MAX_WKL && pr >= 1 && pr <= 15) {
+                s_prio_wid[n] = (uint8_t)w; s_prio_val[n] = (uint8_t)pr; n++;
+            }
+            if (*end != ',') break;
+            e = end + 1;
+        }
+        if (n) fprintf(stderr, "[spurs] SPURS_PRIO: %d workload priorit%s overridden\n", n, n == 1 ? "y" : "ies");
+        __atomic_store_n(&s_prio_n, n, __ATOMIC_RELEASE);
+    }
+    for (int k = 0; k < s_prio_n; k++)
+        if (v->prio[s_prio_wid[k]]) v->prio[s_prio_wid[k]] = (uint8_t)(0x10 - s_prio_val[k]);
+}
+
+/* The update-workload message: this SPU's priorities and uniqueIds, its bit in
+ * every workload's status, its runnable mask; a shutting-down workload this
+ * SPU was the last to hold becomes removable. */
+static void kactivate(KSpu* v)
+{
+    KInst* in = v->in;
+    uint8_t* S = B(in->ea);
+    const uint8_t bit = (uint8_t)(1u << v->num);
+    for (uint32_t i = 0; i < SPURS_MAX_WKL; i++) {
+        const uint8_t* info = S + SPURS_WKL_INFO1 + i * SPURS_WKL_INFO_SZ;
+        const uint8_t p = info[0x18 + v->num];
+        v->prio[i] = p ? (uint8_t)(0x10 - p) : 0;
+        v->uid[i] = info[0x14];
+    }
+    kprio_override(v);
+    uint32_t shutdown = 0, notify = 0;
+    uint16_t runnable = 0;
+    klock(in);
+    for (uint32_t i = 0; i < SPURS_MAX_WKL; i++) {
+        const uint8_t old = S[SPURS_WKL_STATUS1 + i];
+        const uint8_t state = __atomic_load_n(S + SPURS_WKL_STATE1 + i, __ATOMIC_SEQ_CST);
+        if (state == WKL_STATE_RUNNABLE) {
+            bor(S + SPURS_WKL_STATUS1 + i, bit);
+            runnable |= (uint16_t)(0x8000u >> i);
+        } else {
+            band(S + SPURS_WKL_STATUS1 + i, (uint8_t)~bit);
+        }
+        if (state == WKL_STATE_SHUTTING_DOWN && (old & bit) && S[SPURS_WKL_STATUS1 + i] == 0) {
+            uint8_t st = WKL_STATE_SHUTTING_DOWN;
+            if (__atomic_compare_exchange_n(S + SPURS_WKL_STATE1 + i, &st, WKL_STATE_REMOVABLE, 0,
+                                            __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST))
+                shutdown |= 0x80000000u >> i;
+        }
+    }
+    v->runnable1 = runnable;
+    for (uint32_t i = 0; i < SPURS_MAX_WKL; i++) {
+        if (!(shutdown & (0x80000000u >> i))) continue;
+        bor(S + SPURS_WKL_EVENT1 + i, 0x01);
+        if (S[SPURS_WKL_EVENT1 + i] & 0x12)          /* a hook, or a waiter */
+            notify |= 0x80000000u >> i;
+    }
+    kunlock(in, v);
+    if (notify) kevent_notify(in, notify);
+}
+
+/* Returns 1 if this SPU must leave (terminate request). */
+static int kprocess_requests(KSpu* v)
+{
+    uint8_t* S = B(v->in->ea);
+    const uint8_t bit = (uint8_t)(1u << v->num);
+    int terminate = 0, update = 0;
+    klock(v->in);
+    if (S[SPURS_SYSSRV_TERMINATE] & bit) {
+        band(S + SPURS_SYSSRV_ON_SPU, (uint8_t)~bit);
+        terminate = 1;
+    }
+    if (S[SPURS_SYSSRV_MSG] & bit) {
+        band(S + SPURS_SYSSRV_MSG, (uint8_t)~bit);
+        update = 1;
+    }
+    kunlock(v->in, v);
+    if (update) kactivate(v);
+    return terminate;
+}
+
+static int kready_workload(KSpu* v)
+{
+    const uint8_t* S = B(v->in->ea);
+    const uint16_t sig = (uint16_t)(S[SPURS_WKL_SIGNAL1] << 8 | S[SPURS_WKL_SIGNAL1 + 1]);
+    const uint32_t flag = be32(S + SPURS_WKL_FLAG + 0x0C);
+    for (uint32_t i = 0; i < SPURS_MAX_WKL; i++) {
+        const uint32_t ready = S[SPURS_WKL_READY1 + i] > 8 ? 8 : S[SPURS_WKL_READY1 + i];
+        const uint32_t idle = S[SPURS_WKL_IDLE2 + i] > 8 ? 8 : S[SPURS_WKL_IDLE2 + i];
+        const uint8_t c = S[SPURS_WKL_CURCONT + i];
+        if (!(v->runnable1 & (0x8000u >> i)) || !v->prio[i] || S[SPURS_WKL_MAXCONT + i] <= c)
+            continue;
+        if ((flag == 0 && S[SPURS_WKL_FLAG_RCV] == i) || (sig & (0x8000u >> i)) ||
+            (ready && ready + idle > c))
+            return 1;
+    }
+    return 0;
+}
+
+/* SPURS_IDLE_SPIN_US=<us>: an idle SPU polls for work that long before it
+ * sleeps. Work also appears without a library call -- readyCount is updated
+ * by SPU policy modules with PUTLLC and by the title's own atomics -- and a
+ * sleeping SPU only sees that at its 1 ms timeout, where the real one is woken
+ * by the lost reservation at once. SPURS_IDLE_STATS=1 counts what ends each
+ * idle wait, every 10 s. */
+static int s_idle_spin_us = -1, s_idle_stats = 0;
+static unsigned long long s_is_sleep, s_is_notify, s_is_timeout_found, s_is_spin_found;
+extern unsigned long long ps3_qpc_us(void);
+#define kidle_now_us ps3_qpc_us
+static inline void kidle_relax(void)
+{
+    for (int k = 0; k < 16; k++) YieldProcessor();
+}
+/* SPURS_IDLE_MWAITX=<TSC cycles>: on AMD CPUs with MONITORX, the idle spin
+ * waits in MWAITX between its checks instead of spinning on PAUSE: the thread
+ * stops issuing (its SMT sibling gets the core, the core draws less power) and
+ * wakes on a store to the instance's first line -- readyCount, the idle and
+ * current-contention counts -- or after that many TSC cycles, when the other
+ * lines (signal, flag, system-service message) are checked as before.
+ * Default 2000; 0 keeps PAUSE. */
+static int s_idle_mwaitx = -1;
+static void kidle_mwaitx_init(void)
+{
+    int cyc = 0;
+#if defined(__x86_64__) && (defined(__GNUC__) || defined(__clang__))
+    unsigned a = 0x80000001u, b = 0, c = 0, d = 0;
+    __asm__ volatile("cpuid" : "+a"(a), "=b"(b), "=c"(c), "=d"(d));
+    const char* e = getenv("SPURS_IDLE_MWAITX");
+    cyc = e ? atoi(e) : 2000;
+    if (!(c & (1u << 29))) cyc = 0;            /* no MONITORX */
+#endif
+    __atomic_store_n(&s_idle_mwaitx, cyc > 0 ? cyc : 0, __ATOMIC_RELEASE);
+}
+static int kidle_peek(KSpu* v, uint8_t bit);
+/* One turn of the idle spin; nonzero when it found work. */
+static inline int kidle_turn(KSpu* v, uint8_t bit, const void* line)
+{
+#if defined(__x86_64__) && (defined(__GNUC__) || defined(__clang__))
+    const int cyc = s_idle_mwaitx;
+    if (cyc > 0) {
+        /* MONITORX rax=address ecx=0 edx=0, look once more (a store between
+         * the last look and the arming would otherwise wait out the timer),
+         * then MWAITX eax=0 (C1) ecx=2 (timer) ebx=TSC cycles. */
+        __asm__ volatile(".byte 0x0f, 0x01, 0xfa" : : "a"(line), "c"(0u), "d"(0u) : "memory");
+        if (kidle_peek(v, bit)) return 1;
+        __asm__ volatile(".byte 0x0f, 0x01, 0xfb" : : "a"(0u), "c"(2u), "b"((unsigned)cyc) : "memory");
+        return kidle_peek(v, bit);
+    }
+#endif
+    (void)line;
+    kidle_relax();
+    return kidle_peek(v, bit);
+}
+static int kidle_peek(KSpu* v, uint8_t bit)
+{
+    const uint8_t* S = B(v->in->ea);
+    return (__atomic_load_n(S + SPURS_SYSSRV_MESSAGE, __ATOMIC_ACQUIRE) & bit) || kready_workload(v);
+}
+static void kidle_stats_tick(void)
+{
+    static unsigned long long last;
+    const unsigned long long now = kidle_now_us();
+    if (!last) { last = now; return; }
+    if (now - last < 10000000ull) return;
+    last = now;
+    fprintf(stderr, "[spurs-idle] 10 s: %llu sleeps (%llu woken by a notify, %llu timed out "
+            "onto work), %llu found while spinning\n",
+            __atomic_exchange_n(&s_is_sleep, 0, __ATOMIC_RELAXED),
+            __atomic_exchange_n(&s_is_notify, 0, __ATOMIC_RELAXED),
+            __atomic_exchange_n(&s_is_timeout_found, 0, __ATOMIC_RELAXED),
+            __atomic_exchange_n(&s_is_spin_found, 0, __ATOMIC_RELAXED));
+}
+
+/* Idle until there is something to do. Returns 1 if the group must exit
+ * (every SPU idle and the instance was created exitIfNoWork). */
+/* Bit n set while SPU n sits in kidle (PS3_TIMELINE samples it). */
+volatile uint32_t g_spurs_idle_mask;
+
+static int kidle_inner(KSpu* v);
+/* SPURS_BUSY_STATS=1: the share of wall time each SPU of the first instance
+ * spends outside kidle (in workloads: policy modules, jobs, the system
+ * service), every 10 s. */
+static int s_busy_stats = -1;
+static unsigned long long s_busy_idle_ns[KMAX_SPU], s_busy_t0;
+static unsigned long long kbusy_ns(void)
+{
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long long)ts.tv_sec * 1000000000ull + (unsigned long long)ts.tv_nsec;
+}
+static void kbusy_tick(KSpu* v, unsigned long long now)
+{
+    if (v->in != &s_kinst[0] || v->num != 0) return;
+    if (!s_busy_t0) { s_busy_t0 = now; return; }
+    if (now - s_busy_t0 < 10000000000ull) return;
+    const double wall = (double)(now - s_busy_t0);
+    const uint32_t n = v->in->nspus < KMAX_SPU ? v->in->nspus : KMAX_SPU;
+    double sum = 0; char buf[128]; int o = 0;
+    for (uint32_t i = 0; i < n; i++) {
+        const double b = 100.0 * (1.0 - (double)__atomic_exchange_n(&s_busy_idle_ns[i], 0, __ATOMIC_RELAXED) / wall);
+        sum += b;
+        o += snprintf(buf + o, sizeof buf - (size_t)o, " %.0f", b);
+    }
+    fprintf(stderr, "[spurs-busy] 10 s: SPUs busy %.1f%% (each:%s)\n", n ? sum / n : 0.0, buf);
+    s_busy_t0 = now;
+}
+static int kidle(KSpu* v)
+{
+    const uint32_t bit = 1u << (v->num & 31u);
+    if (__builtin_expect(s_busy_stats < 0, 0)) s_busy_stats = getenv("SPURS_BUSY_STATS") ? 1 : 0;
+    const unsigned long long t0 = s_busy_stats ? kbusy_ns() : 0;
+    __atomic_fetch_or(&g_spurs_idle_mask, bit, __ATOMIC_RELAXED);
+    const int r = kidle_inner(v);
+    __atomic_fetch_and(&g_spurs_idle_mask, ~bit, __ATOMIC_RELAXED);
+    if (s_busy_stats && v->in == &s_kinst[0] && v->num < KMAX_SPU) {
+        const unsigned long long t1 = kbusy_ns();
+        __atomic_fetch_add(&s_busy_idle_ns[v->num], t1 - t0, __ATOMIC_RELAXED);
+        kbusy_tick(v, t1);
+    }
+    return r;
+}
+static int kidle_inner(KSpu* v)
+{
+    KInst* in = v->in;
+    uint8_t* S = B(in->ea);
+    const uint8_t bit = (uint8_t)(1u << v->num);
+    if (__atomic_load_n(&s_idle_spin_us, __ATOMIC_ACQUIRE) < 0) {
+        const char* e = getenv("SPURS_IDLE_SPIN_US");
+        const int us = e ? atoi(e) : 0;
+        __atomic_store_n(&s_idle_stats, getenv("SPURS_IDLE_STATS") ? 1 : 0, __ATOMIC_RELAXED);
+        kidle_mwaitx_init();
+        __atomic_store_n(&s_idle_spin_us, us > 0 ? us : 0, __ATOMIC_RELEASE);
+    }
+    int spun = 0, slept = 0, woke = 0;
+    for (;;) {
+        klock(in);
+        const uint8_t idling = S[SPURS_SPU_IDLING];
+        const int all_idle = (uint32_t)__builtin_popcount(idling) == S[SPURS_NSPUS];
+        const int should_exit = all_idle && (S[SPURS_FLAGS1] & SPURS_SF1_EXIT_IF_NO_WORK);
+        const int found = (S[SPURS_SYSSRV_MESSAGE] & bit) || kready_workload(v);
+        const int was_idle = (idling & bit) != 0;
+        if (found && !should_exit) band(S + SPURS_SPU_IDLING, (uint8_t)~bit);
+        else                       bor(S + SPURS_SPU_IDLING, bit);
+        if (was_idle && !should_exit && !found) {
+            kline_release(in, v);
+            if (s_idle_spin_us > 0 && !spun) {
+                /* Unlocked: a racy peek, confirmed under the lock above. */
+                ReleaseSRWLockExclusive(&in->lock);
+                spun = 1;
+                const unsigned long long end = kidle_now_us() + (unsigned)s_idle_spin_us;
+                do {
+                    if (kidle_turn(v, bit, S + SPURS_WKL_READY1)) {
+                        if (s_idle_stats) __atomic_fetch_add(&s_is_spin_found, 1, __ATOMIC_RELAXED);
+                        break;
+                    }
+                } while (kidle_now_us() < end);
+                continue;
+            }
+            /* The real SPU waits for its reservation on the instance to be
+             * lost; here: woken by the PPU library, or after 1 ms to see
+             * stores the title makes itself. The lock-line stripes are not
+             * held across the sleep. */
+            woke = SleepConditionVariableSRW(&in->idle_cv, &in->lock, 1, 0);
+            slept = 1;
+            ReleaseSRWLockExclusive(&in->lock);
+            if (s_idle_stats) {
+                __atomic_fetch_add(&s_is_sleep, 1, __ATOMIC_RELAXED);
+                if (woke) __atomic_fetch_add(&s_is_notify, 1, __ATOMIC_RELAXED);
+            }
+            continue;
+        }
+        kunlock(in, v);
+        { extern int g_ps3_tl; extern void ps3_tl(const char*, uint32_t, uint32_t);
+          if (g_ps3_tl) ps3_tl("kwake", (uint32_t)(in - s_kinst) << 24 | v->num, (uint32_t)(spun | slept << 1 | woke << 2)); }
+        if (s_idle_stats) {
+            if (slept && !woke && found) __atomic_fetch_add(&s_is_timeout_found, 1, __ATOMIC_RELAXED);
+            if (v->num == 0) kidle_stats_tick();
+        }
+        return should_exit;
+    }
+}
+
+enum { SYS_TO_KERNEL = 0, SYS_TERMINATE = 1, SYS_EXIT_GROUP = 2 };
+
+static int ksys_service(KSpu* v)
+{
+    uint8_t* S = B(v->in->ea);
+    if (!v->sys_init) {
+        v->sys_init = 1;
+        klock(v->in);
+        bor(S + SPURS_SYSSRV_ON_SPU, (uint8_t)(1u << v->num));
+        bor(S + SPURS_SYSSRV_TRACE_INIT, (uint8_t)(1u << v->num));
+        kunlock(v->in, v);
+    }
+    for (;;) {
+        if (kprocess_requests(v)) return SYS_TERMINATE;
+        for (;;) {
+            if ((uint32_t)(kselect(v, 1) >> 32) != SPURS_SYS_SERVICE_WID)
+                return SYS_TO_KERNEL;            /* a workload wants this SPU */
+            if (!v->idling) break;               /* more messages */
+            if (kidle(v)) return SYS_EXIT_GROUP;
+        }
+    }
+}
+
+/* ---- dispatching a workload ------------------------------------------------------- */
+
+static void kdispatch(KSpu* v, uint32_t wid, uint32_t status)
+{
+    const uint8_t* info = B(v->in->ea) + SPURS_WKL_INFO1 + wid * SPURS_WKL_INFO_SZ;
+    const uint64_t addr = be64(info), arg = be64(info + 8);
+    const uint32_t size = be32(info + 0x10);
+    if (addr != v->cur_addr) {
+        if (!addr || size > SPU_LS_SIZE - 0xA00) {
+            fprintf(stderr, "[spurs-kern] wid %u: module 0x%llX size 0x%X cannot be loaded\n",
+                    wid, (unsigned long long)addr, size);
+            return;
+        }
+        memcpy(v->ctx->ls + 0xA00, B((uint32_t)addr), size);
+        const uint64_t fp = spu_workload_fingerprint(v->ctx->ls + 0xA00, size);
+        v->image_id = 0;
+        v->fn = spu_workload_find_img(fp, &v->image_id);
+        /* Not lifted: pure interpretation. Image 0 is the lifted registry's
+         * wildcard, and would let the interpreter rejoin -- or take an
+         * interrupt into -- another image's lifted code at the same LS pc. */
+        if (!v->fn) v->image_id = -1;
+        if (!v->fn) {
+            static uint64_t s_told[16]; static int s_n;
+            int told = 0;
+            for (int k = 0; k < s_n; k++) told |= s_told[k] == fp;
+            if (!told && s_n < 16) {
+                s_told[s_n++] = fp;
+                fprintf(stderr, "[spurs-kern] module at 0x%llX (fp=0x%016llX, %u bytes) not lifted: "
+                                "interpreting\n", (unsigned long long)addr, (unsigned long long)fp, size);
+                /* SPURS_DUMP_MODULES=<dir>: the bytes exactly as fingerprinted,
+                 * which is what a lift has to be made from. */
+                const char* dir = getenv("SPURS_DUMP_MODULES");
+                if (dir && *dir) {
+                    char path[512];
+                    snprintf(path, sizeof path, "%s/pm_%08llX_%016llX.bin", dir,
+                             (unsigned long long)addr, (unsigned long long)fp);
+                    FILE* f = fopen(path, "wb");
+                    if (f) { fwrite(v->ctx->ls + 0xA00, 1, size, f); fclose(f); }
+                    else fprintf(stderr, "[spurs-kern] cannot write %s\n", path);
+                }
+            }
+        }
+        v->cur_addr = addr;
+        v->cur_uid = info[0x14];
+    }
+    ls_context(v);
+    v->ctx->pm_end = 0xA00u + size;
+    spu_pm_enter(v->ctx, v->fn, v->image_id, arg, addr, status);
+}
+
+/* ---- one SPU ---------------------------------------------------------------------- */
+
+/* An SPU leaving a group that exits for lack of work: it no longer holds any
+ * workload or runs the system service, and the update-workload message is
+ * re-armed so that it reads the workload table again when restarted. */
+static void kspu_leave(KSpu* v)
+{
+    uint8_t* S = B(v->in->ea);
+    const uint8_t bit = (uint8_t)(1u << v->num);
+    klock(v->in);
+    for (uint32_t i = 0; i < SPURS_MAX_WKL; i++)
+        band(S + SPURS_WKL_STATUS1 + i, (uint8_t)~bit);
+    band(S + SPURS_SPU_IDLING, (uint8_t)~bit);
+    band(S + SPURS_SYSSRV_ON_SPU, (uint8_t)~bit);
+    band(S + SPURS_SYSSRV_TRACE_INIT, (uint8_t)~bit);
+    bor(S + SPURS_SYSSRV_MSG, bit);
+    kunlock(v->in, v);
+}
+
+static DWORD WINAPI kspu_main(LPVOID p)
+{
+    KSpu* v = (KSpu*)p;
+    ps3_thread_name("spurs%u", (unsigned)v->num);
+    rsx_hs_thread("spurs");
+    /* SPURS_NICE=<1..19> (default off): the SPURS kernel threads run at that
+     * nice. They are the bulk of the CPU a frame takes (the job modules); a
+     * lower priority lets the threads whose lateness is heard or seen first --
+     * MultiStream's task thread feeding cellAudio, the main PPU thread, the
+     * RSX threads, all left at 0 -- win when the host is short of cores
+     * (4-player split screen on 8 cores dropped up to 44% of the audio blocks).
+     * Lowering one's own priority needs no privilege. */
+#ifdef __linux__
+    { static int nice_v = -1;
+      if (nice_v < 0) { const char* e = getenv("SPURS_NICE"); nice_v = e ? atoi(e) : 0; if (nice_v < 0) nice_v = 0; if (nice_v > 19) nice_v = 19; }
+      if (nice_v > 0 && setpriority(PRIO_PROCESS, (id_t)syscall(SYS_gettid), nice_v) != 0)
+          fprintf(stderr, "[spurs-kern] SPURS_NICE=%d: setpriority failed\n", nice_v); }
+#endif
+    /* SPU_NATIVE (runtime/spu/spu_helpers.h): read again here, after main(),
+     * so an env_default there takes effect (the constructor read is too early). */
+    { extern int g_spu_native_on; const char* e = getenv("SPU_NATIVE"); if (e) g_spu_native_on = e[0] == '1'; }
+    /* SPU_FP_MXCSR=1 (runtime/spu/spu_helpers.h, SPU_FP_MX): this thread's
+     * MXCSR rounds toward zero with FTZ and DAZ, and the lifted job code's
+     * single-precision ops run natively. Off by default. */
+#if defined(__x86_64__) && (defined(__GNUC__) || defined(__clang__))
+    { extern __thread int spu_fp_fast;
+      extern const int spu_fp_mx_available __attribute__((weak));
+      const char* e = getenv("SPU_FP_MXCSR");
+      if (e && e[0] == '1' && &spu_fp_mx_available && spu_fp_mx_available) { _mm_setcsr(0xFFC0u); spu_fp_fast = 1; } }
+#endif
+    /* PS3_HOT_PIN (runtime/platform/ps3_hot_pin.c): the first instance's SPUs get a core each */
+    { extern void ps3_hot_pin_register(int role);
+      if (v->in == &s_kinst[0] && v->num < 5) ps3_hot_pin_register(3 + (int)v->num); }
+    for (;;) {
+        /* the kernel starts in, and returns to, the system service */
+        const int r = ksys_service(v);
+        if (r == SYS_EXIT_GROUP) kspu_leave(v);
+        if (r != SYS_TO_KERNEL) break;
+        for (;;) {
+            const uint64_t sel = kselect(v, 0);
+            const uint32_t wid = (uint32_t)(sel >> 32);
+            if (wid == SPURS_SYS_SERVICE_WID) break;
+            kdispatch(v, wid, (uint32_t)sel);
+        }
+    }
+    return 0;
+}
+
+/* PS3_TIMELINE's sampler (cellGcmSys.c): each kernel SPU's number and
+ * workload, its resident job overlay and pc, and whether it sits in kidle.
+ * Racy reads, a diagnostic. */
+void spurs_tl_sample(void (*emit)(const char*, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t))
+{
+    static int s_dumped;
+    if (!s_dumped) {
+        s_dumped = 1;
+        for (int i = 0; i < KMAX_INST; i++) {
+            KInst* in = &s_kinst[i];
+            if (!in->ea) continue;
+            const uint8_t* S = B(in->ea);
+            for (uint32_t w = 0; w < SPURS_MAX_WKL; w++) {
+                const uint8_t* info = S + SPURS_WKL_INFO1 + w * SPURS_WKL_INFO_SZ;
+                if (!be64(info)) continue;
+                fprintf(stderr, "[tl] inst 0x%08X wid %u: state %u prio %u %u %u %u %u %u %u %u min %u max %u ready %u\n",
+                        in->ea, w, S[SPURS_WKL_STATE1 + w], info[0x18], info[0x19], info[0x1A], info[0x1B],
+                        info[0x1C], info[0x1D], info[0x1E], info[0x1F], S[SPURS_WKL_MINCONT + w],
+                        S[SPURS_WKL_MAXCONT + w], S[SPURS_WKL_READY1 + w]);
+            }
+        }
+    }
+    for (int i = 0; i < KMAX_INST; i++) {
+        KInst* in = &s_kinst[i];
+        if (!in->ea) continue;
+        for (uint32_t n = 0; n < in->nspus && n < KMAX_SPU; n++) {
+            const KSpu* v = &in->spu[n];
+            const spu_context* c = v->ctx;
+            if (!c) continue;
+            const uint32_t idle = (__atomic_load_n(&g_spurs_idle_mask, __ATOMIC_RELAXED) >> n) & 1u;
+            emit("kspu", (uint32_t)i << 24 | n << 16 | (v->cur_wid & 0xFFFFu),
+                 (uint32_t)c->resident_ovl & 0xFFFFu, (uint32_t)c->pc & SPU_LS_MASK,
+                 idle | 0x100u, (uint32_t)c->image_id, in->ea);
+        }
+    }
+}
+
+/* SPURS_KWATCH=<seconds>: every so often, where each SPU of every instance is
+ * -- workload, pc, steps, interrupt state and the event lines -- so a wedged
+ * module or job can be told apart from a slow one without stopping the
+ * process. Reads are racy by design; it is a diagnostic. */
+static DWORD WINAPI kwatch_thread(LPVOID arg)
+{
+    const unsigned secs = (unsigned)(uintptr_t)arg;
+    for (;;) {
+        Sleep(secs * 1000u);
+        for (int i = 0; i < KMAX_INST; i++) {
+            KInst* in = &s_kinst[i];
+            if (!in->ea) continue;
+            const uint8_t* S = B(in->ea);
+            fprintf(stderr, "[kwatch] inst 0x%08X ready=%02X%02X%02X cont=%02X%02X%02X signal=%02X%02X\n",
+                    in->ea, S[SPURS_WKL_READY1], S[SPURS_WKL_READY1 + 1], S[SPURS_WKL_READY1 + 2],
+                    S[SPURS_WKL_CURCONT], S[SPURS_WKL_CURCONT + 1], S[SPURS_WKL_CURCONT + 2],
+                    S[SPURS_WKL_SIGNAL1], S[SPURS_WKL_SIGNAL1 + 1]);
+            for (uint32_t n = 0; n < in->nspus; n++) {
+                const KSpu* v = &in->spu[n];
+                const spu_context* c = v->ctx;
+                if (!c) continue;
+                fprintf(stderr, "[kwatch]   spu%u wid=%u pc=0x%05X steps=%u int=%u ev=0x%X mask=0x%X\n",
+                        n, v->cur_wid, c->pc & SPU_LS_MASK, c->steps, c->int_enable,
+                        c->event_status, c->event_mask);
+            }
+        }
+    }
+    return 0;
+}
+
+static void kgroup_start(KInst* in)
+{
+    { static int s_started = 0;
+      const char* e = getenv("SPURS_KWATCH");
+      int expect = 0;
+      if (e && *e && __atomic_compare_exchange_n(&s_started, &expect, 1, 0,
+                                                 __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+          const int secs = atoi(e) < 1 ? 1 : atoi(e);
+          CreateThread(NULL, 1u << 20, kwatch_thread, (LPVOID)(uintptr_t)secs, 0, NULL);
+      } }
+    for (uint32_t n = 0; n < in->nspus; n++) {
+        KSpu* v = &in->spu[n];
+        if (!v->ctx) {
+            v->ctx = (spu_context*)malloc(sizeof(spu_context));
+            if (!v->ctx) continue;
+        }
+        /* a (re)started SPU thread loads the kernel afresh */
+        memset(v->ctx, 0, sizeof(*v->ctx));
+        spu_context_init(v->ctx, 0);
+        v->ctx->spurs_vspu = v;
+        v->in = in;
+        v->num = n;
+        v->cur_wid = SPURS_SYS_SERVICE_WID;
+        v->cur_uid = 0x20;
+        v->cur_addr = ~0ull;
+        memset(v->loc_cont, 0, sizeof v->loc_cont);
+        memset(v->loc_pend, 0, sizeof v->loc_pend);
+        memset(v->prio, 0, sizeof v->prio);
+        memset(v->uid, 0, sizeof v->uid);
+        v->runnable1 = 0;
+        v->idling = 0;
+        v->sys_init = 0;
+        v->fn = NULL;
+        /* 16 MB, as lv2's SPU threads (spu_host_stack_bytes): the lifted job
+         * code nests a host frame per guest call, and merged lifts
+         * (--merge-chunks) have frames of several KB. */
+        in->spu_th[n] = CreateThread(NULL, 16u << 20, kspu_main, v, 0, NULL);
+    }
+}
+
+static void kgroup_join(KInst* in)
+{
+    for (uint32_t n = 0; n < in->nspus; n++) {
+        if (!in->spu_th[n]) continue;
+        WaitForSingleObject(in->spu_th[n], INFINITE);
+        CloseHandle(in->spu_th[n]);
+        in->spu_th[n] = NULL;
+    }
+}
+
+/* ---- the PPU handler thread: the group's life cycle -------------------------------- */
+
+enum { H_DIRTY = 0xD64, H_WAITING = 0xD65, H_EXITING = 0xD66 };
+
+/* exitIfNoWork: wait until a workload is ready before (re)starting the group.
+ * Re-checked only when WakeUp marks the handler dirty, as libsre does. */
+static int khandler_wait_ready(KInst* in)
+{
+    uint8_t* S = B(in->ea);
+    AcquireSRWLockExclusive(&in->hlock);
+    for (;;) {
+        if (in->exiting) { ReleaseSRWLockExclusive(&in->hlock); return 1; }
+        S[H_DIRTY] = 0;
+        const uint16_t sig = (uint16_t)(S[SPURS_WKL_SIGNAL1] << 8 | S[SPURS_WKL_SIGNAL1 + 1]);
+        const uint32_t flag = be32(S + SPURS_WKL_FLAG + 0x0C);
+        int found = 0;
+        for (uint32_t i = 0; i < SPURS_MAX_WKL && !found; i++) {
+            const uint8_t* info = S + SPURS_WKL_INFO1 + i * SPURS_WKL_INFO_SZ;
+            if (S[SPURS_WKL_STATE1 + i] != WKL_STATE_RUNNABLE || !be64(info + 0x18) ||
+                !(S[SPURS_WKL_MAXCONT + i] & 0x0F))
+                continue;
+            found = S[SPURS_WKL_READY1 + i] || (sig & (0x8000u >> i)) ||
+                    (flag == 0 && S[SPURS_WKL_FLAG_RCV] == i);
+        }
+        if (found) break;
+        S[H_WAITING] = 1;
+        if (!S[H_DIRTY])
+            SleepConditionVariableSRW(&in->hcv, &in->hlock, INFINITE, 0);
+        S[H_WAITING] = 0;
+    }
+    ReleaseSRWLockExclusive(&in->hlock);
+    return 0;
+}
+
+static DWORD WINAPI khandler_main(LPVOID p)
+{
+    KInst* in = (KInst*)p;
+    for (;;) {
+        const int exit_if_no_work = (B(in->ea)[SPURS_FLAGS1] & SPURS_SF1_EXIT_IF_NO_WORK) != 0;
+        if (exit_if_no_work && khandler_wait_ready(in)) break;
+        if (in->exiting) break;
+        kgroup_start(in);
+        kgroup_join(in);
+        if (!exit_if_no_work || in->exiting) break;
+    }
+    return 0;
+}
+
+/* ---- the PPU event helper thread: shutdown completion ------------------------------ */
+
+static DWORD WINAPI kevent_main(LPVOID p)
+{
+    KInst* in = (KInst*)p;
+    const uint32_t ea = in->ea;
+    uint8_t* S = B(ea);
+    for (;;) {
+        AcquireSRWLockExclusive(&in->hlock);
+        while (!in->notify && !in->exiting)
+            SleepConditionVariableSRW(&in->scv, &in->hlock, INFINITE, 0);
+        const uint32_t bits = in->notify;
+        in->notify = 0;
+        const int exiting = in->exiting;
+        ReleaseSRWLockExclusive(&in->hlock);
+        for (uint32_t wid = 0; wid < SPURS_MAX_WKL; wid++) {
+            if (!(bits & (0x80000000u >> wid))) continue;
+            const uint8_t* f1 = S + SPURS_WKL_F1 + SPURS_WKL_F1_SZ * wid;
+            const uint32_t hook = (uint32_t)be64(f1 + 0x30);
+            if (hook) {
+                ps3_invoke_guest(hook, ea, wid, be64(f1 + 0x38), 0, 0, 0, 0, 0);
+                bor(S + SPURS_WKL_EVENT1 + wid, 0x20);
+            }
+            if (!hook || (S[SPURS_WKL_EVENT1 + wid] & 0x10)) {
+                AcquireSRWLockExclusive(&in->hlock);
+                in->sema[wid]++;
+                WakeAllConditionVariable(&in->scv);
+                ReleaseSRWLockExclusive(&in->hlock);
+            }
+        }
+        if (exiting && !bits) break;
+    }
+    return 0;
+}
+
+/* ---- interface ------------------------------------------------------------------- */
+
+void spurs_kernel_start(uint32_t ea, uint32_t nspus)
+{
+    g_spurs_kernel_select = kselect_from_module;
+    AcquireSRWLockExclusive(&s_table);
+    KInst* in = kinst_find(ea);
+    if (!in) in = kinst_find(0);
+    if (!in) {
+        ReleaseSRWLockExclusive(&s_table);
+        fprintf(stderr, "[spurs-kern] more than %d SPURS instances\n", KMAX_INST);
+        return;
+    }
+    KSpu spus[KMAX_SPU];
+    memcpy(spus, in->spu, sizeof spus);            /* keep the LS allocations */
+    memset(in, 0, sizeof *in);
+    memcpy(in->spu, spus, sizeof spus);
+    in->ea = ea;
+    in->nspus = nspus > KMAX_SPU ? KMAX_SPU : nspus;
+    InitializeSRWLock(&in->lock);
+    InitializeSRWLock(&in->hlock);
+    InitializeConditionVariable(&in->idle_cv);
+    InitializeConditionVariable(&in->hcv);
+    InitializeConditionVariable(&in->scv);
+    ReleaseSRWLockExclusive(&s_table);
+    in->event_th = CreateThread(NULL, 1u << 20, kevent_main, in, 0, NULL);
+    in->handler_th = CreateThread(NULL, 1u << 20, khandler_main, in, 0, NULL);
+}
+
+void spurs_kernel_notify(uint32_t ea)
+{
+    KInst* in = kinst_find(ea);
+    if (!in) return;
+    { extern int g_ps3_tl;
+      if (g_ps3_tl) {
+          /* the instance's readyCount line: SPU PUTLLCs on it show up as jlp rows */
+          extern void ps3_tl_jl_watch(uint32_t row);
+          extern void ps3_tl6(const char*, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t);
+          ps3_tl_jl_watch(ea + SPURS_WKL_READY1);
+          const uint8_t* R = B(ea) + SPURS_WKL_READY1;
+          ps3_tl6("knotify", ea, be32(R), be32(R + 4), be32(R + 8),
+                  __atomic_load_n(&g_spurs_idle_mask, __ATOMIC_RELAXED), 1);
+      } }
+    AcquireSRWLockExclusive(&in->lock);
+    WakeAllConditionVariable(&in->idle_cv);
+    ReleaseSRWLockExclusive(&in->lock);
+}
+
+void spurs_kernel_wakeup(uint32_t ea)
+{
+    KInst* in = kinst_find(ea);
+    if (!in) return;
+    uint8_t* S = B(ea);
+    AcquireSRWLockExclusive(&in->hlock);
+    S[H_DIRTY] = 1;
+    if (S[H_WAITING]) WakeAllConditionVariable(&in->hcv);
+    ReleaseSRWLockExclusive(&in->hlock);
+    spurs_kernel_notify(ea);
+}
+
+void spurs_kernel_shutdown_completed(uint32_t ea, uint32_t wid)
+{
+    KInst* in = kinst_find(ea);
+    if (in && wid < SPURS_MAX_WKL) kevent_notify(in, 0x80000000u >> wid);
+}
+
+void spurs_kernel_wait_shutdown_sema(uint32_t ea, uint32_t wid)
+{
+    KInst* in = kinst_find(ea);
+    if (!in || wid >= SPURS_MAX_WKL) return;
+    AcquireSRWLockExclusive(&in->hlock);
+    while (!in->sema[wid])
+        SleepConditionVariableSRW(&in->scv, &in->hlock, INFINITE, 0);
+    in->sema[wid]--;
+    ReleaseSRWLockExclusive(&in->hlock);
+}
+
+void spurs_kernel_stop(uint32_t ea)
+{
+    KInst* in = kinst_find(ea);
+    if (!in) return;
+    uint8_t* S = B(ea);
+    AcquireSRWLockExclusive(&in->hlock);
+    in->exiting = 1;
+    S[H_EXITING] = 1;
+    WakeAllConditionVariable(&in->hcv);
+    WakeAllConditionVariable(&in->scv);
+    ReleaseSRWLockExclusive(&in->hlock);
+    /* ask every SPU to leave through its system service */
+    klock(in);
+    __atomic_store_n(S + SPURS_SYSSRV_TERMINATE, 0xFF, __ATOMIC_SEQ_CST);
+    __atomic_store_n(S + SPURS_SYSSRV_MESSAGE, 0xFF, __ATOMIC_SEQ_CST);
+    WakeAllConditionVariable(&in->idle_cv);
+    kunlock(in, NULL);
+    if (in->handler_th) { WaitForSingleObject(in->handler_th, INFINITE); CloseHandle(in->handler_th); }
+    if (in->event_th)   { WaitForSingleObject(in->event_th, INFINITE);   CloseHandle(in->event_th); }
+    AcquireSRWLockExclusive(&s_table);
+    in->ea = 0;
+    in->handler_th = in->event_th = NULL;
+    ReleaseSRWLockExclusive(&s_table);
+}
