+static uint32_t rnd(void)
+{
+    rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17;
+    return (uint32_t)rng;
+}
+
+enum { GUEST = 1 << 16 };
+static uint8_t guest[2][GUEST];         /* two locations */
+static uint32_t mapped_end[2];          /* bytes past this are unmapped */
+
+static const u8* guest_ptr(void* user, u32 location, u32 offset, u32 min_bytes)
+{
+    (void)user;
+    const u32 loc = location & 1u;
+    if ((u64)offset + min_bytes > mapped_end[loc]) return NULL;
+    return guest[loc] + offset;
+}
+
+static void random_plan(rsx_vertex_fetch_plan* plan, int use_inline,
+                        const u8* inl, u32 inl_bytes)
+{
+    memset(plan, 0, sizeof *plan);
+    rsx_vertex_layout_plan_init(&plan->layout, rnd() & 0xFFFFu);
+    plan->base_offset = (rnd() % 4 == 0) ? rnd() % 256u : 0;
+    plan->divider_mask = rnd() & 0xFFFFu;
+    plan->guest_ptr = guest_ptr;
+    u32 inline_packed = 0;
+    for (u32 a = 0; a < RSX_DSP_NUM_VERTEX_ATTR; a++) {
+        rsx_vertex_fetch_attr* f = &plan->attr[a];
+        const u32 r = rnd() % 16;
+        /* Weighted toward the formats a title uses; 0 = disabled, 8/9 invalid. */
+        f->desc.type = r < 6 ? RSX_VTX_TYPE_FLOAT : r < 7 ? 0 : r < 8 ? 8 + (rnd() & 1)
+                     : 1 + rnd() % 7;
+        f->desc.size = (rnd() % 8 == 0) ? rnd() % 6 : 1 + rnd() % 4;
+        f->elem_size = rsx_vertex_attrib_size(f->desc.type, f->desc.size);
+        f->desc.stride = (rnd() % 4 == 0) ? 0 : f->elem_size + (rnd() % 3) * 4u;
+        f->stride = f->desc.stride ? f->desc.stride : f->elem_size;
+        f->desc.frequency = (rnd() % 4 == 0) ? rnd() % 4 : 0;
+        f->desc.offset = rnd() % 4096u;
+        f->desc.location = rnd() & 1u;
+        for (int k = 0; k < 4; k++) {
+            const u32 w = rnd();
+            memcpy(&f->default_value[k], &w, 4);
+        }
+    }
+    if (use_inline) {
+        /* The shape rsx_vertex_fetch_plan_set_inline gives: offsets packed
+         * in register order, one stride. */
+        for (u32 a = 0; a < RSX_DSP_NUM_VERTEX_ATTR; a++) {
+            plan->inline_off[a] = inline_packed;
+            if (plan->attr[a].desc.type && plan->attr[a].desc.size)
+                inline_packed += plan->attr[a].elem_size;
+        }
+        plan->inline_stride = inline_packed ? inline_packed : 16u;
+        plan->inline_data = inl;
+        plan->inline_bytes = inl_bytes;
+    }
+}
+
+int main(void)
+{
+    enum { PLANS = 6000, MAXV = 200 };
+    static rsx_vertex_ref refs[MAXV];
+    static u8 a[MAXV * 16 * 16], b[MAXV * 16 * 16];
+    static u8 inl[8192];
+    int ok_runs = 0, fail_runs = 0, inline_runs = 0, prepared = 0, consecutive_runs = 0;
+
+    for (int n = 0; n < PLANS; n++) {
+        for (int l = 0; l < 2; l++) {
+            for (u32 i = 0; i < GUEST; i++) guest[l][i] = (u8)rnd();
+            mapped_end[l] = (rnd() % 3 == 0) ? rnd() % GUEST : GUEST;
+        }
+        for (u32 i = 0; i < sizeof inl; i++) inl[i] = (u8)rnd();
+        const int use_inline = rnd() % 5 == 0;
+        rsx_vertex_fetch_plan plan;
+        random_plan(&plan, use_inline, inl, (u32)(rnd() % sizeof inl));
+
+        const u32 count = 1 + rnd() % MAXV;
+        const u32 base = (rnd() % 4 == 0) ? rnd() % 64u : 0;
+        /* A third of the runs are consecutive elements (a draw fetched over
+         * its whole index range): fetch_all walks those by stride. */
+        const int run = rnd() % 3 == 0;
+        const u32 start = rnd() % 300u;
+        for (u32 i = 0; i < count; i++) {
+            refs[i].vertex_id = run ? start + i : (rnd() % 8 == 0) ? rnd() : rnd() % 300u;
+            refs[i].base_index = base;
+        }
+        if (run) consecutive_runs++;
+        if (rnd() % 4 != 0) { rsx_vertex_fetch_plan_prepare(&plan, refs, count); prepared++; }
+        if (use_inline) inline_runs++;
+
+        const u32 stride = plan.layout.stride;
+        memset(a, 0xAB, sizeof a);
+        memset(b, 0xAB, sizeof b);
+        int ra = 1;
+        for (u32 i = 0; i < count && ra; i++)
+            ra = rsx_vertex_fetch_one(&plan, &refs[i], stride ? a + (u64)i * stride : NULL);
+        const int rb = rsx_vertex_fetch_all(&plan, refs, count, stride ? b : NULL);
+
+        CHECK(ra == rb, "plan %d: fetch_one verdict %d, fetch_all %d", n, ra, rb);
+        if (ra && rb) {
+            ok_runs++;
+            if (memcmp(a, b, (size_t)count * stride) != 0) {
+                u32 off = 0;
+                while (a[off] == b[off]) off++;
+                const u32 v = stride ? off / stride : 0, slot = stride ? (off % stride) / 16u : 0;
+                CHECK(0, "plan %d: output differs at vertex %u slot %u (attr %u type %u size %u)",
+                      n, v, slot, plan.layout.attrs[slot],
+                      plan.attr[plan.layout.attrs[slot]].desc.type,
+                      plan.attr[plan.layout.attrs[slot]].desc.size);
+            }
+        } else if (!ra && !rb) {
+            fail_runs++;
+        }
+    }
+
+    printf("test_vertex_fetch: %d plans (%d succeeded, %d failed on both sides, %d prepared,"
+           " %d inline, %d consecutive), %d failure(s)\n", PLANS, ok_runs, fail_runs, prepared,
+           inline_runs, consecutive_runs, fails);
+    if (ok_runs < PLANS / 4 || fail_runs < 50 || inline_runs < 200) {
+        printf("FAIL: too few cases exercised a path\n");
+        return 1;
+    }
+    return fails ? 1 : 0;
+}
diff --git a/libs/video/tests/test_vertex_remap.c b/libs/video/tests/test_vertex_remap.c
new file mode 100644
index 00000000..53d9fec2
--- /dev/null
+++ b/libs/video/tests/test_vertex_remap.c
@@ -0,0 +1,134 @@
+/*
+ * rsx_vertex_remap_build (direct table when the references allow it) against
+ * rsx_vertex_remap_build_hashed (always the hash table): same unique count,
+ * same unique prefix of refs, same occurrence map.
+ *
+ * The two remap objects are reused across thousands of calls of varying
+ * size, so a generation tag that survives from one draw into the next -- the
+ * way a reused table goes wrong -- shows up as a reference wrongly reported
+ * as already seen.
+ *
+ * Build (from the repo root):
+ *   clang -std=gnu17 -O2 -Wall -Wextra -Wno-unused-parameter -I include -I libs/video \
+ *     -o /tmp/test_vertex_remap libs/video/tests/test_vertex_remap.c \
+ *     libs/video/rsx_vertex_compact.c libs/video/rsx_dispatch.c
+ */
+#include "rsx_vertex_compact.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int fails;
+#define CHECK(c, ...) do { if (!(c)) { fails++; if (fails <= 20) { \
+    printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } } while (0)
+
+static uint64_t rng = 0x13198A2E03707344ull;
+static uint32_t rnd(void)
+{
+    rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17;
+    return (uint32_t)rng;
+}
+
+int main(void)
+{
+    enum { RUNS = 20000, MAXN = 5000 };
+    static rsx_vertex_ref in[MAXN], a[MAXN], b[MAXN];
+    rsx_vertex_remap ra, rb;
+    memset(&ra, 0, sizeof ra);
+    memset(&rb, 0, sizeof rb);
+    int direct_shaped = 0, mixed = 0, wide = 0;
+
+    for (int n = 0; n < RUNS; n++) {
+        const u32 count = 1 + rnd() % MAXN;
+        const int shape = rnd() % 6;
+        const u32 base = rnd() % 4 ? rnd() % 100u : 0;
+        const u32 lo = rnd() % 70000u;
+        const u32 span = shape == 0 ? 1 + rnd() % 8u           /* heavy duplication */
+                       : shape == 1 ? 1u << 20                   /* exactly past the limit */
+                       : shape == 2 ? 0xFFFFFFFFu - lo           /* anything */
+                       : 1 + rnd() % 65536u;                     /* a 16-bit index buffer */
+        for (u32 i = 0; i < count; i++) {
+            in[i].vertex_id = lo + (span ? rnd() % span : 0);
+            in[i].base_index = (shape == 3 && rnd() % 50 == 0) ? base + 1 : base;
+        }
+        if (shape == 3) mixed++;
+        else if (shape == 1 || shape == 2) wide++;
+        else direct_shaped++;
+
+        memcpy(a, in, count * sizeof *in);
+        memcpy(b, in, count * sizeof *in);
+        u32 ua = 0, ub = 0;
+        const int oka = rsx_vertex_remap_build(&ra, a, count, &ua);
+        const int okb = rsx_vertex_remap_build_hashed(&rb, b, count, &ub);
+        CHECK(oka && okb, "run %d: build failed (%d, %d)", n, oka, okb);
+        CHECK(ua == ub, "run %d: unique %u vs %u", n, ua, ub);
+        if (ua != ub) continue;
+        CHECK(!memcmp(a, b, ua * sizeof *a), "run %d: unique prefix differs", n);
+        for (u32 i = 0; i < count; i++)
+            if (rsx_vertex_remap_index(&ra, i) != rsx_vertex_remap_index(&rb, i)) {
+                CHECK(0, "run %d: occurrence %u maps to %u vs %u", n, i,
+                      rsx_vertex_remap_index(&ra, i), rsx_vertex_remap_index(&rb, i));
+                break;
+            }
+    }
+    /* rsx_vertex_remap_build_range: applies exactly when every reference
+     * shares a base and the id range fits in the reference count; then the
+     * refs are lo..hi and every occurrence maps back to its own reference. */
+    int range_ok = 0, range_no = 0;
+    for (int n = 0; n < RUNS; n++) {
+        const u32 count = 1 + rnd() % MAXN;
+        const u32 lo = rnd() % 70000u;
+        const u32 span = rnd() % 3 ? 1 + rnd() % count : 1 + rnd() % (2u * count);
+        const u32 base = rnd() % 100u;
+        const int mixed = rnd() % 10 == 0;
+        u32 vlo = 0xFFFFFFFFu, vhi = 0;
+        int bases_differ = 0;
+        for (u32 i = 0; i < count; i++) {
+            in[i].vertex_id = lo + rnd() % span;
+            in[i].base_index = (mixed && rnd() % 7 == 0) ? base + 1 : base;
+            if (in[i].vertex_id < vlo) vlo = in[i].vertex_id;
+            if (in[i].vertex_id > vhi) vhi = in[i].vertex_id;
+            bases_differ |= in[i].base_index != in[0].base_index;
+        }
+        const int expect = !bases_differ && (u64)vhi - vlo + 1u <= count;
+        memcpy(a, in, count * sizeof *in);
+        u32 out = 0;
+        const int ok = rsx_vertex_remap_build_range(&ra, a, count, &out);
+        CHECK(ok == expect, "range run %d: applied %d, expected %d", n, ok, expect);
+        if (!ok) {
+            range_no++;
+            CHECK(!memcmp(a, in, count * sizeof *in), "range run %d: refs changed on refusal", n);
+            continue;
+        }
+        range_ok++;
+        CHECK(out == vhi - vlo + 1u, "range run %d: count %u, span %u", n, out, vhi - vlo + 1u);
+        for (u32 i = 0; i < out; i++)
+            if (a[i].vertex_id != vlo + i || a[i].base_index != in[0].base_index) {
+                CHECK(0, "range run %d: ref %u is %u/%u", n, i, a[i].vertex_id, a[i].base_index);
+                break;
+            }
+        for (u32 i = 0; i < count; i++) {
+            const u32 m = rsx_vertex_remap_index(&ra, i);
+            if (m >= out || a[m].vertex_id != in[i].vertex_id || a[m].base_index != in[i].base_index) {
+                CHECK(0, "range run %d: occurrence %u maps to %u", n, i, m);
+                break;
+            }
+        }
+    }
+    printf("test_vertex_remap: range mode %d applied, %d refused\n", range_ok, range_no);
+    CHECK(range_ok > RUNS / 4 && range_no > RUNS / 10, "too few cases on one side of range mode");
+
+    /* count 0 and 1 */
+    u32 u = 99;
+    CHECK(rsx_vertex_remap_build(&ra, a, 0, &u) && u == 0, "count 0");
+    a[0].vertex_id = 7; a[0].base_index = 3;
+    CHECK(rsx_vertex_remap_build(&ra, a, 1, &u) && u == 1 && rsx_vertex_remap_index(&ra, 0) == 0, "count 1");
+
+    rsx_vertex_remap_destroy(&ra);
+    rsx_vertex_remap_destroy(&rb);
+    printf("test_vertex_remap: %d runs (%d direct-shaped, %d mixed base, %d wide span), %d failure(s)\n",
+           RUNS, direct_shaped, mixed, wide, fails);
+    return fails ? 1 : 0;
+}
diff --git a/libs/video/tests/test_vp_const_usage.c b/libs/video/tests/test_vp_const_usage.c
new file mode 100644
index 00000000..d7f65db3
--- /dev/null
+++ b/libs/video/tests/test_vp_const_usage.c
@@ -0,0 +1,114 @@
+/*
+ * rsx_vp_analyze_constants against the decompiler it describes.
+ *
+ * The draw engine uploads only the vp_c[] rows this analysis reports, so a row
+ * it misses is a constant the shader reads as stale data. The check here is
+ * not against a second decoding of the fields but against the HLSL the
+ * decompiler actually emits: random programs are decompiled, every vp_c[...]
+ * in the text is collected, and each fixed index must fall inside the
+ * reported range, and a relative read in the shader must be reported as
+ * `relative` (the converse is allowed: it only costs a full upload).
+ *
+ * Build (from the repo root):
+ *   clang -std=gnu17 -Wall -Wextra -I include -I libs/video \
+ *     -o /tmp/test_vp_const_usage libs/video/tests/test_vp_const_usage.c \
+ *     libs/video/rsx_vp_decompiler.c
+ */
+#include "rsx_vp_decompiler.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int fails;
+#define CHECK(c, ...) do { if (!(c)) { fails++; if (fails <= 20) { \
+    printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } } while (0)
+
+static uint64_t rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void)
+{
+    rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17;
+    return (uint32_t)rng;
+}
+
+static void put_le(uint8_t* p, uint32_t v)
+{
+    p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8);
+    p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);
+}
+
+/* One instruction with chosen source types. Opcodes are random over the
+ * whole field; flow-control and unknown ops are left in on purpose, since
+ * the analysis has to cover whatever the decompiler emits for them too. */
+static void make_instr(uint8_t* p, int last, int relative_bias)
+{
+    uint32_t d0 = rnd(), d1 = rnd(), d2 = rnd(), d3 = rnd();
+    /* Bias the source types toward constants (type 3) so most programs
+     * exercise the analysis. */
+    if (rnd() & 1) d1 = (d1 & ~0xFFu) | (((d1 & 0xFFu) & ~1u) | 1u);    /* src0 hi bits */
+    if (rnd() & 1) d2 = (d2 & ~(3u << 6)) | (3u << 6);                  /* src1 type = 3 */
+    if (rnd() & 1) d3 = (d3 & ~(3u << 21)) | (3u << 21);                /* src2 type low bits */
+    if (rnd() & 1) d2 = (d2 & ~(3u << 23)) | (3u << 23);                /* src0 type = 3 */
+    if (!relative_bias) d3 &= ~2u;          /* index_const off */
+    d3 &= ~1u;
+    if (last) d3 |= 1u;
+    put_le(p + 0, d0); put_le(p + 4, d1); put_le(p + 8, d2); put_le(p + 12, d3);
+}
+
+static char hlsl[1 << 20];
+
+int main(void)
+{
+    enum { PROGRAMS = 20000, MAXI = 24 };
+    static uint8_t uc[MAXI * 16];
+    int decompiled = 0, ranged = 0, relative = 0, over_relative = 0;
+    for (int n = 0; n < PROGRAMS; n++) {
+        const int instrs = 1 + (int)(rnd() % MAXI);
+        const int rel = (rnd() % 4) == 0;
+        for (int i = 0; i < instrs; i++) make_instr(uc + i * 16, i == instrs - 1, rel);
+
+        rsx_vp_const_usage u;
+        const int ai = rsx_vp_analyze_constants(uc, (uint32_t)instrs * 16u, &u);
+        CHECK(ai == instrs && u.valid, "program %d: analysis returned %d (valid %d) for %d instrs",
+              n, ai, u.valid, instrs);
+
+        const int r = rsx_vp_decompile(uc, (uint32_t)instrs * 16u, hlsl, sizeof hlsl);
+        if (r < 0) continue;
+        decompiled++;
+
+        int saw_relative = 0;
+        for (const char* q = hlsl; (q = strstr(q, "vp_c[")) != NULL; q += 5) {
+            const char* idx = q + 5;
+            /* The cbuffer declaration, not a read. */
+            if (q - hlsl >= 7 && !strncmp(q - 7, "float4 ", 7)) continue;
+            if (*idx == '(') { saw_relative = 1; continue; }
+            const unsigned c = (unsigned)strtoul(idx, NULL, 10);
+            CHECK(!u.relative ? (u.lo <= u.hi && c >= u.lo && c <= u.hi) : 1,
+                  "program %d: shader reads vp_c[%u] outside [%u, %u]", n, c, u.lo, u.hi);
+        }
+        /* One-way: a relative read the analysis misses would leave rows
+         * unwritten. Reporting relative for a source the opcode never reads
+         * only costs a full copy, so it is allowed and counted. */
+        CHECK(!saw_relative || u.relative,
+              "program %d: shader reads relatively, analysis did not say so", n);
+        if (u.relative && !saw_relative) over_relative++;
+        if (u.relative) relative++; else if (u.lo <= u.hi) ranged++;
+    }
+
+    /* No end flag: the analysis must refuse to give a range. */
+    for (int i = 0; i < 4; i++) make_instr(uc + i * 16, 0, 0);
+    rsx_vp_const_usage u;
+    CHECK(rsx_vp_analyze_constants(uc, 4 * 16u, &u) < 0 && !u.valid,
+          "unterminated program accepted");
+    /* NULL input. */
+    CHECK(rsx_vp_analyze_constants(NULL, 16, &u) < 0 && !u.valid, "NULL ucode accepted");
+
+    printf("test_vp_const_usage: %d programs decompiled (%d ranged, %d relative, %d of those"
+           " conservatively), %d failure(s)\n", decompiled, ranged, relative, over_relative, fails);
+    if (decompiled < PROGRAMS / 2 || ranged < 1000 || relative < 100) {
+        printf("FAIL: too few programs exercised the check\n");
+        return 1;
+    }
+    return fails ? 1 : 0;
+}
