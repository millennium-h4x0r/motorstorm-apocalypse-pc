+/* The parser: today's walk, in a loop of its own. Between passes it waits the
+ * way the rsx thread did -- PS3_DRAIN_NAP_US at a semaphore or a park -- and
+ * when it has caught up with `put` it polls it (no one signals a `put` store):
+ * every 30 us for 2 ms after the last progress, then every 200 us. */
+#ifndef _WIN32
+static void* gcm_split_parser_main(void* arg)
+{
+    (void)arg;
+    ps3_thread_name("rsx-parse");
+    long nap_us = 200;
+    { const char* e = getenv("PS3_DRAIN_NAP_US"); if (e && *e) nap_us = atol(e); }
+    if (nap_us < 0) nap_us = 0;
+    if (nap_us > 999999) nap_us = 999999;
+    unsigned long long last_progress = ps3_qpc_us();
+    for (;;) {
+        AcquireSRWLockExclusive(&s_gcm_fifo_lock);
+        const u32 g0 = s_fifo_getoff;
+        const u64 w0 = s_ring_w;
+        gcm_rsx_process_fifo_unlocked();
+        gcm_ring_publish();
+        const int busy = s_fifo_busy;
+        const int moved = s_fifo_getoff != g0 || s_ring_w != w0;
+        ReleaseSRWLockExclusive(&s_gcm_fifo_lock);
+        if (s_split_lockstep) gcm_split_wait_drained();
+        const unsigned long long now = ps3_qpc_us();
+        if (moved) last_progress = now;
+        if ((busy & 4) && moved) continue;            /* stopped short of put: walk on */
+        if (busy) { gcm_split_nap_us(nap_us); continue; }
+        if (moved) continue;
+        gcm_split_nap_us(now - last_progress < 2000u ? 30 : 200);
+    }
+    return NULL;
+}
+#endif
