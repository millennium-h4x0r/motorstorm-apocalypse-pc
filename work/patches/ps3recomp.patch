+            memcpy(ls + at, vm_base + segs[i].addr, size);
+        } else if (segs[i].type == LV2_SPU_SEG_FILL) {
+            const uint32_t v = segs[i].addr;
+            for (uint32_t o = 0; o + 4 <= size; o += 4) {
+                ls[at + o] = v >> 24; ls[at + o + 1] = v >> 16; ls[at + o + 2] = v >> 8; ls[at + o + 3] = v;
