+/* The far plane must stay the far plane: 1.0 + 0.5 rounded in float is 2^24,
+ * which wrapped every far pixel of a written-back Z24 to 0 (the near plane). */
+static void test_depth_to_d24(void)
+{
+    CHECK(rsx_depth_to_d24(1.0f) == 0xFFFFFFu);
+    CHECK(rsx_depth_to_d24(0.0f) == 0u);
+    CHECK(rsx_depth_to_d24(-0.5f) == 0u);
+    CHECK(rsx_depth_to_d24(2.0f) == 0xFFFFFFu);
+    CHECK(rsx_depth_to_d24(0.5f) == 0x800000u);          /* 8388607.5 rounds up */
+    CHECK(rsx_depth_to_d24(1.0f / 16777215.0f) == 1u);
+    for (u32 d = 0xFFFF00u; d <= 0xFFFFFFu; d++)          /* top of the range round-trips */
+        CHECK(rsx_depth_to_d24((float)d / 16777215.0f) == d);
+}
