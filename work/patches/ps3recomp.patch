+/* The engine TEXTURE handle `*hd` as an RGBA8 image of w x h with `usage`,
+ * created (or created again at another size) as needed, in GENERAL. */
+static int vk_lt_image(void* user, u32* hd, u32 w, u32 h, VkImageUsageFlags usage)
+{
+    vk_eng_obj* o = vk_eng_get(*hd, VK_ENG_TEXTURE);
+    if (o && o->w == w && o->h == h && o->fmt == VK_FORMAT_R8G8B8A8_UNORM) return 0;
+    if (o) vk_eng_release(user, *hd);   /* destroyed once the batch is done with it */
+    *hd = vk_eng_alloc();
+    if (!*hd) return -1;
+    o = &s_eobj[*hd];
+    if (vk_create_image(&o->im, VK_FORMAT_R8G8B8A8_UNORM, w, h, usage, VK_IMAGE_ASPECT_COLOR_BIT)) {
+        vk_destroy_image(&o->im); memset(o, 0, sizeof *o); *hd = 0; return -1;
+    }
+    o->kind = VK_ENG_TEXTURE; o->fmt = VK_FORMAT_R8G8B8A8_UNORM; o->bpp = 4; o->w = w; o->h = h;
+    o->readable = (usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT) != 0;
+    /* Into GENERAL now, or not kept: a later call would find it the right
+     * size and use it in a layout it never got. */
+    if (vk_op_begin()) { vk_eng_release(user, *hd); *hd = 0; return -1; }
+    vk_barrier_image(o->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    return vk_op_end();
+}
+
+/* rsx_draw_backend.native_latch: a private copy of one G-buffer image as it
+ * stands now, for a lighting pass that runs later in the frame. */
+static int vk_eng_native_latch(void* user, u32 which, u32 src)
+{
+    /* A colour target, or a texture made to be copied from. */
+    vk_eng_obj* o = vk_eng_get(src, VK_ENG_COLOR);
+    if (!o) { o = vk_eng_get(src, VK_ENG_TEXTURE); if (o && !o->readable) o = NULL; }
+    if (which > 1u || !o || o->fmt != VK_FORMAT_R8G8B8A8_UNORM || o->block || o->cube) return -1;
+    const u32 w = o->w, h = o->h;
+    if (vk_lt_image(user, &s_lt.in[which], w, h, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT))
+        return -1;
+    o = vk_eng_get(src, VK_ENG_COLOR);
+    if (!o) o = vk_eng_get(src, VK_ENG_TEXTURE);
+    if (!o) return -1;
+    if (vk_op_begin()) return -1;
+    vk_global_barrier();
+    VkImageCopy r = { .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                      .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                      .extent = { w, h, 1 } };
+    pvkCmdCopyImage(s_vk.cmd, o->im.img, VK_IMAGE_LAYOUT_GENERAL,
+                    s_eobj[s_lt.in[which]].im.img, VK_IMAGE_LAYOUT_GENERAL, 1, &r);
+    vk_global_barrier();
+    return vk_op_end();
+}
