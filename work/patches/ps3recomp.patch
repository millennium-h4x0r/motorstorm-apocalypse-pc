+        assert(ic.int_enable == 0);
+        printf("irq interp: iret back to srr0, interrupts off\n");
+
+        /* (9) the job runner's LS 0 exit: a branch back to 0 after the first
+         *     step ends the run as the armed stop. */
+        {
+            extern SPU_THREAD_LOCAL uint32_t g_spu_interp_ls0_exit;
+            memset(&ic, 0, sizeof ic);
+            spu_context_init(&ic, 0);
+            ic.image_id = -1;
+            W(0x00, 0x40800003u);                      /* il $3, 0 */
+            W(0x04, 0x32000000u | ((0x40 - 0x04) >> 2 << 7));   /* br 0x40 */
+            W(0x40, 0x32000000u | ((uint32_t)(-(0x40 >> 2)) & 0xFFFF) << 7); /* br 0 */
+            g_spu_interp_ls0_exit = 0x3E4;
+            spu_interp_run_until(&ic, 0, 0);
+            g_spu_interp_ls0_exit = 0;
+            assert(ic.status == SPU_STATUS_STOPPED_BY_STOP && ic.stop_code == 0x3E4);
+            printf("job ls0 exit: branch back to LS 0 ends the run\n");
+        }
+        #undef W
+    }
+
     printf("spu_interp_selftest: PASS\n");
     return 0;
 }
