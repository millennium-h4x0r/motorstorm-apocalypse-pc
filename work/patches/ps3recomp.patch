+/* ---- write-back of GPU-drawn targets into guest memory -------------------- */
+
+static u8* local_bytes(u32 offset) { return vm_base + GUEST_LOCAL_EA + offset; }
+
+static void test_writeback(void)
+{
+    printf("-- write-back\n");
+    engine_up();
+    const u32 base = 0x40000u, pitch = 256u * 4u;
+    /* A8R8G8B8, Z24S8, linear; pitch A = 1024. */
+    m(M_SURFACE_FORMAT, 8u | (2u << 5) | (1u << 8));
+    m(M_SURFACE_PITCH_A, pitch);
+    memset(local_bytes(base), 0xEE, pitch * 256u);
+    m(M_CLEAR_BUFFERS, 0xF0u);                       /* binds the target */
+
+    /* Rows 10..11 of a copy starting there: only those rows come back, in the
+     * guest's A,R,G,B order. */
+    rsx_draw_engine_writeback(RSX_LOCATION_LOCAL, base + 10u * pitch, pitch, 2u * pitch);
+    const u8* r10 = local_bytes(base + 10u * pitch);
+    CHECK(r10[0] == 0x44 && r10[1] == 0x11 && r10[2] == 0x22 && r10[3] == 0x33,
+          "a copied row comes back as A,R,G,B (%02X %02X %02X %02X)", r10[0], r10[1], r10[2], r10[3]);
+    CHECK(local_bytes(base + 9u * pitch)[0] == 0xEE && local_bytes(base + 12u * pitch)[0] == 0xEE,
+          "rows outside the copy keep the guest's bytes");
+    CHECK(g_stub_rb_y == 10u && g_stub_rb_h == 2u,
+          "only the copied rows are read back (y %u, h %u)", g_stub_rb_y, g_stub_rb_h);
+
+    /* The same rows again with nothing drawn since: no second readback. */
+    const int calls = g_stub_rb_calls;
+    rsx_draw_engine_writeback(RSX_LOCATION_LOCAL, base + 10u * pitch, pitch, 2u * pitch);
+    CHECK(g_stub_rb_calls == calls, "rows already written back are not read again");
+    /* Other rows of the same target still are. */
+    rsx_draw_engine_writeback(RSX_LOCATION_LOCAL, base + 20u * pitch, pitch, pitch);
+    CHECK(g_stub_rb_calls == calls + 1 && local_bytes(base + 20u * pitch)[0] == 0x44,
+          "a copy of other rows of the same target is written back");
+
+    /* A copy that walks another pitch is not this target's layout. */
+    memset(local_bytes(base + 30u * pitch), 0xEE, pitch);
+    rsx_draw_engine_writeback(RSX_LOCATION_LOCAL, base + 30u * pitch, 2u * pitch, pitch);
+    CHECK(local_bytes(base + 30u * pitch)[0] == 0xEE, "a copy at another pitch writes nothing");
+
+    /* A8B8G8R8 is written in its own byte order. */
+    m(M_SURFACE_FORMAT, 16u | (2u << 5) | (1u << 8));
+    m(M_CLEAR_BUFFERS, 0xF0u);
+    rsx_draw_engine_writeback(RSX_LOCATION_LOCAL, base + 40u * pitch, pitch, pitch);
+    const u8* r40 = local_bytes(base + 40u * pitch);
+    CHECK(r40[0] == 0x44 && r40[1] == 0x33 && r40[2] == 0x22 && r40[3] == 0x11,
+          "an A8B8G8R8 target comes back as A,B,G,R (%02X %02X %02X %02X)", r40[0], r40[1], r40[2], r40[3]);
+
+    /* A 16-bit target is never overwritten with 32-bit pixels. */
+    m(M_SURFACE_FORMAT, 3u | (2u << 5) | (1u << 8));
+    m(M_CLEAR_BUFFERS, 0xF0u);
+    memset(local_bytes(base + 50u * pitch), 0xEE, pitch);
+    rsx_draw_engine_writeback(RSX_LOCATION_LOCAL, base + 50u * pitch, pitch, pitch);
+    CHECK(local_bytes(base + 50u * pitch)[0] == 0xEE, "an R5G6B5 target is not written back");
+
+    /* Depth: a 256x128 Z24S8 zeta at 0x100000, pitch 1024, under a canvas-
+     * sized attachment. A copy asking for far more than the buffer stops at
+     * its last row; the stencil byte stays the guest's. */
+    const u32 zbase = 0x100000u;
+    m(M_SURFACE_FORMAT, 8u | (2u << 5) | (1u << 8));
+    m(M_SURFACE_CLIP_V, 128u << 16);
+    m(M_CONTEXT_DMA_ZETA, DMA_LOCAL);
+    m(M_ZETA_OFFSET, zbase);
+    m(M_SURFACE_PITCH_Z, pitch);
+    memset(local_bytes(zbase), 0xEE, pitch * 256u);
+    m(M_CLEAR_BUFFERS, 0x3u);                        /* depth + stencil */
+    rsx_draw_engine_writeback(RSX_LOCATION_LOCAL, zbase, pitch, pitch * 256u);
+    const u8* z0 = local_bytes(zbase);
+    CHECK(z0[0] == 0x80 && z0[1] == 0x00 && z0[2] == 0x00 && z0[3] == 0xEE,
+          "depth 0.5 comes back as Z24 0x800000 with the stencil kept (%02X %02X %02X %02X)",
+          z0[0], z0[1], z0[2], z0[3]);
+    CHECK(local_bytes(zbase + 127u * pitch)[0] == 0x80 && local_bytes(zbase + 128u * pitch)[0] == 0xEE,
+          "the depth write stops at the guest buffer's last row");
+
+    /* A failed depth read writes nothing. */
+    m(M_CLEAR_BUFFERS, 0x3u);
+    memset(local_bytes(zbase), 0xEE, pitch);
+    g_stub_depth_fail = 1;
+    rsx_draw_engine_writeback(RSX_LOCATION_LOCAL, zbase, pitch, pitch);
+    g_stub_depth_fail = 0;
+    CHECK(local_bytes(zbase)[0] == 0xEE, "a failed depth read leaves the guest bytes alone");
+    /* ...and is retried: the rows were never written. */
+    rsx_draw_engine_writeback(RSX_LOCATION_LOCAL, zbase, pitch, pitch);
+    CHECK(local_bytes(zbase)[0] == 0x80, "the depth rows are written once the read succeeds");
+
+    engine_down();
+}
