+ *                          s32 width, height;
+ *                          struct { u32 x0, y0, x1, y1; } Scissor; } */
+enum {
+    CELL_FONT_O_SURF_BUFFER    = 0x00,
+    CELL_FONT_O_SURF_WIDTHBYTE = 0x04,
+    CELL_FONT_O_SURF_PIXELSIZE = 0x08,
+    CELL_FONT_O_SURF_WIDTH     = 0x0C,
+    CELL_FONT_O_SURF_HEIGHT    = 0x10,
+    CELL_FONT_O_SURF_SC_X0     = 0x14,
+    CELL_FONT_O_SURF_SC_Y0     = 0x18,
+    CELL_FONT_O_SURF_SC_X1     = 0x1C,
+    CELL_FONT_O_SURF_SC_Y1     = 0x20,
+    CELL_FONT_SURFACE_SIZE     = 0x24,
+};
+
+/* CellFontGlyphMetrics: { f32 width, height;
+ *   struct { f32 bearingX, bearingY, advance; } Horizontal, Vertical; } */
+enum {
+    CELL_FONT_O_GM_WIDTH    = 0x00,
+    CELL_FONT_O_GM_HEIGHT   = 0x04,
+    CELL_FONT_O_GM_H_BX     = 0x08,
+    CELL_FONT_O_GM_H_BY     = 0x0C,
+    CELL_FONT_O_GM_H_ADV    = 0x10,
+    CELL_FONT_O_GM_V_BX     = 0x14,
+    CELL_FONT_O_GM_V_BY     = 0x18,
+    CELL_FONT_O_GM_V_ADV    = 0x1C,
+    CELL_FONT_GLYPH_METRICS_SIZE = 0x20,
+};
+
+/* CellFontImageTransInfo: { u8* Image; u32 imageWidthByte; u32 imageWidth;
+ *                           u32 imageHeight; void* Surface; u32 surfWidthByte; } */
+enum {
+    CELL_FONT_O_TI_IMAGE        = 0x00,
+    CELL_FONT_O_TI_IMAGE_WBYTE  = 0x04,
+    CELL_FONT_O_TI_IMAGE_WIDTH  = 0x08,
+    CELL_FONT_O_TI_IMAGE_HEIGHT = 0x0C,
+    CELL_FONT_O_TI_SURFACE      = 0x10,
+    CELL_FONT_O_TI_SURF_WBYTE   = 0x14,
+    CELL_FONT_TRANS_INFO_SIZE   = 0x18,
+};
+
+/* CellFontHorizontalLayout: { f32 baseLineY; f32 lineHeight; f32 effectHeight; } */
+enum {
+    CELL_FONT_O_HL_BASELINE   = 0x00,
+    CELL_FONT_O_HL_LINEHEIGHT = 0x04,
+    CELL_FONT_O_HL_EFFECT     = 0x08,
+};
+
+/* CellFontKerning: { f32 offsetX; f32 offsetY; } */
+enum {
+    CELL_FONT_O_KERN_X = 0x00,
+    CELL_FONT_O_KERN_Y = 0x04,
+};
 
