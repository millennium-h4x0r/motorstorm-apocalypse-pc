+    gxx = shutil.which("g++")
+    if not cxx:
+        print("skip: no clang++")
+        return 0
+    hdr = apply_fast_mm(HEADER_PREAMBLE)
+    check("thunks in the header", "PPU_THUNK_BODY" in hdr and "preserve_all" in hdr)
+    with tempfile.TemporaryDirectory() as d:
+        open(os.path.join(d, "ppu_recomp.h"), "w").write(hdr + "\n")
+        open(os.path.join(d, "callee.c"), "w").write(CALLEE)
+        open(os.path.join(d, "caller.cpp"), "w").write(CALLER)
+        cc = gxx or cxx
+        r = subprocess.run([cc.replace("++", "cc") if cc.endswith("g++") else cxx, "-O2", "-x", "c",
+                            "-c", os.path.join(d, "callee.c"), "-o", os.path.join(d, "callee.o")],
+                           capture_output=True, text=True)
+        check("callee compiles", r.returncode == 0, r.stderr[-1500:])
+        if r.returncode:
+            return 1
+        outs = {}
+        for tag, defs in (("thunk", ["-DUSE_THUNK"]), ("plain", [])):
+            exe = os.path.join(d, tag)
+            r = subprocess.run([cxx, "-O3", "-march=x86-64-v3", "-std=gnu++20", "-w", "-I", d] + defs +
+                               [os.path.join(d, "caller.cpp"), os.path.join(d, "callee.o"), "-o", exe],
+                               capture_output=True, text=True)
+            check(f"{tag} caller builds", r.returncode == 0, r.stderr[-1500:])
+            if r.returncode:
+                return 1
+            outs[tag] = subprocess.run([exe], capture_output=True, text=True).stdout.strip()
+            if tag == "thunk":
+                dis = subprocess.run(["objdump", "-d", "--no-show-raw-insn", exe], capture_output=True,
+                                     text=True).stdout
+                body = dis[dis.find("vm_read32_coldm>:"):][:4000]
+                check("the thunk saves ymm and ends without vzeroupper",
+                      "vmovdqu %ymm15" in body and "vzeroupper\n" in body and
+                      body.split("ret")[0].rstrip().splitlines()[-1].find("vzeroupper") < 0, body[:400])
+        check("thunk caller computes what the plain caller does", outs["thunk"] == outs["plain"], outs)
+        if gxx:
+            src = os.path.join(d, "g.cpp")
+            open(src, "w").write('#define PPU_INLINE_STORES\n#include "ppu_recomp.h"\n'
+                                 'unsigned f(uint64_t a) { return vm_read32_inl(a) + vm_read8_inl(a); }\n'
+                                 'void g(uint64_t a) { vm_write32_inl(a, 5); }\n')
+            r = subprocess.run([gxx, "-O2", "-w", "-I", d, "-c", src, "-o", os.path.join(d, "g.o")],
+                               capture_output=True, text=True)
+            check("the header builds with GCC", r.returncode == 0, r.stderr[-1500:])
+        # --coh-bytemap header, and the --stack-fast accessors, with both compilers
+        bdir = os.path.join(d, "bm"); os.makedirs(bdir)
+        open(os.path.join(bdir, "ppu_recomp.h"), "w").write(apply_fast_mm(HEADER_PREAMBLE, True) + "\n")
+        src = os.path.join(bdir, "b.cpp")
+        open(src, "w").write('#define PPU_INLINE_STORES\n#include "ppu_recomp.h"\n'
+                             'unsigned f(uint64_t a) { const ppu_mm _mm = ppu_mm_take(); vm_write32_mm(&_mm, a, 1);'
+                             ' vm_write64_stk_mm(&_mm, a + 8, 2); return vm_read32_stk_mm(&_mm, a + 8) + vm_read8_mm(&_mm, a); }\n')
+        for cc in [c for c in (cxx, gxx) if c]:
+            r = subprocess.run([cc, "-O2", "-w", "-march=x86-64-v3", "-I", bdir, "-c", src, "-o", src + ".o"],
+                               capture_output=True, text=True)
+            check(f"the --coh-bytemap header builds with {os.path.basename(cc)}", r.returncode == 0, r.stderr[-1500:])
+    print(f"\n{'FAILED: ' + ', '.join(FAILS) if FAILS else 'all passed'}")
+    return 1 if FAILS else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
