+/* NV40 half registers alias the full ones: H(2n) is the low and H(2n+1) the
+ * high half of R(n), two fp16 values to each 32-bit component -- R(n).x holds
+ * H(2n).x in its low 16 bits and H(2n).y in its high 16, R(n).y H(2n).zw,
+ * R(n).z/w H(2n+1). The decompiler keeps r[] and h[] apart, which is only
+ * right for a register a program uses one way. The pairs it uses both ways
+ * (bit n: R(n) and H(2n) or H(2n+1) both read or written) are kept coherent
+ * after every write (rsx_fp_alias_sync). MotorStorm Apocalypse writes its
+ * velocity as halves into H0.xy and stores R0 through UP4UB: separate, the
+ * motion-blur buffer held the wrong register and smeared the frame. */
+static u64 rsx_fp_alias_pairs(const u8* ucode, u32 max_bytes)
+{
+    u64 full = 0, half = 0;      /* bit n: R(n) used; bit n: H(2n) or H(2n+1) used */
+    u32 off = 0;
+    while (off + 16 <= max_bytes) {
+        const u32 w0 = rsx_fp_read_word(ucode + off + 0);
+        const u32 w1 = rsx_fp_read_word(ucode + off + 4);
+        const u32 w2 = rsx_fp_read_word(ucode + off + 8);
+        const u32 w3 = rsx_fp_read_word(ucode + off + 12);
+        off += 16;
+        if (!(w2 & FP_BRANCH)) {
+            if (!(w0 & FP_OUT_NONE)) {
+                const u32 d = (w0 & FP_OUT_REG_MASK) >> FP_OUT_REG_SHIFT;
+                if (w0 & FP_OUT_HALF) half |= 1ull << ((d >> 1) & 63u);
+                else full |= 1ull << (d & 63u);
