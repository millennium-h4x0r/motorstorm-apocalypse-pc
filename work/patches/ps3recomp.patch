+            if (x && *x) snprintf(dir, sizeof dir, "%s/ps3recomp/spirv", x);
+            else if (la && *la) snprintf(dir, sizeof dir, "%s/ps3recomp/spirv", la);
+            else if (h && *h) snprintf(dir, sizeof dir, "%s/.cache/ps3recomp/spirv", h);
