+/* CellFontRenderer: { void* systemReserved[64]; } (256 bytes, title-owned).
+ * CellFont:         { void* SystemReserved[64]; } (256 bytes, title-owned).
+ * Both are opaque to the title; the words we keep in them are ours. */
+enum {
+    CELL_FONT_O_OBJ_MAGIC  = 0x00,
+    CELL_FONT_O_OBJ_SLOT   = 0x04,
+    CELL_FONT_O_FONT_SCALE_X = 0x08,   /* informational copies */
+    CELL_FONT_O_FONT_SCALE_Y = 0x0C,
+    CELL_FONT_OPAQUE_SIZE  = 0x100,
+};
