+/* A float colour target's guest pixel: fn components of fsz bytes, each
+ * big-endian, R first (the texture decoder's order for 0x9A/0x9B/0x90).
+ * 0 for an 8-bit target. */
+static u32 eng_float_layout(rsx_be_format f, u8* fsz, u8* fn)
+{
