+        memset(&ic, 0, sizeof ic);
+        spu_context_init(&ic, 0);
+        ic.image_id = -1;
+        W(0x00, 0x00000123u);
+        W(0x40, 0x35600000u | (3u << 7) | 0x40000u);
+        W(0x60, 0x00000000u);
+        ic.gpr[3]._u32[0] = 0x60;
+        ic.event_status = 1; ic.event_mask = 1;
+        ic.sn_defer = 1;
+        spu_interp_run_until(&ic, 0x40, 0);
+        assert(ic.status == SPU_STATUS_STOPPED_BY_STOP && ic.stop_code == 0);
+        assert(ic.sn_defer == 0);
+        printf("irq interp: sn_defer runs one more instruction\n");
+
